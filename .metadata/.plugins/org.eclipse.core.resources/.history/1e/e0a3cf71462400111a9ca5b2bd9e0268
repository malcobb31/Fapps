    // =========================================================================
    // 3. GET MRD SET FROM CAMP  (opd_visit = 'Y')
    // =========================================================================

    /**
     * Fetch distinct MRD_NO values from Camp_count_detail for processMonth
     * where opd_visit = 'Y'.  Used to tag Camp (Out Reach) OPD type.
     *
     * Binary search is performed on Registered_date column.
     *
     * @param campTable    Camp_count_detail (or equivalent)
     * @param processDate  YYYY-MM-DD
     * @param processMonth YYYY-MM
     * @param dbURL        DB URL
     * @param dbName       DB username
     * @param dbPass       DB password
     * @return HashSet<String>  MRD_NO values, uppercase-trimmed; empty set on error
     */
    public HashSet<String> getMRDSetFromCamp(String campTable,
                                             String processDate, String processMonth,
                                             String dbURL, String dbName, String dbPass) {

        HashSet<String> mrdSet = new HashSet<String>();
        Connection conn        = null;
        Statement  stmt        = null;
        ResultSet  rs          = null;
        int rowCount           = 0;

        try {
            String firstDay = processMonth + "-01";

            String binaryDateM = "Registered_date~~" + firstDay + "~~monthly";
            String[] snoRangeM = binarySearch("yes", binaryDateM, campTable, dbURL, dbName, dbPass);

            String binaryDateD = "Registered_date~~" + processDate + "~~daily";
            String[] snoRangeD = binarySearch("yes", binaryDateD, campTable, dbURL, dbName, dbPass);

            pu.sop("getMRDSetFromCamp", "SNO Range: [" + snoRangeM[0] + " - " + snoRangeD[1] + "]");

            String query =
                "SELECT TRIM(UPPER(MRD_NO)) AS MRD_NO"
                + " FROM " + campTable
                + " WHERE sno >= " + snoRangeM[0] + " AND sno <= " + snoRangeD[1]
                + "   AND DATE_FORMAT(Registered_date, '%Y-%m') = '" + processMonth + "'"
                + "   AND UPPER(TRIM(opd_visit)) = 'Y'"
                + "   AND MRD_NO IS NOT NULL AND TRIM(MRD_NO) != ''";

            pu.sop("getMRDSetFromCamp", "Query: " + query);

            conn = new MySQLConnection().getConnection(dbURL, dbName, dbPass);
            stmt = conn.createStatement(ResultSet.TYPE_SCROLL_INSENSITIVE, ResultSet.CONCUR_READ_ONLY);
            rs   = stmt.executeQuery(query);

            rs.last();
            rowCount = rs.getRow();
            rs.beforeFirst();

            pu.sop("getMRDSetFromCamp", "Total camp MRD records: " + rowCount);

            while (rs.next()) {
                String mrd = rs.getString("MRD_NO");
                if (mrd != null && !mrd.trim().isEmpty()) {
                    mrdSet.add(mrd.trim().toUpperCase());
                }
            }

        } catch (Exception ex) {
            System.out.println("EXCEPTION in getMRDSetFromCamp: " + ex.toString());
            ex.printStackTrace();
        } finally {
            try {
                if (rs   != null) rs.close();
                if (stmt != null) stmt.close();
                if (conn != null) conn.close();
            } catch (Exception e) { /* ignore */ }
        }

        return mrdSet;
    }

