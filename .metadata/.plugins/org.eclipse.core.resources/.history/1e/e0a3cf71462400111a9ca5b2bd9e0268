/**
 * OPD_Source - Data Retrieval for OPD Type Classification
 *
 * Methods:
 *  1. deleteCurrentDayData()       - Remove existing rows for processDate from dest table
 *                                    and reset AUTO_INCREMENT
 *  2. copySourceData()             - INSERT all rows from source table for processDate
 *                                    into dest table with OPD_TYPE = 'Natural OPD'
 *                                    ordered by VISIT_DATE
 *  3. getMRDSetFromCamp()          - Fetch distinct MRD_NO from Camp_count_detail
 *                                    where opd_visit = 'Y' for processMonth
 *  4. getMRDSetFromScreening()     - Fetch distinct MRD_NO from Free_Screening_Count
 *                                    where opd_visit = 'Y' for processMonth
 *
 * All queries use SNORangeFinder binary-search to narrow the scan range,
 * exactly as TCN_Source does.
 */
public class OPD_Source {

    PrintUtilMsg pu = new PrintUtilMsg();

    // =========================================================================
    // BINARY SEARCH HELPER  (same pattern as TCN_Source)
    // =========================================================================

    private String[] binarySearch(String binarySearch, String date, String sourceTable,
                                  String db_url, String db_name, String db_pass) {

        String[] snoRangeReturn = new String[4];

        try {
            pu.sop("binarySearch", "Is Binary Search? [" + binarySearch + "]");

            if (binarySearch.equalsIgnoreCase("yes")) {

                String[] pull_data_details = date.split("~~");
                String dateColumn = pull_data_details[0];
                String dateValue  = pull_data_details[1];
                String trendType  = pull_data_details[2];

                String[] dates_details = dateValue.split("#");
                boolean hashExist = dates_details.length > 1;

                String from_date_final = "";
                String to_date_final   = "";
                int[]  snoRangeFinal   = new int[2];

                pu.sop("binarySearch", "DateColumn: " + dateColumn
                        + ", Date: " + dateValue + ", Trend: " + trendType);

                int[] snoRange = new SNORangeFinder().getStartEndIdOfTable(
                        sourceTable, db_url, db_name, db_pass);
                pu.sop("binarySearch", "Table MIN [" + snoRange[0] + "], MAX [" + snoRange[1] + "]");

                if (trendType.toLowerCase().equals("monthly")
                        || (trendType.toLowerCase().equals("daily") && hashExist)) {

                    if (!hashExist) {
                        from_date_final = dateValue.substring(0, 8) + "01";
                        to_date_final   = dateValue;
                    } else if (hashExist && trendType.toLowerCase().equals("monthly")) {
                        java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
                        java.util.Date shared_date = sdf.parse(dates_details[0]);
                        java.util.Calendar c = java.util.Calendar.getInstance();
                        c.setTime(shared_date);
                        c.add(java.util.Calendar.MONTH, -Integer.parseInt(dates_details[1]));
                        String from_year_month = sdf.format(c.getTime());
                        from_date_final = from_year_month.substring(0, 8) + "01";
                        to_date_final   = dates_details[0].substring(0, 8) + "01";
                    } else {
                        int numberOfDays = (Integer.parseInt(dates_details[1])) - 1;
                        java.util.Date shared_date =
                                new java.text.SimpleDateFormat("yyyy-MM-dd").parse(dates_details[0]);
                        java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
                        to_date_final = sdf.format(shared_date);
                        java.util.Calendar c = java.util.Calendar.getInstance();
                        c.setTime(shared_date);
                        c.add(java.util.Calendar.DATE, -numberOfDays);
                        from_date_final = sdf.format(c.getTime());
                    }

                    String[] dates = {from_date_final, to_date_final};

                    for (int i = 0; i < dates.length; i++) {
                        int[] snoRangeToFromDate = new SNORangeFinder().getStartAndEndId(
                                dates[i], snoRange[0], snoRange[1], sourceTable,
                                "DATE_FORMAT(" + dateColumn + ",'%Y-%m-%d')",
                                "daily", "120", false, "sno",
                                db_url, db_name, db_pass);

                        pu.sop("binarySearch", "FOR DATE [" + dates[i] + "], MinSno["
                                + snoRangeToFromDate[0] + "], MaxSno[" + snoRangeToFromDate[1] + "]");

                        if (i == 0) snoRangeFinal[0] = snoRangeToFromDate[0];
                        else        snoRangeFinal[1] = snoRangeToFromDate[1];
                    }

                    snoRangeReturn[0] = "" + snoRangeFinal[0];
                    snoRangeReturn[1] = "" + snoRangeFinal[1];
                    snoRangeReturn[2] = from_date_final;
                    snoRangeReturn[3] = to_date_final;

                } else {
                    snoRange = new SNORangeFinder().getStartAndEndId(
                            dateValue, snoRange[0], snoRange[1], sourceTable,
                            "DATE_FORMAT(" + dateColumn + ",'%Y-%m-%d')",
                            trendType.toLowerCase(), "120", false, "sno",
                            db_url, db_name, db_pass);

                    snoRangeReturn[0] = "" + snoRange[0];
                    snoRangeReturn[1] = "" + snoRange[1];
                    snoRangeReturn[2] = "NA";
                    snoRangeReturn[3] = "NA";
                }
            }

        } catch (Exception ex) {
            System.out.println("EXCEPTION in binarySearch: " + ex.toString());
            ex.printStackTrace();
        }

        return snoRangeReturn;
    }

    // =========================================================================
    // 1. DELETE CURRENT DAY DATA
    // =========================================================================

    /**
     * Delete rows from the destination table where VISIT_DATE = processDate,
     * then reset AUTO_INCREMENT to MAX(sno)+1 so the sequence stays clean.
     *
     * @param destTable    Destination table name
     * @param processDate  YYYY-MM-DD
     * @param dbURL        DB URL
     * @param dbName       DB username
     * @param dbPass       DB password
     * @return boolean     true if successful
     */
    public boolean deleteCurrentDayData(String destTable, String processDate,
                                        String dbURL, String dbName, String dbPass) {

        Connection conn   = null;
        Statement  stmt   = null;
        boolean isDeleted = false;
        int deletedRows   = 0;

        

        String firstDay = processDate.substring(0, 7) + "-01";

     // Get SNO range for month start
     String binaryDateMonthly = "VISIT_DATE~~" + firstDay + "~~daily";
     String[] snoRangeStart = binarySearch("yes", binaryDateMonthly,
             destTable, dbURL, dbName, dbPass);

     // Get SNO range for process date
     String binaryDateDaily = "VISIT_DATE~~" + processDate + "~~daily";
     String[] snoRangeEnd = binarySearch("yes", binaryDateDaily,
             destTable, dbURL, dbName, dbPass);

     String snoMin = snoRangeStart[0];
     String snoMax = snoRangeEnd[1];

     String deleteQuery = "DELETE FROM " + destTable
    		    + " WHERE sno >= " + snoMin
    		    + " AND sno <= " + snoMax
    		    + " AND STR_TO_DATE(VISIT_DATE, '%Y-%m-%d') IS NOT NULL";
        try {
            pu.sop("deleteCurrentDayData", "Query: " + deleteQuery);

            conn = new MySQLConnection().getConnection(dbURL, dbName, dbPass);
            stmt = conn.createStatement();
            deletedRows = stmt.executeUpdate(deleteQuery);
            conn.commit();

            pu.sop("deleteCurrentDayData", "Rows deleted: " + deletedRows);

            // Reset AUTO_INCREMENT to avoid gaps / collisions
            String maxSnoQuery = "SELECT COALESCE(MAX(sno), 0) AS maxSno FROM " + destTable;
            ResultSet rs = stmt.executeQuery(maxSnoQuery);
            long maxSno = 0;
            if (rs.next()) {
                maxSno = rs.getLong("maxSno");
            }
            rs.close();

            long nextSno = maxSno + 1;
            String alterQuery = "ALTER TABLE " + destTable + " AUTO_INCREMENT = " + nextSno;
            stmt.executeUpdate(alterQuery);
            conn.commit();

            pu.sop("deleteCurrentDayData", "AUTO_INCREMENT reset to: " + nextSno);

            isDeleted = true;

        } catch (Exception ex) {
            System.out.println("EXCEPTION in deleteCurrentDayData: " + ex.toString());
            ex.printStackTrace();
            isDeleted = false;
        } finally {
            try {
                if (stmt != null) stmt.close();
                if (conn != null) conn.close();
            } catch (Exception e) { /* ignore */ }
        }

        return isDeleted;
    }

