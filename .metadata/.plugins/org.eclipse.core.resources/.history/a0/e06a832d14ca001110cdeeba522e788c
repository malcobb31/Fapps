            completedFiles++;
            if (!fs.moved && ("FATAL_ERROR".equalsIgnoreCase(fs.status) || "DB_ERROR".equalsIgnoreCase(fs.status) || "BATCH_FAILURE".equalsIgnoreCase(fs.status))) {
                retainedFiles++;
