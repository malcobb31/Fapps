    public void process(File input) {
        if (input == null) {
            log("ERROR", "Input path is null", serverIP, "FATAL_ERROR");
            return;
        }

        log("INFO", "Process started: " + input.getAbsolutePath(), serverIP, "START");

        Map<String, ReportingEntityRow> reportingEntityLookup;
        Map<String, RegionRow> regionLookup;
        Map<String, BranchRow> branchLookup;
        Set<String> existingTargetUserIds;
        Map<String, String> reUserStatusLookup;

        try {
            reportingEntityLookup = loadReportingEntityLookup();
            regionLookup = loadRegionLookup();
            branchLookup = loadBranchLookup();
            existingTargetUserIds = loadExistingTargetUserIds();
            reUserStatusLookup = loadReUserStatusLookup();
        } catch (SQLException e) {
            log("ERROR", "Fatal error loading lookups: " + rootCause(e), serverIP, "FATAL_ERROR");
            return;
        }

        log("INFO", "Lookup loaded: reporting_entity_pview_bkp_1610=" + reportingEntityLookup.size()
                + " region_pview_bkp_1610=" + regionLookup.size()
                + " branch_pview_bkp_1610=" + branchLookup.size()
                + " target_user_ids=" + existingTargetUserIds.size()
                + " re_user_status=" + reUserStatusLookup.size(), serverIP, "LOOKUP_LOADED");

        if (input.isFile()) {
            DirectorySummary ds = new DirectorySummary();
            FileSummary fs = processOneFile(input, reportingEntityLookup, regionLookup, branchLookup, existingTargetUserIds, reUserStatusLookup);
            ds.totalFiles = 1;
            if (fs != null) {
                ds.accumulate(fs);
            }
            log("INFO", buildDirectorySummary(ds), serverIP, "DIR_SUMMARY");
            return;
        }

        File[] files = input.listFiles();
        if (files == null || files.length == 0) {
            DirectorySummary ds = new DirectorySummary();
            log("INFO", buildDirectorySummary(ds), serverIP, "DIR_SUMMARY");
            return;
        }

        List<File> csvFiles = new ArrayList<File>();
        for (File f : files) {
            if (f != null && f.isFile() && f.getName().toLowerCase(Locale.ENGLISH).endsWith(".csv")) {
                csvFiles.add(f);
            }
        }

        Collections.sort(csvFiles, new Comparator<File>() {
            @Override
            public int compare(File a, File b) {
                return a.getName().compareToIgnoreCase(b.getName());
            }
        });

        DirectorySummary ds = new DirectorySummary();
        ds.totalFiles = csvFiles.size();

        final Map<String, ReportingEntityRow> finalReportingEntityLookup = reportingEntityLookup;
        final Map<String, RegionRow> finalRegionLookup = regionLookup;
        final Map<String, BranchRow> finalBranchLookup = branchLookup;
        final Set<String> finalExistingTargetUserIds = existingTargetUserIds;
        final Map<String, String> finalReUserStatusLookup = reUserStatusLookup;

        ExecutorService executor = Executors.newFixedThreadPool(Math.min(MAX_PARALLEL_FILES, Math.max(1, csvFiles.size())));
        List<Future<FileSummary>> futures = new ArrayList<Future<FileSummary>>();

        for (final File file : csvFiles) {
            futures.add(executor.submit(new Callable<FileSummary>() {
                @Override
                public FileSummary call() {
                    return processOneFile(file, finalReportingEntityLookup, finalRegionLookup, finalBranchLookup, finalExistingTargetUserIds, finalReUserStatusLookup);
                }
            }));
        }

        executor.shutdown();

        for (Future<FileSummary> future : futures) {
            try {
                FileSummary fs = future.get();
                if (fs != null) {
                    ds.accumulate(fs);
                }
            } catch (Exception e) {
                ds.errorFiles++;
                log("ERROR", "Fatal file execution error: " + rootCause(e), serverIP, "FATAL_ERROR");
            }
        }

        log("INFO", buildDirectorySummary(ds), serverIP, "DIR_SUMMARY");
    }

    private Map<String, ReportingEntityRow> loadReportingEntityLookup() throws SQLException {
        Map<String, ReportingEntityRow> map = new HashMap<String, ReportingEntityRow>();
        Connection connection = null;
        Statement st = null;
        ResultSet rs = null;

        try {
            connection = openConnection();
            st = connection.createStatement();
            rs = st.executeQuery(REPORTING_ENTITY_LOOKUP_SQL);

            while (rs.next()) {
                UUID id = parseUuid(rs.getObject("id"));
                String fiCode = normalizeKey(rs.getString("fi_code"));
                if (id == null || fiCode == null) {
                    continue;
                }

                ReportingEntityRow row = new ReportingEntityRow(id, fiCode);
                if (!map.containsKey(fiCode)) {
                    map.put(fiCode, row);
                }
            }
        } finally {
            closeQuietly(rs);
            closeQuietly(st);
            closeQuietly(connection);
        }

        return map;
    }

    private Map<String, RegionRow> loadRegionLookup() throws SQLException {
        Map<String, RegionRow> map = new HashMap<String, RegionRow>();
        Connection connection = null;
        Statement st = null;
        ResultSet rs = null;

        try {
            connection = openConnection();
            st = connection.createStatement();
            rs = st.executeQuery(REGION_LOOKUP_SQL);

            while (rs.next()) {
                UUID id = parseUuid(rs.getObject("id"));
                UUID reportingEntityId = parseUuid(rs.getObject("reporting_entity_id"));
                String regionCode = normalizeKey(rs.getString("region_code"));

                if (id == null || reportingEntityId == null || regionCode == null) {
                    continue;
                }

                String key = composeKey(regionCode, reportingEntityId);
                RegionRow row = new RegionRow(id, regionCode, reportingEntityId);
                if (!map.containsKey(key)) {
                    map.put(key, row);
                }
            }
        } finally {
            closeQuietly(rs);
            closeQuietly(st);
            closeQuietly(connection);
        }

        return map;
    }

