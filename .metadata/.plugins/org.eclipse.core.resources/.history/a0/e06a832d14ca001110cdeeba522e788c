                map.put(userId, status);
            }
        } finally {
            closeQuietly(rs);
            closeQuietly(st);
            closeQuietly(connection);
        }

        return map;
    }

    private FileSummary processOneFile(File file,
                                       Map<String, ReportingEntityRow> reportingEntityLookup,
                                       Map<String, RegionRow> regionLookup,
                                       Map<String, BranchRow> branchLookup,
                                       Set<String> existingTargetUserIds,
                                       Map<String, String> reUserStatusLookup) {
        FileSummary summary = new FileSummary(file == null ? "NA" : file.getName());
        summary.status = "STARTED";
        summary.effectiveBatchSize = BATCH_SIZE;

        log("INFO", "File start: " + summary.fileName, serverIP, "FILE_START");

        BufferedReader reader = null;
        Connection connection = null;
        PreparedStatement ps = null;
        boolean fatal = false;

        Set<String> seenUserIds = new HashSet<String>();
        Set<String> duplicateUserIds = new HashSet<String>();
        List<String> lookupFailures = new ArrayList<String>();

        try {
            if (file == null || !file.exists()) {
                summary.status = "MISSING";
                summary.dbFailed++;
                fatal = true;
                return summary;
            }

            reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), fileCharset));
            String headerLine = reader.readLine();

            if (headerLine == null) {
                summary.status = "EMPTY_FILE";
                summary.emptyFile = true;
                File moved = moveAfterSuccess(file);
                summary.moved = moved != null;
                log("INFO", "File moved: " + summary.fileName + " -> " + (moved != null ? moved.getAbsolutePath() : "NA"), serverIP, "FILE_MOVED");
                logFileSummary(summary);
                return summary;
            }

            List<String> headers = parseCsvLine(headerLine, delimiter.charAt(0));
            Map<String, Integer> headerIndex = buildHeaderIndex(headers);

            if (headerIndex.isEmpty()) {
                summary.status = "HEADER_ONLY";
                summary.headerOnlyFile = true;
                File moved = moveAfterSuccess(file);
                summary.moved = moved != null;
                log("INFO", "File moved: " + summary.fileName + " -> " + (moved != null ? moved.getAbsolutePath() : "NA"), serverIP, "FILE_MOVED");
                logFileSummary(summary);
                return summary;
            }

            connection = openConnection();
            connection.setAutoCommit(false);
            ps = connection.prepareStatement(INSERT_SQL);

            String line;
            int batchCount = 0;
            int lineNumber = 1;

            while ((line = reader.readLine()) != null) {
                lineNumber++;

                if (line.trim().length() == 0) {
                    summary.blankLines++;
                    continue;
                }

                summary.dataRows++;

                List<String> rowTokens = parseCsvLine(line, delimiter.charAt(0));
                RowBuildResult row = buildRow(
                        rowTokens,
                        headerIndex,
                        reportingEntityLookup,
                        regionLookup,
                        branchLookup,
                        existingTargetUserIds,
                        reUserStatusLookup,
                        seenUserIds,
                        duplicateUserIds,
                        lookupFailures,
                        lineNumber);

                if (row.logMessage != null) {
                    log(row.logLevel, row.logMessage, serverIP, row.evtType);
                }

                if (!row.ok) {
                    if (row.skipIneligibleType) {
                        summary.skippedIneligibleType++;
                    } else if (row.duplicateInFile) {
                        summary.duplicateInFile++;
                    } else if (row.duplicateInTarget) {
                        summary.duplicateInTarget++;
                    } else if (row.lookupFailure) {
                        summary.lookupFailures++;
                    } else {
                        summary.rowErrors++;
                    }
                    summary.skipped++;
                    continue;
                }

                bindRow(ps, row.rowValues);
                ps.addBatch();
                batchCount++;

                if (batchCount >= BATCH_SIZE) {
                    executeBatch(ps, summary, file.getName(), batchCount);
                    batchCount = 0;
                }
            }

            if (batchCount > 0) {
                executeBatch(ps, summary, file.getName(), batchCount);
            }

            connection.commit();
            summary.status = summary.dataRows == 0 ? "HEADER_ONLY" : "SUCCESS";
            if (summary.dataRows == 0) {
                summary.headerOnlyFile = true;
            }

            if (!duplicateUserIds.isEmpty()) {
                log("WARN",
                        "Duplicate user_ids found (" + duplicateUserIds.size() + "): " + joinSet(duplicateUserIds),
                        serverIP,
                        "DUPLICATE_SUMMARY");
            }

            if (!lookupFailures.isEmpty()) {
                log("WARN",
                        "Lookup failures found (" + lookupFailures.size() + "): " + joinList(lookupFailures),
                        serverIP,
                        "LOOKUP_FAILURES");
            }

            File moved = moveAfterSuccess(file);
            summary.moved = moved != null;
            if (moved != null) {
                log("INFO", "File moved: " + summary.fileName + " -> " + moved.getAbsolutePath(), serverIP, "FILE_MOVED");
            } else {
                log("WARN", "File not moved after commit: " + summary.fileName, serverIP, "FILE_MOVED");
            }

            logFileSummary(summary);
        } catch (BatchUpdateException bue) {
            summary.batchFailures++;
            summary.dbFailed++;
            summary.status = "BATCH_FAILURE";
            fatal = true;
            log("ERROR", "Batch failure on file " + summary.fileName + ": " + rootCause(bue), serverIP, "BATCH_FAILURE");
        } catch (SQLException sqle) {
            summary.dbFailed++;
            summary.status = "DB_ERROR";
            fatal = true;
            log("ERROR", "Database error on file " + summary.fileName + ": " + rootCause(sqle), serverIP, "FATAL_ERROR");
        } catch (Exception e) {
            summary.dbFailed++;
            summary.status = "FATAL_ERROR";
            fatal = true;
            log("ERROR", "Fatal error on file " + summary.fileName + ": " + rootCause(e), serverIP, "FATAL_ERROR");
        } finally {
            if (fatal) {
                rollbackQuietly(connection);
                summary.moved = false;
                log("WARN", "File retained in source directory: " + summary.fileName, serverIP, "FILE_RETAINED");
                logFileSummary(summary);
            }
            closeQuietly(ps);
            closeQuietly(connection);
            closeQuietly(reader);
        }

        return summary;
    }

    private Connection openConnection() throws SQLException {
        return DriverManager.getConnection(jdbcUrl, dbUser, dbPassword);
    }

    private void executeBatch(PreparedStatement ps, FileSummary summary, String fileName, int batchCount) throws SQLException {
        try {
            ps.executeBatch();
            ps.clearBatch();
            summary.inserted += batchCount;
        } catch (BatchUpdateException bue) {
            summary.batchFailures++;
            log("ERROR", "Batch execution failure for file " + fileName + ": " + rootCause(bue), serverIP, "BATCH_FAILURE");
            throw bue;
        }
    }

    /**
     * Lookup flow:
     * IBU:
     *   1) bc_organisation -> reporting_entity_pview_bkp_1610.fi_code -> reporting_entity_pview_bkp_1610.id
     *   2) region_code + reporting_entity_pview_bkp_1610.id -> region_pview_bkp_1610.region_code + region_pview_bkp_1610.reporting_entity_id -> region_pview_bkp_1610.id
     *   3) user_branch_id + region_pview_bkp_1610.id -> branch_pview_bkp_1610.branch_code + branch_pview_bkp_1610.region_id -> branch_pview_bkp_1610.id
     *
     * IRA / IRU:
     *   1) bc_organisation -> reporting_entity_pview_bkp_1610.fi_code -> reporting_entity_pview_bkp_1610.id
     *   2) region_code + reporting_entity_pview_bkp_1610.id -> region_pview_bkp_1610.region_code + region_pview_bkp_1610.reporting_entity_id -> region_pview_bkp_1610.id
     *   3) branch_id is not required and is inserted as NULL
     *
     * Any missing mandatory step is logged and the row is skipped.
     *
     * active flag:
     *   Looked up from re_mgmt.re_user_pview_bkp_1610.status for this user_id.
     *   status == 'TESTBED' -> active = true
     *   any other status, or no re_user match -> active = false
     */
    private RowBuildResult buildRow(List<String> rowTokens,
                                    Map<String, Integer> headerIndex,
                                    Map<String, ReportingEntityRow> reportingEntityLookup,
                                    Map<String, RegionRow> regionLookup,
                                    Map<String, BranchRow> branchLookup,
                                    Set<String> existingTargetUserIds,
                                    Map<String, String> reUserStatusLookup,
                                    Set<String> seenUserIds,
                                    Set<String> duplicateUserIds,
                                    List<String> lookupFailures,
                                    int lineNumber) {

        String userTypeRaw = normalize(getValueFromAliases(rowTokens, headerIndex, "user_mode"));
        String userType = userTypeRaw == null ? null : userTypeRaw.toUpperCase(Locale.ENGLISH);

        if (userType == null || !ELIGIBLE_USER_TYPES.contains(userType)) {
            return RowBuildResult.skipType(
                    "Skipping line=" + lineNumber + " because user_mode=" + userTypeRaw + " is not eligible",
                    "ROW_SKIPPED");
        }

        Map<String, Object> values = new LinkedHashMap<String, Object>();

        UUID generatedId = UUID.randomUUID();
        values.put("id", generatedId);

        String userId = normalize(getValueFromAliases(rowTokens, headerIndex, "user_id"));
        if (userId == null) {
            return RowBuildResult.rowError(
                    "Skipping line=" + lineNumber + " because user_id is missing",
                    "ROW_ERROR");
        }

        if (!seenUserIds.add(userId)) {
            if (duplicateUserIds.add(userId)) {
                log("WARN",
                        "Duplicate user_id found in CSV line=" + lineNumber + " user_id=" + userId,
                        serverIP,
                        "DUPLICATE_USER_ID");
            }
            return RowBuildResult.duplicateInFile(
                    "Skipping line=" + lineNumber + " because user_id=" + userId + " is duplicated in CSV",
                    "DUPLICATE_USER_ID");
        }

        if (existingTargetUserIds != null && existingTargetUserIds.contains(userId)) {
            return RowBuildResult.duplicateInTarget(
                    "Skipping line=" + lineNumber + " because user_id=" + userId + " already exists in target table; this row would replace an existing record if upsert were enabled",
                    "DUPLICATE_REPLACE_CANDIDATE");
        }

        values.put("user_id", userId);

        /*
         * Mandatory parent check:
         * user_branch_region_pview_bkp_1610_bkp_1610.user_id -> re_user.user_id
         *
         * If the user does not exist in re_user, do not add the row
         * to the JDBC batch because it would fail the FK constraint.
         */
        if (reUserStatusLookup == null || !reUserStatusLookup.containsKey(userId)) {
            String msg = "Skipping line=" + lineNumber
                    + " user_id=" + userId
                    + " because user_id not found in re_mgmt.re_user_pview_bkp_1610";

            lookupFailures.add(msg);
            return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
        }

        String fiCode = normalize(getValueFromAliases(rowTokens, headerIndex, "bc_organisation"));

        
        if (fiCode == null) {
            String msg = "Skipping line=" + lineNumber + " user_id=" + userId + " because bc_organisation is missing";
            lookupFailures.add(msg);
            return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
        }

        ReportingEntityRow reportingEntity = reportingEntityLookup == null ? null : reportingEntityLookup.get(normalizeKey(fiCode));
        if (reportingEntity == null || reportingEntity.id == null) {
            String msg = "Skipping line=" + lineNumber + " user_id=" + userId + " because reporting_entity_pview_bkp_1610 not found for bc_organisation=" + fiCode;
            lookupFailures.add(msg);
            return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
        }

        String regionCode = normalize(getValueFromAliases(rowTokens, headerIndex, "region_code"));
        if (regionCode == null) {
            String msg = "Skipping line=" + lineNumber + " user_id=" + userId + " because region_code is missing";
            lookupFailures.add(msg);
            return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
        }

        String regionKey = composeKey(regionCode, reportingEntity.id);
        RegionRow region_pview_bkp_1610 = regionLookup == null ? null : regionLookup.get(regionKey);
        if (region_pview_bkp_1610 == null || region_pview_bkp_1610.id == null) {
            String msg = "Skipping line=" + lineNumber + " user_id=" + userId +
                    " because region_pview_bkp_1610 not found for region_code=" + regionCode +
                    " and reporting_entity_id=" + reportingEntity.id;
            lookupFailures.add(msg);
            return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
        }

        values.put("region_id", region_pview_bkp_1610.id);

        if ("IBU".equals(userType)) {
            String branchCode = normalize(getValueFromAliases(rowTokens, headerIndex, "user_branch_id"));
            if (branchCode == null) {
                String msg = "Skipping line=" + lineNumber + " user_id=" + userId + " because user_branch_id is missing";
                lookupFailures.add(msg);
                return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
            }

            String branchKey = composeKey(branchCode, region_pview_bkp_1610.id);
            BranchRow branch_pview_bkp_1610 = branchLookup == null ? null : branchLookup.get(branchKey);
            if (branch_pview_bkp_1610 == null || branch_pview_bkp_1610.id == null) {
                String msg = "Skipping line=" + lineNumber + " user_id=" + userId +
                        " because branch_pview_bkp_1610 not found for user_branch_id=" + branchCode +
                        " and region_id=" + region_pview_bkp_1610.id;
                lookupFailures.add(msg);
                return RowBuildResult.lookupFailure(msg, "LOOKUP_MISS");
            }

            values.put("branch_id", branch_pview_bkp_1610.id);
        } else {
            values.put("branch_id", null);
        }

        String reUserStatus = reUserStatusLookup == null ? null : reUserStatusLookup.get(userId);
        boolean active = ACTIVE_STATUS_VALUE.equalsIgnoreCase(reUserStatus);

        values.put("active", Boolean.valueOf(active));
        values.put("version", parseLong(getValueFromAliases(rowTokens, headerIndex, "version"), Long.valueOf(0L)));
        values.put("created_at", parseTimestamp(getValueFromAliases(rowTokens, headerIndex, "created_at"), currentTimestamp()));

        String createdBy = normalize(getValueFromAliases(rowTokens, headerIndex, "created_by"));
        values.put("created_by", createdBy == null ? "SYSTEM" : createdBy);

        values.put("updated_at", parseTimestamp(getValueFromAliases(rowTokens, headerIndex, "updated_at"), currentTimestamp()));

        String updatedBy = normalize(getValueFromAliases(rowTokens, headerIndex, "updated_by"));
        values.put("updated_by", updatedBy == null ? "SYSTEM" : updatedBy);

        return RowBuildResult.success(values);
    }

    private void bindRow(PreparedStatement ps, Map<String, Object> rowValues) throws SQLException {
        int i = 1;
        for (String column : INSERT_COLUMNS) {
            Object value = rowValues.get(column);

            if ("id".equals(column) || "branch_id".equals(column) || "region_id".equals(column)) {
                ps.setObject(i, value);
            } else if ("active".equals(column)) {
                if (value == null) {
                    ps.setNull(i, java.sql.Types.BOOLEAN);
                } else {
                    ps.setBoolean(i, ((Boolean) value).booleanValue());
                }
            } else if ("version".equals(column)) {
                if (value == null) {
                    ps.setNull(i, java.sql.Types.BIGINT);
                } else {
                    ps.setLong(i, ((Long) value).longValue());
                }
            } else if ("created_at".equals(column) || "updated_at".equals(column)) {
                if (value == null) {
                    ps.setTimestamp(i, null);
                } else {
                    ps.setTimestamp(i, (Timestamp) value);
                }
            } else {
                ps.setString(i, value == null ? null : String.valueOf(value));
            }
            i++;
        }
    }

    private Map<String, Integer> buildHeaderIndex(List<String> headers) {
        Map<String, Integer> map = new HashMap<String, Integer>();
        if (headers == null) {
            return map;
        }

        for (int i = 0; i < headers.size(); i++) {
            String h = normalizeHeader(headers.get(i));
            if (h != null && h.length() > 0 && !map.containsKey(h)) {
                map.put(h, Integer.valueOf(i));
            }
        }
        return map;
    }

    private String getValueFromAliases(List<String> rowTokens, Map<String, Integer> headerIndex, String targetColumn) {
        List<String> aliases = SOURCE_ALIASES.get(targetColumn);
        if (aliases == null) {
            return null;
        }

        for (String alias : aliases) {
            Integer idx = headerIndex.get(normalizeHeader(alias));
            if (idx != null && idx.intValue() >= 0 && idx.intValue() < rowTokens.size()) {
                return rowTokens.get(idx.intValue());
            }
        }
        return null;
    }

    private List<String> parseCsvLine(String line, char delim) {
        List<String> result = new ArrayList<String>();
        StringBuilder current = new StringBuilder();
        boolean inQuotes = false;

        for (int i = 0; i < line.length(); i++) {
            char c = line.charAt(i);
            if (inQuotes) {
                if (c == '"') {
                    if (i + 1 < line.length() && line.charAt(i + 1) == '"') {
                        current.append('"');
                        i++;
                    } else {
                        inQuotes = false;
                    }
                } else {
                    current.append(c);
                }
            } else {
                if (c == '"') {
                    inQuotes = true;
                } else if (c == delim) {
                    result.add(current.toString());
                    current.setLength(0);
                } else {
                    current.append(c);
                }
            }
        }

        result.add(current.toString());
        return result;
    }

    private UUID parseUuid(Object value) {
        if (value == null) {
            return null;
        }
        if (value instanceof UUID) {
            return (UUID) value;
        }
        try {
            return UUID.fromString(String.valueOf(value).trim());
        } catch (Exception e) {
            return null;
        }
    }

    private Boolean parseBoolean(String value, Boolean defaultValue) {
        String n = normalize(value);
        if (n == null) {
            return defaultValue;
        }

        String v = n.toLowerCase(Locale.ENGLISH);
        if ("true".equals(v) || "t".equals(v) || "1".equals(v) || "yes".equals(v) || "y".equals(v)) {
            return Boolean.TRUE;
        }
        if ("false".equals(v) || "f".equals(v) || "0".equals(v) || "no".equals(v) || "n".equals(v)) {
            return Boolean.FALSE;
        }
        return defaultValue;
    }

    private Long parseLong(String value, Long defaultValue) {
        String n = normalize(value);
        if (n == null) {
            return defaultValue;
        }
        try {
            return Long.valueOf(n);
        } catch (Exception e) {
            return defaultValue;
        }
    }

    private Timestamp parseTimestamp(String value, Timestamp defaultValue) {
        String n = normalize(value);
        if (n == null) {
            return defaultValue;
        }

        List<DateTimeFormatter> f = Arrays.asList(
                DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"),
                DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss"),
                DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss"),
                DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss"),
                DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS"),
                DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss.SSS"),
                DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss.SSS")
        );

        for (int i = 0; i < f.size(); i++) {
            try {
                return Timestamp.valueOf(LocalDateTime.parse(n, f.get(i)));
            } catch (DateTimeParseException ignore) {
                // try next
            }
        }

        try {
            return Timestamp.from(OffsetDateTime.parse(n).toInstant());
        } catch (Exception ignore) {
            // try next
        }

        return defaultValue;
    }

    private Timestamp currentTimestamp() {
        return Timestamp.from(LocalDateTime.now().atZone(ZoneId.systemDefault()).toInstant());
    }

    private String normalize(String value) {
        if (value == null) {
            return null;
        }
        String t = value.trim();
        if (t.length() == 0) {
            return null;
        }
        if ("\\N".equalsIgnoreCase(t)) {
            return null;
        }
        if ("NULL".equalsIgnoreCase(t)) {
            return null;
        }
        return t;
    }

    private String normalizeHeader(String value) {
        String n = normalize(value);
        return n == null ? null : n.toLowerCase(Locale.ENGLISH);
    }

    private String normalizeKey(String value) {
        String n = normalize(value);
        return n == null ? null : n.toUpperCase(Locale.ENGLISH);
    }

    private String composeKey(String left, UUID right) {
        String l = normalizeKey(left);
        if (l == null || right == null) {
            return null;
        }
        return l + "|" + right.toString().toLowerCase(Locale.ENGLISH);
    }

    private File moveAfterSuccess(File sourceFile) {
        if (sourceFile == null || !sourceFile.exists()) {
            return null;
        }

        File parent = sourceFile.getParentFile();
        if (parent == null) {
            return null;
        }

        File processedDir = new File(parent, "processed");
        if (!processedDir.exists()) {
            processedDir.mkdirs();
        }

        File target = new File(processedDir, sourceFile.getName());
        int attempt = 0;

        while (target.exists()) {
            attempt++;
            String name = sourceFile.getName();
            int dot = name.lastIndexOf('.');
            String base = dot > 0 ? name.substring(0, dot) : name;
            String ext = dot > 0 ? name.substring(dot) : "";
            target = new File(processedDir, base + "_" + attempt + ext);
        }

        try {
            Files.move(sourceFile.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
            return target;
        } catch (IOException e) {
            log("ERROR", "File move failed for " + sourceFile.getName() + ": " + rootCause(e), serverIP, "FILE_MOVE_FAILED");
            return null;
        }
    }

