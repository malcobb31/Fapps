     * Used to derive the 'active' flag written to re_mgmt.user_branch_region_v1:
     *   status == 'TESTBED' -> active = true
     *   any other status (or no re_user match at all) -> active = false
     */
    private Map<String, String> loadReUserStatusLookup() throws SQLException {
        Map<String, String> map = new HashMap<String, String>();
        Connection connection = null;
        Statement st = null;
        ResultSet rs = null;

        try {
            connection = openConnection();
            st = connection.createStatement();
            rs = st.executeQuery(RE_USER_STATUS_LOOKUP_SQL);

            while (rs.next()) {
                String userId = normalize(rs.getString("user_id"));
                String status = normalize(rs.getString("status"));
                if (userId == null) {
                    continue;
