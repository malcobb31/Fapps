	public int[] getStartEndIdOfTable(String table, String db_url,
			String db_name, String db_pass) {
		int[] startEndId = null;
		String query = null;
		Connection conn = null;
		Statement stmt = null;
		ResultSet rs = null;
		try {
			query = "select min(sno) min,max(sno) max from " + table;
			conn = new com.fapps.db.MySQLConnection().getConnection(db_url,
					db_name, db_pass);
			stmt = conn.createStatement();
			rs = stmt.executeQuery(query);
			while (rs.next()) {
				startEndId = new int[]{rs.getInt("min"), rs.getInt("max")};
			}
		} catch (Exception ex) {
			startEndId = null;
			ex.printStackTrace();
		} finally {
			try {
				if (conn != null) {
					if (rs != null) {
						rs.close();
					}
					if (stmt != null) {
						stmt.close();
					}
					conn.close();
				}
			} catch (Exception e) {
			}
		}
		return startEndId;
	}
	
	
	
