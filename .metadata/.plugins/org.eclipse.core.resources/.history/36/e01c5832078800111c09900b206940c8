	private String mapUserType(String userMode, String bcOrganisation, String rawStatus) {
		if (isBlank(userMode))
			return null;
		String mode = userMode.trim().toUpperCase();

		if ("IBA".equals(mode))
			return "SKIP";

		if (!"IA".equals(mode)) {
			return mode;
		}

		if (!"1".equals(rawStatus == null ? "" : rawStatus.trim())) {
			return "IA";
		}

		String key = normalizeKey(bcOrganisation);
		Integer count = iaCounterByBcOrganisation.get(key);
		if (count == null) {
			count = Integer.valueOf(0);
		}
		count = Integer.valueOf(count.intValue() + 1);
		iaCounterByBcOrganisation.put(key, count);

		if (count.intValue() == 1) {
			log("INFO", "IA occurrence 1 for bc_organisation " + bcOrganisation + " mapped to IAU_1", null, "IA_MAPPING");
			return "IAU_1";
		}
		if (count.intValue() == 2) {
			log("INFO", "IA occurrence 2 for bc_organisation " + bcOrganisation + " mapped to IAU_2", null, "IA_MAPPING");
			return "IAU_2";
		}

		return "IAU";
	}

