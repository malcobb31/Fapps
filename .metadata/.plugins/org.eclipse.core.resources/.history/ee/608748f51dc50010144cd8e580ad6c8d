	            throw new RuntimeException(
	                "Non-JSON response: " + browserResponse.substring(0, Math.min(200, browserResponse.length()))
	            );
	        }

	        JSONObject browserJson = new JSONObject(browserResponse);
	        int browserHandle = browserJson.getInt("browserHandle");
	        logSuccess("Browser handle obtained: " + browserHandle);

	        conn.disconnect();


	        // -------------------------
	        // Step 2: Create User Folder
	        // -------------------------
	        logDebug("Creating folder on agent 2 with path: " + path);

	        String folderUrl = BASE_URL + "/infrastructure/agents/" + agentId + "/browse/folder/";
	        url = new URL(folderUrl);
	        conn = (HttpsURLConnection) url.openConnection();
	        conn.setRequestMethod("POST");
	        conn.setRequestProperty("Authorization", "Bearer " + token);
	        conn.setRequestProperty("Accept", "application/json");
	        conn.setRequestProperty("Content-Type", "application/json");
	        conn.setDoOutput(true);

	        JSONObject payload = new JSONObject();
	        payload.put("browserHandle", browserHandle);
	        payload.put("path", path);

	        logDebug("User folder creation payload: " + payload.toString(2));

	        try (OutputStream os = conn.getOutputStream()) {
	            os.write(payload.toString().getBytes(StandardCharsets.UTF_8));
	        }

	        String postResponse = readResponse(conn);
	        responseCode = conn.getResponseCode();

	        logDebug("Folder creation response code: " + responseCode);
	        logDebug("Folder creation response: " + postResponse);

	        if (responseCode == 200 || responseCode == 201) {
	            logSuccess("User folder created successfully: " + path);
	        } else if (responseCode == 409) {
	            logWarn("User folder already exists: " + path);
	        } else if (responseCode == 401) {
	            logError("Unauthorized: Token may be invalid");
	            throw new RuntimeException("Authorization failed during user folder creation");
	        } else {
	            logError("User folder creation failed. Code: " + responseCode);
	            throw new RuntimeException("Failed to create user folder: " + postResponse);
	        }

	    } catch (Exception e) {
	        logError("Exception during user folder creation: " + e.getMessage());
	        throw e;

	    } finally {
	        if (conn != null) conn.disconnect();
	    }
	}


