    // Main processing method
    public static void processAllInDirectory(String dirPath, String processedDirPath, String headerFlag,
            String delimiter, String sqldburl, String sdbuser, String sdbpass, String pdbHost, String pdbPort,
            String pdbName, String pdbUser, String pdbPass, String destUrl, String destUser, String destPass,
            String numTablesToPickStr, String configTable, String maxCpuUtil, String maxMemUtil,
            String bulkNumberStr, String dbTypeStr) {
        
        log("INFO", "CSV processing started",pdbHost, "PROCESS_START");
        logResourceUsage("STARTUP",pdbHost);
        
        ProcessConfig config = new ProcessConfig(dirPath, processedDirPath, headerFlag, delimiter, sqldburl,
                sdbuser, sdbpass, pdbHost, pdbPort, pdbName, pdbUser, pdbPass, destUrl, destUser, destPass,
                numTablesToPickStr, configTable, maxCpuUtil, maxMemUtil, bulkNumberStr, dbTypeStr);

        try {
            executeProcessing(config,pdbHost);
            logResourceUsage("COMPLETION",pdbHost);
            log("INFO", "CSV processing completed successfully",pdbHost, "PROCESS_END");
        } catch (Exception e) {
            log("ERROR", "Processing failed: " + e.getMessage(),pdbHost, "PROCESS_ERROR");
            e.printStackTrace();
        }
    }

    private static void executeProcessing(ProcessConfig config,String pdbHost) {
        // Resource validation
        logResourceUsage("PRE_VALIDATION",pdbHost);
        if (!validateSystemResources(config.maxCpuThreshold, config.maxMemoryThreshold,pdbHost)) {
            log("ERROR", "System resources exceed configured thresholds",pdbHost, "RESOURCE_EXCEEDED");
            return;
        }

        // Directory validation
        if (!validateDirectories(config.dirPath, config.processedDirPath,pdbHost)) {
            log("ERROR", "Directory validation failed",pdbHost, "DIR_VALIDATION_FAILED");
            return;
        }

        // Discover CSV files
        List<Path> csvFiles = discoverCsvFiles(config.dirPath,pdbHost);
        if (csvFiles.isEmpty()) {
            log("INFO", "No CSV files found in directory: " + config.dirPath,pdbHost, "NO_FILES_FOUND");
            return;
        }

        // Fetch ready tables
        List<TableEntry> readyTables = fetchReadyTables(config,pdbHost);
        if (readyTables.isEmpty()) {
            log("INFO", "No tables ready for import",pdbHost, "NO_TABLES_READY");
            return;
        }

        // Group files by table
        Map<String, List<Path>> tableFilesMap = groupFilesByTable(csvFiles, readyTables,pdbHost);
        log("INFO", String.format("File grouping completed - Tables_With_Files:%d Total_CSV_Files:%d", 
            tableFilesMap.size(), csvFiles.size()),pdbHost, "FILE_GROUPING");

        // Process tables
        logResourceUsage("PRE_PROCESSING",pdbHost);
        processTablesInParallel(config, readyTables, tableFilesMap,pdbHost);
        logResourceUsage("POST_PROCESSING",pdbHost);
    }

    private static boolean validateSystemResources(double maxCpuThreshold, double maxMemoryThreshold,String pdbHost) {
        try {
            MemoryMXBean memoryBean = ManagementFactory.getMemoryMXBean();
            long usedMemory = memoryBean.getHeapMemoryUsage().getUsed();
            long maxMemory = memoryBean.getHeapMemoryUsage().getMax();
            double memoryUsage = (double) usedMemory / maxMemory * 100;
            double cpuUsage = getCpuUsage();

            log("INFO", String.format("Resource validation - CPU:%.2f%% (Threshold:%.2f%%) Memory:%.2f%% (Threshold:%.2f%%)", 
                cpuUsage, maxCpuThreshold, memoryUsage, maxMemoryThreshold),pdbHost, "RESOURCE_CHECK");

            if (memoryUsage > maxMemoryThreshold) {
                log("WARNING", String.format("Memory usage %.2f%% exceeds threshold %.2f%%", 
                    memoryUsage, maxMemoryThreshold),pdbHost, "MEMORY_THRESHOLD_EXCEEDED");
                return false;
            }

            if (cpuUsage > maxCpuThreshold) {
                log("WARNING", String.format("CPU usage %.2f%% exceeds threshold %.2f%%", 
                    cpuUsage, maxCpuThreshold),pdbHost, "CPU_THRESHOLD_EXCEEDED");
                return false;
            }

            return true;
        } catch (Exception e) {
            log("WARNING", "Could not validate system resources: " + e.getMessage(),pdbHost, "RESOURCE_CHECK_ERROR");
            return true;
        }
    }

    private static boolean validateDirectories(String dirPath, String processedDirPath,String pdbHost) {
        try {
            Path sourceDir = Paths.get(dirPath);
            Path processedDir = Paths.get(processedDirPath);

            if (!Files.exists(sourceDir) || !Files.isDirectory(sourceDir)) {
                log("ERROR", "Source directory does not exist: " + dirPath,pdbHost, "DIR_NOT_FOUND");
                return false;
            }

            Files.createDirectories(processedDir);
            log("INFO", String.format("Directory validation successful - Source:%s Processed:%s", 
                dirPath, processedDirPath),pdbHost, "DIR_VALIDATED");
            return true;
        } catch (Exception e) {
            log("ERROR", "Directory validation failed: " + e.getMessage(),pdbHost, "DIR_VALIDATION_ERROR");
            return false;
        }
    }

    private static List<Path> discoverCsvFiles(String dirPath,String pdbHost) {
        try (Stream<Path> stream = Files.list(Paths.get(dirPath))) {
            List<Path> files = stream
                    .filter(Files::isRegularFile)
                    .filter(p -> {
                        String fileName = p.getFileName().toString().toLowerCase();
                        return (fileName.startsWith("raw_") || fileName.startsWith("process_")) && fileName.endsWith(".csv");
                    })
                    .sorted(Comparator.comparing(p -> p.getFileName().toString()))
                    .collect(Collectors.toList());

            log("INFO", String.format("CSV file discovery completed - Files_Found:%d Directory:%s", 
                files.size(), dirPath),pdbHost, "FILE_DISCOVERY");
            return files;
        } catch (IOException e) {
            log("ERROR", "Failed to discover CSV files: " + e.getMessage(),pdbHost, "FILE_DISCOVERY_ERROR");
            return Collections.emptyList();
        }
    }

    private static List<TableEntry> fetchReadyTables(ProcessConfig config,String pdbHost) {
        List<TableEntry> tables = new ArrayList<>();
        String query = "SELECT sno, table_name FROM " + config.configTable + " WHERE sync_status = 'ready_to_import' LIMIT ?";
        
        try (Connection conn = DriverManager.getConnection(config.sourceDb.url, config.sourceDb.user, config.sourceDb.password);
             PreparedStatement ps = conn.prepareStatement(query)) {
            
            ps.setInt(1, config.numTablesToPick);
            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    TableEntry table = new TableEntry(rs.getString("sno"), rs.getString("table_name"));
                    tables.add(table);
                }
            }
            
            log("INFO", String.format("Ready tables fetched - Count:%d Config_Table:%s", 
                tables.size(), config.configTable),pdbHost, "TABLE_FETCH");
                
        } catch (SQLException e) {
            log("ERROR", "Failed to fetch ready tables: " + e.getMessage(),pdbHost, "TABLE_FETCH_ERROR");
        }
        return tables;
    }

    private static Map<String, List<Path>> groupFilesByTable(List<Path> csvFiles, List<TableEntry> readyTables,String pdbHost) {
        Map<String, List<Path>> tableFilesMap = new HashMap<>();
        Set<String> readySnoSet = readyTables.stream().map(t -> t.sno).collect(Collectors.toSet());

        for (Path file : csvFiles) {
            String fileName = file.getFileName().toString();
            String[] parts = fileName.split("_");
            
            if (parts.length > 4) {
                String sno = parts[4];
                if (readySnoSet.contains(sno)) {
                    tableFilesMap.computeIfAbsent(sno, k -> new ArrayList<>()).add(file);
                }
            }
        }

        log("INFO", String.format("File grouping completed - Tables_With_Files:%d Total_Files:%d", 
            tableFilesMap.size(), csvFiles.size()),pdbHost, "FILE_GROUPING");
        return tableFilesMap;
    }

    private static void processTablesInParallel(ProcessConfig config, List<TableEntry> readyTables, Map<String, List<Path>> tableFilesMap,String pdbHost) {
        log("INFO", String.format("Parallel processing started - Thread_Count:%d Tables_To_Process:%d", 
            config.threadCount, readyTables.size()),pdbHost, "PARALLEL_START");
        
        ExecutorService executor = Executors.newFixedThreadPool(config.threadCount);
        List<Future<TableProcessResult>> futures = new ArrayList<>();

        for (TableEntry table : readyTables) {
            List<Path> files = tableFilesMap.getOrDefault(table.sno, Collections.emptyList());
            futures.add(executor.submit(() -> processTable(config, table, files,pdbHost)));
        }

        // Wait for completion
        List<TableProcessResult> results = new ArrayList<>();
        for (Future<TableProcessResult> future : futures) {
            try {
                TableProcessResult result = future.get();
                results.add(result);
            } catch (Exception e) {
                log("ERROR", "Thread execution failed: " + e.getMessage(),pdbHost, "THREAD_ERROR");
            }
        }

        executor.shutdown();
        try {
            if (!executor.awaitTermination(30, TimeUnit.MINUTES)) {
                log("WARNING", "Thread pool timeout - forcing shutdown",pdbHost, "THREAD_TIMEOUT");
                executor.shutdownNow();
            }
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            executor.shutdownNow();
        }

        // Log summary
        long successful = results.stream().mapToLong(r -> r.success ? 1 : 0).sum();
        int totalFiles = results.stream().mapToInt(r -> r.filesProcessed).sum();
        
        log("INFO", String.format("Parallel processing completed - Successful_Tables:%d/%d Total_Files_Processed:%d", 
            successful, results.size(), totalFiles),pdbHost, "PARALLEL_END");

        // Log failed tables
        results.stream().filter(r -> !r.success)
                .forEach(r -> log("ERROR", String.format("Table processing failed - Table:%s SNO:%s Error:%s", 
                    r.table.tableName, r.table.sno, r.errorMessage),pdbHost, "TABLE_FAILED"));
    }

    private static TableProcessResult processTable(ProcessConfig config, TableEntry table, List<Path> files,String pdbHost) {
        log("INFO", String.format("Table processing started - Table:%s SNO:%s Files_Count:%d", 
            table.tableName, table.sno, files.size()),pdbHost, "TABLE_START");
        
        try {
            updateTableStatus(table.sno, "in_process", config,pdbHost);

            if (files.isEmpty()) {
                updateTableStatus(table.sno, "init", config,pdbHost);
                log("INFO", String.format("Table processing completed - Table:%s Files_Processed:0 Status:No_Files", 
                    table.tableName),pdbHost, "TABLE_END");
                return new TableProcessResult(table, true, 0, null);
            }

            int processedCount = 0;
            for (Path file : files) {
                log("INFO", String.format("File processing started - File:%s Table:%s", 
                    file.getFileName().toString(), table.tableName),pdbHost, "FILE_START");
                
                try {
                    processFile(config, table, file,pdbHost);
                    processedCount++;
                    
                    log("INFO", String.format("File processing completed - File:%s Table:%s", 
                        file.getFileName().toString(), table.tableName),pdbHost, "FILE_END");
                } catch (Exception e) {
                    log("ERROR", String.format("File processing failed - File:%s Table:%s Error:%s", 
                        file.getFileName().toString(), table.tableName, e.getMessage()),pdbHost, "FILE_ERROR");
                    throw e;
                }
            }

            updateTableStatus(table.sno, "init", config,pdbHost);
            log("INFO", String.format("Table processing completed - Table:%s SNO:%s Files_Processed:%d Status:Success", 
                table.tableName, table.sno, processedCount),pdbHost, "TABLE_END");
            
            return new TableProcessResult(table, true, processedCount, null);
            
        } catch (Exception e) {
            log("ERROR", String.format("Table processing failed - Table:%s SNO:%s Error:%s", 
                table.tableName, table.sno, e.getMessage()),pdbHost, "TABLE_ERROR");
            updateTableStatus(table.sno, "error", config,pdbHost);
            return new TableProcessResult(table, false, 0, e.getMessage());
        }
    }

    private static void processFile(ProcessConfig config, TableEntry table, Path file,String pdbHost) throws Exception {
        // Check if table exists
        boolean tableExists = false;
        try (Connection conn = DriverManager.getConnection(config.targetDb.url, config.targetDb.user, config.targetDb.password)) {
            tableExists = tableExists(conn, table.tableName);
            
            if (tableExists) {
                log("INFO", String.format("Table found - Table:%s", table.tableName),pdbHost, "TABLE_FOUND");
            } else {
                log("INFO", String.format("Table not found, will be created - Table:%s", table.tableName),pdbHost, "TABLE_NOT_FOUND");
            }
        }

        // Process based on database type
        if ("psql".equals(config.dbType)) {
            processFilePostgreSQL(config, table, file,pdbHost);
        } else if ("sql".equals(config.dbType) || "mysql".equals(config.dbType)) {
            processFileMySQL(config, table, file,pdbHost);
        } else {
            throw new IllegalArgumentException("Unsupported database type: " + config.dbType);
        }

        // Move file to processed directory
        moveFileToProcessed(file, Paths.get(config.processedDirPath),pdbHost);
    }

    private static void processFilePostgreSQL(ProcessConfig config, TableEntry table, Path file,String pdbHost) throws Exception {
        try (Connection conn = DriverManager.getConnection(config.targetDb.url, config.targetDb.user, config.targetDb.password)) {
            if (!tableExists(conn, table.tableName)) {
                createTableUsingPsql(table.tableName, file.toString(), config.delimiter, config.targetDb,pdbHost);
                log("INFO", String.format("Table created - Table:%s Database:PostgreSQL", table.tableName),pdbHost, "TABLE_CREATED");
            }
        }
        importCSVUsingPsql(file.toString(), config.delimiter, config.hasHeader, table.tableName, config.targetDb,pdbHost);
    }

    private static void processFileMySQL(ProcessConfig config, TableEntry table, Path file,String pdbHost) throws Exception {
        try (Connection conn = DriverManager.getConnection(config.targetDb.url, config.targetDb.user, config.targetDb.password)) {
            conn.setAutoCommit(false);
            
            if (!tableExists(conn, table.tableName)) {
                createTableFromCSV(table.tableName, file.toString(), config.delimiter, conn,pdbHost);
                log("INFO", String.format("Table created - Table:%s Database:MySQL", table.tableName),pdbHost, "TABLE_CREATED");
            }
            
            importCSVUsingJDBCBatch(file.toString(), config.delimiter, config.hasHeader, table.tableName, conn, config.bulkSize,pdbHost);
            conn.commit();
        }
    }

    // Helper methods - optimized
    private static int parseIntOrDefault(String value, int defaultValue) {
        try {
            return (value == null || value.trim().isEmpty()) ? defaultValue : Integer.parseInt(value.trim());
        } catch (NumberFormatException e) {
            return defaultValue;
        }
    }

    private static double parseDoubleOrDefault(String value, double defaultValue) {
        try {
            return (value == null || value.trim().isEmpty()) ? defaultValue : Double.parseDouble(value.trim());
        } catch (NumberFormatException e) {
            return defaultValue;
        }
    }

    private static void updateTableStatus(String sno, String status, ProcessConfig config,String pdbHost) {
        String query = "UPDATE " + config.configTable + " SET sync_status = ? WHERE sno = ?";
        try (Connection conn = DriverManager.getConnection(config.sourceDb.url, config.sourceDb.user, config.sourceDb.password);
             PreparedStatement ps = conn.prepareStatement(query)) {
            
            ps.setString(1, status);
            ps.setString(2, sno);
            ps.executeUpdate();
            
        } catch (SQLException e) {
            log("ERROR", "Failed to update table status for SNO " + sno + ": " + e.getMessage(),pdbHost, "STATUS_UPDATE_ERROR");
        }
    }

