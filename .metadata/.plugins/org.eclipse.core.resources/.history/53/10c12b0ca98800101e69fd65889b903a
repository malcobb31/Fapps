    private static void createTableFromCSV(String tableName, String csvFile, String delimiter, Connection conn,String pdbHost) throws Exception {
        // Implementation needed
        log("INFO", String.format("Creating MySQL table from CSV - Table:%s", tableName),pdbHost, "TABLE_CREATE_MYSQL");
		

		String headerLine = readFirstLine(csvFile);
		if (headerLine == null || headerLine.trim().isEmpty()) {
			throw new IOException("Cannot read header from CSV file: " + csvFile);
		}

		String[] columns = headerLine.split(Pattern.quote(delimiter), -1);
		

		StringBuilder ddl = new StringBuilder();
		ddl.append("CREATE TABLE IF NOT EXISTS `").append(tableName).append("` (");

		for (int i = 0; i < columns.length; i++) {
			String columnName = sanitizeColumnName(columns[i], i);
			ddl.append("`").append(columnName).append("` TEXT");
			if (i < columns.length - 1) {
				ddl.append(", ");
			}
		}
		ddl.append(") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;");

		
		try (Statement stmt = conn.createStatement()) {
			stmt.execute(ddl.toString());
		}
    }

