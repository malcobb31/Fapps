        log("INFO", String.format("Importing CSV via JDBC batch - Table:%s Bulk_Size:%d", tableName, batchSize),pdbHost, "CSV_IMPORT_JDBC");
        List<String> columns = getTableColumns(conn, tableName);
		if (columns.isEmpty()) {
			throw new SQLException("Could not determine table structure for: " + tableName);
		}

		

		String insertSQL = buildInsertSQL(tableName, columns);
//		logDebug("Insert SQL: " + insertSQL);

		try (PreparedStatement ps = conn.prepareStatement(insertSQL);
				BufferedReader reader = Files.newBufferedReader(Paths.get(csvFile))) {

			String line;
			int lineCount = 0;
			int batchCount = 0;

			// Skip header if present
			if (hasHeader) {
				String headerLine = reader.readLine();
//				logDebug("Skipped header line: " + (headerLine != null
//						? headerLine.substring(0, Math.min(50, headerLine.length())) + "..." : "null"));
			}

			while ((line = reader.readLine()) != null) {
				String[] values = line.split(Pattern.quote(delimiter), -1);

				for (int i = 0; i < Math.min(values.length, columns.size()); i++) {
					ps.setString(i + 1, values[i]);
				}

				ps.addBatch();
				lineCount++;

				if (lineCount % batchSize == 0) {
					int[] results = ps.executeBatch();
					batchCount++;
//					logDebug("Executed batch " + batchCount + " with " + results.length + " statements");
				}
			}

			// Execute remaining batch
			if (lineCount % batchSize != 0) {
				int[] results = ps.executeBatch();
//				logDebug("Executed final batch with " + results.length + " statements");
			}

			
		}

    }
	private static List<String> getTableColumns(Connection conn, String tableName) throws SQLException {
	
		List<String> columns = new ArrayList<>();
		DatabaseMetaData meta = conn.getMetaData();

		try (ResultSet rs = meta.getColumns(null, null, tableName, null)) {
			while (rs.next()) {
				String columnName = rs.getString("COLUMN_NAME");
				columns.add(columnName);
			
			}
		}

		return columns;
	}

