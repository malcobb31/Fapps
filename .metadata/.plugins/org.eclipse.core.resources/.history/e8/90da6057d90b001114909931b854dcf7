			// FIX: Header parsing must follow strict format: "val"|"val"
			List<String> headerFields = parseStrictPipeQuotedRow(headerLine);
			if (headerFields == null || headerFields.isEmpty()) {
				throw new Exception("CSV header could not be parsed: " + csvFilePath);
			}

			String[] csvHeaders = headerFields.toArray(new String[0]);

			// Fetch DB column names + types
			Map<String, Integer> dbColumnTypes = new HashMap<>();
			List<String> dbColumns = new ArrayList<>();

			try (Statement stmt = conn.createStatement();
					ResultSet rs = stmt.executeQuery("SELECT * FROM " + tableName + " LIMIT 1")) {

				ResultSetMetaData meta = rs.getMetaData();
				for (int i = 1; i <= meta.getColumnCount(); i++) {
					String col = meta.getColumnName(i);
					int type = meta.getColumnType(i);

					dbColumns.add(col);
					dbColumnTypes.put(col.toLowerCase(), type);
				}
			}

			// Fetch NOT NULL info dynamically from INFORMATION_SCHEMA
			Map<String, Boolean> dbNotNullMap = new HashMap<>();

			String schemaName = null;
			String pureTableName = tableName;

			if (tableName != null && tableName.contains(".")) {
				String[] parts = tableName.split("\\.", 2);
				schemaName = parts[0].trim();
				pureTableName = parts[1].trim();
			}

			String notNullQuery = "SELECT COLUMN_NAME, IS_NULLABLE " + "FROM INFORMATION_SCHEMA.COLUMNS "
					+ "WHERE TABLE_SCHEMA = " + (schemaName != null ? "?" : "DATABASE()") + " " + "AND TABLE_NAME = ?";

			try (PreparedStatement ps = conn.prepareStatement(notNullQuery)) {
				int idx = 1;

				if (schemaName != null) {
					ps.setString(idx++, schemaName);
				}

				ps.setString(idx, pureTableName);

				try (ResultSet rs = ps.executeQuery()) {
					while (rs.next()) {
						String col = rs.getString("COLUMN_NAME");
						String isNullable = rs.getString("IS_NULLABLE");
						boolean notNull = "NO".equalsIgnoreCase(isNullable);
						dbNotNullMap.put(col.toLowerCase(), notNull);
					}
				}
			} catch (Exception e) {
				// If metadata fails, we still continue safely
				log("WARNING", "Failed to fetch NOT NULL metadata for table=" + tableName + " err=" + e.getMessage(),
						serverIP, "META_WARN");
			}

			// Call loader
			insertPartialCSV(csvFilePath, tableName, conn, serverIP, csvHeaders, dbColumns, dbColumnTypes, dbNotNullMap,
					hasHeader, delimiter);

		} finally {
			if (reader != null) {
				try {
					reader.close();
				} catch (Exception ignore) {
				}
			}
		}
	}

	public void insertPartialCSV(String csvFilePath, String tableName, Connection conn, String serverIP,
			String[] csvHeaders, List<String> dbColumns, Map<String, Integer> dbColumnTypes,
			Map<String, Boolean> dbNotNullMap, boolean hasHeader, String delimiter) throws Exception {

		File csvFile = new File(csvFilePath);
		if (!csvFile.exists() || !csvFile.canRead()) {
			throw new FileNotFoundException("CSV file not found or not readable: " + csvFile.getAbsolutePath());
		}

		// clean CSV headers
		List<String> csvCols = Arrays.stream(csvHeaders).map(h -> h == null ? "" : h.replace("\"", "").trim())
				.filter(h -> !h.isEmpty()).collect(Collectors.toList());

		if (csvCols.isEmpty()) {
			throw new Exception("CSV header is empty/invalid: " + csvFile.getName());
		}

		// match columns (CSV vs DB)
		List<String> matchedCols = new ArrayList<>();
		for (String csvCol : csvCols) {
			for (String dbCol : dbColumns) {
				if (dbCol != null && dbCol.equalsIgnoreCase(csvCol)) {
					matchedCols.add(dbCol);
					break;
				}
			}
		}

		if (matchedCols.isEmpty()) {
			throw new Exception("No matching columns found between CSV and table: " + tableName);
		}

		// Build insert SQL
		String colSql = matchedCols.stream().map(c -> "`" + c.replace("`", "") + "`").collect(Collectors.joining(","));

		String qSql = matchedCols.stream().map(x -> "?").collect(Collectors.joining(","));

		String insertSql = "INSERT INTO " + tableName + " (" + colSql + ") VALUES (" + qSql + ")";
		log("INFO", "INSERT SQL: " + insertSql, serverIP, "MYSQL_INSERT_SQL");

		long inserted = 0;
		int batchCount = 0;

		try (BufferedReader br = Files.newBufferedReader(Paths.get(csvFilePath), StandardCharsets.UTF_8);

				// BufferedReader br = new BufferedReader(new
				// FileReader(csvFilePath));
				PreparedStatement ps = conn.prepareStatement(insertSql)) {

			String firstLine = br.readLine();
			if (firstLine == null) {
				throw new Exception("Empty file: " + csvFilePath);
			}

			long lineNo = 1;

			// If file has NO header, first line is data
			if (!hasHeader) {
				List<String> rowFields = parseStrictPipeQuotedRow(firstLine);
				rowFields = normalizeRowSize(rowFields, csvCols.size());
				// bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes,
				// dbNotNullMap, tableName);

				bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes, dbNotNullMap);
				ps.addBatch();
				batchCount++;
				inserted++;
			}

			String line;
			while ((line = br.readLine()) != null) {
				lineNo++;

				if (line.trim().isEmpty())
					continue;

				List<String> rowFields = parseStrictPipeQuotedRow(line);
				rowFields = normalizeRowSize(rowFields, csvCols.size());

				try {
					bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes, dbNotNullMap);
					// bindRow(ps, rowFields, csvCols, matchedCols,
					// dbColumnTypes, dbNotNullMap, tableName);

					ps.addBatch();
					batchCount++;
					inserted++;

					if (batchCount >= 10000) {
						ps.executeBatch();
						batchCount = 0;
					}

				} catch (Exception rowEx) {
					log("ERROR",
							"Row insert failed at lineNo=" + lineNo + " file=" + csvFile.getName() + " table="
									+ tableName + " err=" + rowEx.getMessage() + " rawLine=" + line,
							serverIP, "ROW_INSERT_FAIL");
					throw rowEx;
				}
			}

			if (batchCount > 0) {
				ps.executeBatch();
			}
		}

		log("INFO", "CSV inserted successfully - tableName:" + tableName + " File:" + csvFile.getName() + " Inserted:"
				+ inserted, serverIP, "CSV_LOAD");
	}

	private List<String> parseStrictPipeQuotedRow(String line) throws Exception {
		List<String> fields = new ArrayList<>();
		if (line == null)
			return fields;

		// remove BOM + trim only left side (safe)
		line = line.replace("\uFEFF", "");

		int i = 0;
		int n = line.length();

		while (i < n) {

			// skip spaces/tabs before a field
			while (i < n && (line.charAt(i) == ' ' || line.charAt(i) == '\t'))
				i++;

			if (i >= n)
				break;

			// Must start with "
			if (line.charAt(i) != '"') {
				throw new Exception("Invalid row format: expected '\"' at pos=" + i + " but found=" + line.charAt(i));
			}
			i++; // skip opening quote

			StringBuilder value = new StringBuilder();

			while (i < n) {
				char c = line.charAt(i);

				if (c == '"') {
					// if next is | or end => close field
					if (i + 1 >= n || line.charAt(i + 1) == '|') {
						i++; // consume closing quote
						break;
					}

					// otherwise this quote is part of data (this handles
					// ""value"" case)
					value.append('"');
					i++;
					continue;
				}

				value.append(c);
				i++;
			}

			fields.add(value.toString());

			// after closing quote -> consume delimiter if present
			if (i < n && line.charAt(i) == '|') {
				i++;
			}
		}

		return fields;
	}

	private List<String> normalizeRowSize(List<String> rowFields, int expectedSize) {
		if (rowFields == null)
			rowFields = new ArrayList<>();

		if (rowFields.size() < expectedSize) {
			while (rowFields.size() < expectedSize)
				rowFields.add("");
		} else if (rowFields.size() > expectedSize) {
			rowFields = rowFields.subList(0, expectedSize);
		}
		return rowFields;
	}

