	private void processFileMySQL(ProcessConfig config, TableEntry table, Path file, String serverIP, int bulkSize,
	        Connection conn) throws Exception {

	    boolean fkDisabled = false;
	    String tempTable = table.tableName + "_temp_" + System.currentTimeMillis();

	    try {

	        log("INFO", "MySQL reconciliation started. Temp=" + tempTable, serverIP, "MYSQL_RECON_START");

	        boolean originalExists = tableExists(conn, table.tableName);

	        //  BASELINE MODE (Original missing)
	        if (!originalExists) {

	            log("WARNING",
	                    "Original table missing — creating baseline temp snapshot only: " + table.tableName,
	                    serverIP,
	                    "BASELINE_MODE");

	            createTempMySQLTableFromCSV(
	                    conn,
	                    file.toString(),
	                    config.delimiter,
	                    config.hasHeader,
	                    table.tableName + "_baseline_" + System.currentTimeMillis(),
	                    serverIP,
	                    bulkSize);

	            conn.commit();
	            return;
	        }

	        //  NORMAL RECON FLOW

	        disableFKChecks(conn, serverIP, table.tableName);
	        fkDisabled = true;

	        long mainRows = getFastTableRowCount(conn, table.tableName);

	        createTempMySQLTableForRecon(conn, table.tableName, tempTable, serverIP);

	        importCSVToMySQL(file.toString(), config.delimiter, config.hasHeader, tempTable, conn, serverIP, bulkSize);

	        long tempRows = getFastTableRowCount(conn, tempTable);

	        log("INFO", "CSV loaded into temp. Rows=" + tempRows, serverIP, "TEMP_LOAD");

	        List<String> pkCols = getMySQLPrimaryKeys(conn, table.tableName);

	        createTempPKIndex(conn, tempTable, pkCols, serverIP);

	        generateChecksumForTemp(conn, tempTable, table.tableName, serverIP);

	        runReconciliation(conn, table.tableName, tempTable, pkCols, mainRows, tempRows, serverIP);

	        conn.commit();

	    } catch (Exception e) {

	        if (conn != null)
	            conn.rollback();

	        log("ERROR", "Reconciliation failed: " + e.getMessage(), serverIP, "MYSQL_RECON_FAIL");

	        throw e;

	    } finally {

	        if (fkDisabled) {
	            enableFKChecks(conn, serverIP, table.tableName);
	        }
	    }
	}

	private void createTempMySQLTableFromCSV(
	        Connection conn,
	        String csvFile,
	        String delimiter,
	        boolean hasHeader,
	        String tempTable,
	        String serverIP,
	        int bulkSize) throws Exception {

	    log("INFO",
	            "Creating baseline temp table directly from CSV: " + tempTable,
	            serverIP,
	            "BASELINE_TEMP_CREATE");

	    List<String> columnDefinitions = analyzeCSVStructure(csvFile, delimiter, serverIP);

	    if (columnDefinitions.isEmpty()) {
	        throw new SQLException("Cannot create temp table — CSV structure unknown");
	    }

	    String createSQL = "CREATE TABLE " + tempTable +
	            " (" + String.join(", ", columnDefinitions) + ")";

	    try (Statement st = conn.createStatement()) {
	        st.execute(createSQL);
	    }

	    importCSVToMySQL(
	            csvFile,
	            delimiter,
	            hasHeader,
	            tempTable,
	            conn,
	            serverIP,
	            bulkSize);

	    long rows = getFastTableRowCount(conn, tempTable);

	    log("INFO",
	            "Baseline snapshot created successfully. Rows=" + rows,
	            serverIP,
	            "BASELINE_READY");
	}


	private void createTempMySQLTableForRecon(Connection conn, String mainTable, String tempTable, String serverIP)
			throws SQLException {

		try (Statement st = conn.createStatement()) {

			// safest structure clone
			st.execute("CREATE TABLE " + tempTable + " AS SELECT * FROM " + mainTable + " WHERE 1=0");

			st.execute("ALTER TABLE " + tempTable + " ADD COLUMN checksum_value VARCHAR(32),"
					+ " ADD COLUMN checksum_status VARCHAR(20)");

			st.execute("CREATE INDEX idx_checksum ON " + tempTable + "(checksum_value)");
		}

		log("INFO", "Recon temp table created: " + tempTable, serverIP, "TEMP_CREATED");
	}
	
	private long getFastTableRowCount(Connection conn, String tableName) {

	    String sql =
	            "SELECT TABLE_ROWS " +
	            "FROM INFORMATION_SCHEMA.TABLES " +
	            "WHERE TABLE_SCHEMA = DATABASE() " +
	            "AND TABLE_NAME = ?";

	    try (PreparedStatement ps = conn.prepareStatement(sql)) {

	        ps.setString(1, tableName);

	        ResultSet rs = ps.executeQuery();

	        if (rs.next()) {

	            long rows = rs.getLong(1);

	            if (rows >= 0)
	                return rows;
	        }

	    } catch (Exception ignored) {}

	    // fallback if metadata inaccurate
	    return 0;
	}


	private String getChecksumExpression(Connection conn, String tableName, String alias) throws SQLException {

		String cacheKey = tableName + "|" + (alias == null ? "" : alias);

		if (checksumExpressionCache.containsKey(cacheKey)) {
			return checksumExpressionCache.get(cacheKey);
		}

		List<String> cols = new ArrayList<>();

		String schema = null;
		String pureTable = tableName;

		if (tableName.contains(".")) {
			String[] parts = tableName.split("\\.", 2);
			schema = parts[0];
			pureTable = parts[1];
		}

		String sql = "SELECT COLUMN_NAME " + "FROM INFORMATION_SCHEMA.COLUMNS " + "WHERE TABLE_NAME = ? "
				+ (schema != null ? "AND TABLE_SCHEMA = ? " : "AND TABLE_SCHEMA = DATABASE() ")
				+ "ORDER BY ORDINAL_POSITION";

		try (PreparedStatement ps = conn.prepareStatement(sql)) {

			ps.setString(1, pureTable);

			if (schema != null) {
				ps.setString(2, schema);
			}

			ResultSet rs = ps.executeQuery();

			String prefix = (alias == null || alias.isEmpty()) ? "" : alias + ".";

			while (rs.next()) {

				String col = rs.getString(1);

				if (!col.equalsIgnoreCase("checksum_value") && !col.equalsIgnoreCase("checksum_status")) {

					cols.add("IFNULL(" + prefix + "`" + col + "`,'')");
				}
			}
		}

		if (cols.isEmpty()) {
			throw new SQLException("No columns found for checksum on table " + tableName);
		}

		String expr = "MD5(CONCAT_WS('|'," + String.join(",", cols) + "))";

		checksumExpressionCache.put(cacheKey, expr);

		return expr;
	}

