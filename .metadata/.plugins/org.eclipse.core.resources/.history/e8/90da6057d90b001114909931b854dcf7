	// CSV structure analysis with proper resource management
	private List<String> analyzeCSVStructure(String csvFilePath, String delimiter, String serverIP) {
		List<String> columnDefinitions = new ArrayList<>();
		BufferedReader reader = null;

		try {
			reader = Files.newBufferedReader(Paths.get(csvFilePath));
			String headerLine = reader.readLine();

			if (headerLine != null) {
				String[] headers = headerLine.split(Pattern.quote(delimiter), -1);

				for (int i = 0; i < headers.length; i++) {
					String columnName = sanitizeColumnName(headers[i].trim());
					if (columnName.isEmpty()) {
						columnName = "column_" + (i + 1);
					}
					columnDefinitions.add(columnName + " TEXT");
				}
			}

			log("INFO",
					String.format("CSV structure analyzed - File:%s Columns:%d", csvFilePath, columnDefinitions.size()),
					serverIP, "CSV_ANALYZED");

		} catch (IOException e) {
			log("ERROR",
					String.format("Failed to analyze CSV structure - File:%s Error:%s", csvFilePath, e.getMessage()),
					serverIP, "CSV_ANALYSIS_ERROR");
		} finally {
			closeQuietly(reader);
		}

		return columnDefinitions;
	}

	// Column name sanitization
	private String sanitizeColumnName(String columnName) {
		if (columnName == null || columnName.trim().isEmpty()) {
			return "";
		}

		// Remove quotes and special characters, replace spaces with underscores
		return columnName.replaceAll("[\"'`]", "").replaceAll("[^a-zA-Z0-9_]", "_").replaceAll("_{2,}", "_")
				.replaceAll("^_|_$", "").toLowerCase();
	}

	private void importCSVUsingPsql(String csvFilePath, String tableName, String serverIP, int bulkSize,
			Connection conn) throws Exception {

		;

		int totalRows = 0;
		int chunkCount = 0;

		char delim = '|'; // PIPE delimiter

		try {

			String schema = "public";
			String pureTable = tableName;

			if (tableName.contains(".")) {
				String[] parts = tableName.split("\\.", 2);
				schema = parts[0];
				pureTable = parts[1];
			}

			String cacheKey = schema + "." + pureTable.toLowerCase();

			TableMeta pgMeta = pgMetaCache.computeIfAbsent(cacheKey, t -> {
				try {
					return fetchPostgresTableMeta(conn, tableName, serverIP);
				} catch (Exception e) {
					throw new RuntimeException(e);
				}
			});

			if (pgMeta == null || pgMeta.columns.isEmpty()) {
				throw new Exception("PostgreSQL table metadata not found for table=" + tableName);
			}

			try (BufferedReader br = new BufferedReader(new FileReader(csvFilePath))) {

				// -------- HEADER ----------
				String headerLine = br.readLine();
				if (headerLine == null) {
					throw new Exception("CSV file is empty: " + csvFilePath);
				}

				// Strict pipe-quoted parsing: "col"|"col"
				List<String> headerCols = parseStrictPipeQuotedRow(headerLine);
				if (headerCols == null || headerCols.isEmpty()) {
					throw new Exception("Header could not be parsed: " + csvFilePath);
				}

				// Normalize header names (safe)
				List<String> csvColumns = headerCols.stream()
						.map(s -> s == null ? "" : s.replace("\"", "").trim().toLowerCase()).filter(s -> !s.isEmpty())
						.collect(Collectors.toList());

				if (csvColumns.isEmpty()) {
					throw new Exception("CSV header is empty/invalid after cleaning: " + csvFilePath);
				}

				// ---------------------------------------------------
				// PARTIAL + REORDER SUPPORT:
				// matchedCols = intersection(CSV cols, DB cols)
				// Keep order of CSV header (because CSV row values follow that
				// order)
				// ---------------------------------------------------
				List<String> matchedCols = new ArrayList<>();
				for (String csvCol : csvColumns) {
					for (String dbCol : pgMeta.columns) {
						if (dbCol != null && dbCol.equalsIgnoreCase(csvCol)) {
							matchedCols.add(dbCol.toLowerCase());
							break;
						}
					}
				}

				if (matchedCols.isEmpty()) {
					throw new Exception("No matching columns found between CSV and PostgreSQL table=" + tableName
							+ " file=" + csvFilePath + " CSV_Cols=" + csvColumns + " DB_Cols=" + pgMeta.columns);
				}

				log("INFO",
						"PostgreSQL PARTIAL column validation passed - table=" + tableName + " CSV_Cols="
								+ csvColumns.size() + " DB_Cols=" + pgMeta.columns.size() + " Matched_Cols="
								+ matchedCols.size(),
						serverIP, "PSQL_COL_VALIDATION");

				// ---------------------------------------------------
				// COPY SQL (matched columns only, in CSV header order)
				// ---------------------------------------------------
				String copySQL = "COPY " + tableName + " (" + String.join(",", matchedCols)
						+ ") FROM STDIN WITH (FORMAT csv, HEADER false, DELIMITER '|', "
						+ "QUOTE '\"', ESCAPE '\"', NULL 'NULL')";

				try (BufferedReader reader = Files.newBufferedReader(Paths.get(csvFilePath))) {

					// skip header
					reader.readLine();

					CopyManager copyManager = new CopyManager((BaseConnection) conn);

					long rows = copyManager.copyIn(copySQL, reader);
					totalRows += rows;

					log("INFO", "Direct COPY completed rows=" + rows, serverIP, "PSQL_DIRECT_COPY");

					conn.commit();
				}
			}

		} catch (Exception e) {
			try {
				if (conn != null)
					conn.rollback();
			} catch (Exception ignore) {
			}

			log("ERROR", "COPY failed: " + e.getMessage(), serverIP, "PSQL_IMPORT_ERROR");
			throw e;

		}
	}

	private static class TableMeta {
		List<String> columns = new ArrayList<>(); // in ordinal order
		Map<String, Boolean> notNullMap = new HashMap<>(); // col -> true/false
		Map<String, String> pgTypeMap = new HashMap<>(); // col -> pg data_type
	}

	private TableMeta fetchPostgresTableMeta(Connection conn, String tableName, String serverIP) throws Exception {

		TableMeta meta = new TableMeta();

		String schema = "public";
		String pureTable = tableName;

		if (tableName != null && tableName.contains(".")) {
			String[] parts = tableName.split("\\.", 2);
			schema = parts[0].trim();
			pureTable = parts[1].trim();
		}

		String sql = "SELECT column_name, is_nullable, data_type " + "FROM information_schema.columns "
				+ "WHERE table_schema = ? AND table_name = ? " + "ORDER BY ordinal_position";

		try (PreparedStatement ps = conn.prepareStatement(sql)) {
			ps.setString(1, schema);
			ps.setString(2, pureTable);

			try (ResultSet rs = ps.executeQuery()) {
				while (rs.next()) {
					String col = rs.getString("column_name");
					String isNullable = rs.getString("is_nullable");
					String dataType = rs.getString("data_type");

					meta.columns.add(col.toLowerCase());

					boolean notNull = "NO".equalsIgnoreCase(isNullable);
					meta.notNullMap.put(col.toLowerCase(), notNull);

					meta.pgTypeMap.put(col.toLowerCase(), dataType == null ? "text" : dataType.toLowerCase());
				}
			}
		}

		log("INFO", "PostgreSQL metadata loaded - table=" + tableName + " cols=" + meta.columns.size(), serverIP,
				"PSQL_META");

		return meta;
	}

