	private List<String> getMySQLPrimaryKeys(Connection conn, String tableName) throws SQLException {

	    List<String> keys = new ArrayList<>();

	    String schema = null;
	    String pureTable = tableName;

	    //  SPLIT schema.table
	    if (tableName.contains(".")) {
	        String[] parts = tableName.split("\\.", 2);
	        schema = parts[0];
	        pureTable = parts[1];
	    }

	    String sql =
	            "SELECT COLUMN_NAME " +
	            "FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE " +
	            "WHERE TABLE_SCHEMA = ? " +
	            "AND TABLE_NAME = ? " +
	            "AND CONSTRAINT_NAME = 'PRIMARY'";

	    try (PreparedStatement ps = conn.prepareStatement(sql)) {

	        ps.setString(1, schema != null ? schema : conn.getCatalog());
	        ps.setString(2, pureTable);

	        ResultSet rs = ps.executeQuery();

	        while (rs.next()) {
	            keys.add(rs.getString(1));
	        }
	    }

	    if (keys.isEmpty()) {
	        throw new SQLException("No primary key found for table " + tableName);
	    }

	    return keys;
	}

	private void runReconciliation(Connection conn, String mainTable, String tempTable, List<String> pkCols,
			long mainRows, long tempRows, String serverIP) throws SQLException {

		log("INFO", "Reconciliation started Main=" + mainTable, serverIP, "RECON_START");

		String join = pkCols.stream().map(pk -> "t.`" + pk + "` = m.`" + pk + "`").collect(Collectors.joining(" AND "));

		String mainChecksum = getChecksumExpression(conn, mainTable, "m");

		String sql = "SELECT " + "SUM(CASE WHEN m." + pkCols.get(0) + " IS NULL THEN 1 ELSE 0 END) AS new_rows, "
				+ "SUM(CASE WHEN t.checksum_value <> " + mainChecksum + " AND m." + pkCols.get(0)
				+ " IS NOT NULL THEN 1 ELSE 0 END) AS changed_rows, " + "SUM(CASE WHEN t.checksum_value = "
				+ mainChecksum + " AND m." + pkCols.get(0) + " IS NOT NULL THEN 1 ELSE 0 END) AS unchanged_rows "
				+ "FROM " + tempTable + " t " + "LEFT JOIN " + mainTable + " m ON " + join;

		long newRows = 0;
		long changedRows = 0;
		long unchangedRows = 0;

		try (Statement st = conn.createStatement(); ResultSet rs = st.executeQuery(sql)) {

			if (rs.next()) {
				newRows = rs.getLong("new_rows");
				changedRows = rs.getLong("changed_rows");
				unchangedRows = rs.getLong("unchanged_rows");
			}
		}

		long missingRows = mainRows - unchangedRows - changedRows;

		log("INFO",
				"RECON RESULT -> " + "MainRows:" + mainRows + " TempRows:" + tempRows + " New:" + newRows + " Missing:"
						+ missingRows + " Changed:" + changedRows + " Unchanged:" + unchangedRows,
				serverIP, "RECON_SUMMARY");
	}

	private void createTempPKIndex(Connection conn, String tempTable, List<String> pkCols, String serverIP)
			throws SQLException {

		String idxCols = pkCols.stream().map(c -> "`" + c + "`").collect(Collectors.joining(","));

		try (Statement st = conn.createStatement()) {

			st.execute("CREATE INDEX idx_temp_pk ON " + tempTable + "(" + idxCols + ")");

			st.execute("ANALYZE TABLE " + tempTable);
		}

		log("INFO", "Temp PK index created", serverIP, "TEMP_INDEX");
	}

	private void generateChecksumForTemp(Connection conn, String tempTable, String mainTable, String serverIP)
			throws SQLException {

		log("INFO", "Checksum generation started for temp=" + tempTable, serverIP, "CHECKSUM_START");

		String checksumExpr = getChecksumExpression(conn, tempTable, null);

		String sql = "UPDATE " + tempTable + " SET checksum_value = " + checksumExpr;

		try (Statement st = conn.createStatement()) {

			int updated = st.executeUpdate(sql);

			log("INFO", "Checksum generated successfully. Rows=" + updated, serverIP, "CHECKSUM_COMPLETE");
		}
	}

