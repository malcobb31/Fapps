    // Index creation methods with proper resource management
    private void createIndexesFromSource(String tableName, DatabaseConfig sourceDb, DatabaseConfig targetDb, String pdbHost) {
        Connection sourceConn = null;
        Connection targetConn = null;
        PreparedStatement sourcePs = null;
        ResultSet rs = null;
        
        try {
            sourceConn = DriverManager.getConnection(sourceDb.url, sourceDb.user, sourceDb.password);
            targetConn = DriverManager.getConnection(targetDb.url, targetDb.user, targetDb.password);
            
            // Query to get indexes from MySQL source
            String indexQuery = "SELECT DISTINCT INDEX_NAME, COLUMN_NAME, NON_UNIQUE " +
                               "FROM information_schema.STATISTICS " +
                               "WHERE TABLE_NAME = ? AND INDEX_NAME != 'PRIMARY' " +
                               "ORDER BY INDEX_NAME, SEQ_IN_INDEX";
            
            sourcePs = sourceConn.prepareStatement(indexQuery);
            sourcePs.setString(1, tableName);
            rs = sourcePs.executeQuery();
            
            Map<String, List<String>> indexes = new HashMap<>();
            Map<String, Boolean> indexTypes = new HashMap<>();
            
            while (rs.next()) {
                String indexName = rs.getString("INDEX_NAME");
                String columnName = rs.getString("COLUMN_NAME");
                boolean isUnique = rs.getInt("NON_UNIQUE") == 0;
                
                indexes.computeIfAbsent(indexName, k -> new ArrayList<>()).add(columnName);
                indexTypes.put(indexName, isUnique);
            }
            
            // Create indexes in PostgreSQL
            for (Map.Entry<String, List<String>> entry : indexes.entrySet()) {
                createIndex(targetConn, tableName, entry.getKey(), entry.getValue(), 
                           indexTypes.get(entry.getKey()), pdbHost);
            }
            
            log("INFO", String.format("Indexes created - Table:%s Index_Count:%d", 
                                    tableName, indexes.size()), pdbHost, "INDEXES_CREATED");
            
        } catch (SQLException e) {
            log("ERROR", String.format("Failed to create indexes - Table:%s Error:%s", 
                                     tableName, e.getMessage()), pdbHost, "INDEX_CREATION_ERROR");
        } finally {
            closeQuietly(rs);
            closeQuietly(sourcePs);
            closeQuietly(targetConn);
            closeQuietly(sourceConn);
        }
    }
    
    // Create individual index
    private void createIndex(Connection conn, String tableName, String indexName, List<String> columns, 
                           boolean isUnique, String pdbHost) {
        Statement stmt = null;
        
        try {
            StringBuilder indexSQL = new StringBuilder();
            indexSQL.append("CREATE ");
            if (isUnique) {
                indexSQL.append("UNIQUE ");
            }
            indexSQL.append("INDEX IF NOT EXISTS ").append(indexName)
                    .append(" ON ").append(tableName)
                    .append(" (").append(String.join(", ", columns)).append(")");
            
            stmt = conn.createStatement();
            stmt.executeUpdate(indexSQL.toString());
            
            log("INFO", String.format("Index created - Table:%s Index:%s Columns:%s Unique:%s", 
                                    tableName, indexName, String.join(",", columns), isUnique), 
                pdbHost, "INDEX_CREATED");
            
        } catch (SQLException e) {
            log("ERROR", String.format("Failed to create index - Table:%s Index:%s Error:%s", 
                                     tableName, indexName, e.getMessage()), pdbHost, "INDEX_ERROR");
        } finally {
            closeQuietly(stmt);
        }
    }
    
