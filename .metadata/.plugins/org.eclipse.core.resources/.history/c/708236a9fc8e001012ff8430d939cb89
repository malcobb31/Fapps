    // CSV structure analysis with proper resource management
    private List<String> analyzeCSVStructure(String csvFilePath, String delimiter, String pdbHost) {
        List<String> columnDefinitions = new ArrayList<>();
        BufferedReader reader = null;
        
        try {
            reader = Files.newBufferedReader(Paths.get(csvFilePath));
            String headerLine = reader.readLine();
            
            if (headerLine != null) {
                String[] headers = headerLine.split(Pattern.quote(delimiter));
                
                for (int i = 0; i < headers.length; i++) {
                    String columnName = sanitizeColumnName(headers[i].trim());
                    if (columnName.isEmpty()) {
                        columnName = "column_" + (i + 1);
                    }
                    columnDefinitions.add(columnName + " TEXT");
                }
            }
            
            log("INFO", String.format("CSV structure analyzed - File:%s Columns:%d", 
                                    csvFilePath, columnDefinitions.size()), pdbHost, "CSV_ANALYZED");
            
        } catch (IOException e) {
            log("ERROR", String.format("Failed to analyze CSV structure - File:%s Error:%s", 
                                     csvFilePath, e.getMessage()), pdbHost, "CSV_ANALYSIS_ERROR");
        } finally {
            closeQuietly(reader);
        }
        
        return columnDefinitions;
    }
    
    // Column name sanitization
    private String sanitizeColumnName(String columnName) {
        if (columnName == null || columnName.trim().isEmpty()) {
            return "";
        }
        
        // Remove quotes and special characters, replace spaces with underscores
        return columnName.replaceAll("[\"'`]", "")
                        .replaceAll("[^a-zA-Z0-9_]", "_")
                        .replaceAll("_{2,}", "_")
                        .replaceAll("^_|_$", "")
                        .toLowerCase();
    }
    
    // PostgreSQL CSV import with proper resource management
    private void importCSVUsingPsql(String csvFilePath, String delimiter, boolean hasHeader, 
                                   String tableName, DatabaseConfig dbConfig, String pdbHost) throws Exception {
        
        Connection conn = null;
        try {
            conn = DriverManager.getConnection(dbConfig.url, dbConfig.user, dbConfig.password);
            
            // Use COPY command for efficient bulk loading
            String copySQL = String.format(
                "COPY %s FROM STDIN WITH (FORMAT CSV, DELIMITER '%s', HEADER %s, QUOTE '\"', ESCAPE '\"')",
                tableName, delimiter, hasHeader ? "true" : "false"
            );
            
            org.postgresql.copy.CopyManager copyManager = 
                new org.postgresql.copy.CopyManager((BaseConnection) conn);
            
            try (FileInputStream fileInputStream = new FileInputStream(csvFilePath)) {
                long rowsInserted = copyManager.copyIn(copySQL, fileInputStream);
                log("INFO", String.format("PostgreSQL CSV import completed - Table:%s Rows:%d File:%s", 
                                        tableName, rowsInserted, csvFilePath), pdbHost, "PSQL_IMPORT_SUCCESS");
            }
            
        } finally {
            closeQuietly(conn);
        }
    }
    
    // MySQL CSV import with proper resource management and batching
    private void importCSVToMySQL(String csvFilePath, String delimiter, boolean hasHeader, 
                                 String tableName, Connection conn, String pdbHost) throws Exception {
        
        BufferedReader reader = null;
        PreparedStatement ps = null;
        
        try {
            reader = Files.newBufferedReader(Paths.get(csvFilePath));
            
            // Skip header if present
            String line = reader.readLine();
            if (!hasHeader && line != null) {
                // Process first line if no header
                processCSVLine(line, delimiter, tableName, conn, ps, pdbHost);
            }
            
            // Get column count for prepared statement
            int columnCount = getColumnCount(conn, tableName);
            if (columnCount == 0) {
                throw new Exception("Could not determine column count for table: " + tableName);
            }
            
            // Prepare insert statement
            StringBuilder insertSQL = new StringBuilder("INSERT INTO ").append(tableName).append(" VALUES (");
            for (int i = 0; i < columnCount; i++) {
                if (i > 0) insertSQL.append(", ");
                insertSQL.append("?");
            }
            insertSQL.append(")");
            
            ps = conn.prepareStatement(insertSQL.toString());
            
            int batchCount = 0;
            int totalRows = 0;
            final int BATCH_SIZE = 1000;
            
            while ((line = reader.readLine()) != null) {
                String[] values = line.split(Pattern.quote(delimiter), -1);
                
                for (int i = 0; i < Math.min(values.length, columnCount); i++) {
                    String value = values[i].trim();
                    if (value.isEmpty() || "NULL".equalsIgnoreCase(value)) {
                        ps.setNull(i + 1, Types.VARCHAR);
                    } else {
                        ps.setString(i + 1, value);
                    }
                }
                
                // Fill remaining columns with NULL if CSV has fewer columns
                for (int i = values.length; i < columnCount; i++) {
                    ps.setNull(i + 1, Types.VARCHAR);
                }
                
                ps.addBatch();
                batchCount++;
                totalRows++;
                
                if (batchCount >= BATCH_SIZE) {
                    ps.executeBatch();
                    batchCount = 0;
                }
            }
            
            // Execute remaining batch
            if (batchCount > 0) {
                ps.executeBatch();
            }
            
            log("INFO", String.format("MySQL CSV import completed - Table:%s Rows:%d File:%s", 
                                    tableName, totalRows, csvFilePath), pdbHost, "MYSQL_IMPORT_SUCCESS");
            
        } finally {
            closeQuietly(ps);
            closeQuietly(reader);
        }
    }
    
