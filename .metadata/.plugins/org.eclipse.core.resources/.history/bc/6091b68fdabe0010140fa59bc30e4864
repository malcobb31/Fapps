	public HashMap<String, String[]> getMRDfromPatient(String sourceTable, String date, String db_url, String db_name,
			String db_pass) {
		HashMap<String, String[]> data = null;
		Connection conn = null;
		Statement stmt = null;
		ResultSet rs = null;
		String query = null;
		String[] snoRange = null;
		String binaryDate = "";
		int rowCount = 0;
		int row = 0;
		String[] curr_moth=null;
		
		try
		{
			curr_moth=dt.getStartDateForMonths("yyyy-MM-dd", date, "-1");
//			System.out.println("date is--"+date);
			binaryDate = "VISIT_DATE~~"+curr_moth[0]+"~~daily";
//			
			snoRange = binarySearch("yes", binaryDate, "Patient_Type_Age_wise_final", db_url, db_name, db_pass);
			
			binaryDate = "VISIT_DATE~~"+date+"~~daily";
			
			String[] snoRange2 = binarySearch("yes", binaryDate, "Patient_Type_Age_wise_final", db_url, db_name, db_pass);
			
			query="select MRD_NO,LOCATION_NAME  as location"
				+ " from Patient_Type_Age_wise_final "
				+" where sno >= "+snoRange[0]+" and sno <= "+snoRange2[1]+""
				+" and DATE_FORMAT(VISIT_DATE,'%Y-%m-%d')>=DATE_FORMAT('"+curr_moth[0]+"','%Y-%m-%d')"
				+" and DATE_FORMAT(VISIT_DATE,'%Y-%m-%d')<=DATE_FORMAT('"+date+"','%Y-%m-%d')"
				+ "group by MRD_NO";
							
				pu.sop("Query API Log: getMRDfromPatient ", query);

				conn = new com.fapps.db.MySQLConnection().getConnection(db_url, db_name, db_pass);
				stmt = conn.createStatement();
				rs   = stmt.executeQuery( query );
				rs.last();
				rowCount = rs.getRow();
				rs.beforeFirst();
				
				pu.sop("Row Count", "Total rows:["+rowCount+"]");

				if( rowCount > 0 ){
						
					String[] sourceTableColumns = new String[6];

					pu.sop("Column Count", "Total Columns:["+sourceTableColumns.length+"]");	
					
					data = new HashMap<String, String[]>();
					//	data[0] = new String[sourceTableColumns.length];
					int colNumber=0;
					String[] tableData = null ;
					

					while( rs.next() )
					{
						colNumber=0;
						//tableData="";
						tableData = new String[sourceTableColumns.length];
						tableData[0]= rs.getString("MRD_NO");
						tableData[1]= rs.getString("location");

						data.put(rs.getString("MRD_NO"), tableData	);
						
					}

				}
		}
		catch( Exception ex )
		{
			System.out.println("EXCEPTION JAR: getMRDfromPatient: "+ex.toString());
			data = null;
			ex.printStackTrace();
		}
		finally
		{
			try
			{
				if( conn != null )
				{
					if( rs != null )
						rs.close();
					if( stmt != null )
						stmt.close();
					conn.close();
				}
			}catch( Exception e ){}
		}
		return data;
	}		
	
