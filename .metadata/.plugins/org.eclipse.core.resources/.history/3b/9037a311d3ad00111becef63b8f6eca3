package etl_summary_v1;

import java.sql.*;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class daily_summary_methods {

    private Connection conn;
    private String tableName;
    private String date;

    private String dbUrl, dbUser, dbPass;

    // Source table/column identifiers (per supplied SNO mapping)
    private static final String AMR_TABLE = "agent_modification_requests";
    private static final String AMR_ID_COL = "id";

    private static final String MSG_TABLE = "msg_history_all";
    private static final String MSG_ID_COL = "id";

    private static final String USER_TABLE = "user_details";
    private static final String USER_SNO_COL = "sno";

    private static final String DEVICE_TABLE = "device_details_default";
    private static final String DEVICE_ID_COL = "id";

    private static final String VOLTE_TABLE = "pview.Vi_volte_call_details";
    private static final String VOLTE_SNO_COL = "sno";

    // SNO ranges, resolved once per table/date combination used
    private int[] amrRange;
    private int[] msgRange;
    private int[] volteRange;

    private boolean debugEnabled = true;
    private String processName = "DAILY_SUMMARY";
    private String processVersion = "1.0";

    private DateTimeFormatter logFormat =
            DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss SSS");

    public daily_summary_methods(Connection conn, String tableName, String date,
                                  String dbUrl, String dbUser, String dbPass) {
        this.conn = conn;
        this.tableName = tableName;
        this.date = date;
        this.dbUrl = dbUrl;
        this.dbUser = dbUser;
        this.dbPass = dbPass;
    }

    public void process() throws Exception {

        log("DEBUG", "START processing date: " + date, "", "START");

        SNORangeFinder finder = new SNORangeFinder();

        // ---- Resolve SNO ranges for date-filtered tables ----
        // agent_modification_requests (used by Metrics 1, 9, 10, 11, 12)
        int[] amrMinMax = finder.getStartEndIdOfTable(AMR_TABLE, AMR_ID_COL, dbUrl, dbUser, dbPass);
        if (amrMinMax == null) {
            throw new Exception("SNO RANGE FETCH FAILED for " + AMR_TABLE);
        }
        amrRange = finder.getStartAndEndId(
                date, amrMinMax[0], amrMinMax[1],
                AMR_TABLE, "upload_time",
                "daily", "120", false,
                AMR_ID_COL, dbUrl, dbUser, dbPass, "%Y-%m-%d"
        );

        // msg_history_all (used by Metrics 2, 3)
        int[] msgMinMax = finder.getStartEndIdOfTable(MSG_TABLE, MSG_ID_COL, dbUrl, dbUser, dbPass);
        if (msgMinMax == null) {
            throw new Exception("SNO RANGE FETCH FAILED for " + MSG_TABLE);
        }
        msgRange = finder.getStartAndEndId(
                date, msgMinMax[0], msgMinMax[1],
                MSG_TABLE, "time",
                "daily", "120", false,
                MSG_ID_COL, dbUrl, dbUser, dbPass, "%Y-%m-%d"
        );

        // pview.Vi_volte_call_details (used by Metric 7)
        int[] volteMinMax = finder.getStartEndIdOfTable(VOLTE_TABLE, VOLTE_SNO_COL, dbUrl, dbUser, dbPass);
        if (volteMinMax == null) {
            throw new Exception("SNO RANGE FETCH FAILED for " + VOLTE_TABLE);
        }
        volteRange = finder.getStartAndEndId(
                date, volteMinMax[0], volteMinMax[1],
                VOLTE_TABLE, "sourceTimeStamp",
                "daily", "120", false,
                VOLTE_SNO_COL, dbUrl, dbUser, dbPass, "%Y-%m-%d"
        );

        // user_details and device_details_default have no date filter in any
        // requested metric, so no SNO range is computed or applied for them
        // (per RANGE OPTIMIZATION RULE: no arbitrary date/range filter).

        log("DEBUG", "Ranges AMR:" + amrRange[0] + "-" + amrRange[1] +
                " MSG:" + msgRange[0] + "-" + msgRange[1] +
                " VOLTE:" + volteRange[0] + "-" + volteRange[1], "", "SNO");

        // ================= METRIC QUERIES =================

        // Metric 1 — Total tests conducted per day
        long totalTestsConducted = getCountLong(
                "select count(distinct scan_id) from " + AMR_TABLE +
                " where " + AMR_ID_COL + " between " + amrRange[0] + " and " + amrRange[1] +
                " and date(upload_time) = '" + date + "'");

        // Metric 2 — Total message inserted in evt table per day
        long totalMsgInserted = getCountLong(
                "select count(*) from " + MSG_TABLE +
                " where " + MSG_ID_COL + " between " + msgRange[0] + " and " + msgRange[1] +
                " and date(time) = '" + date + "'");

        // Metric 3 — Total EVTs inserted in evt table per day
        // NOTE: supplied condition uses >= exactly as specified; not changed to =.
        // Because this is a >= (open-ended) filter, the msgRange upper bound
        // (computed for the single target date) would incorrectly exclude
        // later rows, so the SNO range is not applied here to avoid changing
        // the query's result. Only the lower bound is used to avoid scanning
        // from the very start of the table without altering the result set.
        long totalEvtInserted = getCountLong(
                "select count(*) from " + MSG_TABLE +
                " where " + MSG_ID_COL + " >= " + msgRange[0] +
                " and msg='evt' and date(time) >= '" + date + "'");

        // Metric 4 — Total registered users (no date filter — no range applied)
        long totalRegisteredUsers = getCountLong(
                "select count(*) from " + USER_TABLE);

        // Metric 5 — Total active users (no date filter — no range applied)
        long totalActiveUsers = getCountLong(
                "select count(*) from " + USER_TABLE +
                " where msg_history_minute_status='Active'");

        // Metric 6 — Total active Agents (no date filter — no range applied)
        long totalActiveAgents = getCountLong(
                "select count(*) from " + DEVICE_TABLE +
                " where status_config='Active'");

        // Metric 7 — Total VoLTE call reports processed per day
        long totalVolteReports = getCountLong(
                "select count(*) from " + VOLTE_TABLE +
                " where " + VOLTE_SNO_COL + " between " + volteRange[0] + " and " + volteRange[1] +
                " and date(sourceTimeStamp) = '" + date + "'");

        // Metric 8 — New Registered Users of the day (no SNO range: user_details
        // has no range computed since it carries no date-filtered metric elsewhere;
        // computing one solely for this metric was not requested)
        long newRegisteredUsers = getCountLong(
                "select count(*) from " + USER_TABLE +
                " where date(user_reg_date) = '" + date + "'");

        // Metric 9 — Total tests conducted per day by App
        long totalTestsByApp = getCountLong(
                "select count(distinct scan_id) from " + AMR_TABLE +
                " where " + AMR_ID_COL + " between " + amrRange[0] + " and " + amrRange[1] +
                " and date(upload_time) = '" + date + "'" +
                " and schedule_type='app'");

        // Metric 10 — Total tests conducted per day by UI
        long totalTestsByUi = getCountLong(
                "select count(distinct scan_id) from " + AMR_TABLE +
                " where " + AMR_ID_COL + " between " + amrRange[0] + " and " + amrRange[1] +
                " and date(upload_time) = '" + date + "'" +
                " and schedule_type='ui'");

        // Metric 11 — Total tests conducted per day by Scheduler
        long totalTestsByScheduler = getCountLong(
                "select count(distinct scan_id) from " + AMR_TABLE +
                " where " + AMR_ID_COL + " between " + amrRange[0] + " and " + amrRange[1] +
                " and date(upload_time) = '" + date + "'" +
                " and schedule_type='schedule_process'");

        // Metric 12 — Total tests conducted per day by API
        long totalTestsByApi = getCountLong(
                "select count(distinct scan_id) from " + AMR_TABLE +
                " where " + AMR_ID_COL + " between " + amrRange[0] + " and " + amrRange[1] +
                " and date(upload_time) = '" + date + "'" +
                " and schedule_type='api'");

        log("DEBUG", "Summary TotalTests:" + totalTestsConducted +
                " MsgInserted:" + totalMsgInserted +
                " EvtInserted:" + totalEvtInserted +
                " RegisteredUsers:" + totalRegisteredUsers +
                " ActiveUsers:" + totalActiveUsers +
                " ActiveAgents:" + totalActiveAgents +
                " VolteReports:" + totalVolteReports +
                " NewRegisteredUsers:" + newRegisteredUsers +
                " TestsByApp:" + totalTestsByApp +
                " TestsByUi:" + totalTestsByUi +
                " TestsByScheduler:" + totalTestsByScheduler +
                " TestsByApi:" + totalTestsByApi,
                "", "SUMMARY");

        insertRow(totalTestsConducted, totalMsgInserted, totalEvtInserted,
                totalRegisteredUsers, totalActiveUsers, totalActiveAgents,
                totalVolteReports, newRegisteredUsers,
                totalTestsByApp, totalTestsByUi, totalTestsByScheduler, totalTestsByApi);

        log("DEBUG", "END processing", "", "END");
    }

    private long getCountLong(String query) throws Exception {

        log("DEBUG", query, "", "QUERY");

        try (Statement stmt = conn.createStatement();
             ResultSet rs = stmt.executeQuery(query)) {
            if (rs.next()) return rs.getLong(1);
        }

        return 0L;
    }

    private void insertRow(
            long totalTestsConducted, long totalMsgInserted, long totalEvtInserted,
            long totalRegisteredUsers, long totalActiveUsers, long totalActiveAgents,
            long totalVolteReports, long newRegisteredUsers,
            long totalTestsByApp, long totalTestsByUi, long totalTestsByScheduler, long totalTestsByApi
    ) throws Exception {

        String sql = "INSERT INTO " + tableName +
                " (report_date, total_tests_conducted, total_msg_inserted, total_evt_inserted," +
                " total_registered_users, total_active_users, total_active_agents," +
                " total_volte_reports, new_registered_users," +
                " total_tests_by_app, total_tests_by_ui, total_tests_by_scheduler, total_tests_by_api)" +
                " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)";

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            int i = 1;
            ps.setString(i++, date);
            ps.setLong(i++, totalTestsConducted);
            ps.setLong(i++, totalMsgInserted);
            ps.setLong(i++, totalEvtInserted);
            ps.setLong(i++, totalRegisteredUsers);
            ps.setLong(i++, totalActiveUsers);
            ps.setLong(i++, totalActiveAgents);
            ps.setLong(i++, totalVolteReports);
            ps.setLong(i++, newRegisteredUsers);
            ps.setLong(i++, totalTestsByApp);
            ps.setLong(i++, totalTestsByUi);
            ps.setLong(i++, totalTestsByScheduler);
            ps.setLong(i++, totalTestsByApi);

            ps.executeUpdate();

            log("DEBUG", "Insert successful for date: " + date, "", "INSERT");
        }
    }

    private void log(String level, String message, String serverIP, String evtType) {

        if ("DEBUG".equalsIgnoreCase(level) && !debugEnabled) return;

        String timestamp = LocalDateTime.now().format(logFormat);

        System.out.println("Time:" + timestamp +
                " [" + level + "] Process_Name:" + processName +
                " Process_Version:" + processVersion +
                " EVT_Type:" + evtType +
                " Description:" + message);
    }
}