	/**
	 * In-memory representation of the "lapview known state" of one user, for ranking purposes only.
	 * This is the per-event state buffer required by rules #3/#9/#12/#13: it is seeded from the DB
	 * (via metadata, since re_user_bkp_1710_v3_copy has no top-level bc_organisation/region_code/
	 * user_branch_id/login_time columns) and is overwritten as each incremental CSV row is
	 * processed, so that later events in the same run see earlier events' results.
	 *
	 * This buffer is used ONLY to decide ranking scope membership/ordering. All non-ranking
	 * field resolution (address enrichment, name splitting, etc.) continues to use resolveRow()
	 * exactly as before, driven by the actual incoming source row.
	 *
	 * IMPORTANT (rule #10/#13): currentUserType/currentStatus/currentActive represent the
	 * COMMITTED baseline - state actually believed to be durable in the database. They are
	 * advanced ONLY through TransactionContext.commitPending(), which is invoked after a chunk's
	 * COMMIT has physically succeeded. They are never touched directly while an event's writes are
	 * still pending inside an open transaction; see TransactionContext below.
	 */
	static final class UserState {
		String userId;
		String userMode; // normalized upper-case mode, e.g. IA/IU/IRA/IRU/IBU, or null if not rank-eligible
		String userStatus; // raw source user_status code (e.g. "1"), used against RANKED_STATUSES
		String bcOrganisation;
		String regionCode;
		String userBranchId;
		String loginTime;
		String reFlag; // null means explicitly eligible; non-null values are never ranked
		// re_flag of the reporting entity the user's DB row CURRENTLY belongs to (seeded from the DB
		// via reporting_entity_id). Unlike reFlag it is never overwritten by an incoming CSV row, so
		// an incoming row pointing at an eligible FI cannot unlock a user whose stored row sits under
		// a flagged / unresolved reporting entity. null means eligible.
		String dbReFlag;
		// Committed baseline: the ranking-derived outcome actually durable in the DB (or believed to
		// be, pending an in-flight transaction's commit). Never mutated for a not-yet-committed
		// event; see TransactionContext.
		String currentUserType;
		String currentStatus;
		String currentActive;
		boolean protectedRecord;
		boolean hasDsc; // dsc_id configured -> occupies a seat even when protected

		String scopeKey(String modeKey) {
			return ntp12_process_methods.buildScopeKeyStatic(modeKey, bcOrganisation, regionCode, userBranchId);
		}
	}

	/**
	 * Transaction-chunk-scoped view of "committed-equivalent" user state (rule #11).
	 *
	 * WHY THIS EXISTS: within one open transaction, event N's ranking calculation must be able to
	 * see the effects of event N-1's successful writes even though neither has actually been
	 * COMMITted yet (COMMIT only happens once per BATCH_SIZE events). At the same time, UserState's
	 * currentUserType/currentStatus/currentActive fields must continue to mean "durably committed"
	 * (rule #10) - they must NOT be advanced just because a statement executed; the transaction
	 * could still roll back.
	 *
	 * SOLUTION: this class holds a small overlay of pending (userId -> {userType,status,active})
	 * changes recorded only after a given event's own JDBC statements succeeded (executeUpdate()
	 * returned without exception) within the CURRENT open transaction. Ranking recalculation reads
	 * through this overlay first, falling back to UserState's committed baseline. Only when the
	 * chunk's COMMIT physically succeeds does commitPending() copy the overlay into the real
	 * UserState.current* fields. If the chunk rolls back, discard() drops the overlay entirely and
	 * the committed baseline (from before the chunk started) remains authoritative.
	 */
	static final class TransactionContext {
		private final Map<String, String> pendingUserType = new HashMap<String, String>();
		private final Map<String, String> pendingStatus = new HashMap<String, String>();
		private final Map<String, String> pendingActive = new HashMap<String, String>();

		/**
		 * Event-scoped snapshot of whatever this overlay contained for a set of userIds
		 * immediately BEFORE the current event's statements started running. Used to restore the
		 * overlay to its exact pre-event contents if the event fails partway through - without
		 * touching entries belonging to any other (earlier, already-succeeded) event in the same
		 * transaction chunk.
		 *
		 * "no previous pending value" is represented by NOT putting a key into the snapshot maps
		 * at all - restoreEvent() removes any such key from the live overlay rather than putting
		 * back a null, since HashMap can't distinguish "absent" from "mapped to null" otherwise.
		 */
		static final class EventStateSnapshot {
			private final Map<String, String> priorUserType = new HashMap<String, String>();
			private final Map<String, String> priorStatus = new HashMap<String, String>();
			private final Map<String, String> priorActive = new HashMap<String, String>();
			private final Set<String> hadEntry = new HashSet<String>();
			private final Set<String> touchedKeys = new HashSet<String>();
		}

		/**
		 * Call once, before an event's statements begin executing. Returns a snapshot handle that
		 * must later be passed to either discardEventSnapshot() (event succeeded - keep the
		 * pending changes) or restoreEvent() (event failed - undo just this event's overlay
		 * writes). The event itself is responsible for telling the snapshot, via noteTouched(),
		 * which userIds it may write to recordSuccess() for - beginEvent() takes no arguments
		 * because the set of affected users (the incoming user plus every ranking-propagated
		 * target) is not fully known until ranking is recalculated inside the event.
		 */
		EventStateSnapshot beginEvent() {
			return new EventStateSnapshot();
		}

		/**
		 * Captures this key's current overlay value (or "no entry") into the snapshot the first
		 * time the current event is about to write to it. Safe to call more than once per key per
		 * event - only the first call for a given key actually captures anything, so a key's
		 * pre-event value is never overwritten by an intermediate in-event value.
		 */
		private void captureIfFirstTouch(EventStateSnapshot snap, String normalizedUserId) {
			if (!snap.touchedKeys.add(normalizedUserId))
				return; // already captured this key for this event
			if (pendingUserType.containsKey(normalizedUserId)) {
				snap.hadEntry.add(normalizedUserId);
				snap.priorUserType.put(normalizedUserId, pendingUserType.get(normalizedUserId));
				snap.priorStatus.put(normalizedUserId, pendingStatus.get(normalizedUserId));
				snap.priorActive.put(normalizedUserId, pendingActive.get(normalizedUserId));
			}
			// else: no prior entry - leave hadEntry/priorXxx untouched; restoreEvent() will remove
			// the key entirely for this normalizedUserId, matching "no pending value" (see class doc).
		}

		/**
		 * Records a successful statement's effect for one user within the CURRENT event, snapshotting
		 * that key's pre-event overlay value first (if this is the first write to that key during
		 * this event). This is the only way the pending overlay is ever mutated.
		 */
		void recordSuccess(EventStateSnapshot snap, String normalizedUserId, String userType, String status,
				String active) {
			captureIfFirstTouch(snap, normalizedUserId);
			pendingUserType.put(normalizedUserId, userType);
			pendingStatus.put(normalizedUserId, status);
			pendingActive.put(normalizedUserId, active);
		}

		/** Event succeeded: keep every pending change it made. Nothing to do but drop the snapshot. */
		void discardEventSnapshot(EventStateSnapshot snap) {
			// Intentionally a no-op beyond letting the snapshot become garbage: the live overlay
			// already holds the event's writes, which is exactly what should survive.
		}

		/**
		 * Event failed: undo ONLY this event's overlay writes, restoring each touched key to
		 * exactly what it held before this event started (rule: "restore TransactionContext to
		 * exactly the state it had before this event"). Keys touched by earlier, already-succeeded
		 * events in the same transaction chunk are untouched because they are not in
		 * snap.touchedKeys.
		 */
		void restoreEvent(EventStateSnapshot snap) {
			for (String key : snap.touchedKeys) {
				if (snap.hadEntry.contains(key)) {
					pendingUserType.put(key, snap.priorUserType.get(key));
					pendingStatus.put(key, snap.priorStatus.get(key));
					pendingActive.put(key, snap.priorActive.get(key));
				} else {
					pendingUserType.remove(key);
					pendingStatus.remove(key);
					pendingActive.remove(key);
				}
			}
		}

		String effectiveUserType(UserState st) {
			String p = pendingUserType.get(normalizeKeyStatic(st.userId));
			return p != null ? p : st.currentUserType;
		}

		String effectiveStatus(UserState st) {
			String p = pendingStatus.get(normalizeKeyStatic(st.userId));
			return p != null ? p : st.currentStatus;
		}

		String effectiveActive(UserState st) {
			String p = pendingActive.get(normalizeKeyStatic(st.userId));
			return p != null ? p : st.currentActive;
		}

		/** Copies every pending change into the real committed baseline. Call ONLY after COMMIT succeeds. */
		void commitPending(Map<String, UserState> stateBuffer) {
			for (Map.Entry<String, String> e : pendingUserType.entrySet()) {
				UserState st = stateBuffer.get(e.getKey());
				if (st == null)
					continue;
				st.currentUserType = e.getValue();
				st.currentStatus = pendingStatus.get(e.getKey());
				st.currentActive = pendingActive.get(e.getKey());
			}
			clear();
		}

		/** Drops every pending change. Call after a whole-chunk ROLLBACK - committed baseline is left untouched. */
		void discard() {
			clear();
		}

		private void clear() {
			pendingUserType.clear();
			pendingStatus.clear();
			pendingActive.clear();
		}

		boolean isEmpty() {
			return pendingUserType.isEmpty();
		}
	}

