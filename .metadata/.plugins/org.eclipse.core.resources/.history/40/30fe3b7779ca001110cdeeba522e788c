	private CsvTable loadCsv(Path file) {
		try (BufferedReader br = Files.newBufferedReader(file, StandardCharsets.ISO_8859_1)) {

			/*
			 * Read the header as one logical CSV record.
			 * A logical record may span multiple physical lines.
			 */
			String headerRecord = readCsvRecord(br);

			if (isBlank(headerRecord))
				return null;

			List<String> rawHeaders = parseDelimitedLine(headerRecord, '|');

			if (rawHeaders.isEmpty())
				return null;

			List<String> headers = new ArrayList<String>();

			for (String h : rawHeaders)
				headers.add(normalizeHeader(h));

			List<Map<String, String>> rows = new ArrayList<Map<String, String>>();

			String record;

			while ((record = readCsvRecord(br)) != null) {

				if (isBlank(record))
					continue;

				List<String> vals = parseDelimitedLine(record, '|');

				if (vals.isEmpty())
					continue;

				/*
				 * Do NOT shift/drop columns here.
				 * The source column order is determined strictly by
				 * the header position.
				 */

				if (vals.size() != headers.size()) {

					String userId =
							vals.size() > 0
									? cleanValue(vals.get(0))
									: "";

					log("WARN",
							"CSV column-count mismatch | file="
									+ file.getFileName()
									+ " | user_id=" + userId
									+ " | headers=" + headers.size()
									+ " | values=" + vals.size(),
							null,
							"CSV_SCHEMA_MISMATCH");
				}

				/*
				 * Pad missing trailing fields with blank values.
				 */
				while (vals.size() < headers.size())
					vals.add("");

				/*
				 * Ignore anything beyond the header count.
				 *
				 * IMPORTANT:
				 * We do NOT shift the remaining fields.
				 */
				if (vals.size() > headers.size())
					vals = new ArrayList<String>(
							vals.subList(0, headers.size())
					);

				Map<String, String> row = new LinkedHashMap<String, String>();

				for (int i = 0; i < headers.size(); i++) {

					String value =
							i < vals.size()
									? vals.get(i)
									: null;

					row.put(
							headers.get(i),
							cleanValue(value)
					);
				}

				rows.add(row);
			}

			log("INFO",
					"Loaded: " + file.getFileName()
							+ " | Rows=" + rows.size()
							+ " | Headers=" + headers.size(),
					null,
					"CSV_LOAD");

			CsvTable table =
					new CsvTable(file, headers, rows);

			if (isUserMaster(table))
				validateSourceHeaders(headers);

			return table;

		} catch (Exception e) {

			log("ERROR",
					"CSV load error: "
							+ file.getFileName()
							+ " | " + e.getMessage(),
					null,
					"CSV_LOAD");

			return null;
		}
	}
	private String readCsvRecord(BufferedReader br) throws IOException {

		StringBuilder record = new StringBuilder();

		boolean inQuotes = false;

		String line;

		while ((line = br.readLine()) != null) {

			if (record.length() > 0)
				record.append('\n');

			record.append(line);

			for (int i = 0; i < line.length(); i++) {

				char ch = line.charAt(i);

				/*
				 * Backslash escaped quote:
				 *
				 * \"
				 */
				if (ch == '\\'
						&& i + 1 < line.length()
						&& line.charAt(i + 1) == '"') {

					i++;
					continue;
				}

				/*
				 * Doubled quote inside quoted value:
				 *
				 * ""
				 */
				if (ch == '"'
						&& inQuotes
						&& i + 1 < line.length()
						&& line.charAt(i + 1) == '"') {

					i++;
					continue;
				}

				if (ch == '"')
					inQuotes = !inQuotes;
			}

			/*
			 * Once quotes are balanced, the complete logical CSV
			 * record has been read.
			 */
			if (!inQuotes)
				return record.toString();
		}

		return record.length() == 0
				? null
				: record.toString();
	}
	
	private boolean isUserMaster(CsvTable t) {
		return t.hasHeader("user_id") && t.hasHeader("user_mode") && t.hasHeader("user_status")
				&& t.hasHeader("bc_organisation") && t.hasHeader("first_name") && t.hasHeader("title");
	}

	private List<Path> findCsvFiles(Path dir) throws IOException {
		List<Path> files = new ArrayList<>();
		try (DirectoryStream<Path> stream = Files.newDirectoryStream(dir, "*.csv")) {
			for (Path p : stream)
				if (Files.isRegularFile(p))
					files.add(p);
		}
		files.sort(Comparator.comparing(p -> p.getFileName().toString().toLowerCase()));
		return files;
	}

