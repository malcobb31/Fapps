	private void mergeLookupByUserId(Map<String, Map<String, String>> target, CsvTable table) {
		if (target == null || table == null || table.rows == null)
			return;
		for (Map<String, String> row : table.rows) {
			String userId = get(row, "user_id");
			if (isBlank(userId))
				continue;
			String key = normalizeKey(userId);
			Map<String, String> prev = target.get(key);
			if (prev == null) {
				target.put(key, new HashMap<String, String>(row));
				continue;
			}
			// Same user_id twice (mapping CSVs repeat rows): keep the first non-blank value per column.
			for (Map.Entry<String, String> e : row.entrySet()) {
				if (isBlank(cleanValue(prev.get(e.getKey()))) && !isBlank(cleanValue(e.getValue())))
					prev.put(e.getKey(), e.getValue());
			}
		}
	}

	private Map<String, String> lookupRowByUserId(Map<String, Map<String, String>> lookup, String userId) {
		if (lookup == null || isBlank(userId))
			return null;
		return lookup.get(normalizeKey(userId));
	}

