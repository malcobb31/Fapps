	public boolean run(String csvFolderPath) {
		EtlReport report = new EtlReport();
		report.startMs = System.currentTimeMillis();

		log("INFO", "========================================", null, "APP_START");
		log("INFO", "USER MIGRATION STARTING", null, "APP_START");
		log("INFO", "Process=" + PROCESS_NAME + "  Version=" + PROCESS_VERSION, null, "APP_START");
		log("INFO", "========================================", null, "APP_START");

		try {
			Path inputDir = Paths.get(csvFolderPath);
			if (!Files.exists(inputDir) || !Files.isDirectory(inputDir)) {
				log("ERROR", "CSV folder not found or not a directory: " + csvFolderPath, null, "CONFIG_LOAD");
				return false;
			}

			List<Path> csvFiles = findCsvFiles(inputDir);
			if (csvFiles.isEmpty()) {
				log("WARN", "No CSV files found in: " + csvFolderPath, null, "CSV_LOAD");
				return false;
			}

			// Address, region, branch and reporting-entity lookups come from the DB (re_mgmt schema).
			Map<String, Map<String, String>> addressLookup = loadAddressLookup();
			log("INFO", "Address lookup loaded from re_mgmt.address_pview_bkp_1610 | Entries=" + addressLookup.size(), null,
					"LOOKUP_LOAD");

			Map<String, String> regionLookup = loadRegionLookup();
			log("INFO", "Region lookup loaded from re_mgmt.region_pview_bkp_1610 | Entries=" + regionLookup.size(), null,
					"LOOKUP_LOAD");

			Map<String, String> branchLookup = loadBranchLookup();
			log("INFO", "Branch lookup loaded from re_mgmt.branch_pview_bkp_1610 | Entries=" + branchLookup.size(), null,
					"LOOKUP_LOAD");

			Map<String, String> reLookup = loadReportingEntityLookup();
			log("INFO", "Reporting-entity lookup loaded | Entries=" + reLookup.size(), null, "LOOKUP_LOAD");

			// Seed the ranking state buffer from the DB's currently-persisted rows (rule #13: "current
			// DB state"). This lets ranking recalculation see users that never appear in the incoming
			// CSVs at all (e.g. User B/C in the spec's examples).
			seedStateBufferFromDb(report);
			log("INFO", "Ranking state buffer seeded | Entries=" + stateBuffer.size(), null, "CONFIG_LOAD");

			String updateSql = buildUpdateSql();
			// re_flag guard: only rows whose reporting entity has re_flag IS NULL can be modified.
			// metadata.previous_status is added only when the user is demoted (? #4/#5 = previous status).
			String rankOnlySql = "UPDATE re_mgmt.re_user_bkp_1710 u SET user_type = ?, status = ?, active = ?, "
					+ "same_registration_correspondence_address = CASE WHEN u.user_type LIKE 'IAU%' OR "
					+ "CAST(? AS text) LIKE 'IAU%' THEN (CASE WHEN CAST(? AS text) LIKE 'IAU%' THEN true ELSE NULL END) "
					+ "ELSE u.same_registration_correspondence_address END, "
					+ "metadata = CASE WHEN CAST(? AS text) IS NULL THEN u.metadata ELSE "
					+ "COALESCE(u.metadata, '{}'::jsonb) || jsonb_build_object('previous_status', CAST(? AS text)) END "
					+ "WHERE u.user_id = ? AND " + RE_FLAG_ELIGIBLE_GUARD + " AND " + USER_MUTATION_GUARD
					+ " AND " + USER_TYPE_SCOPE_GUARD;

			try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass)) {
				conn.setAutoCommit(false);

				try (PreparedStatement ps = conn.prepareStatement(updateSql);
						PreparedStatement rankPs = conn.prepareStatement(rankOnlySql);
						PreparedStatement insertPs = conn.prepareStatement(buildInsertSql())) {
					insertPsRef = insertPs;

					iaCounterByBcOrganisation.clear();

					// ---- Master-event engine (rules #2, #3, #22) ----
					//
					// Exactly one JDBC Connection, one PreparedStatement per statement type (reused,
					// never re-prepared per event - rule #6), and one open transaction per chunk of
					// BATCH_SIZE SOURCE EVENTS (not statements - rule #4/#25).
					//
					// Every statement caused by event N (its own direct UPDATE, then every
					// ranking-propagated UPDATE it triggers, in that order) is executed with
					// executeUpdate() IMMEDIATELY, before event N+1 is even looked at. There is no
					// batch queue of any kind for these two statement types; the ordering guarantee
					// (rule #3) comes directly from Java call order, not from any queuing structure.
					//
					// A SAVEPOINT is taken before each event's writes (rule #12, Option A) so a single
					// bad event can be rolled back to its own savepoint without discarding every
					// earlier-in-chunk event that already succeeded and without requiring a full
					// chunk replay. This is preferred over Option B (whole-chunk rollback + replay)
					// because per-event SAVEPOINTs are cheap on PostgreSQL and keep the rest of the
					// chunk's already-executed statements intact and in the same transaction.
					TransactionContext txCtx = new TransactionContext();
					int eventsInChunk = 0;

					// Pass 1: load every CSV first. The two mapping CSVs (user_address / user_details) must
					// be complete BEFORE any master row is resolved - file names sort as ..._48 (address),
					// ..._50 (master), ..._57 (details), so streaming in name order would miss details.
					List<CsvTable> masterTables = new ArrayList<CsvTable>();
					for (Path f : csvFiles) {
						CsvTable t = loadCsv(f);
						if (t == null || t.rows.isEmpty())
							continue;
						if (isUserMaster(t)) {
							masterTables.add(t);
							report.totalRows += t.rows.size();
						} else if (isUserAddressCsv(t)) {
							mergeLookupByUserId(userAddressCsvLookupRef, t);
						} else if (isUserDetails(t)) {
							mergeLookupByUserId(userDetailsLookupRef, t);
						} else {
							log("WARN", "CSV not recognised (not master / address / details), ignored | file="
									+ f.getFileName(), null, "CSV_LOAD");
						}
					}
					log("INFO", "CSV loaded | master rows=" + report.totalRows + " | address users="
							+ userAddressCsvLookupRef.size() + " | details users=" + userDetailsLookupRef.size(), null,
							"CSV_LOAD");
					if (masterTables.isEmpty())
						log("WARN", "No user_master CSV found (needs user_id, user_mode, user_status, bc_organisation, "
								+ "first_name, title)", null, "CSV_LOAD");

					// Ranking for NEW bc_organisations: once, over the complete CSV population (login_time desc).
					precomputeNewOrgRanking(masterTables, reLookup, regionLookup, branchLookup);

					// Pass 2: process the master rows.
					for (CsvTable t : masterTables) {
						eventsInChunk = processMasterTableSequentially(t, conn, ps, rankPs, txCtx, eventsInChunk,
								reLookup, addressLookup, regionLookup, branchLookup, report);
					}

					// Commit whatever remains below BATCH_SIZE at the very end of the run.
					if (eventsInChunk > 0) {
						commitChunk(conn, txCtx, report);
					}
				}
			}

			if (!report.dtWarn.isEmpty()) {
				log("INFO", "-- Aggregated Datatype Warnings --", null, "DATATYPE_WARN");
				for (Map.Entry<String, Integer> e : report.dtWarn.counts().entrySet()) {
					log("WARN", "DATATYPE_WARN Column=" + e.getKey() + " Expected=" + typeForColumn(e.getKey())
							+ " Failures=" + e.getValue() + " SampleValues=" + report.dtWarn.samples().get(e.getKey()),
							null, "DATATYPE_WARN");
				}
			}

			report.endMs = System.currentTimeMillis();
			printEtlReport(report);

			// Post-migration steps run automatically after the update phase completes.
			boolean statusUpdateOk = applyPostMigrationStatusUpdate();
			boolean dedupOk = correctDuplicateEmailMobile();

			printRunAudit("ntp12_update");
			return statusUpdateOk && dedupOk;

		} catch (Exception e) {
			log("ERROR", "Fatal ETL error: " + e.getMessage(), null, "ETL_ERROR");
			return false;
		}
	}

	// Lookups that must persist across the whole directory (not per-file); kept as instance state
	// so processMasterTableSequentially can see details/addresses loaded from files processed so far.
	// NOTE: because master, address and details CSVs may appear in any file-order within the
	// directory, this UPDATE parser resolves each master row using whatever address/details rows
	// have been loaded up to that point, exactly like the previous implementation did (it also
	// loaded all lookups before processing rows) - the only behavioral difference here is that
	// files are streamed in order rather than fully pre-scanned, per rule "0". If address/details
	// CSVs are guaranteed to sort before the master CSV files (as the deterministic filename sort
	// generally ensures for this feed), enrichment is unaffected.
	private final Map<String, Map<String, String>> userDetailsLookupRef = new HashMap<String, Map<String, String>>();
	private final Map<String, Map<String, String>> userAddressCsvLookupRef = new HashMap<String, Map<String, String>>();

	/**
	 * Processes every row of one master CSV table, in file order, executing each event's DB writes
	 * immediately (direct UPDATE, then that event's ranking-propagated UPDATEs) inside the current
	 * open chunk transaction, and committing every BATCH_SIZE events (rules #2, #3, #4, #22).
	 *
	 * Returns the updated eventsInChunk counter (how many events have executed since the last
	 * COMMIT), so the caller can keep the chunk-boundary count correct across multiple CSV files.
	 */
	private int processMasterTableSequentially(CsvTable masterTable, Connection conn, PreparedStatement ps,
			PreparedStatement rankPs, TransactionContext txCtx, int eventsInChunk, Map<String, String> reLookup,
			Map<String, Map<String, String>> addressLookup, Map<String, String> regionLookup,
			Map<String, String> branchLookup, EtlReport report) throws SQLException {

		for (Map<String, String> row : masterTable.rows) {

			String userId = get(row, "user_id");
			String userMode = get(row, "user_mode");
			String modeKey = isBlank(userMode) ? "" : userMode.trim().toUpperCase();

			if (isBlank(userId)) {
				report.skipAcc.record("BLANK_USER_ID");
				audit.skipped("blank user_id", userId);
				continue;
			}

			// ---- re_flag EVENT GATE (mandatory business rule) ----
			// Evaluated BEFORE any in-memory state (stateBuffer, scopeMembership, counters used for
			// ranking), ranking calculation, field resolution, savepoint or JDBC write for this event.
			// A skipped event is rejected in full: no direct UPDATE, no ranking-propagated UPDATE,
			// and no influence on later ranking decisions or other users.
			// Eligible means re_flag IS NULL for BOTH (a) the FI named in the incoming row and
			// (b) the reporting entity the user's stored DB row currently belongs to.
			// 'false', any other non-NULL value, unresolved and ambiguous FI codes all fail closed.
			String incomingFiCode = get(row, "bc_organisation");
			String incomingFlag = lookupReFlag(incomingFiCode);
			UserState priorState = stateBuffer.get(normalizeKey(userId));
			if (priorState != null && priorState.protectedRecord) {
				report.skipAcc.record("PROTECTED_EXISTING_USER");
				audit.skipped(isProtectedStatus(priorState.currentStatus)
						? "protected status " + priorState.currentStatus.trim().toUpperCase()
						: "protected (dsc_id + key_cloak_user_id set)", userId);
				continue;
			}
			// Only IA / IU / IRA / IRU / IBU (and the IAU_1 / IAU_2 seat holders) are handled here.
			// NO, HOI and any other stored user type are never touched.
			if (priorState != null && !isBlank(priorState.currentUserType)
					&& !IN_SCOPE_USER_TYPES.contains(priorState.currentUserType.trim().toUpperCase())) {
				report.skipAcc.record("OUT_OF_SCOPE_USER_TYPE");
				audit.skipped("user_type " + priorState.currentUserType.trim().toUpperCase() + " not handled", userId);
				continue;
			}
			String storedFlag = priorState == null ? null : priorState.dbReFlag;
			String flagSkipReason = reFlagSkipReason(incomingFlag);
			String flagSource = "incoming_bc_organisation";
			String offendingFlag = incomingFlag;
			if (flagSkipReason == null) {
				flagSkipReason = reFlagSkipReason(storedFlag);
				flagSource = "stored_reporting_entity";
				offendingFlag = storedFlag;
			}
			if (flagSkipReason != null) {
				report.skipAcc.record(flagSkipReason);
				report.eventsSkippedReFlag++;
				audit.skipped("re_flag " + describeFlag(offendingFlag) + " (" + flagSource + ")", userId);
				continue;
			}

			if (!USER_MODE_MAX_COUNT.containsKey(modeKey)) {
				report.skipAcc.record("USER_MODE_NOT_SUPPORTED_" + modeKey);
				audit.skipped("user_mode " + (isBlank(modeKey) ? "(blank)" : modeKey) + " not handled", userId);
				continue;
			}

			// IRA / IRU need a valid region_code, IBU a valid region_code AND user_branch_id. An invalid
			// row is NOT skipped any more: it is still migrated, but as DEACTIVATED (no seat taken).
			boolean forceDeactivate = !passesRegionBranchValidation(modeKey, row, regionLookup, branchLookup);
			if (forceDeactivate) {
				report.skipAcc.record("INVALID_REGION_OR_BRANCH_" + modeKey + "_MIGRATED_DEACTIVATED");
			}

			// ---- One SOURCE EVENT starts here. Everything below executes against the DB
			// IMMEDIATELY and in this exact order before the loop moves to the next row. ----

			Savepoint eventSavepoint = conn.setSavepoint();
			// Snapshot of the transaction-local overlay taken before this event writes anything to
			// it. On success the overlay's new entries are kept as-is (discardEventSnapshot). On
			// failure, restoreEvent() undoes exactly this event's overlay writes - restoring each
			// touched key to what it held immediately before this event, and removing keys that had
			// no prior entry - without disturbing any other user's overlay entry left behind by an
			// earlier, already-succeeded event in the same 500-event transaction chunk.
			TransactionContext.EventStateSnapshot txSnapshot = txCtx.beginEvent();

			try {
				// Step 1/2: fold this event into the state buffer (lapview known state for this user).
				// Only reached for re_flag IS NULL events (see gate above), so incomingFlag is null here.
				String previousScopeKeyIfAny = null;
				UserState existing = stateBuffer.get(normalizeKey(userId));
				if (existing != null && existing.userMode != null) {
					previousScopeKeyIfAny = existing.userMode + "::" + existing.scopeKey(existing.userMode);
				}
				UserState updatedState = updateStateBufferFromRow(row, userId, modeKey, incomingFlag);

				// Step 3: determine whether this event can affect ranking (rule #3.3, Case H).
				String userStatus = get(row, "user_status");
				boolean newRowIsRankRelevant = RANKED_STATUSES.contains(userStatus);
				boolean rankingScopeChanged = previousScopeKeyIfAny != null
						&& !previousScopeKeyIfAny.equals(modeKey + "::" + updatedState.scopeKey(modeKey));

				decisionScratch.clear();

				// Ranking only for a NEW bc_organisation (no row in re_user at run start), and never for a
				// row that is migrated as DEACTIVATED because of an invalid region / branch.
				String incomingReUuid = resolveReportingEntityId(incomingFiCode, reLookup);
				boolean newOrg = !isBlank(incomingReUuid) && !orgIdsInTable.contains(normalizeKey(incomingReUuid));
				if (forceDeactivate && updatedState.userMode != null) {
					// A deactivated row must not take a seat in anybody's ranking.
					Set<String> members = scopeMembership.get(updatedState.userMode + "|" + updatedState.scopeKey(updatedState.userMode));
					if (members != null)
						members.remove(normalizeKey(userId));
					updatedState.userMode = null;
				}
				// New org users are ranked ONCE up front over the whole CSV (precomputeNewOrgRanking), so the
				// incremental per-event re-rank below is no longer needed (kept dormant for reference).
				if (INCREMENTAL_RERANK && newOrg && !forceDeactivate
						&& (newRowIsRankRelevant || previousScopeKeyIfAny != null || rankingScopeChanged)) {
					// Step 4/5/6: reconstruct the complete affected population and re-rank it with the
					// exact same V3 rules, then diff+update every changed user (rules #4, #7, #8, #9).
					if (previousScopeKeyIfAny != null && rankingScopeChanged) {
						// User moved scope/mode: re-rank the OLD scope too (it lost a member).
						String[] oldParts = splitScopeMode(previousScopeKeyIfAny);
						reRankScopeAndCollectDecisions(oldParts[0], oldParts[1], decisionScratch, txCtx);
					}
					reRankScopeAndCollectDecisions(modeKey, updatedState.scopeKey(modeKey), decisionScratch, txCtx);
				}

				// Resolve the incoming row's own non-ranking fields (address enrichment, names, etc.)
				// exactly as before, applying this event's RankDecision if one was computed.
				RankDecision ownDecision = decisionScratch.get(normalizeKey(userId));
				if (newOrg && ownDecision == null && !forceDeactivate)
					ownDecision = newOrgDecisionByUserId.get(normalizeKey(userId));
				if (!newOrg || ownDecision == null) {
					// Existing bc_organisation (or a row not ranked): no ranking, only this user is decided
					// by a plain seat check.
					ownDecision = buildSeatDecision(modeKey, updatedState, userStatus, forceDeactivate, txCtx);
				}
				Map<String, String> resolved = resolveRow(row, reLookup, addressLookup, userAddressCsvLookupRef,
						userDetailsLookupRef, report.dtWarn, ownDecision);

				// ---- Event N direct UPDATE - executed immediately (rules #3, #5, #22) ----
				// The statement itself also carries the database-side re_flag guard (see buildUpdateSql).
				// A user that is not in the table goes straight to INSERT (saves a useless UPDATE round trip).
				String auditAction = null; // recorded only once the whole event succeeded
				int directAffected = 0;
				if (existing != null) {
					bindResolvedUpdateRow(ps, resolved, report.dtWarn);
					directAffected = ps.executeUpdate();
				}
				if (directAffected > 0) {
					report.inserted++;
					report.directUpdateSuccess++;
					recordAppliedState(userId, resolved, txCtx, txSnapshot);
					auditAction = "UPDATED";
				} else if (existing == null && insertPsRef != null && !isBlank(resolved.get("reporting_entity_id"))
						&& !isBlank(resolved.get("user_type"))) {
					// The user is not in re_user at all: migrate it as a NEW user (TESTBED or DEACTIVATED as
					// decided above). The event gate already proved re_flag IS NULL for its bc_organisation.
					bindResolvedUpdateRow(insertPsRef, resolved, report.dtWarn);
					int insertedRows = insertPsRef.executeUpdate();
					if (insertedRows > 0) {
						report.newUsersInserted++;
						recordAppliedState(userId, resolved, txCtx, txSnapshot);
						auditAction = "INSERTED (new user_id)";
					} else {
						report.conflictSkipped++;
						report.directUpdateNoMatch++;
						audit.skipped("insert conflict (user_id already exists)", userId);
					}
				} else {
					// 0 rows: no such user_id, or the DB-side re_flag guard refused the write.
					report.conflictSkipped++;
					report.directUpdateNoMatch++;
					audit.skipped(existing == null ? "new user_id but fi_code / reporting entity not resolved"
							: "DB guard refused (re_flag / protected / user_type)", userId);
				}

				// ---- Event N ranking-propagated UPDATE(s) - executed immediately, in decision
				// order, still inside this same event, before the next source event is processed
				// (rules #3, #6, #22, #23). This deliberately excludes the incoming user_id itself
				// (already handled above with the full resolveRow enrichment) to avoid a duplicate,
				// weaker update overwriting the rich one. ----
				for (Map.Entry<String, RankDecision> e : decisionScratch.entrySet()) {
					String affectedUserId = e.getKey();
					if (affectedUserId.equals(normalizeKey(userId)))
						continue;

					UserState affectedState = stateBuffer.get(affectedUserId);
					if (affectedState == null)
						continue;
					// re_flag: a ranking-propagated target must itself be eligible (both its effective
					// and its stored reporting-entity flag). Ineligible users are never written.
					String affectedSkip = reFlagSkipReason(affectedState.reFlag);
					if (affectedSkip == null)
						affectedSkip = reFlagSkipReason(affectedState.dbReFlag);
					if (affectedSkip != null) {
						report.skipAcc.record(affectedSkip + "_RANK_PROPAGATED");
						continue;
					}

					RankDecision decision = e.getValue();
					String baselineStatus = txCtx.effectiveStatus(affectedState);
					String newStatus = decision.statusOverride == null ? baselineStatus : decision.statusOverride;
					String finalStatus = mapFinalStatus(newStatus);
					String baselineUserType = txCtx.effectiveUserType(affectedState);
					boolean changed = !safeEquals(baselineUserType, decision.userType)
							|| !safeEquals(mapFinalStatus(baselineStatus), finalStatus);

					if (!changed)
						continue;

					boolean active = STATUS_TESTBED.equals(finalStatus);
					rankPs.setString(1, decision.userType);
					// Final status is written directly. A demoted user (DEACTIVATED) also gets
					// metadata.previous_status = the status its source code mapped to (e.g. LOCKED).
					rankPs.setString(2, finalStatus);
					rankPs.setBoolean(3, active);
					String prevForDemoted = STATUS_DEACTIVATED.equals(finalStatus)
							? mapOperationalStatus(affectedState.userStatus) : null;
					rankPs.setString(4, decision.userType);
					rankPs.setString(5, decision.userType);
					rankPs.setString(6, prevForDemoted);
					rankPs.setString(7, prevForDemoted);
					rankPs.setString(8, affectedState.userId);
					int rankAffected = rankPs.executeUpdate();

					// Logging/counting only reflects an outcome we actually observed (rule #15):
					// count and log a ranking-propagated update as successful ONLY when its own SQL
					// execution actually affected the target row.
					if (rankAffected > 0) {
						report.rankPropagatedUpdates++;
						report.rankUpdateSuccess++;
						txCtx.recordSuccess(txSnapshot, affectedUserId, decision.userType, finalStatus,
								Boolean.toString(active));
						audit.group("RE-RANKED in new org by login_time (earlier row changed)", affectedState.userId);
						audit.restatus(affectedState.userId, decision.userType, finalStatus,
								"ranked out by login_time (new org)");
					} else {
						report.rankUpdateFailed++;
						report.skipAcc.record("RANK_PROPAGATED_NO_MATCH");
					}
				}

				report.eventsProcessed++;
				if (auditAction != null)
					audit.written(auditAction, userId, resolved);
				// Event succeeded end-to-end: keep every transaction-local overlay write it made.
				txCtx.discardEventSnapshot(txSnapshot);

			} catch (SQLException rowEx) {
				// ---- FAILURE HANDLING (rule #12, Option A: SAVEPOINT per event) ----
				//
				// Roll back ONLY this event's statements. Every earlier event in this chunk that
				// already executed successfully remains intact in the transaction, in its original
				// physical order, because a SAVEPOINT rollback in PostgreSQL undoes work performed
				// since that savepoint without touching anything committed/executed before it.
				//
				// IMPORTANT STATE RULE (rule #13): a failed DB write must NOT be represented as a
				// successful committed change. restoreEvent() undoes exactly this event's
				// transaction-local overlay writes (see TransactionContext.EventStateSnapshot),
				// putting back whatever each touched key held immediately before this event started
				// (or removing the key if it had no prior entry) - WITHOUT clearing the whole
				// overlay, so earlier, already-succeeded events in this same 500-event transaction
				// chunk keep their pending state intact. The in-memory ranking source-state
				// (userMode/userStatus/bcOrganisation/etc. in stateBuffer, updated by
				// updateStateBufferFromRow above) intentionally is NOT rolled back - the parser's
				// existing semantics require later events to keep seeing this row's source fields
				// for ranking-scope reconstruction (rule #13), even though its DB write did not
				// succeed. This mirrors the original implementation's separation between "source
				// event state" and "committed DB state". (Only re_flag-eligible events ever reach
				// this point; re_flag-skipped events never mutate stateBuffer at all.)
				try {
					conn.rollback(eventSavepoint);
				} catch (SQLException spEx) {
					log("ERROR", "Savepoint rollback failed | user_id=" + userId + " | " + spEx.getMessage(), null,
							"SAVEPOINT_ERROR");
				}
				txCtx.restoreEvent(txSnapshot);
				String sqlState = rowEx.getSQLState() == null ? "UNKNOWN" : rowEx.getSQLState();
				String reason = sqlState.startsWith("23") ? "INTEGRITY_CONSTRAINT_" + sqlState : "ROW_ERROR_" + sqlState;
				report.skipAcc.record(reason);
				report.eventsFailed++;
				audit.skipped("DB error " + reason, userId);
				log("WARN", "Event failed and rolled back to its savepoint | user_id=" + userId + " | Reason="
						+ reason + " | SQLState=" + sqlState + " | Detail=" + rowEx.getMessage(), null,
						"EVENT_ERROR");
			} finally {
				try {
					conn.releaseSavepoint(eventSavepoint);
				} catch (SQLException ignored) {
					// Some drivers no-op or disallow release after rollback; safe to ignore.
				}
			}

			eventsInChunk++;

			// ---- Chunk boundary: COMMIT every BATCH_SIZE SOURCE EVENTS (rules #2, #4, #25) ----
			// This is a count of EVENTS, not of direct+ranking statements - an event that produced
			// five ranking-propagated UPDATEs still counts as one event toward this threshold.
			if (eventsInChunk >= BATCH_SIZE) {
				commitChunk(conn, txCtx, report);
				eventsInChunk = 0;
			}
		}

		return eventsInChunk;
	}

	/**
	 * Commits the current chunk transaction and, only once that COMMIT has physically succeeded,
	 * promotes every transaction-local pending state change into the real committed UserState
	 * baseline (rule #10/#11). If COMMIT itself throws, the chunk is rolled back instead and the
	 * pending overlay is discarded - the committed baseline from before this chunk remains
	 * authoritative, and every event in the failed chunk is reported as failed since none of its
	 * writes survived.
	 */
	private void commitChunk(Connection conn, TransactionContext txCtx, EtlReport report) throws SQLException {
		try {
			conn.commit();
			report.batchesExecuted++;
			report.transactionsCommitted++;
			// Remember exactly which users this run really updated (committed). The post-migration
			// step is limited to these user_ids so it never touches the rest of the table.
			touchedUserIds.addAll(txCtx.pendingUserType.keySet());
			touchedUserIds.addAll(txCtx.pendingStatus.keySet());
			txCtx.commitPending(stateBuffer);
		} catch (SQLException commitEx) {
			report.batchesFailed++;
			report.transactionsRolledBack++;
			try {
				conn.rollback();
			} catch (SQLException ignored) {
			}
			txCtx.discard();
			log("ERROR", "Chunk COMMIT failed; chunk rolled back | " + commitEx.getMessage(), null,
					"TRANSACTION_ERROR");
			throw commitEx;
		}
	}

	private String[] splitScopeMode(String modeAndScope) {
		int idx = modeAndScope.indexOf("::");
		return new String[] { modeAndScope.substring(0, idx), modeAndScope.substring(idx + 2) };
	}

	private boolean safeEquals(String a, String b) {
		if (a == null)
			return b == null;
		return a.equals(b);
	}

	/**
	 * Folds one incoming CSV row into the state buffer as the user's lapview known state for
	 * ranking purposes (rule #13). Returns the resulting UserState.
	 *
	 * Callers MUST have already established re_flag eligibility for the event (see the event gate in
	 * processMasterTableSequentially); this method is never invoked for a skipped event, so a skipped
	 * event cannot create or mutate buffer state or scope membership.
	 */
	private UserState updateStateBufferFromRow(Map<String, String> row, String userId, String modeKey, String reFlag) {
		String key = normalizeKey(userId);
		UserState st = stateBuffer.get(key);
		if (st == null) {
			st = new UserState();
			st.userId = userId;
			// Not seeded from the DB (no stored row): there is no stored reporting entity to protect.
			st.dbReFlag = reFlag;
			stateBuffer.put(key, st);
		}

		String userStatus = get(row, "user_status");
		boolean rankEligibleMode = USER_MODE_MAX_COUNT.containsKey(modeKey);
		boolean rankEligibleStatus = RANKED_STATUSES.contains(userStatus);

		// Remove from any previous scope membership set before updating (Case C: became ineligible,
		// or moved scope) - membership sets are re-derived by reRankScopeAndCollectDecisions anyway,
		// but keeping this tidy avoids stale scope entries.
		if (st.userMode != null) {
			String oldMemberKey = st.userMode + "|" + st.scopeKey(st.userMode);
			Set<String> oldMembers = scopeMembership.get(oldMemberKey);
			if (oldMembers != null)
				oldMembers.remove(key);
		}

		st.userMode = (rankEligibleMode && rankEligibleStatus) ? modeKey : null;
		st.userStatus = userStatus;
		st.bcOrganisation = get(row, "bc_organisation");
		st.regionCode = get(row, "region_code");
		st.userBranchId = get(row, "user_branch_id");
		st.loginTime = get(row, "login_time");
		st.reFlag = reFlag;
		if (st.reFlag != null) st.userMode = null;

		if (st.userMode != null) {
			String newMemberKey = st.userMode + "|" + st.scopeKey(st.userMode);
			Set<String> newMembers = scopeMembership.get(newMemberKey);
			if (newMembers == null) {
				newMembers = new HashSet<String>();
				scopeMembership.put(newMemberKey, newMembers);
			}
			newMembers.add(key);
		}

		return st;
	}

	/**
	 * Ranks the CSV users of every NEW bc_organisation (no row in the table at run start, re_flag NULL)
	 * once, over the whole file: per mode + scope, login_time descending (user_id ascending on ties).
	 * IA: 1st -> IAU_1, 2nd -> IAU_2, rest IA DEACTIVATED; IU 3, IRA 2, IRU 3, IBU 3 seats, rest DEACTIVATED.
	 * Only users not yet in the table, with a testbed status (1,2,4,6,7,12,20) and a valid region/branch
	 * take part. Decisions are final, so no earlier row ever has to be re-written.
	 */
	private void precomputeNewOrgRanking(List<CsvTable> masterTables, Map<String, String> reLookup,
			Map<String, String> regionLookup, Map<String, String> branchLookup) {
		newOrgDecisionByUserId.clear();
		Map<String, List<Map<String, String>>> byScope = new LinkedHashMap<String, List<Map<String, String>>>();
		Set<String> seen = new HashSet<String>();
		for (CsvTable t : masterTables) {
			for (Map<String, String> row : t.rows) {
				String userId = get(row, "user_id");
				if (isBlank(userId) || !seen.add(normalizeKey(userId)) || stateBuffer.containsKey(normalizeKey(userId)))
					continue;
				String modeKey = get(row, "user_mode").toUpperCase();
				if (!USER_MODE_MAX_COUNT.containsKey(modeKey) || !RANKED_STATUSES.contains(get(row, "user_status")))
					continue;
				String fi = get(row, "bc_organisation");
				if (reFlagSkipReason(lookupReFlag(fi)) != null)
					continue;
				String reId = resolveReportingEntityId(fi, reLookup);
				if (isBlank(reId) || orgIdsInTable.contains(normalizeKey(reId)))
					continue;
				if (!passesRegionBranchValidation(modeKey, row, regionLookup, branchLookup))
					continue;
				String key = modeKey + "|" + buildScopeKey(modeKey, row);
				List<Map<String, String>> list = byScope.get(key);
				if (list == null) {
					list = new ArrayList<Map<String, String>>();
					byScope.put(key, list);
				}
				list.add(row);
			}
		}
		for (Map.Entry<String, List<Map<String, String>>> e : byScope.entrySet()) {
			String modeKey = e.getKey().substring(0, e.getKey().indexOf('|'));
			List<Map<String, String>> rows = e.getValue();
			Collections.sort(rows, new Comparator<Map<String, String>>() {
				@Override
				public int compare(Map<String, String> a, Map<String, String> b) {
					String la = get(a, "login_time");
					String lb = get(b, "login_time");
					if (isBlank(la) && isBlank(lb))
						return get(a, "user_id").compareTo(get(b, "user_id"));
					if (isBlank(la))
						return 1;
					if (isBlank(lb))
						return -1;
					int cmp = lb.compareTo(la);
					return cmp != 0 ? cmp : get(a, "user_id").compareTo(get(b, "user_id"));
				}
			});
			int max = USER_MODE_MAX_COUNT.get(modeKey).intValue();
			for (int i = 0; i < rows.size(); i++) {
				RankDecision d;
				if ("IA".equals(modeKey))
					d = i == 0 ? new RankDecision("IAU_1", STATUS_TESTBED)
							: i == 1 ? new RankDecision("IAU_2", STATUS_TESTBED)
									: new RankDecision("IA", STATUS_MIGRATION_IN_ACTIVE, "ranked out by login_time (new org)");
				else
					d = i < max ? new RankDecision(modeKey, STATUS_TESTBED)
							: new RankDecision(modeKey, STATUS_MIGRATION_IN_ACTIVE, "ranked out by login_time (new org)");
				newOrgDecisionByUserId.put(normalizeKey(get(rows.get(i), "user_id")), d);
			}
		}
		log("INFO", "New-org ranking precomputed | scopes=" + byScope.size() + " | users=" + newOrgDecisionByUserId.size(),
				null, "RANKING");
	}

	/**
	 * Replacement for ranking: decides ONLY the incoming user, nobody else is re-ranked or touched.
	 *   - status not in 1,2,4,6,7,12,20          -> no seat needed (resolveRow deactivates it)
	 *   - invalid region / branch                -> DEACTIVATED (MIGRATION_IN_ACTIVE collapses to it)
	 *   - user already holds TESTBED             -> keeps its seat
	 *   - seats of this mode + scope already full (IA 2, IU 3, IRA 2, IRU 3, IBU 3, counted over OTHER
	 *     users that are currently TESTBED and re_flag IS NULL) -> DEACTIVATED, no re-ranking
	 *   - otherwise                              -> TESTBED
	 * The stored user_type is kept as is (falls back to the mode for a user without one).
	 */
	private RankDecision buildSeatDecision(String modeKey, UserState st, String rawStatus, boolean forceDeactivate,
			TransactionContext txCtx) {
		String keptType = txCtx.effectiveUserType(st);
		if (isBlank(keptType))
			keptType = modeKey;

		if (forceDeactivate)
			return new RankDecision(keptType, STATUS_MIGRATION_IN_ACTIVE, "invalid region/branch");
		if (!RANKED_STATUSES.contains(rawStatus == null ? "" : rawStatus.trim()))
			return new RankDecision(keptType, null);
		if (STATUS_TESTBED.equals(txCtx.effectiveStatus(st)))
			return new RankDecision(keptType, STATUS_TESTBED);

		Integer max = USER_MODE_MAX_COUNT.get(modeKey);
		Set<String> members = scopeMembership.get(modeKey + "|" + st.scopeKey(modeKey));
		int taken = 0;
		if (members != null) {
			String self = normalizeKey(st.userId);
			for (String id : members) {
				if (id.equals(self))
					continue;
				UserState other = stateBuffer.get(id);
				if (other != null && other.reFlag == null && other.dbReFlag == null
						&& (STATUS_TESTBED.equals(txCtx.effectiveStatus(other)) || other.hasDsc))
					taken++;
			}
		}
		if (max != null && taken >= max.intValue())
			return new RankDecision(keptType, STATUS_MIGRATION_IN_ACTIVE,
					"seats full (" + modeKey + " max " + max + ") in existing org");

		// A free IA seat is an IAU seat: IAU_1 unless another member already holds it, else IAU_2.
		if ("IA".equals(modeKey) && !(keptType.startsWith("IAU"))) {
			boolean iau1Taken = false;
			if (members != null) {
				String self = normalizeKey(st.userId);
				for (String id : members) {
					if (id.equals(self))
						continue;
					UserState other = stateBuffer.get(id);
					if (other != null && "IAU_1".equals(txCtx.effectiveUserType(other)))
						iau1Taken = true;
				}
			}
			keptType = iau1Taken ? "IAU_2" : "IAU_1";
		}
		return new RankDecision(keptType, STATUS_TESTBED);
	}

	/**
	 * Rebuilds the COMPLETE current ranking population for (modeKey, scopeKey) from the state
	 * buffer (which already reflects DB seed state + all earlier incremental events + this event),
	 * runs the exact same V3 ranking rules (same comparator, same cutoffs), and records a
	 * RankDecision for every member - regardless of whether that member changed - into
	 * decisionsOut, keyed by normalized user_id. Callers diff against the transaction-local
	 * effective baseline (txCtx.effectiveUserType/effectiveStatus, falling back to
	 * currentUserType/currentStatus) to decide which members actually need a DB write (rule #14).
	 *
	 * Reuses the instance-level rankMembersScratch list (cleared, not reallocated) per rule #20.A.
	 */
	private void reRankScopeAndCollectDecisions(String modeKey, String scopeKey,
			Map<String, RankDecision> decisionsOut, TransactionContext txCtx) {
		String memberKey = modeKey + "|" + scopeKey;
		Set<String> memberIds = scopeMembership.get(memberKey);
		if (memberIds == null || memberIds.isEmpty())
			return;

		rankMembersScratch.clear();
		for (String id : memberIds) {
			UserState st = stateBuffer.get(id);
			// re_flag: only users with re_flag IS NULL (effective and stored) may take part in ranking,
			// so flagged / unexpected / unresolved users never influence others' ranks.
			if (st != null && st.reFlag == null && st.dbReFlag == null && modeKey.equals(st.userMode))
				rankMembersScratch.add(st);
		}
		if (rankMembersScratch.isEmpty())
			return;

		// Same comparator as V3/buildRankDecisions: login_time descending, user_id ascending tie-break.
		Collections.sort(rankMembersScratch, new Comparator<UserState>() {
			@Override
			public int compare(UserState a, UserState b) {
				String la = a.loginTime;
				String lb = b.loginTime;
				if (isBlank(la) && isBlank(lb))
					return a.userId.compareTo(b.userId);
				if (isBlank(la))
					return 1;
				if (isBlank(lb))
					return -1;
				int cmp = lb.compareTo(la);
				if (cmp != 0)
					return cmp;
				return a.userId.compareTo(b.userId);
			}
		});

		int maxCount = USER_MODE_MAX_COUNT.get(modeKey).intValue();

		for (int i = 0; i < rankMembersScratch.size(); i++) {
			UserState st = rankMembersScratch.get(i);
			RankDecision decision;
			if ("IA".equals(modeKey)) {
				if (i == 0) {
					decision = new RankDecision("IAU_1", STATUS_TESTBED);
				} else if (i == 1) {
					decision = new RankDecision("IAU_2", STATUS_TESTBED);
				} else {
					decision = new RankDecision("IA", STATUS_MIGRATION_IN_ACTIVE);
				}
			} else {
				if (i < maxCount) {
					decision = new RankDecision(modeKey, STATUS_TESTBED);
				} else {
					decision = new RankDecision(modeKey, STATUS_MIGRATION_IN_ACTIVE);
				}
			}
			decisionsOut.put(normalizeKey(st.userId), decision);
		}
	}

	/**
	 * Seeds the ranking state buffer from re_user_bkp_1710_v3_copy's current rows (rule #13: "current DB
	 * state"). Because this table has no top-level bc_organisation/region_code/user_branch_id/
	 * login_time columns, those fields are read back out of the row's metadata jsonb - the same
	 * flat key/value structure buildMetadataJson()/addAllMetadata() populate from the original
	 * source row. user_mode is likewise read from metadata (it is the raw source field; V3/UPDATE
	 * never persist a separate "user_mode" column, only the derived user_type).
	 *
	 * AMBIGUITY (flagged per rule #21.6): any existing DB row whose metadata is missing user_mode,
	 * bc_organisation, or login_time cannot be placed into a ranking scope at all and is excluded
	 * from ranking population reconstruction - logged as a warning. There is no other source for
	 * these fields in the supplied schema.
	 *
	 * re_flag: each stored user's flag comes from its actual reporting_entity_id relationship. A user
	 * with NULL / dangling reporting_entity_id gets RE_FLAG_UNKNOWN (fail closed).
	 */
	private void seedStateBufferFromDb(EtlReport report) {
		String sql = "SELECT u.user_id, u.user_type, u.status, u.active, u.metadata, u.reporting_entity_id, "
				+ "u.dsc_id, u.key_cloak_user_id, re.id AS matched_re_id, re.re_flag "
				+ "FROM re_mgmt.re_user_bkp_1710 u LEFT JOIN re_mgmt.reporting_entity_pview_bkp_1610 re ON re.id = u.reporting_entity_id";
		Connection conn = null;
		PreparedStatement ps = null;
		ResultSet rs = null;
		int skippedNoScope = 0;

		try {
			conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
			conn.setAutoCommit(false); // lets the driver stream the whole table in chunks (fetch size)
			ps = conn.prepareStatement(sql);
			ps.setFetchSize(5000);
			rs = ps.executeQuery();

			while (rs.next()) {
				String userId = rs.getString("user_id");
				if (isBlank(userId))
					continue;

				Map<String, String> meta = new LinkedHashMap<String, String>();
				String metaJson = rs.getString("metadata");
				if (!isBlank(metaJson))
					parseFlatJsonObject(metaJson.trim(), meta);

				String seededReId = rs.getString("reporting_entity_id");
				if (!isBlank(seededReId))
					orgIdsInTable.add(normalizeKey(seededReId));

				UserState st = new UserState();
				st.userId = userId;
				st.currentUserType = rs.getString("user_type");
				st.currentStatus = rs.getString("status");
				st.protectedRecord = (rs.getString("dsc_id") != null && rs.getString("key_cloak_user_id") != null)
						|| isProtectedStatus(st.currentStatus);
				st.reFlag = rs.getString("matched_re_id") == null ? RE_FLAG_UNKNOWN : rs.getString("re_flag");
				st.dbReFlag = st.reFlag;
				boolean activeVal = rs.getBoolean("active");
				st.currentActive = rs.wasNull() ? null : Boolean.toString(activeVal);

				String userMode = meta.get("user_mode");
				String bcOrg = meta.get("bc_organisation");
				String userStatus = meta.get("user_status");
				String loginTime = meta.get("login_time");

				String storedType = st.currentUserType == null ? "" : st.currentUserType.trim().toUpperCase();
				String modeKey = isBlank(userMode) ? null : userMode.trim().toUpperCase();
				// Rows without ranking metadata: derive mode from user_type and fi_code from reporting_entity_id
				if (modeKey == null && IN_SCOPE_USER_TYPES.contains(storedType))
					modeKey = storedType.startsWith("IAU") ? "IA" : storedType;
				if (isBlank(bcOrg) && !isBlank(rs.getString("reporting_entity_id")))
					bcOrg = fiCodeByReId.get(normalizeKey(rs.getString("reporting_entity_id")));
				st.hasDsc = rs.getString("dsc_id") != null;
				// A stored TESTBED / DSC-configured row of a handled type occupies a seat of its scope.
				boolean seatHolder = IN_SCOPE_USER_TYPES.contains(storedType)
						&& (STATUS_TESTBED.equalsIgnoreCase(st.currentStatus == null ? "" : st.currentStatus.trim()) || st.hasDsc);
				boolean rankEligibleMode = modeKey != null && USER_MODE_MAX_COUNT.containsKey(modeKey);
				boolean rankEligibleStatus = seatHolder
						|| (!isBlank(userStatus) && RANKED_STATUSES.contains(userStatus.trim()));

				if ((st.protectedRecord && !seatHolder) || st.reFlag != null || !rankEligibleMode || !rankEligibleStatus
						|| isBlank(bcOrg)) {
					// Not currently rank-eligible (or insufficient metadata to place it in a scope, or its
					// reporting entity is flagged/unresolved) - still buffer its known current state so a
					// future event that touches this user_id starts from the right baseline (and so the
					// event gate can see its stored re_flag), but do not add it to any scope membership set.
					st.userMode = null;
					stateBuffer.put(normalizeKey(userId), st);
					if (st.reFlag == null && rankEligibleMode && rankEligibleStatus && isBlank(bcOrg))
						skippedNoScope++;
					continue;
				}

				st.userMode = modeKey;
				st.userStatus = isBlank(userStatus) ? "" : userStatus.trim();
				st.bcOrganisation = bcOrg;
				st.regionCode = meta.get("region_code");
				st.userBranchId = meta.get("user_branch_id");
				st.loginTime = loginTime;

				stateBuffer.put(normalizeKey(userId), st);

				String memberKey = modeKey + "|" + st.scopeKey(modeKey);
				Set<String> members = scopeMembership.get(memberKey);
				if (members == null) {
					members = new HashSet<String>();
					scopeMembership.put(memberKey, members);
				}
				members.add(normalizeKey(userId));
			}
		} catch (Exception e) {
			log("WARN", "Ranking state buffer seed failed: " + e.getMessage(), null, "LOOKUP_LOAD");
		} finally {
			closeQuietly(rs);
			closeQuietly(ps);
			closeQuietly(conn);
		}

		if (skippedNoScope > 0) {
			log("WARN", "DB rows rank-eligible by status but missing bc_organisation/user_mode/login_time in "
					+ "metadata (cannot reconstruct ranking scope) | Count=" + skippedNoScope, null,
					"RANK_SEED_INCOMPLETE");
		}
	}

	/**
	 * After a successful direct row UPDATE, records this user's just-applied user_type/status/
	 * active into the TRANSACTION-LOCAL overlay (NOT directly into UserState.current*), per rule
	 * #10/#11: the write has executed but the enclosing chunk has not yet COMMITted, so it is not
	 * yet safe to call it "committed". commitChunk() promotes this into the real committed baseline
	 * once COMMIT actually succeeds. The passed-in snapshot lets this write be undone in isolation
	 * (via TransactionContext.restoreEvent()) if a later statement within the SAME event fails.
	 */
	private void recordAppliedState(String userId, Map<String, String> resolved, TransactionContext txCtx,
			TransactionContext.EventStateSnapshot txSnapshot) {
		UserState st = stateBuffer.get(normalizeKey(userId));
		if (st == null)
			return;
		String userType = resolved.containsKey("user_type") ? resolved.get("user_type") : st.currentUserType;
		String status = resolved.get("status");
		if (status == null)
			status = txCtx.effectiveStatus(st);
		String active = resolved.get("active");
		if (active == null)
			active = txCtx.effectiveActive(st);
		txCtx.recordSuccess(txSnapshot, normalizeKey(userId), userType, status, active);
	}

	/**
	 * POST-MIGRATION STATUS UPDATE STEP.
	 *
	 * Runs after the full migration/update phase completes. For every ELIGIBLE row whose
	 * user_type is IA / IU / IRA / IRU / IBU (re_flag IS NULL and the user-mutation guard are
	 * re-checked in the UPDATE itself):
	 *   - metadata.previous_status = current (raw) status
	 *   - status = DEACTIVATED
	 * but only for rows still holding a status in STATUSES_TO_DEACTIVATE (DELETED, REJECTED,
	 * ACTIVATION_PENDING, ACTIVATION_REJECTED, DELETION_PENDING, IN_ACTIVE, MIGRATION_IN_ACTIVE).
	 * TESTBED and DEACTIVATED rows are untouched, so previous_status is never overwritten twice.
	 */
	private boolean applyPostMigrationStatusUpdate() {
		log("INFO", "========================================", null, "STATUS_UPDATE_START");
		log("INFO", "POST-MIGRATION STATUS UPDATE STARTING", null, "STATUS_UPDATE_START");
		log("INFO", "========================================", null, "STATUS_UPDATE_START");

		StringBuilder inList = new StringBuilder();
		for (String s : STATUSES_TO_DEACTIVATE) {
			if (inList.length() > 0)
				inList.append(",");
			inList.append("'").append(s).append("'");
		}

		// re_user_bkp_1710 has no previous_status column: the old status goes into metadata first
		// (key previous_status; a V3 'previousStatus' value is reused when present), then status is
		// collapsed to DEACTIVATED. Rows that already carry metadata.previous_status (set by the
		// event path) are left alone so the value is never overwritten.
		String sql = "UPDATE re_mgmt.re_user_bkp_1710 u SET metadata = COALESCE(u.metadata, '{}'::jsonb) "
				+ "|| jsonb_build_object('previous_status', COALESCE(u.metadata->>'previousStatus', u.status)), "
				+ "status = '" + STATUS_DEACTIVATED + "' "
				+ "WHERE u.user_type IN ('IA','IU','IRA','IRU','IBU') AND u.status IN (" + inList + ") AND "
				+ "(u.metadata IS NULL OR u.metadata->>'previous_status' IS NULL) AND "
				+ "lower(u.user_id) = ANY (?) AND "
				+ RE_FLAG_ELIGIBLE_GUARD + " AND " + USER_MUTATION_GUARD;

		// Only the users this run actually updated - never the whole table (other users exist).
		if (touchedUserIds.isEmpty()) {
			log("INFO", "Rows status-updated: 0 (no user was updated in this run)", null, "STATUS_UPDATE_SUMMARY");
			return true;
		}

		int updated = 0;
		try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
				PreparedStatement ps = conn.prepareStatement(sql)) {
			conn.setAutoCommit(false);
			List<String> ids = new ArrayList<String>(touchedUserIds);
			for (int from = 0; from < ids.size(); from += 5000) {
				List<String> part = ids.subList(from, Math.min(ids.size(), from + 5000));
				ps.setArray(1, conn.createArrayOf("varchar", part.toArray(new String[0])));
				updated += ps.executeUpdate();
			}
			conn.commit();
		} catch (Exception e) {
			log("ERROR", "Post-migration status update failed: " + e.getMessage(), null, "STATUS_UPDATE_ERROR");
			return false;
		}

		log("INFO", "Rows status-updated: " + updated, null, "STATUS_UPDATE_SUMMARY");
		log("INFO", "========================================", null, "STATUS_UPDATE_END");
		log("INFO", "POST-MIGRATION STATUS UPDATE COMPLETED", null, "STATUS_UPDATE_END");
		log("INFO", "========================================", null, "STATUS_UPDATE_END");
		return true;
	}

	/**
	 * Splits executeBatch() results into {applied, blocked}. SUCCESS_NO_INFO is treated as applied
	 * (the driver cannot tell); 0 means the WHERE / re_flag guard matched nothing.
	 */
	private int[] countBatchResults(int[] results) {
		int applied = 0;
		int blocked = 0;
		if (results == null)
			return new int[] { 0, 0 };
		for (int r : results) {
			if (r == 0)
				blocked++;
			else
				applied++;
		}
		return new int[] { applied, blocked };
	}

	/**
	 * Post-migration duplicate email/mobile correction. Business rules unchanged. Only users whose
	 * reporting entity has re_flag IS NULL are loaded (so flagged users cannot influence the eligible
	 * population's decisions, nor consume values from the sequential mobile generator), and the final
	 * UPDATE re-verifies eligibility in the database. Its transaction semantics remain fully
	 * independent from master-event processing (rule #19).
	 */
	public boolean correctDuplicateEmailMobile() {
		log("INFO", "========================================", null, "DEDUP_START");
		log("INFO", "POST-MIGRATION DUPLICATE EMAIL/MOBILE CORRECTION STARTING", null, "DEDUP_START");
		log("INFO", "========================================", null, "DEDUP_START");

		String selectSql = "SELECT u.user_id, u.user_type, u.reporting_entity_id, u.email, u.mobile, u.mobile_number, u.mobile_no "
				+ "FROM re_mgmt.re_user_bkp_1710 u WHERE u.user_type IN ('NO','IAU_1','IAU_2') AND "
				+ RE_FLAG_ELIGIBLE_GUARD + " AND " + USER_MUTATION_GUARD;

		Map<String, List<Map<String, String>>> reGroups = new LinkedHashMap<String, List<Map<String, String>>>();

		try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
				PreparedStatement ps = conn.prepareStatement(selectSql);
				ResultSet rs = ps.executeQuery()) {

			while (rs.next()) {
				String reId = rs.getString("reporting_entity_id");
				if (isBlank(reId))
					continue;
				String key = normalizeKey(reId);

				Map<String, String> record = new HashMap<String, String>();
				record.put("user_id", rs.getString("user_id"));
				record.put("user_type", rs.getString("user_type"));
				record.put("email", rs.getString("email"));
				record.put("mobile", rs.getString("mobile"));
				record.put("mobile_number", rs.getString("mobile_number"));
				record.put("mobile_no", rs.getString("mobile_no"));

				List<Map<String, String>> list = reGroups.get(key);
				if (list == null) {
					list = new ArrayList<Map<String, String>>();
					reGroups.put(key, list);
				}
				list.add(record);
			}
		} catch (Exception e) {
			log("ERROR", "Failed to load users for duplicate correction: " + e.getMessage(), null, "DEDUP_ERROR");
			return false;
		}

		String updateSql = "UPDATE re_mgmt.re_user_bkp_1710 u SET email = ?, mobile = ?, mobile_number = ?, mobile_no = ? "
				+ "WHERE u.user_id = ? AND " + RE_FLAG_ELIGIBLE_GUARD + " AND " + USER_MUTATION_GUARD;

		int emailCorrected = 0;
		int mobileCorrected = 0;
		int guardBlockedCount = 0;
		long nextMobile = 6000001111L;

		try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass)) {
			conn.setAutoCommit(false);

			try (PreparedStatement ps = conn.prepareStatement(updateSql)) {

				for (Map.Entry<String, List<Map<String, String>>> reEntry : reGroups.entrySet()) {
					List<Map<String, String>> members = reEntry.getValue();

					Map<String, String> noUser = null;
					List<Map<String, String>> iauUsers = new ArrayList<Map<String, String>>();
					for (Map<String, String> m : members) {
						String userType = m.get("user_type");
						if ("NO".equals(userType)) {
							noUser = m;
						} else if ("IAU_1".equals(userType) || "IAU_2".equals(userType)) {
							iauUsers.add(m);
						}
					}

					if (iauUsers.isEmpty())
						continue;

					String noEmail = noUser == null ? null : noUser.get("email");
					String noMobile = noUser == null ? null : effectiveMobile(noUser);

					Map<String, String> pendingEmail = new HashMap<String, String>();
					Map<String, String> pendingMobile = new HashMap<String, String>();

					for (Map<String, String> iau : iauUsers) {
						String userType = iau.get("user_type");
						String iauUserId = iau.get("user_id");
						String iauEmail = iau.get("email");

						if (!isBlank(noEmail) && !isBlank(iauEmail)
								&& effectiveEmail(noEmail).equals(effectiveEmail(iauEmail))) {
							pendingEmail.put(iauUserId, userType + "." + iauEmail.trim());
						}
					}

					for (Map<String, String> iau : iauUsers) {
						String iauUserId = iau.get("user_id");
						String iauMobile = effectiveMobile(iau);

						if (!isBlank(noMobile) && !isBlank(iauMobile) && noMobile.equals(iauMobile)) {
							pendingMobile.put(iauUserId, String.valueOf(nextMobile));
							nextMobile++;
						}
					}

					if (iauUsers.size() >= 2) {
						for (int i = 0; i < iauUsers.size(); i++) {
							for (int j = i + 1; j < iauUsers.size(); j++) {
								Map<String, String> a = iauUsers.get(i);
								Map<String, String> b = iauUsers.get(j);

								String aUserId = a.get("user_id");
								String bUserId = b.get("user_id");
								String aEmail = a.get("email");
								String bEmail = b.get("email");
								String aMobile = effectiveMobile(a);
								String bMobile = effectiveMobile(b);

								boolean emailDup = !isBlank(aEmail) && !isBlank(bEmail)
										&& effectiveEmail(aEmail).equals(effectiveEmail(bEmail));
								boolean mobileDup = !isBlank(aMobile) && !isBlank(bMobile) && aMobile.equals(bMobile);

								if (emailDup) {
									if (!pendingEmail.containsKey(aUserId))
										pendingEmail.put(aUserId, a.get("user_type") + "." + aEmail.trim());
									if (!pendingEmail.containsKey(bUserId))
										pendingEmail.put(bUserId, b.get("user_type") + "." + bEmail.trim());

									if (!pendingMobile.containsKey(aUserId)) {
										pendingMobile.put(aUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
									if (!pendingMobile.containsKey(bUserId)) {
										pendingMobile.put(bUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
								} else if (mobileDup) {
									if (!pendingMobile.containsKey(aUserId)) {
										pendingMobile.put(aUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
									if (!pendingMobile.containsKey(bUserId)) {
										pendingMobile.put(bUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
								}
							}
						}
					}

					for (Map<String, String> iau : iauUsers) {
						String userType = iau.get("user_type");
						String iauUserId = iau.get("user_id");

						String newEmail = pendingEmail.containsKey(iauUserId) ? pendingEmail.get(iauUserId)
								: iau.get("email");
						String newMobileVal = pendingMobile.containsKey(iauUserId) ? pendingMobile.get(iauUserId)
								: effectiveMobile(iau);

						boolean changed = pendingEmail.containsKey(iauUserId) || pendingMobile.containsKey(iauUserId);
						if (!changed)
							continue;

						ps.setString(1, newEmail);
						ps.setString(2, newMobileVal);
						ps.setString(3, newMobileVal);
						ps.setString(4, newMobileVal);
						ps.setString(5, iauUserId);
						ps.addBatch();

						if (pendingEmail.containsKey(iauUserId))
							emailCorrected++;
						if (pendingMobile.containsKey(iauUserId))
							mobileCorrected++;

						audit.group("DEDUP - email/mobile made unique (" + userType + ")", iauUserId);
					}
				}

				int[] res = ps.executeBatch();
				conn.commit();
				guardBlockedCount += countBatchResults(res)[1];
			}
		} catch (Exception e) {
			log("ERROR", "Failed to apply duplicate correction: " + e.getMessage(), null, "DEDUP_ERROR");
			return false;
		}

		if (guardBlockedCount > 0) {
			log("WARN", "Duplicate-correction rows refused by re_flag guard: " + guardBlockedCount, null,
					"RE_FLAG_GUARD_BLOCKED");
		}
		log("INFO", "Emails corrected: " + emailCorrected, null, "DEDUP_SUMMARY");
		log("INFO", "Mobiles corrected: " + mobileCorrected, null, "DEDUP_SUMMARY");
		log("INFO", "========================================", null, "DEDUP_END");
		log("INFO", "DUPLICATE EMAIL/MOBILE CORRECTION COMPLETED", null, "DEDUP_END");
		log("INFO", "========================================", null, "DEDUP_END");
		return true;
	}

	private String effectiveEmail(String email) {
		if (isBlank(email))
			return "";
		return email.trim().toLowerCase();
	}

	private String effectiveMobile(Map<String, String> record) {
		if (record == null)
			return null;
		return firstNonBlank(record.get("mobile"), record.get("mobile_number"), record.get("mobile_no"));
	}

	private String mapFinalStatus(String status) {
		if (isBlank(status))
			return status;
		String s = status.trim();
		if (STATUSES_TO_DEACTIVATE.contains(s))
			return STATUS_DEACTIVATED;
		if (STATUS_TESTBED.equals(s))
			return STATUS_TESTBED;
		if (STATUS_DEACTIVATED.equals(s))
			return STATUS_DEACTIVATED;
		return s;
	}

	private boolean isProtectedStatus(String status) {
		return status != null && ("ACTIVE".equalsIgnoreCase(status.trim())
				|| "SUSPENDED_BY_SYSTEM".equalsIgnoreCase(status.trim()));
	}

	private void parseFlatJsonObject(String json, Map<String, String> out) {
		String body = json.trim();
		if (body.length() >= 2 && body.charAt(0) == '{' && body.charAt(body.length() - 1) == '}') {
			body = body.substring(1, body.length() - 1);
		}
		int i = 0;
		int len = body.length();
		while (i < len) {
			while (i < len && (body.charAt(i) == ',' || Character.isWhitespace(body.charAt(i))))
				i++;
			if (i >= len)
				break;
			if (body.charAt(i) != '"')
				break;
			StringBuilder key = new StringBuilder();
			i++;
			while (i < len && body.charAt(i) != '"') {
				if (body.charAt(i) == '\\' && i + 1 < len) {
					key.append(unescapeJsonChar(body.charAt(i + 1)));
					i += 2;
				} else {
					key.append(body.charAt(i));
					i++;
				}
			}
			i++; // closing quote
			while (i < len && (body.charAt(i) == ':' || Character.isWhitespace(body.charAt(i))))
				i++;
			if (i < len && body.charAt(i) == 'n' && body.startsWith("null", i)) {
				out.put(key.toString(), null);
				i += 4;
				continue;
			}
			if (i >= len || body.charAt(i) != '"') {
				int depth = 0;
				while (i < len && !(body.charAt(i) == ',' && depth == 0)) {
					if (body.charAt(i) == '{' || body.charAt(i) == '[')
						depth++;
					if (body.charAt(i) == '}' || body.charAt(i) == ']')
						depth--;
					i++;
				}
				continue;
			}
			StringBuilder val = new StringBuilder();
			i++;
			while (i < len && body.charAt(i) != '"') {
				if (body.charAt(i) == '\\' && i + 1 < len) {
					val.append(unescapeJsonChar(body.charAt(i + 1)));
					i += 2;
				} else {
					val.append(body.charAt(i));
					i++;
				}
			}
			i++; // closing quote
			out.put(key.toString(), val.toString());
		}
	}

	private char unescapeJsonChar(char escaped) {
		switch (escaped) {
		case 'r':
			return '\r';
		case 'n':
			return '\n';
		case '"':
			return '"';
		case '\\':
			return '\\';
		default:
			return escaped;
		}
	}

	/**
	 * Builds the scope key used to group rows for ranking, per role:
	 *   IA / IAU / IU : fiCode (bc_organisation)
	 *   IRA / IRU     : fiCode (bc_organisation) + regionCode (region_code)
	 *   IBU           : fiCode (bc_organisation) + regionCode (region_code) + branchCode (user_branch_id)
	 * (V3 source-of-truth rule, unchanged.)
	 */
	private String buildScopeKey(String modeKey, Map<String, String> row) {
		return buildScopeKeyStatic(modeKey, get(row, "bc_organisation"), get(row, "region_code"),
				get(row, "user_branch_id"));
	}

	static String buildScopeKeyStatic(String modeKey, String bcOrganisation, String regionCode, String userBranchId) {
		String fiCode = normalizeKeyStatic(bcOrganisation);

		if ("IRA".equals(modeKey) || "IRU".equals(modeKey)) {
			return fiCode + "|" + normalizeKeyStatic(regionCode);
		}
		if ("IBU".equals(modeKey)) {
			return fiCode + "|" + normalizeKeyStatic(regionCode) + "|" + normalizeKeyStatic(userBranchId);
		}
		return fiCode;
	}

	private static String normalizeKeyStatic(String key) {
		if (key == null)
			return "";
		return key.trim().toLowerCase();
	}

	/**
	 * Rule #4 pre-validation: IRA/IRU require a valid region_code in re_mgmt.region_pview_bkp_1610.
	 * IBU additionally requires a valid user_branch_id in re_mgmt.branch_pview_bkp_1610 (scoped to
	 * that region). IA/IU are not subject to this check and always pass.
	 */
	private boolean passesRegionBranchValidation(String modeKey, Map<String, String> row,
			Map<String, String> regionLookup, Map<String, String> branchLookup) {
		if (!"IRA".equals(modeKey) && !"IRU".equals(modeKey) && !"IBU".equals(modeKey)) {
			return true;
		}

		String fiCode = get(row, "bc_organisation");
		String regionCode = get(row, "region_code");
		if (isBlank(fiCode) || isBlank(regionCode)) {
			return false;
		}

		// region_code is only unique WITHIN an FI, not globally, so the lookup key must be
		// scoped by fiCode (matches buildScopeKey's IRA/IRU/IBU scoping).
		String regionKey = normalizeKey(fiCode) + "|" + normalizeKey(regionCode);
		if (regionLookup == null || !regionLookup.containsKey(regionKey)) {
			return false;
		}

		if (!"IBU".equals(modeKey)) {
			return true;
		}

		String branchCode = get(row, "user_branch_id");
		if (isBlank(branchCode)) {
			return false;
		}

		// branch_code is likewise only unique within a region/FI, so scope by fiCode+regionCode.
		String branchKey = normalizeKey(fiCode) + "|" + normalizeKey(regionCode) + "|" + normalizeKey(branchCode);
		if (branchLookup == null || !branchLookup.containsKey(branchKey)) {
			return false;
		}

		// Ensure the branch actually belongs to the validated region (region_code match).
		String branchRegionCode = branchLookup.get(branchKey);
		return normalizeKey(regionCode).equals(branchRegionCode);
	}

	private Map<String, String> resolveRow(Map<String, String> row, Map<String, String> reLookup,
			Map<String, Map<String, String>> addressLookup, Map<String, Map<String, String>> userAddressCsvLookup,
			Map<String, Map<String, String>> userDetailsLookup, DatatypeWarnAccumulator warns,
			RankDecision rankDecision) {
		String userId = get(row, "user_id");
		String bcOrg = get(row, "bc_organisation");
		String userMode = get(row, "user_mode");
		String rawStatus = get(row, "user_status");

		Map<String, String> addressMetadata = lookupRowByUserId(addressLookup, userId);
		Map<String, String> addressCsvRow = lookupRowByUserId(userAddressCsvLookup, userId);
		Map<String, String> detailsRow = lookupRowByUserId(userDetailsLookup, userId);

		String mappedType;
		if (rankDecision != null) {
			mappedType = rankDecision.userType;
		} else {
			mappedType = mapUserType(userMode, bcOrg, rawStatus);
		}

		// Status (final rules):
		//   - source codes 1,2,4,6,7,12,20 are the testbed statuses -> TESTBED / active, unless the seats
		//     are already taken (or region/branch invalid) -> DEACTIVATED (see buildSeatDecision)
		//   - every other code (0,3,8,13,14,15 ...) -> DEACTIVATED
		// Before a row is deactivated, the status it came with (code mapped via mapOperationalStatus,
		// e.g. 4 -> LOCKED) is put into metadata.previous_status. No status is written when the source
		// code is blank/unknown-empty.
		String originalStatus = mapOperationalStatus(rawStatus);
		String finalStatus;
		String previousStatus = null;
		if (isBlank(originalStatus)) {
			finalStatus = null;
		} else if (RANKED_STATUSES.contains(rawStatus == null ? "" : rawStatus.trim())) {
			boolean seatLost = rankDecision != null && rankDecision.statusOverride != null
					&& !STATUS_TESTBED.equals(rankDecision.statusOverride);
			finalStatus = seatLost ? STATUS_DEACTIVATED : STATUS_TESTBED;
		} else {
			finalStatus = STATUS_DEACTIVATED;
		}
		if (STATUS_DEACTIVATED.equals(finalStatus)) {
			previousStatus = originalStatus;
		}
		String statusToWrite = finalStatus;

		// active is derived solely from the final status, not raw source status.
		String activeStr = finalStatus == null ? null : Boolean.toString(STATUS_TESTBED.equals(finalStatus));

		String reUuid = resolveReportingEntityId(bcOrg, reLookup);
		if (!isBlank(bcOrg) && isBlank(reUuid)) {
			warns.record("reporting_entity_id[LOOKUP_MISS]", bcOrg);
		}

		String countryCode = firstNonBlank(get(row, "country_code"), "+91");
		String gender = mapGender(get(row, "gender"));
		String title = mapTitle(get(row, "title"));

		// Mapped columns + where each value came from (address DB -> address CSV -> master CSV etc.).
		Map<String, String> src = new HashMap<String, String>();
		String landlineNumber = pick(src, "landline",
				new String[] { "address_db.phone2", "address_csv.phone2", "master.pstn_phone_no" },
				get(addressMetadata, "phone2"), get(addressCsvRow, "phone2"), get(row, "pstn_phone_no"));
		String mobileNo = pick(src, "mobile",
				new String[] { "address_db.phone3", "address_csv.phone3", "master.gsm_phone_no" },
				get(addressMetadata, "phone3"), get(addressCsvRow, "phone3"), get(row, "gsm_phone_no"));
		String email = pick(src, "email",
				new String[] { "address_db.email_id", "address_csv.email_id", "master.email" },
				get(addressMetadata, "email_id"), get(addressCsvRow, "email_id"), get(row, "email"));
		if (!isBlank(email))
			email = email.toLowerCase();

		String rawCitizenship = pick(src, "citizenship", new String[] { "details_csv.citizenship", "master.citizenship" },
				get(detailsRow, "citizenship"), get(row, "citizenship"));
		if (rawCitizenship == null)
			src.put("__src_citizenship", "default(Indian)");
		String citizenship = normalizeCitizenship(rawCitizenship);
		String designation = pick(src, "designation",
				new String[] { "details_csv.designation", "details_csv.user_certificate_name",
						"master.user_certificate_name", "master.user_certificate" },
				get(detailsRow, "designation"), get(detailsRow, "user_certificate_name"),
				get(row, "user_certificate_name"), get(row, "user_certificate"));

		String createdBy = firstNonBlank(get(row, "user_created_by"), get(row, "created_by"), "SYSTEM");
		String updatedBy = firstNonBlank(get(row, "last_updated_by"), get(row, "updated_by"), "SYSTEM");

		String ckycNo = null;
		String ckycNumber = firstNonBlank(get(row, "ckyc_number"), get(detailsRow, "ckyc_number"));

		String proofOfIdentityNumber = null;
		String proofOfIdentity = null;

		String employeeCode = pick(src, "employee_code",
				new String[] { "details_csv.employee_code", "details_csv.employ_code" },
				get(detailsRow, "employee_code"), get(detailsRow, "employ_code"));
		String keyCloakUserId = null;

		String officeAddress = "Same as registered address";

		Boolean sameRegistrationCorrespondenceAddress = null;
		if (!isBlank(mappedType) && mappedType.startsWith("IAU")) {
			sameRegistrationCorrespondenceAddress = Boolean.TRUE;
		}

		String workflowStatus = "APPROVED";

		Map<String, String> nameFields = resolveNameFields(row);

		String metadataJson = buildMetadataJson(row, addressMetadata, detailsRow, mappedType, finalStatus,
				previousStatus);

		Map<String, String> r = new LinkedHashMap<String, String>();

		r.put("active", activeStr);
		r.put("dob", get(row, "date_of_birth"));
		r.put("same_registration_correspondence_address", sameRegistrationCorrespondenceAddress == null ? null
				: sameRegistrationCorrespondenceAddress.toString());
		r.put("created_at", get(row, "user_created_date"));
		r.put("updated_at",
				firstNonBlank(get(row, "last_updated_date"), get(row, "updated_at"), get(row, "user_created_date")));
		r.put("version", firstNonBlank(get(row, "version_no"), "0"));
		r.put("country_code", countryCode);
		r.put("gender", gender);
		r.put("title", title);
		r.put("dsc_id", null);
		r.put("reporting_entity_id", reUuid);
		r.put("landline_number", landlineNumber);
		r.put("mobile", mobileNo);
		r.put("mobile_number", mobileNo);
		r.put("user_type", mappedType);
		r.put("citizenship", citizenship);
		r.put("ckyc_no", ckycNo);
		r.put("created_by", createdBy);
		r.put("designation", designation);
		r.put("employee_id", null);
		r.put("proof_of_identity_number", proofOfIdentityNumber);
		r.put("updated_by", updatedBy);
		r.put("email", email);
		r.put("first_name", nameFields.get("first_name"));
		r.put("last_name", nameFields.get("last_name"));
		r.put("middle_name", nameFields.get("middle_name"));
		r.put("key_cloak_user_id", keyCloakUserId);
		r.put("user_id", userId);
		r.put("ckyc_number", ckycNumber);
		r.put("employ_code", employeeCode);
		r.put("office_address", officeAddress);
		r.put("board_resoluation_date", null);
		r.put("authorization_letter", null);
		r.put("date_of_authorization", null);
		r.put("status", statusToWrite);
		r.put("workflow_status", workflowStatus);
		r.put("operation", "INSERT");
		r.put("requester_reason", null);
		r.put("approver_reason", null);
		r.put("date_of_authorizarion", null);
		r.put("phone_number", firstNonBlank(mobileNo, landlineNumber));
		r.put("pending_actions", "{}");
		r.put("proof_of_identity", proofOfIdentity);
		r.put("landline", landlineNumber);
		r.put("board_resolution_date", null);
		r.put("metadata", metadataJson);
		r.put("mobile_country_code", countryCode);
		r.put("poi_type", null);
		r.put("poi_no", null);
		r.put("mobile_no", mobileNo);
		// transient keys (never bound to SQL): audit only
		r.putAll(src);
		r.put("__prev_status", previousStatus);
		if (STATUS_DEACTIVATED.equals(finalStatus)) {
			if (rankDecision != null && rankDecision.reason != null)
				r.put("__deact_reason", rankDecision.reason);
			else if (RANKED_STATUSES.contains(rawStatus == null ? "" : rawStatus.trim()))
				r.put("__deact_reason", "ranked out by login_time (new org)");
			else
				r.put("__deact_reason", "inactive source status " + originalStatus);
		}

		return r;
	}

	private Map<String, String> resolveNameFields(Map<String, String> row) {

		Map<String, String> nameMap = new HashMap<String, String>();

		String firstName = get(row, "first_name");
		String middleName = get(row, "middle_name");
		String lastName = get(row, "last_name");

		if (!isBlank(lastName) || !isBlank(middleName)) {
			String cleanedFirst = firstName;
			if (!isBlank(cleanedFirst)) {
				if (!isBlank(lastName))
					cleanedFirst = stripTrailingToken(cleanedFirst, lastName);
				if (!isBlank(middleName))
					cleanedFirst = stripTrailingToken(cleanedFirst, middleName);
			}
			nameMap.put("first_name", isBlank(cleanedFirst) ? firstName : cleanedFirst);
			nameMap.put("middle_name", middleName);
			nameMap.put("last_name", lastName);
			return nameMap;
		}

		if (isBlank(firstName)) {
			nameMap.put("first_name", null);
			nameMap.put("middle_name", null);
			nameMap.put("last_name", null);
			return nameMap;
		}

		String[] parts = firstName.trim().split("\\s+");

		if (parts.length == 1) {
			nameMap.put("first_name", parts[0]);
			nameMap.put("middle_name", null);
			nameMap.put("last_name", null);
		} else if (parts.length == 2) {
			nameMap.put("first_name", parts[0]);
			nameMap.put("middle_name", null);
			nameMap.put("last_name", parts[1]);
		} else {
			StringBuilder middle = new StringBuilder();
			for (int i = 1; i < parts.length - 1; i++) {
				if (middle.length() > 0)
					middle.append(" ");
				middle.append(parts[i]);
			}
			nameMap.put("first_name", parts[0]);
			nameMap.put("middle_name", middle.toString());
			nameMap.put("last_name", parts[parts.length - 1]);
		}

		return nameMap;
	}

	private String stripTrailingToken(String source, String token) {
		if (isBlank(source) || isBlank(token))
			return source;
		String trimmedSource = source.trim();
		String trimmedToken = token.trim();
		if (trimmedSource.length() < trimmedToken.length())
			return source;

		String tail = trimmedSource.substring(trimmedSource.length() - trimmedToken.length());
		if (!tail.equalsIgnoreCase(trimmedToken))
			return source;

		int boundaryIdx = trimmedSource.length() - trimmedToken.length() - 1;
		if (boundaryIdx >= 0 && trimmedSource.charAt(boundaryIdx) != ' ')
			return source;

		return trimmedSource.substring(0, trimmedSource.length() - trimmedToken.length()).trim();
	}

	/**
	 * Binds the resolved row for the incoming-row's own UPDATE. user_type IS bound (rule #10/#17
	 * require ranking-derived user_type to actually reach the DB). user_id remains excluded from
	 * the SET clause (it is the WHERE key).
	 */
	private void bindResolvedUpdateRow(PreparedStatement ps, Map<String, String> resolved, DatatypeWarnAccumulator warns)
			throws SQLException {
		int paramIndex = 1;
		for (int i = 0; i < INSERT_COLUMNS.size(); i++) {
			String col = INSERT_COLUMNS.get(i);
			if ("user_id".equalsIgnoreCase(col)) {
				continue;
			}
			ColumnMeta meta = COLUMN_REGISTRY.get(col);
			TypeBinder.bind(ps, paramIndex++, meta, resolved.get(col), warns);
		}

		ps.setString(paramIndex, resolved.get("user_id"));
	}

	private void validateSourceHeaders(List<String> headers) {
		Set<String> headerSet = new HashSet<>(headers);
		for (String expected : EXPECTED_SOURCE_COLS) {
			if (!headerSet.contains(expected)) {
				log("WARN", "MISSING_SOURCE_COLUMN=" + expected + " | Dependent target columns will receive NULL", null,
						"MAPPING_WARN");
			}
		}
	}

	private String mapUserType(String userMode, String bcOrganisation, String rawStatus) {
		if (isBlank(userMode))
			return null;
		String mode = userMode.trim().toUpperCase();

		if ("IBA".equals(mode))
			return "SKIP";

		if (!"IA".equals(mode)) {
			return mode;
		}

		if (!"1".equals(rawStatus == null ? "" : rawStatus.trim())) {
			return "IA";
		}

		String key = normalizeKey(bcOrganisation);
		Integer count = iaCounterByBcOrganisation.get(key);
		if (count == null) {
			count = Integer.valueOf(0);
		}
		count = Integer.valueOf(count.intValue() + 1);
		iaCounterByBcOrganisation.put(key, count);

		if (count.intValue() == 1)
			return "IAU_1";
		if (count.intValue() == 2)
			return "IAU_2";

		return "IA";
	}

	private String mapOperationalStatus(String userStatus) {
		if (isBlank(userStatus))
			return null;
		switch (userStatus.trim()) {
		case "0":
			return "IN_ACTIVE";
		case "1":
			return "TESTBED";
		case "2":
			return "NOT_LOGGED";
		case "3":
			return "DELETED";
		case "4":
			return "LOCKED";
		case "6":
			return "ALREADY_LOGGED";
		case "7":
			return "PENDING_AUTHORIZE";
		case "8":
			return "REJECTED";
		case "12":
			return "DIGITAL_CERTIFICATE_REGISTRATION";
		case "13":
			return "DELETION_PENDING";
		case "14":
			return "ACTIVATION_PENDING";
		case "15":
			return "ACTIVATION_REJECTED";
		case "20":
			return "TERMS_AND_CONDITIONS";
		default:
			return userStatus.trim();
		}
	}

	private String mapTitle(String rawTitle) {
		if (isBlank(rawTitle))
			return null;
		switch (rawTitle.trim()) {
		case "01":
			return "Mr.";
		case "02":
			return "Mrs.";
		case "03":
			return "Ms.";
		case "04":
			return "Ms.";
		default:
			return null;
		}
	}

	private String mapGender(String rawGender) {
		if (isBlank(rawGender))
			return null;
		switch (rawGender.trim().toUpperCase()) {
		case "M":
			return "Male";
		case "F":
			return "Female";
		case "T":
			return "Transgender";
		default:
			return rawGender.trim();
		}
	}

	private String normalizeCitizenship(String rawCitizenship) {
		if (isBlank(rawCitizenship))
			return "Indian";
		String c = rawCitizenship.trim().toLowerCase();
		// details CSV carries country codes ("IN"); V3 maps anything containing "india" to Indian.
		if (c.contains("india") || "in".equals(c) || "ind".equals(c))
			return "Indian";
		return rawCitizenship.trim();
	}

	private String buildMetadataJson(Map<String, String> row, Map<String, String> addressMetadata,
			Map<String, String> detailsRow, String mappedType, String finalStatus, String previousStatus) {
		Map<String, String> meta = new LinkedHashMap<String, String>();
		addAllMetadata(meta, row);
		addAllMetadata(meta, addressMetadata);
		addAllMetadata(meta, detailsRow);
		meta.put("mapped_user_type", mappedType == null ? "" : mappedType);
		meta.put("mapped_operational_status", finalStatus == null ? "" : finalStatus);
		if (!isBlank(previousStatus)) {
			// Only rows being deactivated carry previous_status (status they had before DEACTIVATED).
			meta.put("previous_status", previousStatus);
		}
		return toJson(meta);
	}

	private void addAllMetadata(Map<String, String> target, Map<String, String> source) {
		if (source == null)
			return;
		for (Map.Entry<String, String> e : source.entrySet()) {
			String key = normalizeKey(e.getKey());
			if (isBlank(key))
				continue;
			if (!target.containsKey(key))
				target.put(key, cleanMetadataValue(e.getValue()));
		}
	}

	private String cleanMetadataValue(String value) {
		if (value == null)
			return "";
		String v = value.trim();
		if (v.isEmpty() || "\\N".equals(v) || "NULL".equalsIgnoreCase(v) || "null".equalsIgnoreCase(v))
			return "";
		return v;
	}

	/**
	 * user_type is included in the SET clause so ranking-derived type transitions (rule #10/#16/
	 * #17) actually reach the DB for the incoming row itself. Ranking-propagated updates to OTHER
	 * users go through the reusable rankPs statement instead, executed immediately per event.
	 *
	 * re_flag: the target table is aliased "u" and the WHERE clause carries the database-side
	 * eligibility guard, so even a Java-side bug cannot update a user whose stored reporting entity
	 * does not have re_flag IS NULL. SET-clause column references remain unqualified (they refer to
	 * the target row), which is valid with an alias.
	 */
	private String buildUpdateSql() {
		StringBuilder sb = new StringBuilder("UPDATE re_mgmt.re_user_bkp_1710 u SET ");
		boolean first = true;

		for (String col : INSERT_COLUMNS) {
			if ("user_id".equalsIgnoreCase(col)) {
				continue;
			}

			if (!first) {
				sb.append(", ");
			}
			first = false;
			sb.append(col).append(" = ");

			SqlType t = COLUMN_REGISTRY.get(col).sqlType;
			if (t == SqlType.UUID)
				sb.append("COALESCE(CAST(? AS uuid), ").append(col).append(")");
			else if (t == SqlType.JSONB)
				sb.append("COALESCE(CAST(? AS jsonb), ").append(col).append(")");
			else
				sb.append("COALESCE(?, ").append(col).append(")");
		}

		sb.append(" WHERE u.user_id = ? AND ").append(RE_FLAG_ELIGIBLE_GUARD)
				.append(" AND ").append(USER_MUTATION_GUARD)
				.append(" AND ").append(USER_TYPE_SCOPE_GUARD);
		return sb.toString();
	}

	/**
	 * INSERT for a user that is not in re_user yet. Same column order as the UPDATE (all columns except
	 * user_id, then user_id), so bindResolvedUpdateRow() binds it unchanged. ON CONFLICT keeps it safe.
	 */
	private String buildInsertSql() {
		StringBuilder cols = new StringBuilder();
		StringBuilder vals = new StringBuilder();
		for (String col : INSERT_COLUMNS) {
			if ("user_id".equalsIgnoreCase(col))
				continue;
			if (cols.length() > 0) {
				cols.append(", ");
				vals.append(", ");
			}
			cols.append(col);
			SqlType t = COLUMN_REGISTRY.get(col).sqlType;
			if (t == SqlType.UUID)
				vals.append("CAST(? AS uuid)");
			else if (t == SqlType.JSONB)
				vals.append("CAST(? AS jsonb)");
			else
				vals.append("?");
		}
		cols.append(", user_id");
		vals.append(", ?");
		return "INSERT INTO re_mgmt.re_user_bkp_1710 (" + cols + ") VALUES (" + vals
				+ ") ON CONFLICT (user_id) DO NOTHING";
	}

	private Map<String, String> loadReportingEntityLookup() {
		Map<String, String> map = new HashMap<String, String>();
		Map<String, Integer> fiCodeCounts = new HashMap<String, Integer>();
		reFlagByFiCode.clear();
		ambiguousFiCodes.clear();
		fiCodeByReId.clear();
		String sql = "SELECT fi_code, id, re_flag FROM re_mgmt.reporting_entity_pview_bkp_1610";
		Connection conn = null;
		PreparedStatement ps = null;
		ResultSet rs = null;

		try {
			conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();
			while (rs.next()) {
				String fi = rs.getString("fi_code");
				String id = rs.getString("id");
				if (isBlank(fi) || isBlank(id)) continue;
				String key = normalizeKey(fi);
				int count = fiCodeCounts.containsKey(key) ? fiCodeCounts.get(key).intValue() + 1 : 1;
				fiCodeCounts.put(key, Integer.valueOf(count));
				if (count > 1) {
					ambiguousFiCodes.add(key);
					map.remove(key);
					reFlagByFiCode.remove(key);
					continue;
				}
				try {
					java.util.UUID.fromString(id.trim());
					map.put(key, id.trim());
					fiCodeByReId.put(normalizeKey(id), key);
					// HashMap supports a null value, preserving the distinction between a known NULL
					// flag and a missing/ambiguous FI code.
					reFlagByFiCode.put(key, rs.getString("re_flag"));
				} catch (IllegalArgumentException ex) {
					log("WARN", "Invalid reporting-entity UUID; lookup row skipped | fi_code=" + fi, null, "LOOKUP_LOAD");
				}
			}
		} catch (Exception e) {
			// Fail closed: with an empty/partial flag map every unresolved FI code is RE_FLAG_UNKNOWN.
			log("WARN", "Reporting-entity lookup failed: " + e.getMessage(), null, "LOOKUP_LOAD");
		} finally {
			closeQuietly(rs);
			closeQuietly(ps);
			closeQuietly(conn);
		}
		for (String key : ambiguousFiCodes) {
			map.remove(key);
			reFlagByFiCode.remove(key);
			log("WARN", "Duplicate fi_code in reporting_entity_pview_bkp_1610; lookup marked ambiguous and its users will not be processed | fi_code=" + key,
					null, "LOOKUP_AMBIGUOUS_FI_CODE");
		}
		for (Map.Entry<String, String> e : reFlagByFiCode.entrySet()) {
			String flag = e.getValue();
			if (flag != null && !isExplicitFalseReFlag(flag)) {
				log("WARN", "Unexpected non-null re_flag; users of this entity will not be processed | fi_code=" + e.getKey()
						+ " | re_flag=" + flag, null, "RE_FLAG_UNEXPECTED");
			}
		}
		return map;
	}

	/**
	 * Returns: null when the FI code resolves to exactly one reporting entity whose re_flag IS NULL
	 * (the ONLY eligible outcome); the raw non-null re_flag string otherwise; RE_FLAG_AMBIGUOUS for
	 * duplicate fi_code rows; RE_FLAG_UNKNOWN for blank/unresolved FI codes.
	 */
	private String lookupReFlag(String fiCode) {
		String key = normalizeKey(fiCode);
		if (isBlank(key)) return RE_FLAG_UNKNOWN;
		if (ambiguousFiCodes.contains(key)) return RE_FLAG_AMBIGUOUS;
		if (!reFlagByFiCode.containsKey(key)) return RE_FLAG_UNKNOWN;
		return reFlagByFiCode.get(key);
	}

	private boolean isExplicitFalseReFlag(String flag) {
		return flag != null && "false".equalsIgnoreCase(flag.trim());
	}

	/**
	 * Maps a flag value to a skip reason, or null if (and only if) the flag IS NULL (eligible).
	 * Any non-NULL value that is not an explicit 'false' ('true', 't', 'f', '0', '', unknown text)
	 * is NOT eligible.
	 */
	private String reFlagSkipReason(String flag) {
		if (flag == null)
			return null;
		if (RE_FLAG_AMBIGUOUS.equals(flag))
			return "RE_FLAG_AMBIGUOUS_SKIP";
		if (RE_FLAG_UNKNOWN.equals(flag))
			return "RE_FLAG_UNKNOWN_SKIP";
		if (isExplicitFalseReFlag(flag))
			return "RE_FLAG_FALSE_SKIP";
		return "RE_FLAG_UNEXPECTED_SKIP";
	}

	private String describeFlag(String flag) {
		if (flag == null)
			return "<NULL>";
		if (RE_FLAG_AMBIGUOUS.equals(flag))
			return "<AMBIGUOUS_FI_CODE>";
		if (RE_FLAG_UNKNOWN.equals(flag))
			return "<UNRESOLVED>";
		return "'" + flag + "'";
	}

