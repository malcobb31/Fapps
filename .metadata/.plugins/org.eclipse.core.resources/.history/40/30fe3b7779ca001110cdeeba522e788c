	/**
	 * Compact run audit. The log shows one line per group (inserted, updated, each skip reason, final
	 * TESTBED / each deactivation reason, mapping source per column) with the count and the first ids;
	 * the complete per-user list is written to a TSV file so the console never turns into a wall of rows.
	 */
	static final class RunAudit {
		static final int IDS_IN_LOG = 20;
		static final String[] MAPPED_COLS = { "email", "mobile", "landline", "designation", "employee_code",
				"citizenship" };
		// columns of a per-user row: user_id, action, user_type, status, reason, previous_status, <sources...>
		final Map<String, List<String>> groups = new LinkedHashMap<String, List<String>>();
		final Map<String, String[]> rows = new LinkedHashMap<String, String[]>();
		final Map<String, Map<String, Integer>> sources = new LinkedHashMap<String, Map<String, Integer>>();
		final Map<String, List<String>> missing = new LinkedHashMap<String, List<String>>();
		private int seq = 0;

		RunAudit() {
			for (String c : MAPPED_COLS) {
				sources.put(c, new LinkedHashMap<String, Integer>());
				missing.put(c, new ArrayList<String>());
			}
		}

		void group(String group, String userId) {
			List<String> ids = groups.get(group);
			if (ids == null) {
				ids = new ArrayList<String>();
				groups.put(group, ids);
			}
			String id = userId == null || userId.trim().isEmpty() ? "(blank)" : userId.trim();
			if (ids.isEmpty() || !ids.get(ids.size() - 1).equals(id) || "(blank)".equals(id))
				if (!ids.contains(id) || "(blank)".equals(id) || group.startsWith("SKIPPED"))
					ids.add(id);
		}

		/** A user row really written to the DB (action = INSERTED / UPDATED). */
		void written(String action, String userId, Map<String, String> resolved) {
			group(action, userId);
			String[] r = new String[6 + MAPPED_COLS.length];
			r[0] = userId;
			r[1] = action;
			r[2] = nz(resolved.get("user_type"));
			r[3] = nz(resolved.get("status"));
			r[4] = nz(resolved.get("__deact_reason"));
			r[5] = nz(resolved.get("__prev_status"));
			for (int i = 0; i < MAPPED_COLS.length; i++) {
				String c = MAPPED_COLS[i];
				String src = resolved.get("__src_" + c);
				if (src == null) {
					missing.get(c).add(userId);
					src = "missing";
				}
				Map<String, Integer> m = sources.get(c);
				Integer n = m.get(src);
				m.put(src, Integer.valueOf(n == null ? 1 : n.intValue() + 1));
				r[6 + i] = src;
			}
			rows.put(key(userId), r);
		}

		/** A later decision changed an already written user (ranking inside a new org). */
		void restatus(String userId, String userType, String status, String reason) {
			String[] r = rows.get(key(userId));
			if (r == null)
				return;
			r[2] = nz(userType);
			r[3] = nz(status);
			r[4] = "DEACTIVATED".equals(status) ? nz(reason) : "";
		}

		/** A source row the business rules did not write. */
		void skipped(String reason, String userId) {
			group("SKIPPED - " + reason, userId);
			String[] r = new String[6 + MAPPED_COLS.length];
			java.util.Arrays.fill(r, "");
			r[0] = userId == null ? "" : userId;
			r[1] = "SKIPPED";
			r[4] = reason;
			String k = key(userId);
			rows.put(rows.containsKey(k) ? k + "#" + (++seq) : k, r);
		}

		/** Final TESTBED / DEACTIVATED groups, built from each user's LAST known state. */
		Map<String, List<String>> finalStatusGroups() {
			Map<String, List<String>> out = new LinkedHashMap<String, List<String>>();
			for (String[] r : rows.values()) {
				if ("SKIPPED".equals(r[1]))
					continue;
				String g = "TESTBED".equals(r[3]) ? "FINAL TESTBED"
						: "DEACTIVATED".equals(r[3])
								? "FINAL DEACTIVATED - " + (r[4].isEmpty() ? "inactive source status" : r[4])
								: "FINAL status " + (r[3].isEmpty() ? "(unchanged)" : r[3]);
				List<String> ids = out.get(g);
				if (ids == null) {
					ids = new ArrayList<String>();
					out.put(g, ids);
				}
				ids.add(r[0]);
			}
			return out;
		}

		private static String key(String userId) {
			return userId == null ? "" : userId.trim().toLowerCase();
		}

		static String nz(String s) {
			return s == null ? "" : s;
		}

		static String preview(List<String> ids) {
			if (ids == null || ids.isEmpty())
				return "";
			int n = Math.min(IDS_IN_LOG, ids.size());
			StringBuilder sb = new StringBuilder("[");
			for (int i = 0; i < n; i++) {
				if (i > 0)
					sb.append(", ");
				sb.append(ids.get(i));
			}
			sb.append(']');
			if (ids.size() > n)
				sb.append(" +").append(ids.size() - n).append(" more");
			return sb.toString();
		}
	}

	private final RunAudit audit = new RunAudit();

	/** Prints the compact audit and writes the full per-user TSV into the working directory. */
	private void printRunAudit(String filePrefix) {
		log("INFO", "---------------- RUN AUDIT ----------------", null, "RUN_AUDIT");
		if (audit.groups.isEmpty())
			log("INFO", "No source row produced any action", null, "RUN_AUDIT");
		for (Map.Entry<String, List<String>> e : audit.groups.entrySet()) {
			log("INFO", String.format("%-58s : %6d  %s", e.getKey(), e.getValue().size(),
					RunAudit.preview(e.getValue())), null, "RUN_AUDIT");
		}
		for (Map.Entry<String, List<String>> e : audit.finalStatusGroups().entrySet()) {
			log("INFO", String.format("%-58s : %6d  %s", e.getKey(), e.getValue().size(),
					RunAudit.preview(e.getValue())), null, "RUN_AUDIT");
		}
		log("INFO", "---------------- MAPPING (written rows) ----------------", null, "RUN_AUDIT");
		for (String c : RunAudit.MAPPED_COLS) {
			StringBuilder sb = new StringBuilder();
			for (Map.Entry<String, Integer> s : audit.sources.get(c).entrySet()) {
				if (sb.length() > 0)
					sb.append(", ");
				sb.append(s.getKey()).append('=').append(s.getValue());
			}
			List<String> miss = audit.missing.get(c);
			log("INFO", String.format("%-14s : %s%s", c, sb.length() == 0 ? "-" : sb.toString(),
					miss.isEmpty() ? "" : "  | missing for " + RunAudit.preview(miss)), null, "RUN_AUDIT");
		}

		String ts = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyyMMdd_HHmmss"));
		Path out = Paths.get(filePrefix + "_audit_" + ts + ".tsv").toAbsolutePath();
		try (java.io.BufferedWriter w = Files.newBufferedWriter(out, StandardCharsets.UTF_8)) {
			w.write("user_id\taction\tuser_type\tstatus\treason\tprevious_status");
			for (String c : RunAudit.MAPPED_COLS)
				w.write("\t" + c + "_source");
			w.newLine();
			for (String[] r : audit.rows.values()) {
				StringBuilder sb = new StringBuilder();
				for (int i = 0; i < r.length; i++) {
					if (i > 0)
						sb.append('\t');
					sb.append(r[i] == null ? "" : r[i]);
				}
				w.write(sb.toString());
				w.newLine();
			}
			log("INFO", "Full per-user audit written: " + out + " | Rows=" + audit.rows.size(), null, "RUN_AUDIT");
		} catch (Exception ex) {
			log("WARN", "Audit file could not be written (" + out + "): " + ex.getMessage(), null, "RUN_AUDIT");
		}
		log("INFO", "--------------------------------------------", null, "RUN_AUDIT");
	}

	/** First non-blank value; records which source it came from as resolved-transient "__src_<col>". */
	private String pick(Map<String, String> srcOut, String col, String[] names, String... values) {
		for (int i = 0; i < values.length; i++) {
			if (!isBlank(values[i])) {
				srcOut.put("__src_" + col, names[i]);
				return values[i].trim();
			}
		}
		return null;
	}

