        } else {
            System.out.println("[INFO] No matching bucket found. Creating bucket.");
            JSONObject createdBucket = createBucket(token, bucketName, enterpriseName, username, accessKey, secretKey);
            if (createdBucket != null) {
                upsertBucketToDB(createdBucket);
            } else {
                System.out.println("[ERROR] Bucket creation failed.");
            }
        }

        System.out.println("[INFO] Run complete for enterprise: " + enterpriseName);
    }

    // ----------------- Authentication -----------------
    private static String authenticateAndGetToken(String baseUrl, String dbName, String username, String password) throws Exception {
        String authUrl = baseUrl + "/auth/token/";
        System.out.println("[INFO] Authenticating via: " + authUrl);

        URL url = new URL(authUrl);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setRequestMethod("POST");
        conn.setDoOutput(true);

        // Set proper JSON headers
        conn.setRequestProperty("Content-Type", "application/json");
        conn.setRequestProperty("Accept", "application/json");

        // Build JSON body
        JSONObject body = new JSONObject();
        body.put("dbName", dbName);
        body.put("name", username);
        body.put("password", password);
        body.put("superUser", true);

        // Send JSON body
        try (OutputStream os = conn.getOutputStream()) {
            os.write(body.toString().getBytes(StandardCharsets.UTF_8));
        }

        int responseCode = conn.getResponseCode();
        System.out.println("[INFO] Auth Response Code: " + responseCode);

        InputStream is = (responseCode >= 200 && responseCode < 300) 
                         ? conn.getInputStream() 
                         : conn.getErrorStream();

        String responseText = readStream(is);
        System.out.println("[DEBUG] Auth Response: " + responseText);

        if (!responseText.trim().startsWith("{")) {
            System.err.println("[ERROR] Non-JSON auth response: " + responseText);
            throw new Exception("Server did not return JSON");
        }

        JSONObject jsonResponse = new JSONObject(responseText);
        if (jsonResponse.has("access")) {
            return jsonResponse.getString("access");
        } else {
            System.err.println("[ERROR] Auth failed: " + responseText);
            return null; // or throw Exception
        }

    }

    // ----------------- Repositories -----------------
    // returns the repo JSONObject (first match) or null
    private JSONObject findRepositoryByName(String token, String enterpriseName) {
        try {
            System.out.println("[INFO] Fetching repositories from: " + REPO_URL);
            URL url = new URL(REPO_URL);
            HttpsURLConnection conn = (HttpsURLConnection) url.openConnection();
            conn.setRequestMethod("GET");
            conn.setRequestProperty("Authorization", "Bearer " + token);
            conn.setRequestProperty("Accept", "application/json");

            int code = conn.getResponseCode();
            System.out.println("[INFO] Repositories GET Response Code: " + code);
            InputStream is = (code >= 200 && code < 300) ? conn.getInputStream() : conn.getErrorStream();
            String resp = readStream(is);
            System.out.println("[DEBUG] Repositories Response:\n" + prettyJson(resp));

            Object parsed = parseJsonResponse(resp);
            JSONArray arr = null;

            if (parsed instanceof JSONArray) {
                arr = (JSONArray) parsed;  // old format
            } else if (parsed instanceof JSONObject) {
                JSONObject obj = (JSONObject) parsed;
                if (obj.has("results")) {
                    arr = obj.getJSONArray("results"); // new paginated format
                } else {
                    System.err.println("[ERROR] JSON object has no 'results' array:\n" + obj.toString(4));
                    return null;
                }
            } else {
                System.err.println("[ERROR] Unexpected response (not JSON): " + resp);
                return null;
            }

            for (int i = 0; i < arr.length(); i++) {
                JSONObject repo = arr.getJSONObject(i);
                if (repo.optString("name", "").equalsIgnoreCase(enterpriseName)) {
                    JSONObject out = new JSONObject();
                    out.put("id", repo.optInt("id", -1));
                    out.put("name", repo.optString("name", ""));
                    Object vq = repo.opt("volumeQuota");
                    out.put("volumeQuota", vq != null ? vq : JSONObject.NULL);
                    out.put("creationDate", repo.optString("creationDate", repo.optString("creation_date", "")));
                    return out;
                }
            }

        } catch (Exception e) {
            System.out.println("[ERROR] Exception in findRepositoryByName: " + e.getMessage());
            e.printStackTrace();
        }

        return null;
    }

    private JSONObject createRepository(String token, String enterpriseName, String owner, long volumeQuotaBytes) {
