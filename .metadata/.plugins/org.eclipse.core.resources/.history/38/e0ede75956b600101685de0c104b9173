            conn.setRequestMethod("POST");
            conn.setRequestProperty("Authorization", "Bearer " + token);
            conn.setRequestProperty("Content-Type", "application/json");
            conn.setDoOutput(true);

            JSONObject body = new JSONObject();
            body.put("name", enterpriseName);
            body.put("comment", enterpriseName);
            body.put("mode", "archiving");
            body.put("owner", owner);
            body.put("volumeQuota", volumeQuotaBytes);
            body.put("organization", "_Archiving");

            try (OutputStream os = conn.getOutputStream()) {
                os.write(body.toString().getBytes(StandardCharsets.UTF_8));
            }

            int code = conn.getResponseCode();
            System.out.println("[INFO] Create Repo Response Code: " + code);
            InputStream is = (code >= 200 && code < 300) ? conn.getInputStream() : conn.getErrorStream();
            String resp = readStream(is);
            System.out.println("[DEBUG] Create Repo Response:\n" + prettyJson(resp));

            if (code == 200 || code == 201 || code == 202) {
                JSONObject json = new JSONObject(resp);
                // normalise fields we need
                JSONObject out = new JSONObject();
                out.put("id", json.optInt("id", -1));
                out.put("name", json.optString("name", enterpriseName));
                out.put("volumeQuota", json.opt("volumeQuota"));
                out.put("creationDate", json.optString("creationDate", ""));
                return out;
            } else {
                System.out.println("[ERROR] Repository creation failed: " + resp);
            }

        } catch (Exception e) {
            System.out.println("[ERROR] Exception in createRepository: " + e.getMessage());
            e.printStackTrace();
        }
        return null;
    }

