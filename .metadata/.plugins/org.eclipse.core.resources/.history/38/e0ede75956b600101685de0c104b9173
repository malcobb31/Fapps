    // ----------------- DB Upserts -----------------
    private void upsertRepositoryToDB(JSONObject repo) {
        try {
            System.out.println("[INFO] Upserting repository into DB: " + repo.toString());
            rest_api_DBConnection db = new rest_api_DBConnection(DB_URL, DB_USER, DB_PASS);
            int id = repo.optInt("id", -1);
            String name = repo.optString("name", "");
            Object vq = repo.opt("volumeQuota");
            long volumeQuota = 0L;
            if (vq == JSONObject.NULL || vq == null) {
                volumeQuota = 0L;
            } else if (vq instanceof Number) {
                volumeQuota = ((Number) vq).longValue();
            } else {
                try {
                    volumeQuota = Long.parseLong(String.valueOf(vq));
                } catch (Exception ex) {
                    volumeQuota = 0L;
                }
            }
            String creationDate = repo.optString("creationDate", "");
            db.insertEnterprise(id, name, volumeQuota, creationDate);
            db.close();
            System.out.println("[INFO] Repository upsert completed.");
        } catch (Exception e) {
            System.out.println("[ERROR] Exception in upsertRepositoryToDB: " + e.getMessage());
            e.printStackTrace();
        }
    }

