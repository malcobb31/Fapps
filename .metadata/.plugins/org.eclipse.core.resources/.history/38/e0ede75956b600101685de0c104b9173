        if (foundRepo != null) {
            // repo exists -> upsert to DB
            System.out.println("[INFO] Repository exists. Upserting into DB.");
            upsertRepositoryToDB(foundRepo);
        } else {
            // not found -> create repo
            System.out.println("[INFO] Repository not found. Creating repository.");
            JSONObject createdRepo = createRepository(token, enterpriseName, username, TEN_GB_BYTES);
            if (createdRepo != null) {
                upsertRepositoryToDB(createdRepo);
            } else {
                System.out.println("[ERROR] Repository creation failed.");
                // still proceed to next steps? We'll stop here to avoid inconsistent state
                return;
            }
        }

        // 3) Create Archiving Project
        System.out.println("[INFO] Creating archiving project for enterprise.");
        JSONObject projectResp = createArchivingProject(token, enterpriseName);
        if (projectResp != null) {
            upsertArchivingProjectToDB(projectResp);
        } else {
            System.out.println("[ERROR] Archiving project creation failed.");
        }

        // 4) Buckets - check existing buckets for objectStoragePk = 4
        System.out.println("[INFO] Checking object storage buckets (pk=4).");
        JSONObject matchedBucket = findBucketByNamingConvention(token, enterpriseName, username, bucketName);
        if (matchedBucket != null) {
            System.out.println("[INFO] Matching bucket found. Upserting to DB.");
