package url_parserV1;

import org.bytedeco.opencv.global.opencv_core;
import org.bytedeco.opencv.global.opencv_imgcodecs;
import org.bytedeco.opencv.opencv_core.*;
import org.bytedeco.opencv.global.opencv_imgproc;

import java.io.BufferedReader;
import java.io.File;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

public class url_parser_methods_login {

    static String TESSERACT_PATH = "C:\\Program Files\\Tesseract-OCR\\tesseract.exe";

    public static void main(String[] args) throws Exception {

        String inputFile = "captcha.png";
        String processedFile = "processed.png";

        // ----------------------------
        // 1. Load CAPTCHA image
        // ----------------------------
        Mat img = opencv_imgcodecs.imread(inputFile);
        if (img.empty()) {
            System.out.println("Image not found!");
            return;
        }

        // ----------------------------
        // 2. Resize ×3 (small text → easier for OCR)
        // ----------------------------
        Mat resized = new Mat();
        opencv_imgproc.resize(img, resized,
                new Size(img.cols() * 3, img.rows() * 3));

        // ----------------------------
        // 3. Convert to HSV
        // ----------------------------
        Mat hsv = new Mat();
        opencv_imgproc.cvtColor(resized, hsv,
                opencv_imgproc.COLOR_BGR2HSV);

        // Blue color mask
        Scalar lowerBlue = new Scalar(90, 40, 40, 0);
        Scalar upperBlue = new Scalar(150, 255, 255, 0);

        Mat lowerMat = new Mat(hsv.size(), hsv.type(), lowerBlue);
        Mat upperMat = new Mat(hsv.size(), hsv.type(), upperBlue);

        Mat mask = new Mat();
        opencv_core.inRange(hsv, lowerMat, upperMat, mask);

        // ----------------------------
        // 4. Smooth noise
        // ----------------------------
        opencv_imgproc.GaussianBlur(mask, mask, new Size(3, 3), 0);

        // ----------------------------
        // 5. Adaptive threshold
        // ----------------------------
        opencv_imgproc.adaptiveThreshold(
                mask,
                mask,
                255,
                opencv_imgproc.ADAPTIVE_THRESH_MEAN_C,
                opencv_imgproc.THRESH_BINARY,
                31,
                10
        );

        // ----------------------------
        // 6. Dilate + Erode
        // ----------------------------
        Mat kernel = opencv_imgproc.getStructuringElement(
                opencv_imgproc.MORPH_RECT, new Size(2, 2));

        opencv_imgproc.dilate(mask, mask, kernel);
        opencv_imgproc.erode(mask, mask, kernel);

        // Save final processed image
        opencv_imgcodecs.imwrite(processedFile, mask);

        // ----------------------------
        // 7. FIND CONTOURS (Extract characters)
        // ----------------------------
        Mat maskCopy = mask.clone();
        List<MatOfPoint> contours = new ArrayList<>();
        Mat hierarchy = new Mat();

        opencv_imgproc.findContours(
                maskCopy,
                contours,
                hierarchy,
                opencv_imgproc.RETR_EXTERNAL,
                opencv_imgproc.CHAIN_APPROX_SIMPLE
        );

        // Sort contours left → right
        contours.sort(Comparator.comparingInt(
                c -> opencv_imgproc.boundingRect(c).x()
        ));

        // ----------------------------
        // 8. OCR EACH CHARACTER (PSM 10)
        // ----------------------------
        StringBuilder finalCaptcha = new StringBuilder();
        int index = 0;

        for (MatOfPoint contour : contours) {
            Rect rect = opencv_imgproc.boundingRect(contour);

            // Ignore noise blobs
            if (rect.width() < 10 || rect.height() < 20)
                continue;

            // Crop this character
            Mat charImg = new Mat(mask, rect);

            // Resize character (better accuracy)
            Mat resizedChar = new Mat();
            opencv_imgproc.resize(charImg, resizedChar, new Size(200, 200));

            // Save temporarily
            String charFile = "char_" + index + ".png";
            opencv_imgcodecs.imwrite(charFile, resizedChar);

            // OCR one character
            String chr = runSingleCharOCR(charFile);
            finalCaptcha.append(chr);

            index++;
        }

        // DONE
        System.out.println("Extracted CAPTCHA: [" + finalCaptcha.toString() + "]");
    }


    // ------------------------------------------
    // OCR function for SINGLE character (PSM 10)
    // ------------------------------------------
    private static String runSingleCharOCR(String imgFile) throws Exception {

        ProcessBuilder pb = new ProcessBuilder(
                TESSERACT_PATH,
                imgFile,
                "stdout",
                "--psm", "10",   // Single character
                "--oem", "3",
                "-c", "tessedit_char_whitelist=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
        );

        pb.redirectErrorStream(true);
        Process process = pb.start();

        BufferedReader br = new BufferedReader(
                new InputStreamReader(process.getInputStream()));

        String line = br.readLine();
        process.waitFor();

        return (line == null ? "" : line.trim());
    }
}



