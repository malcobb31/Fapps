package postgre_agent_v4;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.nio.file.*;
import java.sql.*;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.concurrent.TimeUnit;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Methods class that your postgre_v4_main will call.
 *
 * Public entry:
 *   processAllInDirectory(
 *     inputDir, processedDir, headerFlag, delimiter,
 *     sqldburl, sdbuser, sdbpass,
 *     postgredbhost, pdbport, pdbname, pdbuser, pdbpass,
 *     desturl, destuser, dbpass,
 *     howManyTablesToPick, configTableName,
 *     cpuMaxUtil, cpuMaxMemUtil, bulkNumber, dbTypeVariable
 *   )
 *
 * Note:
 * - dbTypeVariable: "psql" or "sql" (mysql).
 * - desturl/destuser/dbpass are used to connect to the destination DB.
 * - The source DB args (sqldburl, sdbuser, sdbpass, postgredbhost, ...) are accepted and logged
 *   but not used by this CSV importer core — keep them for backward compatibility / future use.
 */
public class postgre_v4_methods_test {
    private static final String PROCESS_NAME = "CSV_TO_DB";
    private static final Pattern TS_IN_NAME = Pattern.compile("(\\d{4}_\\d{2}_\\d{2}_\\d{2}_\\d{2}_\\d{2})"); // yyyy_MM_dd_HH_mm_ss
    private static final DateTimeFormatter TS_FMT = DateTimeFormatter.ofPattern("yyyy_MM_dd_HH_mm_ss");

    /**
     * Entry method called from your main.
     * Matches the order/positions you passed in your postgre_v4_main.
     */
    public static void processAllInDirectory(
            String inputDir,
            String processedDir,
            String headerFlag,
            String delimiter,
            String sqldburl,
            String sdbuser,
            String sdbpass,
            String postgredbhost,
            String pdbport,
            String pdbname,
            String pdbuser,
            String pdbpass,
            String desturl,
            String destuser,
            String dbpass,
            String howManyTablesToPick,
            String configTableName,
            String cpuMaxUtil,
            String cpuMaxMemUtil,
            String bulkNumberStr,
            String dbTypeVariable
    ) throws Exception {

        long t0 = System.nanoTime();
        log("processAllInDirectory called");
        log("inputDir=%s, processedDir=%s, headerFlag=%s, delimiter=%s", inputDir, processedDir, headerFlag, delimiter);
        log("desturl=%s, destuser=%s, dbType=%s, bulkNumber=%s", desturl, destuser, dbTypeVariable, bulkNumberStr);
        // Log unused/optional params so the caller's args are visible:
        log("source(s) -> sqldburl=%s, sdbuser=%s, postgredbhost=%s, pdbport=%s, pdbname=%s, pdbuser=%s",
                sqldburl, sdbuser, postgredbhost, pdbport, pdbname, pdbuser);

        boolean headerPresent = parseBoolean(headerFlag);
        int batchSize = parseInt(bulkNumberStr, 1000);
        String dbType = (dbTypeVariable == null) ? "psql" : dbTypeVariable.toLowerCase(Locale.ROOT);

        // Ensure processedDir exists
        Path processedDirPath = Paths.get(processedDir);
        if (!Files.exists(processedDirPath)) {
            Files.createDirectories(processedDirPath);
            log("Created processed dir: %s", processedDir);
        }

        // Connect to destination DB based on dbType + desturl/user/pass
        try (Connection destConn = connect(dbType, desturl, destuser, dbpass)) {
            destConn.setAutoCommit(false);
            log("Connected to destination DB (%s)", dbType);

            List<File> files = listCsvFilesChronologically(inputDir);
            if (files.isEmpty()) {
                log("No CSV files found in %s", inputDir);
                return;
            }
            log("Found %d CSV files to process", files.size());

            long totalInserted = 0L;
            long totalFailed = 0L;
            int idx = 0;

            for (File csvFile : files) {
                idx++;
                log("Processing (%d/%d): %s", idx, files.size(), csvFile.getName());
                try {
                    FileProcessResult r = processOneCsv(destConn,
                            csvFile,
                            sanitizeTableName(csvFile.getName()), // default table name derived from filename; you can change this behavior
                            delimiter,
                            batchSize,
                            true,       // create table if not exists (kept default true)
                            headerPresent,
                            dbType);

                    destConn.commit();
                    totalInserted += r.inserted;
                    totalFailed += r.failed;
                    log("File %s committed (inserted=%d, failed=%d)", csvFile.getName(), r.inserted, r.failed);

                    // move file to processed directory
                    Path target = processedDirPath.resolve(csvFile.getName());
                    Files.move(csvFile.toPath(), target, StandardCopyOption.REPLACE_EXISTING);
                    log("Moved processed file to %s", target.toString());

                } catch (Exception ex) {
                    logErr("Error processing %s: %s", csvFile.getName(), ex.toString());
                    try { destConn.rollback(); } catch (SQLException se) { logErr("Rollback failed: %s", se); }
                    // we continue processing other files — if you want to stop, throw here
                }
            }

            long ms = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - t0);
            log("All done. files=%d totalInserted=%d totalFailed=%d elapsedMs=%d", files.size(), totalInserted, totalFailed, ms);
        }
    }

    // -------------------- CSV processing helpers --------------------

    private static FileProcessResult processOneCsv(Connection conn,
                                                  File csv,
                                                  String tableName,
                                                  String delimiter,
                                                  int batchSize,
                                                  boolean createTable,
                                                  boolean headerPresent,
                                                  String dbType) throws Exception {

        try (BufferedReader br = new BufferedReader(new FileReader(csv))) {
            String headerLine;
            List<String> headers;

            if (headerPresent) {
                headerLine = br.readLine();
                if (headerLine == null) return new FileProcessResult(0, 0);
                headers = parseCsvLine(headerLine, delimiter);
                headers = sanitizeHeaders(headers);
            } else {
                headerLine = br.readLine();
                if (headerLine == null) return new FileProcessResult(0, 0);
                List<String> firstData = parseCsvLine(headerLine, delimiter);
                headers = generateColumnNames(firstData.size());
                // create table if needed
                if (createTable) {
                    ensureTable(conn, tableName, headers, dbType);
                }
                // insert the first data row and the rest
                long[] counts = insertRows(conn, tableName, headers, batchSize, firstData, br, delimiter);
                return new FileProcessResult(counts[0], counts[1]);
            }

            if (createTable) {
                ensureTable(conn, tableName, headers, dbType);
            }

            long[] counts = insertRows(conn, tableName, headers, batchSize, null, br, delimiter);
            return new FileProcessResult(counts[0], counts[1]);
        }
    }

    /**
     * Insert rows using PreparedStatement in batches.
     *
     * @param firstRow A single row to seed before reading from BufferedReader (used when header=false). Pass null otherwise.
     */
    private static long[] insertRows(Connection conn,
                                     String tableName,
                                     List<String> headers,
                                     int batchSize,
                                     List<String> firstRow,
                                     BufferedReader br,
                                     String delimiter) throws Exception {
        String sql = buildInsertSQL(tableName, headers);
        long inserted = 0L, failed = 0L;

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            int batchCount = 0;

            if (firstRow != null) {
                setRowParams(ps, headers.size(), firstRow);
                ps.addBatch();
                batchCount++;
            }

            String line;
            while ((line = br.readLine()) != null) {
                if (line.isEmpty()) continue;
                List<String> cols = parseCsvLine(line, delimiter);

                if (cols.size() < headers.size()) {
                    while (cols.size() < headers.size()) cols.add(null);
                } else if (cols.size() > headers.size()) {
                    cols = cols.subList(0, headers.size());
                }

                try {
                    setRowParams(ps, headers.size(), cols);
                    ps.addBatch();
                    batchCount++;
                } catch (SQLException ex) {
                    failed++;
                }

                if (batchCount >= batchSize) {
                    int[] res = ps.executeBatch();
                    inserted += countSuccessful(res);
                    batchCount = 0;
                }
            }

            if (batchCount > 0) {
                int[] res = ps.executeBatch();
                inserted += countSuccessful(res);
            }
        }

        return new long[]{inserted, failed};
    }

    private static int countSuccessful(int[] results) {
        int ok = 0;
        for (int r : results) {
            if (r == Statement.SUCCESS_NO_INFO || r >= 0) ok++;
        }
        return ok;
    }

    private static void setRowParams(PreparedStatement ps, int cols, List<String> values) throws SQLException {
        for (int i = 0; i < cols; i++) {
            String v = i < values.size() ? values.get(i) : null;
            if (v == null || v.isEmpty()) {
                ps.setNull(i + 1, Types.VARCHAR);
            } else {
                ps.setString(i + 1, v);
            }
        }
    }

    // -------------------- Table helpers --------------------

    private static void ensureTable(Connection conn, String tableName, List<String> headers, String dbType) throws SQLException {
        if (tableExists(conn, tableName)) {
            log("Table '%s' exists", tableName);
            return;
        }
        String ddl = buildCreateTableDDL(tableName, headers, dbType);
        try (Statement st = conn.createStatement()) {
            st.execute(ddl);
            log("Created table '%s'", tableName);
        }
    }

    private static boolean tableExists(Connection conn, String tableName) throws SQLException {
        DatabaseMetaData md = conn.getMetaData();
        // Note: use unquoted lower-case tableName; sanitize earlier to only [a-z0-9_]
        try (ResultSet rs = md.getTables(null, null, tableName, new String[]{"TABLE"})) {
            return rs.next();
        }
    }

    private static String buildCreateTableDDL(String tableName, List<String> headers, String dbType) {
        StringBuilder sb = new StringBuilder();
        sb.append("CREATE TABLE ").append(tableName).append(" (");
        for (int i = 0; i < headers.size(); i++) {
            String col = headers.get(i);
            sb.append(col).append(" ");
            // Use TEXT for portability (Postgres TEXT, MySQL TEXT)
            sb.append("TEXT");
            if (i < headers.size() - 1) sb.append(", ");
        }
        sb.append(")");
        return sb.toString();
    }

    private static String buildInsertSQL(String tableName, List<String> headers) {
        StringBuilder sb = new StringBuilder();
        sb.append("INSERT INTO ").append(tableName).append(" (");
        for (int i = 0; i < headers.size(); i++) {
            sb.append(headers.get(i));
            if (i < headers.size() - 1) sb.append(", ");
        }
        sb.append(") VALUES (");
        for (int i = 0; i < headers.size(); i++) {
            sb.append("?");
            if (i < headers.size() - 1) sb.append(", ");
        }
        sb.append(")");
        return sb.toString();
    }

    // -------------------- File discovery & parsing --------------------

    private static List<File> listCsvFilesChronologically(String dir) {
        File d = new File(dir);
        if (!d.exists() || !d.isDirectory()) {
            logErr("Input dir not found or not a directory: %s", dir);
            return Collections.emptyList();
        }
        File[] files = d.listFiles((f, name) -> name.toLowerCase(Locale.ROOT).endsWith(".csv"));
        if (files == null || files.length == 0) return Collections.emptyList();

        List<FileWithTime> withTimes = new ArrayList<>();
        for (File f : files) {
            LocalDateTime ts = extractTimestampFromName(f.getName());
            if (ts == null) {
                ts = LocalDateTime.ofInstant(new Date(f.lastModified()).toInstant(), ZoneId.systemDefault());
            }
            withTimes.add(new FileWithTime(f, ts));
        }

        withTimes.sort(Comparator.comparing(fwt -> fwt.ts));
        List<File> ordered = new ArrayList<>(withTimes.size());
        for (FileWithTime fwt : withTimes) ordered.add(fwt.file);
        return ordered;
    }

    private static LocalDateTime extractTimestampFromName(String name) {
        Matcher m = TS_IN_NAME.matcher(name);
        if (m.find()) {
            String ts = m.group(1);
            try {
                return LocalDateTime.parse(ts, TS_FMT);
            } catch (Exception ignored) {
            }
        }
        return null;
    }

    /**
     * Simple CSV line parser with quoted fields support.
     * For heavy-duty CSVs use a library (OpenCSV / Apache Commons CSV).
     */
    private static List<String> parseCsvLine(String line, String delimiter) {
        List<String> out = new ArrayList<>();
        if (line == null) return out;

        char delim = (delimiter == null || delimiter.isEmpty()) ? ',' : delimiter.charAt(0);
        StringBuilder cur = new StringBuilder();
        boolean inQuotes = false;

        for (int i = 0; i < line.length(); i++) {
            char c = line.charAt(i);
            if (c == '"') {
                if (inQuotes && i + 1 < line.length() && line.charAt(i + 1) == '"') {
                    cur.append('"');
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }
            } else if (c == delim && !inQuotes) {
                out.add(cur.toString());
                cur.setLength(0);
            } else {
                cur.append(c);
            }
        }
        out.add(cur.toString());
        return out;
    }

    private static List<String> sanitizeHeaders(List<String> raw) {
        List<String> out = new ArrayList<>(raw.size());
        Set<String> used = new HashSet<>();
        for (int i = 0; i < raw.size(); i++) {
            String h = raw.get(i);
            if (h == null) h = "col_" + (i + 1);
            h = h.trim().toLowerCase(Locale.ROOT);
            h = h.replaceAll("[^A-Za-z0-9_]", "_");
            if (h.isEmpty() || Character.isDigit(h.charAt(0))) {
                h = "c_" + h;
            }
            h = h.replaceAll("_+", "_");
            String base = h;
            int k = 1;
            while (used.contains(h) || h.equalsIgnoreCase("null")) {
                h = base + "_" + k++;
            }
            used.add(h);
            out.add(h);
        }
        return out;
    }

    private static List<String> generateColumnNames(int n) {
        List<String> cols = new ArrayList<>(n);
        for (int i = 1; i <= n; i++) cols.add("col_" + i);
        return cols;
    }

    // -------------------- DB connection util --------------------

    private static Connection connect(String dbType, String url, String user, String pass) throws Exception {
        switch (dbType) {
            case "psql":
            case "postgres":
            case "postgresql":
                Class.forName("org.postgresql.Driver");
                break;
            case "sql":
            case "mysql":
                Class.forName("com.mysql.cj.jdbc.Driver");
                break;
            default:
                throw new IllegalArgumentException("Unsupported dbType: " + dbType + " (use psql|sql)");
        }
        return DriverManager.getConnection(url, user, pass);
    }

    // Sanitize a name to a safe table identifier (lowercase, underscores)
    private static String sanitizeTableName(String raw) {
        if (raw == null || raw.isEmpty()) return "import_table";
        String t = raw;
        // remove extension if present
        int dot = t.lastIndexOf('.');
        if (dot > 0) t = t.substring(0, dot);
        t = t.trim().toLowerCase(Locale.ROOT);
        t = t.replaceAll("[^A-Za-z0-9_]", "_");
        if (t.isEmpty() || Character.isDigit(t.charAt(0))) t = "t_" + t;
        t = t.replaceAll("_+", "_");
        return t;
    }

    // -------------------- small helpers & DTOs --------------------

    private static int parseInt(String s, int def) {
        try { return Integer.parseInt(s.trim()); } catch (Exception e) { return def; }
    }

    private static boolean parseBoolean(String s) {
        if (s == null) return false;
        String v = s.trim().toLowerCase(Locale.ROOT);
        return v.equals("true") || v.equals("1") || v.equals("yes") || v.equals("y");
    }

    private static void log(String fmt, Object... args) {
        String ts = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").format(LocalDateTime.now());
        System.out.printf("[%s] [%s] %s%n", ts, PROCESS_NAME, String.format(fmt, args));
    }

    private static void logErr(String fmt, Object... args) {
        String ts = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").format(LocalDateTime.now());
        System.err.printf("[%s] [%s] %s%n", ts, PROCESS_NAME, String.format(fmt, args));
    }

    private static class FileProcessResult {
        final long inserted;
        final long failed;
        FileProcessResult(long inserted, long failed) { this.inserted = inserted; this.failed = failed; }
    }

    private static class FileWithTime {
        final File file;
        final LocalDateTime ts;
        FileWithTime(File f, LocalDateTime ts) { this.file = f; this.ts = ts; }
    }
}
