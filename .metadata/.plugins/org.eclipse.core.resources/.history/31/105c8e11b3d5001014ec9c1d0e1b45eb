package url_parserV1;

import java.io.*;
import java.nio.file.*;

public class url_parser_methods_login {
    public static void main(String[] args) throws Exception {

        // Run Tesseract command
        Process process = new ProcessBuilder(
                "tesseract",
                "captcha.png",
                "output",
                "--dpi", "300",
                "-l", "eng"
        ).start();

        process.waitFor();

        // Read output file
        String text = new String(Files.readAllBytes(Paths.get("output.txt"))).trim();

        System.out.println("Extracted CAPTCHA: " + text);
    }
}

