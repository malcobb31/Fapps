    // =====================================================================
    // MAX SNO / CHECKPOINT
    // =====================================================================

    /**
     * Read MAX(sno) from the configured trigger table. Unchanged from V1.
     */
    public long getTriggerMaxSno(
            Connection mysqlConn,
            String triggerTable) throws SQLException {

        validateIdentifier(triggerTable, "trigger_table");

        String sql =
                "SELECT COALESCE(MAX(sno), 0) "
                        + "FROM " + triggerTable;

        try (PreparedStatement ps = mysqlConn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            if (rs.next()) {
                return rs.getLong(1);
            }
        }

        return 0L;
    }

    /**
     * Establish maxSno only when it has not already been captured.
     * Unchanged from V1.
     */
    public long initializeMaxSno(
            Connection mysqlConn,
            String configTable,
            ParserConfigV2 config) throws SQLException {

        if (config.maxSno > 0) {
            return config.maxSno;
        }

        long maxSno =
                getTriggerMaxSno(
                        mysqlConn,
                        config.triggerTable
                );

        updateMaxSno(
                mysqlConn,
                configTable,
                config.sno,
                maxSno
        );

        config.maxSno = maxSno;

        return maxSno;
    }

    // =====================================================================
    // TRIGGER FETCH
    // =====================================================================

    /**
     * Fetch a batch within a fixed sno range.
     *
     * V2 adds where_clause to the selected columns. Everything else about
     * the bounded range / batch fetch behavior is unchanged from V1.
     *
     * The query intentionally still DOES NOT select insert_clause.
     */
    public List<TriggerRowV2> fetchDeleteTriggerBatch(
            Connection mysqlConn,
            String triggerTable,
            String sourceTableName,
            long cursorSno,
            long rangeEnd,
            int batchSize) throws SQLException {

        validateIdentifier(triggerTable, "trigger_table");

        String sql =
                "SELECT "
                        + "sno, "
                        + "record_time, "
                        + "table_name, "
                        + "primary_columns_name, "
                        + "primary_columns_value, "
                        + "type_of_operation, "
                        + "sync_status, "
                        + "where_clause "
                        + "FROM " + triggerTable + " "
                        + "WHERE sno > ? "
                        + "AND sno <= ? "
                        + "AND table_name = ? "
                        + "AND type_of_operation = 'DELETE' "
                        + "ORDER BY sno "
                        + "LIMIT ?";

        List<TriggerRowV2> rows = new ArrayList<>();

        try (PreparedStatement ps = mysqlConn.prepareStatement(sql)) {

            ps.setLong(1, cursorSno);
            ps.setLong(2, rangeEnd);
            ps.setString(3, sourceTableName);
            ps.setInt(4, batchSize);

            try (ResultSet rs = ps.executeQuery()) {

                while (rs.next()) {

                    TriggerRowV2 row = new TriggerRowV2();

                    row.sno = rs.getLong("sno");
                    row.recordTime = rs.getTimestamp("record_time");
                    row.tableName = rs.getString("table_name");
                    row.primaryColumnsName =
                            rs.getString("primary_columns_name");
                    row.primaryColumnsValue =
                            rs.getString("primary_columns_value");
                    row.typeOfOperation =
                            rs.getString("type_of_operation");
                    row.syncStatus =
                            rs.getString("sync_status");
                    row.whereClause =
                            rs.getString("where_clause");

                    rows.add(row);
                }
            }
        }

        return rows;
    }

