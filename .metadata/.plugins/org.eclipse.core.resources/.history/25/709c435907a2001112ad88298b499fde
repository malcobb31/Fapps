package delete_process_v2;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Pattern;

/**
 * delete_process_methods_v2
 *
 * V2 PK-driven DELETE synchronizer between MySQL trigger tables and
 * PostgreSQL target tables.
 *
 * This is a direct evolution of delete_process_methods (V1). The entire
 * processing model (configuration selection, maxSno/lastSno checkpointing,
 * bounded sno-range batching, trigger status transitions, Records_Deleted
 * accounting, error handling, and identifier validation) is preserved
 * unchanged in shape and behavior.
 *
 * THE ONLY MAJOR BEHAVIORAL CHANGE:
 *
 *  V1 built the DELETE predicate from:
 *      primary_columns_name + primary_columns_value
 *
 *  V2 builds the DELETE predicate from:
 *      where_clause
 *          -> parsed into column/value pairs
 *          -> mapped positionally via config.220_Col / config.Psql_Col
 *          -> normal-column ("col = ?") or JSONB ("col ->> 'key' = ?")
 *             predicates
 *          -> combined with AND
 *          -> bound as parameterized PostgreSQL DELETE
 *
 * IMPORTANT:
 *
 *  - insert_clause is NEVER read.
 *  - The 220/source business table is NEVER queried.
 *  - primary_columns_name / primary_columns_value are retained in the
 *    trigger row (still selected, still logged) but are NOT used to build
 *    the DELETE predicate anymore. where_clause is authoritative.
 *  - All runtime values are bound through PreparedStatement.
 *  - SQL identifiers are validated before being embedded in SQL.
 *  - This class does NOT open or close DB connections.
 */
public class delete_process_methods {

    /*
     * Range/checkpoint size. Same as V1.
     */
    private static final long RANGE_SIZE = 100000L;

    /*
     * Allow:
     *
     * document_id
     * metadata
     * kyc.documents
     *
     * Do not allow arbitrary SQL expressions.
     */
    private static final Pattern SAFE_IDENTIFIER =
            Pattern.compile(
                    "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
            );

    /*
     * JSONB key is deliberately more restrictive.
     */
    private static final Pattern SAFE_JSONB_KEY =
            Pattern.compile("^[A-Za-z0-9_]+$");

    /*
     * where_clause condition delimiter, e.g.:
     *
     * kig_id=12455299355^|knt_kyc_no=60044577650299
     */
    private static final String WHERE_CLAUSE_CONDITION_DELIMITER = "\\^\\|";

    /*
     * Literal string representing SQL NULL inside where_clause.
     */
    private static final String WHERE_CLAUSE_NULL_LITERAL = "NULL";

    private final Logger logger;

    public delete_process_methods(Logger logger) {
        this.logger = logger;
    }

    // =====================================================================
    // CONFIGURATION
    // =====================================================================

    /**
     * Load only configurations that are ready to run.
     *
     * Column names updated for V2 config_delete table:
     *
     *  220_Table_name
     *  220_Col   (renamed from 220_PK)
     *  Psql_Col  (renamed from Psql_PK)
     */
    public List<ParserConfigV2> loadEligibleConfigurations(
            Connection mysqlConn,
            String configTable) throws SQLException {

        validateIdentifier(configTable, "config_table");

        String sql =
                "SELECT "
                        + "sno, "
                        + "Psql_Table_name, "
                        + "`220_Table_name`, "
                        + "`220_Col`, "
                        + "Psql_Col, "
                        + "Status, "
                        + "Records_Deleted, "
                        + "Trigger_Table, "
                        + "maxSno, "
                        + "lastSno "
                        + "FROM " + configTable + " "
                        + "WHERE Status = 'INIT' "
                        + "ORDER BY sno";

        List<ParserConfigV2> configs = new ArrayList<>();

        try (PreparedStatement ps = mysqlConn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {

                ParserConfigV2 cfg = new ParserConfigV2();

                cfg.sno = rs.getLong("sno");
                cfg.psqlTableName = rs.getString("Psql_Table_name");
                cfg.sourceTableName = rs.getString("220_Table_name");
                cfg.sourceCol = rs.getString("220_Col");
                cfg.psqlCol = rs.getString("Psql_Col");
                cfg.status = rs.getString("Status");
                cfg.recordsDeleted = rs.getLong("Records_Deleted");
                cfg.triggerTable = rs.getString("Trigger_Table");
                cfg.maxSno = rs.getLong("maxSno");
                cfg.lastSno = rs.getLong("lastSno");

                configs.add(cfg);
            }
        }

        logger.log(
                "INFO",
                "CONFIG_SELECTED",
                "Eligible_Configs=" + configs.size()
        );

        return configs;
    }

    /**
     * Update configuration status. Unchanged from V1.
     */
    public void updateConfigStatus(
            Connection mysqlConn,
            String configTable,
            long configSno,
            String newStatus) throws SQLException {

        validateIdentifier(configTable, "config_table");

        String sql =
                "UPDATE " + configTable
                        + " SET Status = ? "
                        + "WHERE sno = ?";

        try (PreparedStatement ps = mysqlConn.prepareStatement(sql)) {

            ps.setString(1, newStatus);
            ps.setLong(2, configSno);

            ps.executeUpdate();
        }

        logger.log(
                "INFO",
                "CONFIG_STATUS_UPDATED",
                "Config_Sno=" + configSno
                        + " Status=" + newStatus
        );
    }

    /**
     * Persist Records_Deleted. Unchanged from V1.
     */
    public void updateRecordsDeleted(
            Connection mysqlConn,
            String configTable,
            long configSno,
            long recordsDeleted) throws SQLException {

        validateIdentifier(configTable, "config_table");

        String sql =
                "UPDATE " + configTable
