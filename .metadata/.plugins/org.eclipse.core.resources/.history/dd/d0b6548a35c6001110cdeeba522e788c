    public static void process(File inputPath, File archiveDir, String sourceJdbcUrl, String dbUser, String dbPass, String serverIP, String targetJdbcUrl, int configuredBatchSize) {
        DirectoryResult dirResult = new DirectoryResult();

        List<File> files = collectCsvFiles(inputPath);
        dirResult.totalFiles = files.size();

        log(
                "INFO",
                "process_start input_path=" + inputPath.getAbsolutePath() + " input_type=" + (inputPath.isFile() ? "file" : "directory"),
                serverIP,
                "PROCESS_START");

        log(
                "INFO",
                "directory_start input_path=" + inputPath.getAbsolutePath()
                        + " archive_dir=" + archiveDir.getAbsolutePath()
                        + " total_files=" + files.size()
                        + " batch_size=" + configuredBatchSize,
                serverIP,
                "DIRECTORY_START");

        if (files.isEmpty()) {
            logDirectorySummary(dirResult, serverIP);
            return;
        }

        final Map<String, String> reportingEntityMap;
        final Map<String, ReUserData> reUserMap;
        try {
            LookupData lookups = loadLookups(sourceJdbcUrl, dbUser, dbPass, serverIP);
            reportingEntityMap = lookups.reportingEntityMap;
            reUserMap = lookups.reUserMap;
            log("INFO", "lookups_loaded reporting_entity=" + reportingEntityMap.size()
                    + " re_user=" + reUserMap.size(), serverIP, "LOOKUP");
        } catch (SQLException sqle) {
            dirResult.errorFiles = files.size();
            dirResult.retainedFiles = files.size();
            log("ERROR", "fatal_error=lookup_load_failed reason=" + rootCause(sqle), serverIP, "FATAL_ERROR");
            logDirectorySummary(dirResult, serverIP);
            return;
        }

        int poolSize = getWorkerPoolSize(files.size());
        ExecutorService executor = Executors.newFixedThreadPool(poolSize);

        List<Future<FileResult>> futures = new ArrayList<Future<FileResult>>();
        for (int i = 0; i < files.size(); i++) {
            final File file = files.get(i);
            futures.add(executor.submit(new Callable<FileResult>() {
                public FileResult call() {
                    return processSingleFile(file, archiveDir, dbUser, dbPass, serverIP, targetJdbcUrl,
                            reportingEntityMap, reUserMap, configuredBatchSize);
                }
            }));
        }

        executor.shutdown();

        for (int i = 0; i < futures.size(); i++) {
            try {
                FileResult result = futures.get(i).get();

                dirResult.totalRows += result.dataRows;
                dirResult.inserted += result.inserted;
                dirResult.skipped += result.skipped;
                dirResult.dbFailed += result.dbFailed;
                dirResult.rowErrors += result.rowErrors;
                dirResult.batchFailures += result.batchFailures;
                dirResult.blankLines += result.blankLines;
                dirResult.unmatchedFiCode += result.unmatchedFiCode;
                dirResult.unmatchedUser += result.unmatchedUser;

                if ("SUCCESS".equals(result.status)) {
                    dirResult.completedFiles++;
                } else {
                    dirResult.retainedFiles++;
                }

                if ("EMPTY".equals(result.status)) {
                    dirResult.emptyFiles++;
                } else if ("HEADER_ONLY".equals(result.status)) {
                    dirResult.headerOnlyFiles++;
                } else if ("ERROR".equals(result.status)) {
                    dirResult.errorFiles++;
                }
            } catch (Exception ex) {
                dirResult.errorFiles++;
                dirResult.retainedFiles++;
                log(
                        "ERROR",
                        "fatal_error=directory_worker_failure reason=" + rootCause(ex),
                        serverIP,
                        "FATAL_ERROR");
            }
        }

        logDirectorySummary(dirResult, serverIP);
    }

    private static int getWorkerPoolSize(int fileCount) {
        int cpu = Runtime.getRuntime().availableProcessors();
        int preferred = cpu / 2;
        if (preferred < 1) {
            preferred = 1;
        }
        if (preferred > MAX_PARALLEL_FILES) {
            preferred = MAX_PARALLEL_FILES;
        }
        if (fileCount < preferred) {
            return fileCount;
        }
        return preferred;
    }

    private static FileResult processSingleFile(File file, File archiveDir, String dbUser, String dbPass,
            String serverIP, String targetJdbcUrl, Map<String, String> reportingEntityMap,
            Map<String, ReUserData> reUserMap, int configuredBatchSize) {
        FileResult result = new FileResult(file.getName());

        log("INFO", "file_start file=" + file.getName(), serverIP, "FILE_START");

        BufferedReader reader = null;
        Connection targetConnection = null;
        PreparedStatement ps = null;

        boolean headerCaptured = false;
        boolean dbInitialized = false;
        boolean commitSuccess = false;

        String[] header = null;
        int currentBatchCount = 0;
        int batchSize = prepareBatchSize(configuredBatchSize);
        result.effectiveBatchSize = batchSize;

        try {
            reader = new BufferedReader(
                    new InputStreamReader(
                            new FileInputStream(file),
                            Charset.forName("UTF-8")));

            String line;

            while ((line = reader.readLine()) != null) {
                if (line.trim().length() == 0) {
                    result.blankLines++;
                    continue;
                }

                List<String> parsed = parseCsvLine(line);
                String[] row = toArray(parsed);

                if (!headerCaptured) {
                    if (row.length == 0) {
                        continue;
                    }
                    row[0] = removeBom(row[0]);
                    header = row;
                    headerCaptured = true;
                    continue;
                }

                result.dataRows++;

                if (!dbInitialized) {
                    // Target connection: INSERT/UPDATE/transaction only.
                    targetConnection = DriverManager.getConnection(targetJdbcUrl, dbUser, dbPass);
                    targetConnection.setAutoCommit(false);

                    ps = targetConnection.prepareStatement(INSERT_SQL);

                    log(
                            "INFO",
                            "file=" + file.getName() + "\nsql=" + INSERT_SQL,
                            serverIP,
                            "INSERT_SQL");

                    dbInitialized = true;
                }

                RowData mapped = mapRow(header, row);
                if (mapped == null) {
                    result.skipped++;
                    continue;
                }

                if (!enrichFromLookups(mapped, reportingEntityMap, reUserMap, result, file.getName(), serverIP)) {
                    result.skipped++;
                    continue;
                }

                bindUpsertRow(ps, mapped);
                ps.addBatch();
                currentBatchCount++;

                if (currentBatchCount >= batchSize) {
                    try {
                        ps.executeBatch();
                        ps.clearBatch();
                    } catch (SQLException sqle) {
                        result.batchFailures++;
                        result.dbFailed += currentBatchCount;
                        log(
                                "ERROR",
                                "file=" + file.getName()
                                        + "\nbatch_size=" + currentBatchCount
                                        + "\nreason=" + rootCause(sqle),
                                serverIP,
                                "BATCH_ERROR");
                        throw sqle;
                    }
                    currentBatchCount = 0;
                }
            }

            if (!headerCaptured) {
                result.status = "EMPTY";
                result.moved = false;
                logFileCompletion(result, serverIP);
                return result;
            }

            if (result.dataRows == 0) {
                result.status = "HEADER_ONLY";
                result.moved = false;
                logFileCompletion(result, serverIP);
                return result;
            }

            if (currentBatchCount > 0 && ps != null) {
                try {
                    ps.executeBatch();
                    ps.clearBatch();
                } catch (SQLException sqle) {
                    result.batchFailures++;
                    result.dbFailed += currentBatchCount;
                    log(
                            "ERROR",
                            "file=" + file.getName()
                                    + "\nbatch_size=" + currentBatchCount
                                    + "\nreason=" + rootCause(sqle),
                            serverIP,
                            "BATCH_ERROR");
                    throw sqle;
                }
            }

            if (dbInitialized) {
                targetConnection.commit();
                commitSuccess = true;
                result.inserted = result.dataRows - result.skipped;
                result.status = "SUCCESS";

                try {
                    moveFile(file, archiveDir);
                    result.moved = true;
                    log("INFO", "file_moved file=" + file.getName(), serverIP, "FILE_MOVED");
                } catch (IOException ioe) {
                    result.status = "ERROR";
                    result.moved = false;
                    log(
                            "ERROR",
                            "file=" + file.getName() + "\nreason=" + rootCause(ioe),
                            serverIP,
                            "FILE_ERROR");
                }
            } else {
                result.status = "HEADER_ONLY";
                result.moved = false;
            }

        } catch (FatalProcessingException fpe) {
            rollbackQuietly(targetConnection);
            result.status = "ERROR";
            result.moved = false;
            result.inserted = 0;
            log(
                    "ERROR",
                    "file=" + file.getName() + "\nreason=" + rootCause(fpe),
                    serverIP,
                    "FATAL_ERROR");
        } catch (SQLException sqle) {
            rollbackQuietly(targetConnection);
            result.status = "ERROR";
            result.moved = false;
            result.inserted = 0;
            log(
                    "ERROR",
                    "file=" + file.getName() + "\nreason=" + rootCause(sqle),
                    serverIP,
                    "FATAL_ERROR");
        } catch (RuntimeException re) {
            rollbackQuietly(targetConnection);
            result.status = "ERROR";
            result.moved = false;
            result.inserted = 0;
            log(
                    "ERROR",
                    "file=" + file.getName() + "\nreason=" + rootCause(re),
                    serverIP,
                    "FATAL_ERROR");
        } catch (Exception ex) {
            rollbackQuietly(targetConnection);
            result.status = "ERROR";
            result.moved = false;
            result.inserted = 0;
            log(
                    "ERROR",
                    "file=" + file.getName() + "\nreason=" + rootCause(ex),
                    serverIP,
                    "FATAL_ERROR");
        } finally {
            closeQuietly(ps);
            closeQuietly(targetConnection);
            closeQuietly(reader);

            if (!commitSuccess && "SUCCESS".equals(result.status)) {
                result.status = "ERROR";
            }
        }

        logFileCompletion(result, serverIP);
        return result;
    }

    private static int prepareBatchSize(int configuredBatchSize) {
        int batchSize = configuredBatchSize;
        if (batchSize <= 0) {
            batchSize = DEFAULT_BATCH_SIZE;
        }
        if (batchSize > MAX_RECOMMENDED_BATCH_SIZE) {
            batchSize = MAX_RECOMMENDED_BATCH_SIZE;
        }
        return batchSize;
    }

    private static List<File> collectCsvFiles(File inputPath) {
        if (inputPath == null || !inputPath.exists()) {
            return Collections.emptyList();
        }

        List<File> files = new ArrayList<File>();

        if (inputPath.isFile()) {
            if (isCsvFile(inputPath)) {
                files.add(inputPath);
            }
            return files;
        }

        File[] listed = inputPath.listFiles();
        if (listed == null || listed.length == 0) {
            return files;
        }

        for (int i = 0; i < listed.length; i++) {
            File f = listed[i];
            if (f != null && f.isFile() && isCsvFile(f)) {
                files.add(f);
            }
        }

        Collections.sort(files, new Comparator<File>() {
            public int compare(File a, File b) {
                return a.getName().compareToIgnoreCase(b.getName());
            }
        });

        return files;
    }

    private static boolean isCsvFile(File file) {
        if (file == null) {
            return false;
        }
        String name = file.getName();
        if (name == null) {
            return false;
        }
        return name.toLowerCase(Locale.ENGLISH).endsWith(".csv");
    }

    private static List<String> parseCsvLine(String line) throws FatalProcessingException {
        List<String> values = new ArrayList<String>();
        if (line == null) {
            return values;
        }

        StringBuilder current = new StringBuilder();
        boolean inQuotes = false;
        int length = line.length();

        for (int i = 0; i < length; i++) {
            char ch = line.charAt(i);

            if (ch == '\\' && inQuotes && i + 1 < length && line.charAt(i + 1) == '"') {
                // Preserve JSON-style escaped quotes inside a field; they do not close the CSV field.
                current.append(ch).append('"');
                i++;
            } else if (ch == '"') {
                if (inQuotes && i + 1 < length && line.charAt(i + 1) == '"') {
                    current.append('"');
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }
            } else if (ch == '|' && !inQuotes) {
                values.add(current.toString());
                current.setLength(0);
            } else {
                current.append(ch);
            }
        }

        if (inQuotes) {
            throw new FatalProcessingException("unclosed_quotes");
        }

        values.add(current.toString());
        return values;
    }

    private static String[] toArray(List<String> values) {
        String[] arr = new String[values.size()];
        for (int i = 0; i < values.size(); i++) {
            arr[i] = values.get(i);
        }
        return arr;
    }

    private static RowData mapRow(String[] header, String[] row) throws FatalProcessingException {
        if (header == null || header.length == 0) {
            throw new FatalProcessingException("missing_header");
        }

        if (row == null) {
            throw new FatalProcessingException("unexpected_null_row");
        }

        if (row.length > header.length) {
            for (int i = header.length; i < row.length; i++) {
                String extra = normalize(row[i]);
                if (extra != null) {
                    throw new FatalProcessingException("malformed_csv_row");
                }
            }
        }

        Map<String, String> sourceMap = new LinkedHashMap<String, String>();
        for (int i = 0; i < header.length; i++) {
            String h = cleanHeader(header[i]);
            if (h == null || h.length() == 0) {
                continue;
            }

            String value = null;
            if (i < row.length) {
                value = normalize(row[i]);
            }
            sourceMap.put(h.toLowerCase(Locale.ENGLISH), value);
        }

        String ckycNoText = normalize(sourceMap.get("kli_kyc_no"));
        if (ckycNoText == null) {
            return null;
        }

        Long ckycNo;
        try {
            ckycNo = Long.valueOf(ckycNoText);
        } catch (NumberFormatException ex) {
            throw new FatalProcessingException("invalid_ckyc_no=" + ckycNoText);
        }
        if (ckycNo == null) {
            return null;
        }

        String entityType = deriveEntityType(ckycNoText);
        if (entityType == null) {
            return null;
        }

        String delinkStatus = sourceMap.get("delink_status");
        // Match the reference parser: a populated delink_status means ACTIVE; NULL/blank means INACTIVE.
        boolean active = !isEmptyTrim(delinkStatus);
        String operationalStatus = active ? "ACTIVE" : "INACTIVE";

        Map<String, String> metadata = new LinkedHashMap<String, String>();
        for (int i = 0; i < header.length; i++) {
            String h = cleanHeader(header[i]);
            if (h == null || h.length() == 0) {
                continue;
            }

            String lower = h.toLowerCase(Locale.ENGLISH);
            if (isMappedHeader(lower)) {
                continue;
            }

            String value = null;
            if (i < row.length) {
                value = normalize(row[i]);
            }

            if (value != null) {
                metadata.put(lower, value);
            }
        }

        RowData data = new RowData();
        data.ckycNo = ckycNo;
        data.ckycReferenceNo = firstNonNull(sourceMap, "ckyc_reference_no", "ckyc_reference_id", "kli_kyc_reference_no");
        data.entityType = entityType;
        data.reportingEntityId = normalize(sourceMap.get("reporting_entity_id"));
        data.userId = firstNonNull(sourceMap, "user_id", "kli_created_by");
        data.title = normalize(sourceMap.get("title"));
        data.firstName = normalize(sourceMap.get("first_name"));
        data.middleName = normalize(sourceMap.get("middle_name"));
        data.lastName = normalize(sourceMap.get("last_name"));
        data.designation = normalize(sourceMap.get("designation"));
        data.email = normalize(sourceMap.get("email"));
        data.citizenship = normalize(sourceMap.get("citizenship"));
        data.countryCode = normalize(sourceMap.get("country_code"));
        data.mobile = normalize(sourceMap.get("mobile"));
        data.poi = normalize(sourceMap.get("poi"));
        data.poiNumber = normalize(sourceMap.get("poi_number"));
        data.dob = parseDate(sourceMap.get("dob"));
        data.gender = normalize(sourceMap.get("gender"));
        data.employeeId = normalize(sourceMap.get("employee_id"));
        data.keycloakUserId = safeUuid(firstNonNull(sourceMap, "keycloak_user_id", "key_cloak_user_id"));
        data.userType = normalize(sourceMap.get("user_type"));
        data.operationalStatus = operationalStatus;
        data.region = normalize(sourceMap.get("region"));
        data.regionCode = firstNonNull(sourceMap, "region_code", "kli_reg_code");
        data.relationType = "DOWNLOAD";
        data.relationActive = Boolean.valueOf(active);
        data.createdBy = firstNonNull(sourceMap, "created_by", "kli_created_by");
        data.updatedBy = firstNonNull(sourceMap, "updated_by", "kli_updated_by");
        data.createdDate = parseTimestamp(firstNonNull(sourceMap, "created_date", "kli_created_date"));
        data.updatedDate = parseTimestamp(firstNonNull(sourceMap, "updated_date", "kli_updated_date"));
        data.closedAt = null;
        data.closedBy = null;
        data.closureRemarks = null;
        data.closureDate = null;
        data.approverUserId = normalize(sourceMap.get("approver_user_id"));
        data.approverReId = normalize(sourceMap.get("approver_re_id"));
        data.workflowId = normalize(sourceMap.get("workflow_id"));
        data.fiCode = firstNonNull(sourceMap, "fi_code", "kli_fi_code");
        data.reName = normalize(sourceMap.get("re_name"));
        data.branchCode = firstNonNull(sourceMap, "branch_code", "kli_br_code");
        data.metadata = toJson(metadata);

        return data;
    }

    private static boolean isMappedHeader(String lowerHeader) {
        if (lowerHeader == null) {
            return false;
        }

        for (int i = 0; i < MAPPED_HEADERS.length; i++) {
            if (lowerHeader.equals(MAPPED_HEADERS[i])) {
                return true;
            }
        }
        return false;
    }

    private static String deriveEntityType(String ckycNoText) {
        ckycNoText = normalize(ckycNoText);
        if (ckycNoText == null || ckycNoText.length() == 0) {
            return null;
        }

        // Use the original text so a leading zero cannot change the derived type.
        char first = ckycNoText.charAt(0);

        if (first >= '1' && first <= '6') {
            return "I";
        }

        if (first >= '7' && first <= '9') {
            return "L";
        }

        return null;
    }

    private static Timestamp parseTimestamp(String value) throws FatalProcessingException {
        value = normalize(value);
        if (value == null) {
            return null;
        }

        String[] patterns = new String[] {
                "yyyy-MM-dd HH:mm:ss",
                "yyyy-MM-dd HH:mm:ss.SSS",
                "yyyy-MM-dd'T'HH:mm:ss",
                "yyyy-MM-dd'T'HH:mm:ss.SSS",
                "yyyy-MM-dd HH:mm:ssXXX",
                "yyyy-MM-dd HH:mm:ss.SSSXXX",
                "yyyy-MM-dd'T'HH:mm:ssXXX",
                "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"
        };

        for (int i = 0; i < patterns.length; i++) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat(patterns[i]);
                sdf.setLenient(false);
                java.util.Date d = sdf.parse(value);
                return new Timestamp(d.getTime());
            } catch (Exception ex) {
                // try next format
            }
        }

        throw new FatalProcessingException("invalid_timestamp=" + value);
    }

    @SuppressWarnings("unused")
    private static Date parseDate(String value) throws FatalProcessingException {
        value = normalize(value);
        if (value == null) {
            return null;
        }

        String[] patterns = new String[] {
                "yyyy-MM-dd",
                "yyyy/MM/dd",
                "dd-MM-yyyy",
                "dd/MM/yyyy"
        };

        for (int i = 0; i < patterns.length; i++) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat(patterns[i]);
                sdf.setLenient(false);
                java.util.Date d = sdf.parse(value);
                return new Date(d.getTime());
            } catch (Exception ex) {
                // try next format
            }
        }

        throw new FatalProcessingException("invalid_date=" + value);
    }

    private static void bindUpsertRow(PreparedStatement ps, RowData row) throws SQLException {
        int idx = 1;
        if (row.ckycNo == null) ps.setNull(idx++, java.sql.Types.BIGINT);
        else ps.setLong(idx++, row.ckycNo.longValue());
        ps.setString(idx++, row.ckycReferenceNo);
        ps.setString(idx++, row.entityType);
        ps.setString(idx++, row.reportingEntityId);
        ps.setString(idx++, row.userId);
        ps.setString(idx++, row.title);
        ps.setString(idx++, row.firstName);
        ps.setString(idx++, row.middleName);
        ps.setString(idx++, row.lastName);
        ps.setString(idx++, row.designation);
        ps.setString(idx++, row.email);
        ps.setString(idx++, row.citizenship);
        ps.setString(idx++, row.countryCode);
        ps.setString(idx++, row.mobile);
        ps.setString(idx++, row.poi);
        ps.setString(idx++, row.poiNumber);
        if (row.dob == null) ps.setNull(idx++, java.sql.Types.DATE);
        else ps.setDate(idx++, row.dob);
        ps.setString(idx++, row.gender);
        ps.setString(idx++, row.employeeId);
        ps.setString(idx++, row.keycloakUserId);
        ps.setString(idx++, row.userType);
        ps.setString(idx++, row.operationalStatus);
        ps.setString(idx++, row.region);
        ps.setString(idx++, row.regionCode);
        ps.setString(idx++, row.relationType);
        if (row.relationActive == null) ps.setNull(idx++, java.sql.Types.BOOLEAN);
        else ps.setBoolean(idx++, row.relationActive.booleanValue());
        ps.setString(idx++, row.createdBy);
        ps.setString(idx++, row.updatedBy);
        if (row.createdDate == null) ps.setNull(idx++, java.sql.Types.TIMESTAMP);
        else ps.setTimestamp(idx++, row.createdDate);
        if (row.updatedDate == null) ps.setNull(idx++, java.sql.Types.TIMESTAMP);
        else ps.setTimestamp(idx++, row.updatedDate);
        if (row.closedAt == null) ps.setNull(idx++, java.sql.Types.TIMESTAMP);
        else ps.setTimestamp(idx++, row.closedAt);
        ps.setString(idx++, row.closedBy);
        ps.setString(idx++, row.closureRemarks);
        if (row.closureDate == null) ps.setNull(idx++, java.sql.Types.DATE);
        else ps.setDate(idx++, row.closureDate);
        ps.setString(idx++, row.approverUserId);
        ps.setString(idx++, row.approverReId);
        ps.setString(idx++, row.workflowId);
        ps.setString(idx++, row.fiCode);
        ps.setString(idx++, row.reName);
        ps.setString(idx++, row.branchCode);
        ps.setString(idx++, row.metadata);
    }

    private static boolean enrichFromLookups(RowData data, Map<String, String> reportingEntityMap,
            Map<String, ReUserData> reUserMap, FileResult result, String fileName, String serverIP) {
        String fiCode = normalize(data.fiCode);
        String directReportingEntityId = normalize(data.reportingEntityId);
        String lookupReportingEntityId = fiCode == null ? null : reportingEntityMap.get(fiCode);

        // Preserve a value already supplied in the CSV; lookup only fills a missing value.
        if (directReportingEntityId == null) {
            data.reportingEntityId = lookupReportingEntityId;
        }
        if (normalize(data.reportingEntityId) == null) {
            result.unmatchedFiCode++;
            log("WARN", "file=" + fileName + " no_reporting_entity_match fi_code="
                    + (fiCode == null ? "NULL" : fiCode) + " row_will_be_imported=true",
                    serverIP, "LOOKUP_WARN");
        }

        String userId = normalize(data.userId);
        if (userId != null) {
            ReUserData user = reUserMap.get(userId);
            if (user != null) {
                // A populated CSV field wins. The app DB lookup supplies only missing profile values.
                data.title = firstNonNull(data.title, user.title);
                data.firstName = firstNonNull(data.firstName, user.firstName);
                data.middleName = firstNonNull(data.middleName, user.middleName);
                data.lastName = firstNonNull(data.lastName, user.lastName);
                data.designation = firstNonNull(data.designation, user.designation);
                data.email = firstNonNull(data.email, user.email);
                data.citizenship = firstNonNull(data.citizenship, user.citizenship);
                data.countryCode = firstNonNull(data.countryCode, user.countryCode);
                data.mobile = firstNonNull(data.mobile, user.mobile);
                data.poi = firstNonNull(data.poi, user.poi);
                data.poiNumber = firstNonNull(data.poiNumber, user.poiNumber);
                data.dob = data.dob != null ? data.dob : user.dob;
                data.gender = firstNonNull(data.gender, user.gender);
                data.employeeId = firstNonNull(data.employeeId, user.employeeId);
                data.keycloakUserId = firstNonNull(data.keycloakUserId, user.keycloakUserId);
                data.userType = firstNonNull(data.userType, user.userType);
                data.reName = firstNonNull(data.reName,
                        buildFullName(data.firstName, data.middleName, data.lastName));
            } else {
                result.unmatchedUser++;
                log("WARN", "file=" + fileName + " no_re_user_match user_id=" + userId
                        + " row_will_be_imported=true", serverIP, "LOOKUP_WARN");
            }
        } else {
            result.unmatchedUser++;
            log("WARN", "file=" + fileName + " missing_user_id_for_re_user_lookup row_will_be_imported=true",
                    serverIP, "LOOKUP_WARN");
        }
        return true;
    }

    private static LookupData loadLookups(String jdbcUrl, String dbUser, String dbPass, String serverIP)
            throws SQLException {
        Connection connection = null;
        try {
            connection = DriverManager.getConnection(jdbcUrl, dbUser, dbPass);
            LookupData result = new LookupData();
            result.reportingEntityMap = loadReportingEntityMap(connection, serverIP);
            result.reUserMap = loadReUserMap(connection, serverIP);
            return result;
        } finally {
            closeQuietly(connection);
        }
    }

    private static Map<String, String> loadReportingEntityMap(Connection connection, String serverIP)
            throws SQLException {
        Map<String, String> map = new HashMap<String, String>();
        Set<String> ambiguousKeys = new HashSet<String>();
        PreparedStatement ps = null;
        ResultSet rs = null;
        try {
            log("INFO", "sql=" + SQL_REPORTING_ENTITY_ALL, serverIP, "LOOKUP");
            ps = connection.prepareStatement(SQL_REPORTING_ENTITY_ALL);
            rs = ps.executeQuery();
            while (rs.next()) {
                String fiCode = normalize(rs.getString("fi_code"));
                String id = normalize(rs.getString("id"));
                if (fiCode == null || id == null || ambiguousKeys.contains(fiCode)) {
                    continue;
                }
                if (map.containsKey(fiCode)) {
                    map.remove(fiCode);
                    ambiguousKeys.add(fiCode);
                    log("WARN", "lookup=reporting_entity key_fi_code=" + fiCode
                            + " result=AMBIGUOUS value_not_used=true", serverIP, "LOOKUP_AMBIGUOUS");
                } else {
                    map.put(fiCode, id);
                }
            }
        } finally {
            closeQuietly(rs);
            closeQuietly(ps);
        }
        return map;
    }

    private static Map<String, ReUserData> loadReUserMap(Connection connection, String serverIP)
            throws SQLException {
        Map<String, ReUserData> map = new HashMap<String, ReUserData>();
        Set<String> ambiguousKeys = new HashSet<String>();
        PreparedStatement ps = null;
        ResultSet rs = null;
        try {
            log("INFO", "sql=" + SQL_RE_USER_ALL, serverIP, "LOOKUP");
            ps = connection.prepareStatement(SQL_RE_USER_ALL);
            rs = ps.executeQuery();
            while (rs.next()) {
                String userId = normalize(rs.getString("user_id"));
                if (userId == null || ambiguousKeys.contains(userId)) {
                    continue;
                }
                ReUserData user = new ReUserData();
                user.title = normalize(rs.getString("title"));
                user.firstName = normalize(rs.getString("first_name"));
                user.middleName = normalize(rs.getString("middle_name"));
                user.lastName = normalize(rs.getString("last_name"));
                user.designation = normalize(rs.getString("designation"));
                user.email = normalize(rs.getString("email"));
                user.citizenship = normalize(rs.getString("citizenship"));
                user.countryCode = normalize(rs.getString("country_code"));
                user.mobile = normalize(rs.getString("mobile"));
                user.poi = normalize(rs.getString("poi"));
                user.poiNumber = normalize(rs.getString("poi_number"));
                user.dob = rs.getDate("dob");
                user.gender = normalize(rs.getString("gender"));
                user.employeeId = normalize(rs.getString("employee_id"));
                user.keycloakUserId = safeUuid(rs.getString("key_cloak_user_id"));
                user.userType = normalize(rs.getString("user_type"));

                if (map.containsKey(userId)) {
                    map.remove(userId);
                    ambiguousKeys.add(userId);
                    log("WARN", "lookup=re_user key_user_id=" + userId
                            + " result=AMBIGUOUS values_not_used=true", serverIP, "LOOKUP_AMBIGUOUS");
                } else {
                    map.put(userId, user);
                }
            }
        } finally {
            closeQuietly(rs);
            closeQuietly(ps);
        }
        return map;
    }

    private static String buildFullName(String firstName, String middleName, String lastName) {
        StringBuilder sb = new StringBuilder();
        appendNamePart(sb, firstName);
        appendNamePart(sb, middleName);
        appendNamePart(sb, lastName);
        return sb.length() == 0 ? null : sb.toString();
    }

    private static void appendNamePart(StringBuilder sb, String value) {
        String part = normalize(value);
        if (part == null) return;
        if (sb.length() > 0) sb.append(' ');
        sb.append(part);
    }

    private static String firstNonNull(Map<String, String> sourceMap, String... keys) {
        if (sourceMap == null || keys == null) return null;
        for (int i = 0; i < keys.length; i++) {
            String value = normalize(sourceMap.get(keys[i]));
            if (value != null) return value;
        }
        return null;
    }

    private static String firstNonNull(String first, String fallback) {
        return normalize(first) != null ? normalize(first) : normalize(fallback);
    }

    private static String safeUuid(String value) {
        value = normalize(value);
        if (value == null) return null;
        try {
            return java.util.UUID.fromString(value).toString();
        } catch (IllegalArgumentException ex) {
            return null;
        }
    }

    private static void moveFile(File sourceFile, File archiveDir) throws IOException {
        if (sourceFile == null || archiveDir == null) {
            return;
        }

        File targetFile = new File(archiveDir, sourceFile.getName());
        Files.move(sourceFile.toPath(), targetFile.toPath(), StandardCopyOption.REPLACE_EXISTING);
    }

