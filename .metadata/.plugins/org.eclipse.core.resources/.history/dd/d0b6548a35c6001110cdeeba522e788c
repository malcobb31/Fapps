        sb.append("closed_at, closed_by, closure_remarks, closure_date, approver_user_id, approver_re_id, workflow_id, fi_code, re_name, branch_code, metadata) ");
        sb.append("SELECT nr.ckyc_no, nr.ckyc_reference_no, nr.entity_type, nr.reporting_entity_id, nr.user_id, nr.title, ");
        sb.append("nr.first_name, nr.middle_name, nr.last_name, nr.designation, nr.email, nr.citizenship, nr.country_code, nr.mobile, ");
