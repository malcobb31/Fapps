	private void importCSVUsingPsql(String csvFilePath, String tableName, DatabaseConfig dbConfig, String serverIP,
	        int bulkSize) throws Exception {

	    Connection conn = null;

	    int totalRows = 0;
	    int chunkCount = 0;

	    char delim = '|'; // PIPE delimiter

	    try {
	        conn = DriverManager.getConnection(dbConfig.url, dbConfig.user, dbConfig.password);
	        conn.setAutoCommit(false);

	        // ---------------------------------------------------
	        // Fetch DB metadata (types + NOT NULL + columns order)
	        // ---------------------------------------------------
	        TableMeta pgMeta = fetchPostgresTableMeta(conn, tableName, serverIP);

	        if (pgMeta == null || pgMeta.columns.isEmpty()) {
	            throw new Exception("PostgreSQL table metadata not found for table=" + tableName);
	        }

	        try (BufferedReader br = new BufferedReader(new FileReader(csvFilePath))) {

	            // -------- HEADER ----------
	            String headerLine = br.readLine();
	            if (headerLine == null) {
	                throw new Exception("CSV file is empty: " + csvFilePath);
	            }

	            // Strict pipe-quoted parsing: "col"|"col"
	            List<String> headerCols = parseStrictPipeQuotedRow(headerLine);
	            if (headerCols == null || headerCols.isEmpty()) {
	                throw new Exception("Header could not be parsed: " + csvFilePath);
	            }

	            // Normalize header names (safe)
	            List<String> csvColumns = headerCols.stream()
	                    .map(s -> s == null ? "" : s.replace("\"", "").trim().toLowerCase())
	                    .filter(s -> !s.isEmpty())
	                    .collect(Collectors.toList());

	            if (csvColumns.isEmpty()) {
	                throw new Exception("CSV header is empty/invalid after cleaning: " + csvFilePath);
	            }

	            // ---------------------------------------------------
	            // PARTIAL + REORDER SUPPORT:
	            // matchedCols = intersection(CSV cols, DB cols)
	            // Keep order of CSV header (because CSV row values follow that order)
	            // ---------------------------------------------------
	            List<String> matchedCols = new ArrayList<>();
	            for (String csvCol : csvColumns) {
	                for (String dbCol : pgMeta.columns) {
	                    if (dbCol != null && dbCol.equalsIgnoreCase(csvCol)) {
	                        matchedCols.add(dbCol.toLowerCase());
	                        break;
	                    }
	                }
	            }

	            if (matchedCols.isEmpty()) {
	                throw new Exception("No matching columns found between CSV and PostgreSQL table=" + tableName
	                        + " file=" + csvFilePath
	                        + " CSV_Cols=" + csvColumns
	                        + " DB_Cols=" + pgMeta.columns);
	            }

	            log("INFO",
	                    "PostgreSQL PARTIAL column validation passed - table=" + tableName
	                            + " CSV_Cols=" + csvColumns.size()
	                            + " DB_Cols=" + pgMeta.columns.size()
	                            + " Matched_Cols=" + matchedCols.size(),
	                    serverIP,
	                    "PSQL_COL_VALIDATION");

	            // ---------------------------------------------------
	            // COPY SQL (matched columns only, in CSV header order)
	            // ---------------------------------------------------
	            String copySQL = "COPY " + tableName + " (" + String.join(",", matchedCols)
	                    + ") FROM STDIN WITH (FORMAT csv, HEADER false, DELIMITER '|', "
	                    + "QUOTE '\"', ESCAPE '\"', NULL 'NULL')";

	            List<String> chunkLines = new ArrayList<>(bulkSize);

	            // -------- DATA ----------
	            String line;
	            long rowNo = 1; // header already read

	            while ((line = br.readLine()) != null) {
	                rowNo++;

	                if (line == null || line.isEmpty()) {
	                    continue;
	                }

	                // Strict parse: expects "val"|"val"
	                List<String> parsed = parseStrictPipeQuotedRow(line);

	                // CSV row must match CSV header count
	                if (parsed.size() != csvColumns.size()) {
	                    throw new Exception("Column mismatch! Expected=" + csvColumns.size()
	                            + " Found=" + parsed.size()
	                            + " File=" + csvFilePath
	                            + " RowNo=" + rowNo
	                            + " RawRow=" + line);
	                }

	                // ---------------------------------------------------
	                // Build row ONLY for matched columns (reordered mapping)
	                // ---------------------------------------------------
	                String fixedLine = buildSafeCopyRowPostgresPartial(
	                        parsed,
	                        csvColumns,
	                        matchedCols,
	                        pgMeta,
	                        delim
	                );

	                chunkLines.add(fixedLine);
	                totalRows++;

	                if (chunkLines.size() >= bulkSize) {
	                    executeCopyChunk(conn, copySQL, chunkLines);
	                    conn.commit();

	                    chunkCount++;
	                    log("INFO", "Processed chunk " + chunkCount + " with " + chunkLines.size() + " rows",
	                            serverIP, "PSQL_CHUNK");

	                    chunkLines.clear();
	                }
	            }

	            if (!chunkLines.isEmpty()) {
	                executeCopyChunk(conn, copySQL, chunkLines);
	                conn.commit();

	                chunkCount++;
	                log("INFO", "Processed final chunk " + chunkCount + " with " + chunkLines.size() + " rows",
	                        serverIP, "PSQL_CHUNK");
	            }

	            log("INFO", "PostgreSQL COPY completed (PARTIAL) - tableName:" + tableName
	                    + " Total_Rows:" + totalRows
	                    + " File:" + csvFilePath
	                    + " Matched_Cols:" + matchedCols.size(),
	                    serverIP, "PSQL_IMPORT_SUCCESS");
	        }

	    } catch (Exception e) {
	        try {
	            if (conn != null) conn.rollback();
	        } catch (Exception ignore) {}

	        log("ERROR", "COPY failed: " + e.getMessage(), serverIP, "PSQL_IMPORT_ERROR");
	        throw e;

	    } finally {
	        if (conn != null) {
	            try { conn.setAutoCommit(true); } catch (Exception ignore) {}
	            closeQuietly(conn);
	        }
	    }
	}

	private String buildSafeCopyRowPostgresPartial(
	        List<String> rowFields,
	        List<String> csvColumns,
	        List<String> matchedCols,
	        TableMeta meta,
	        char delimiter) throws Exception {

	    StringBuilder sb = new StringBuilder();

	    for (int i = 0; i < matchedCols.size(); i++) {

	        String colName = matchedCols.get(i);

	        // Find column index in CSV header
	        int csvIndex = -1;
	        for (int k = 0; k < csvColumns.size(); k++) {
	            if (csvColumns.get(k).equalsIgnoreCase(colName)) {
	                csvIndex = k;
	                break;
	            }
	        }

	        String v = (csvIndex >= 0 && csvIndex < rowFields.size()) ? rowFields.get(csvIndex) : "";
	        if (v == null) v = "";

	        // ==========================================================
	        // IMPORTANT: PRESERVE SPACES (DO NOT TRIM)
	        // ==========================================================
	        v = v.replace("\uFEFF", "");                 // remove BOM only
	        v = v.replace("\r", " ").replace("\n", " "); // safe cleanup, keep spaces

	        // Remove surrounding quotes if present
	        if (v.length() >= 2 && v.startsWith("\"") && v.endsWith("\"")) {
	            v = v.substring(1, v.length() - 1);
	        }

	        boolean isNotNull = meta.notNullMap.getOrDefault(colName.toLowerCase(), false);
	        String pgType = meta.pgTypeMap.getOrDefault(colName.toLowerCase(), "text").toLowerCase();

	        // ==========================================================
	        // NULL handling ("NULL" or "\N")
	        // ==========================================================
	        if (v.equalsIgnoreCase("NULL") || v.equalsIgnoreCase("\\N")) {
	            if (isNotNull) {
	                v = "";
	            } else {
	                sb.append("NULL");
	                if (i < matchedCols.size() - 1) sb.append(delimiter);
	                continue;
	            }
	        }

	        // ==========================================================
	        // Fix MySQL zero-date
	        // ==========================================================
	        if (v.equals("0000-00-00 00:00:00")
	                || v.equals("0000-00-00")
	                || v.startsWith("0000-00-00 00:00:00.")) {

	            if (isNotNull) {
	                v = "1970-01-01 00:00:00";
	            } else {
	                sb.append("NULL");
	                if (i < matchedCols.size() - 1) sb.append(delimiter);
	                continue;
	            }
	        }

	        // ==========================================================
	        // BYTEA handling (Base64 -> \xHEX)
	        // ==========================================================
	        if (isByteaType(pgType)) {

	            if (v.isEmpty()) {
	                if (isNotNull) {
	                    sb.append("\"\\\\x\"");
	                } else {
	                    sb.append("NULL");
	                }
	                if (i < matchedCols.size() - 1) sb.append(delimiter);
	                continue;
	            }

	            String hex;

	            try {
	                byte[] decoded = java.util.Base64.getDecoder().decode(v);
	                hex = bytesToHex(decoded);
	            } catch (Exception base64Fail) {
	                hex = bytesToHex(v.getBytes("UTF-8"));
	            }

	            String byteaVal = "\\\\x" + hex;
	            byteaVal = byteaVal.replace("\"", "\"\"");

	            sb.append("\"").append(byteaVal).append("\"");
	            if (i < matchedCols.size() - 1) sb.append(delimiter);
	            continue;
	        }

	        // ==========================================================
	        // Empty handling for non-binary types
	        // ==========================================================
	        if (v.isEmpty()) {

	            if (isNumericType(pgType)) {
	                sb.append("\"0\"");
	                if (i < matchedCols.size() - 1) sb.append(delimiter);
	                continue;
	            }

	            if (isDateTimeType(pgType)) {
	                if (isNotNull) {
	                    sb.append("\"1970-01-01 00:00:00\"");
	                } else {
	                    sb.append("NULL");
	                }
	                if (i < matchedCols.size() - 1) sb.append(delimiter);
	                continue;
	            }

	            sb.append("\"\"");
	            if (i < matchedCols.size() - 1) sb.append(delimiter);
	            continue;
	        }

	        // ==========================================================
	        // Normal value: escape quotes for CSV COPY
	        // ==========================================================
	        v = v.replace("\"", "\"\"");

	        sb.append("\"").append(v).append("\"");

	        if (i < matchedCols.size() - 1) sb.append(delimiter);
	    }

	    return sb.toString();
	}

	private boolean isNumericType(String pgType) {
	    pgType = pgType.toLowerCase();
	    return pgType.contains("int")
	            || pgType.contains("numeric")
	            || pgType.contains("decimal")
	            || pgType.contains("real")
	            || pgType.contains("double")
	            || pgType.contains("float");
	}

	private boolean isDateTimeType(String pgType) {
	    pgType = pgType.toLowerCase();
	    return pgType.contains("timestamp")
	            || pgType.contains("date")
	            || pgType.contains("time");
	}

	private boolean isByteaType(String pgType) {
	    pgType = pgType.toLowerCase();
	    return pgType.contains("bytea");
	}

	private String bytesToHex(byte[] bytes) {
	    StringBuilder sb = new StringBuilder(bytes.length * 2);
	    for (byte b : bytes) {
	        sb.append(String.format("%02x", b));
	    }
	    return sb.toString();
	}

	private static class TableMeta {
	    List<String> columns = new ArrayList<>();                 // in ordinal order
	    Map<String, Boolean> notNullMap = new HashMap<>();        // col -> true/false
	    Map<String, String> pgTypeMap = new HashMap<>();          // col -> pg data_type
	}

	private TableMeta fetchPostgresTableMeta(Connection conn, String tableName, String serverIP) throws Exception {

	    TableMeta meta = new TableMeta();

	    String schema = "public";
	    String pureTable = tableName;

	    if (tableName != null && tableName.contains(".")) {
	        String[] parts = tableName.split("\\.", 2);
	        schema = parts[0].trim();
	        pureTable = parts[1].trim();
	    }

	    String sql =
	            "SELECT column_name, is_nullable, data_type " +
	            "FROM information_schema.columns " +
	            "WHERE table_schema = ? AND table_name = ? " +
	            "ORDER BY ordinal_position";

	    try (PreparedStatement ps = conn.prepareStatement(sql)) {
	        ps.setString(1, schema);
	        ps.setString(2, pureTable);

	        try (ResultSet rs = ps.executeQuery()) {
	            while (rs.next()) {
	                String col = rs.getString("column_name");
	                String isNullable = rs.getString("is_nullable");
	                String dataType = rs.getString("data_type");

	                meta.columns.add(col.toLowerCase());

	                boolean notNull = "NO".equalsIgnoreCase(isNullable);
	                meta.notNullMap.put(col.toLowerCase(), notNull);

	                meta.pgTypeMap.put(col.toLowerCase(), dataType == null ? "text" : dataType.toLowerCase());
	            }
	        }
	    }

	    log("INFO",
	            "PostgreSQL metadata loaded - table=" + tableName +
	                    " cols=" + meta.columns.size(),
	            serverIP,
	            "PSQL_META");

	    return meta;
	}


	private String buildSafeCopyRowPostgresExact(
	        List<String> rowFields,
	        List<String> columns,
	        TableMeta meta,
	        char delimiter) throws Exception {

	    StringBuilder sb = new StringBuilder();

	    for (int i = 0; i < columns.size(); i++) {

	        String colName = columns.get(i);
	        String v = rowFields.get(i);

	        if (v == null) v = "";

	        // ==========================================================
	        // IMPORTANT: PRESERVE SPACES (DO NOT TRIM)  <-- SAME AS MYSQL
	        // ==========================================================
	        v = v.replace("\uFEFF", "");                 // remove BOM only
	        v = v.replace("\r", " ").replace("\n", " "); // safe cleanup, keep spaces

	        // MySQL side removes surrounding quotes if present (we do same)
	        if (v.length() >= 2 && v.startsWith("\"") && v.endsWith("\"")) {
	            v = v.substring(1, v.length() - 1);
	        }

	        boolean isNotNull = meta.notNullMap.getOrDefault(colName.toLowerCase(), false);
	        String pgType = meta.pgTypeMap.getOrDefault(colName.toLowerCase(), "text").toLowerCase();

	        // ==========================================================
	        // NULL handling ("NULL" or "\N")
	        // ==========================================================
	        if (v.equalsIgnoreCase("NULL") || v.equalsIgnoreCase("\\N")) {
	            if (isNotNull) {
	                // MySQL behavior: for NOT NULL, keep empty string
	                v = "";
	            } else {
	                sb.append("NULL");
	                if (i < columns.size() - 1) sb.append(delimiter);
	                continue;
	            }
	        }

	        // ==========================================================
	        // 🔥 FIX: MySQL zero-date -> PostgreSQL cannot accept
	        // Convert "0000-00-00 ..." into NULL (or default date)
	        // ==========================================================
	        if (v.equals("0000-00-00 00:00:00")
	                || v.equals("0000-00-00")
	                || v.startsWith("0000-00-00 00:00:00.")) {

	            // Best: store NULL in PostgreSQL
	            if (isNotNull) {
	                // If NOT NULL timestamp/date -> choose one behavior:

	                // Option 1 (STRICT): empty -> will fail if DB enforces NOT NULL
	                // v = "";

	                // Option 2 (RECOMMENDED): use safe default timestamp so load never fails
	                v = "1970-01-01 00:00:00";

	            } else {
	                sb.append("NULL");
	                if (i < columns.size() - 1) sb.append(delimiter);
	                continue;
	            }
	        }

	        // ==========================================================
	        // BYTEA handling (longblob equivalent)
	        // CSV contains Base64 -> we convert to \xHEX for Postgres bytea
	        // ==========================================================
	        if (isByteaType(pgType)) {

	            if (v.isEmpty()) {
	                if (isNotNull) {
	                    // empty bytea -> \x
	                    sb.append("\"\\\\x\"");
	                } else {
	                    sb.append("NULL");
	                }
	                if (i < columns.size() - 1) sb.append(delimiter);
	                continue;
	            }

	            String hex = null;

	            // Try Base64 decode
	            try {
	                byte[] decoded = java.util.Base64.getDecoder().decode(v);
	                hex = bytesToHex(decoded);
	            } catch (Exception base64Fail) {
	                // fallback: raw bytes -> hex
	                hex = bytesToHex(v.getBytes("UTF-8"));
	            }

	            // Postgres bytea hex format = \xABCD
	            String byteaVal = "\\\\x" + hex;
	            byteaVal = byteaVal.replace("\"", "\"\"");

	            sb.append("\"").append(byteaVal).append("\"");
	            if (i < columns.size() - 1) sb.append(delimiter);
	            continue;
	        }

	        // ==========================================================
	        // Empty handling for non-binary types
	        // ==========================================================
	        if (v.isEmpty()) {

	            // numeric -> 0 (same as MySQL)
	            if (isNumericType(pgType)) {
	                sb.append("\"0\"");
	                if (i < columns.size() - 1) sb.append(delimiter);
	                continue;
	            }

	            // datetime/timestamp/date/time
	            // MySQL uses 0000-00-00 00:00:00 but Postgres can't.
	            // Best safe equivalent = NULL (or you can set a default date)
	            if (isDateTimeType(pgType)) {
	                if (isNotNull) {
	                    // Recommended: default timestamp to avoid failures
	                    sb.append("\"1970-01-01 00:00:00\"");
	                } else {
	                    sb.append("NULL");
	                }
	                if (i < columns.size() - 1) sb.append(delimiter);
	                continue;
	            }

	            // text/varchar -> empty string
	            sb.append("\"\"");
	            if (i < columns.size() - 1) sb.append(delimiter);
	            continue;
	        }

	        // ==========================================================
	        // Normal value: escape quotes for CSV COPY
	        // This also fixes ""aescae"" cases correctly
	        // ==========================================================
	        v = v.replace("\"", "\"\"");

	        sb.append("\"").append(v).append("\"");

	        if (i < columns.size() - 1) sb.append(delimiter);
	    }

	    return sb.toString();
	}



	private List<String> parseCsvLineOption2(String line, char delimiter) {
		List<String> fields = new ArrayList<>();
		if (line == null)
			return fields;

		StringBuilder field = new StringBuilder();
		boolean inQuotes = false;

		for (int i = 0; i < line.length(); i++) {
			char c = line.charAt(i);

			if (c == '"') {

				if (!inQuotes) {
					// opening quote
					inQuotes = true;
					continue;
				} else {
					// inQuotes == true
					// treat this quote as CLOSING only if next is delimiter or
					// end-of-line
					boolean isEnd = (i == line.length() - 1);
					boolean nextIsDelimiter = (!isEnd && line.charAt(i + 1) == delimiter);

					if (isEnd || nextIsDelimiter) {
						inQuotes = false;
						continue;
					} else {
						// quote is part of data
						field.append('"');
						continue;
					}
				}
			}

			if (c == delimiter && !inQuotes) {
				fields.add(field.toString());
				field.setLength(0);
				continue;
			}

			field.append(c);
		}

		fields.add(field.toString());
		return fields;
	}

	private String buildSafeCopyRow(String[] row, char delimiter) {
		StringBuilder sb = new StringBuilder();

		for (int i = 0; i < row.length; i++) {
			String v = row[i];
			if (v == null)
				v = "";

			// remove CR/LF + trim
			v = v.replace("\r", " ").replace("\n", " ").trim();

			// FIX: Convert MySQL "zero date" into NULL for PostgreSQL
			if (v.equals("0000-00-00 00:00:00") || v.equals("0000-00-00")) {
				v = "NULL";
			}

			// NULL handling
			if (v.isEmpty() || v.equalsIgnoreCase("null") || v.equalsIgnoreCase("\\N") || v.equalsIgnoreCase("NULL")) {
				sb.append("NULL");
			} else {
				// escape quotes for CSV COPY
				v = v.replace("\"", "\"\"");
				sb.append("\"").append(v).append("\"");
			}

			if (i < row.length - 1)
				sb.append(delimiter);
		}

		return sb.toString();
	}

	private void executeCopyChunk(Connection conn, String copySQL, List<String> chunkLines) throws Exception {

	    CopyManager copyManager = new CopyManager((BaseConnection) conn);

	    PipedWriter pw = new PipedWriter();
	    PipedReader pr = new PipedReader(pw, 1024 * 64); // 64KB pipe buffer

	    Thread writerThread = new Thread(() -> {
	        try {
	            for (String row : chunkLines) {
	                pw.write(row);
	                pw.write("\n");
	            }
	        } catch (Exception e) {
	            // ignore
	        } finally {
	            try { pw.close(); } catch (Exception ignore) {}
	        }
	    });

	    writerThread.start();

	    // COPY reads stream directly (no huge memory)
	    copyManager.copyIn(copySQL, pr);

	    writerThread.join();
	}


	// MySQL CSV import with proper resource management and batching
	// MySQL CSV import with proper delimiter support (| / , / etc.)
	private void importCSVToMySQL(String csvFilePath, String delimiter, boolean hasHeader, String tableName,
	        Connection conn, String serverIP, int bulkSize) throws Exception {

	    BufferedReader reader = null;
	    try {
	        reader = new BufferedReader(new FileReader(csvFilePath));
	        String headerLine = reader.readLine();

	        if (headerLine == null) {
	            throw new Exception("CSV file is empty: " + csvFilePath);
	        }

	        //  FIX: Header parsing must follow strict format: "val"|"val"
	        List<String> headerFields = parseStrictPipeQuotedRow(headerLine);
	        if (headerFields == null || headerFields.isEmpty()) {
	            throw new Exception("CSV header could not be parsed: " + csvFilePath);
	        }

	        String[] csvHeaders = headerFields.toArray(new String[0]);

	        // Fetch DB column names + types
	        Map<String, Integer> dbColumnTypes = new HashMap<>();
	        List<String> dbColumns = new ArrayList<>();

	        try (Statement stmt = conn.createStatement();
	             ResultSet rs = stmt.executeQuery("SELECT * FROM " + tableName + " LIMIT 1")) {

	            ResultSetMetaData meta = rs.getMetaData();
	            for (int i = 1; i <= meta.getColumnCount(); i++) {
	                String col = meta.getColumnName(i);
	                int type = meta.getColumnType(i);

	                dbColumns.add(col);
	                dbColumnTypes.put(col.toLowerCase(), type);
	            }
	        }

	        // Fetch NOT NULL info dynamically from INFORMATION_SCHEMA
	        Map<String, Boolean> dbNotNullMap = new HashMap<>();

	        String schemaName = null;
	        String pureTableName = tableName;

	        if (tableName != null && tableName.contains(".")) {
	            String[] parts = tableName.split("\\.", 2);
	            schemaName = parts[0].trim();
	            pureTableName = parts[1].trim();
	        }

	        String notNullQuery =
	                "SELECT COLUMN_NAME, IS_NULLABLE " +
	                "FROM INFORMATION_SCHEMA.COLUMNS " +
	                "WHERE TABLE_SCHEMA = " + (schemaName != null ? "?" : "DATABASE()") + " " +
	                "AND TABLE_NAME = ?";

	        try (PreparedStatement ps = conn.prepareStatement(notNullQuery)) {
	            int idx = 1;

	            if (schemaName != null) {
	                ps.setString(idx++, schemaName);
	            }

	            ps.setString(idx, pureTableName);

	            try (ResultSet rs = ps.executeQuery()) {
	                while (rs.next()) {
	                    String col = rs.getString("COLUMN_NAME");
	                    String isNullable = rs.getString("IS_NULLABLE");
	                    boolean notNull = "NO".equalsIgnoreCase(isNullable);
	                    dbNotNullMap.put(col.toLowerCase(), notNull);
	                }
	            }
	        } catch (Exception e) {
	            // If metadata fails, we still continue safely
	            log("WARNING", "Failed to fetch NOT NULL metadata for table=" + tableName + " err=" + e.getMessage(),
	                    serverIP, "META_WARN");
	        }

	        // Call loader
	        insertPartialCSV(csvFilePath, tableName, conn, serverIP,
	                csvHeaders, dbColumns, dbColumnTypes, dbNotNullMap, hasHeader, delimiter);

	    } finally {
	        if (reader != null) {
	            try { reader.close(); } catch (Exception ignore) {}
	        }
	    }
	}


	public void insertPartialCSV(String csvFilePath, String tableName,
	        Connection conn, String serverIP,
	        String[] csvHeaders, List<String> dbColumns,
	        Map<String, Integer> dbColumnTypes,
	        Map<String, Boolean> dbNotNullMap,
	        boolean hasHeader, String delimiter) throws Exception {

	    File csvFile = new File(csvFilePath);
	    if (!csvFile.exists() || !csvFile.canRead()) {
	        throw new FileNotFoundException("CSV file not found or not readable: " + csvFile.getAbsolutePath());
	    }

	    // clean CSV headers
	    List<String> csvCols = Arrays.stream(csvHeaders)
	            .map(h -> h == null ? "" : h.replace("\"", "").trim())
	            .filter(h -> !h.isEmpty())
	            .collect(Collectors.toList());

	    if (csvCols.isEmpty()) {
	        throw new Exception("CSV header is empty/invalid: " + csvFile.getName());
	    }

	    // match columns (CSV vs DB)
	    List<String> matchedCols = new ArrayList<>();
	    for (String csvCol : csvCols) {
	        for (String dbCol : dbColumns) {
	            if (dbCol != null && dbCol.equalsIgnoreCase(csvCol)) {
	                matchedCols.add(dbCol);
	                break;
	            }
	        }
	    }

	    if (matchedCols.isEmpty()) {
	        throw new Exception("No matching columns found between CSV and table: " + tableName);
	    }

	    // Build insert SQL
	    String colSql = matchedCols.stream()
	            .map(c -> "`" + c.replace("`", "") + "`")
	            .collect(Collectors.joining(","));

	    String qSql = matchedCols.stream().map(x -> "?").collect(Collectors.joining(","));

	    String insertSql = "INSERT INTO " + tableName + " (" + colSql + ") VALUES (" + qSql + ")";
	    log("INFO", "INSERT SQL: " + insertSql, serverIP, "MYSQL_INSERT_SQL");

	    long inserted = 0;
	    int batchCount = 0;

	    try (BufferedReader br = new BufferedReader(new FileReader(csvFilePath));
	         PreparedStatement ps = conn.prepareStatement(insertSql)) {

	        String firstLine = br.readLine();
	        if (firstLine == null) {
	            throw new Exception("Empty file: " + csvFilePath);
	        }

	        long lineNo = 1;

	        // If file has NO header, first line is data
	        if (!hasHeader) {
	            List<String> rowFields = parseStrictPipeQuotedRow(firstLine);
	            rowFields = normalizeRowSize(rowFields, csvCols.size());
//	            bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes, dbNotNullMap, tableName);

	            bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes, dbNotNullMap);
	            ps.addBatch();
	            batchCount++;
	            inserted++;
	        }

	        String line;
	        while ((line = br.readLine()) != null) {
	            lineNo++;

	            if (line.trim().isEmpty()) continue;

	            List<String> rowFields = parseStrictPipeQuotedRow(line);
	            rowFields = normalizeRowSize(rowFields, csvCols.size());

	            try {
	                bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes, dbNotNullMap);
//	            	bindRow(ps, rowFields, csvCols, matchedCols, dbColumnTypes, dbNotNullMap, tableName);


	                ps.addBatch();
	                batchCount++;
	                inserted++;

	                if (batchCount >= 2000) {
	                    ps.executeBatch();
	                    batchCount = 0;
	                }

	            } catch (Exception rowEx) {
	                log("ERROR",
	                        "Row insert failed at lineNo=" + lineNo +
	                                " file=" + csvFile.getName() +
	                                " table=" + tableName +
	                                " err=" + rowEx.getMessage() +
	                                " rawLine=" + line,
	                        serverIP,
	                        "ROW_INSERT_FAIL");
	                throw rowEx;
	            }
	        }

	        if (batchCount > 0) {
	            ps.executeBatch();
	        }
	    }

	    log("INFO",
	            "CSV inserted successfully - tableName:" + tableName +
	                    " File:" + csvFile.getName() +
	                    " Inserted:" + inserted,
	            serverIP,
	            "CSV_LOAD");
	}


	private List<String> parseStrictPipeQuotedRow(String line) throws Exception {
	    List<String> fields = new ArrayList<>();
	    if (line == null) return fields;

	    // remove BOM + trim only left side (safe)
	    line = line.replace("\uFEFF", "");

	    int i = 0;
	    int n = line.length();

	    while (i < n) {

	        // skip spaces/tabs before a field
	        while (i < n && (line.charAt(i) == ' ' || line.charAt(i) == '\t')) i++;

	        if (i >= n) break;

	        // Must start with "
	        if (line.charAt(i) != '"') {
	            throw new Exception("Invalid row format: expected '\"' at pos=" + i + " but found=" + line.charAt(i));
	        }
	        i++; // skip opening quote

	        StringBuilder value = new StringBuilder();

	        while (i < n) {
	            char c = line.charAt(i);

	            if (c == '"') {
	                // if next is | or end => close field
	                if (i + 1 >= n || line.charAt(i + 1) == '|') {
	                    i++; // consume closing quote
	                    break;
	                }

	                // otherwise this quote is part of data (this handles ""value"" case)
	                value.append('"');
	                i++;
	                continue;
	            }

	            value.append(c);
	            i++;
	        }

	        fields.add(value.toString());

	        // after closing quote -> consume delimiter if present
	        if (i < n && line.charAt(i) == '|') {
	            i++;
	        }
	    }

	    return fields;
	}


	private List<String> normalizeRowSize(List<String> rowFields, int expectedSize) {
	    if (rowFields == null) rowFields = new ArrayList<>();

	    if (rowFields.size() < expectedSize) {
	        while (rowFields.size() < expectedSize) rowFields.add("");
	    } else if (rowFields.size() > expectedSize) {
	        rowFields = rowFields.subList(0, expectedSize);
	    }
	    return rowFields;
	}

