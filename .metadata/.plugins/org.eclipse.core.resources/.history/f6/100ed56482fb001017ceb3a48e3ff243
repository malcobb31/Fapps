	private void bindRow(PreparedStatement ps,
	        List<String> rowFields,
	        List<String> csvCols,
	        List<String> matchedCols,
	        Map<String, Integer> dbColumnTypes,
	        Map<String, Boolean> dbNotNullMap) throws Exception {

	    for (int i = 0; i < matchedCols.size(); i++) {

	        String colName = matchedCols.get(i);

	        // Default SQL type
	        int sqlType = Types.VARCHAR;
	        if (dbColumnTypes != null && dbColumnTypes.containsKey(colName.toLowerCase())) {
	            sqlType = dbColumnTypes.get(colName.toLowerCase());
	        }

	        boolean isNotNull = false;
	        if (dbNotNullMap != null && dbNotNullMap.containsKey(colName.toLowerCase())) {
	            isNotNull = Boolean.TRUE.equals(dbNotNullMap.get(colName.toLowerCase()));
	        }

	        // Find CSV index for this DB column
	        int csvIndex = -1;
	        for (int k = 0; k < csvCols.size(); k++) {
	            if (csvCols.get(k).equalsIgnoreCase(colName)) {
	                csvIndex = k;
	                break;
	            }
	        }

	        String v = (csvIndex >= 0 && csvIndex < rowFields.size()) ? rowFields.get(csvIndex) : "";
	        if (v == null) v = "";

	        // ==========================================================
	        // IMPORTANT: PRESERVE SPACES (DO NOT TRIM)
	        // ==========================================================

	        // Remove BOM only (safe)
	        v = v.replace("\uFEFF", "");

	        // Remove CR/LF inside values (optional safe cleanup)
	        // NOTE: this does not remove spaces
	        v = v.replace("\r", " ").replace("\n", " ");

	        // Remove surrounding quotes if present (keeps inside spaces!)
	        if (v.length() >= 2 && v.startsWith("\"") && v.endsWith("\"")) {
	            v = v.substring(1, v.length() - 1);
	        }

	        // ==========================================================
	        // NULL handling ("NULL" or "\N" -> SQL NULL)
	        // ==========================================================
	        if (v.equalsIgnoreCase("NULL") || v.equalsIgnoreCase("\\N")) {
	            if (isNotNull) {
	                // keep empty string for NOT NULL
	                v = "";
	            } else {
	                ps.setNull(i + 1, sqlType);
	                continue;
	            }
	        }

	        // ==========================================================
	        // BLOB / LONG_BLOB handling (Base64 -> bytes)
	        // ==========================================================
	        boolean isBinaryType =
	                (sqlType == Types.BLOB ||
	                 sqlType == Types.LONGVARBINARY ||
	                 sqlType == Types.VARBINARY ||
	                 sqlType == Types.BINARY);

	        if (isBinaryType) {

	            // if empty -> NULL (or empty bytes for NOT NULL)
	            if (v.isEmpty()) {
	                if (isNotNull) {
	                    ps.setBytes(i + 1, new byte[0]);
	                } else {
	                    ps.setNull(i + 1, sqlType);
	                }
	                continue;
	            }

	            // Expect Base64 in CSV for blob columns
	            try {
	                byte[] decoded = java.util.Base64.getDecoder().decode(v);
	                ps.setBytes(i + 1, decoded);
	                continue;
	            } catch (Exception decodeEx) {
	                // If not base64, fallback to raw bytes
	                ps.setBytes(i + 1, v.getBytes("UTF-8"));
	                continue;
	            }
	        }

	        // ==========================================================
	        // Empty handling for non-binary types
	        // ==========================================================
	        if (v.isEmpty()) {

	            // numeric -> 0
	            if (sqlType == Types.INTEGER || sqlType == Types.BIGINT || sqlType == Types.SMALLINT
	                    || sqlType == Types.TINYINT || sqlType == Types.DECIMAL || sqlType == Types.NUMERIC
	                    || sqlType == Types.FLOAT || sqlType == Types.DOUBLE || sqlType == Types.REAL) {

	                ps.setString(i + 1, "0");
	                continue;
	            }

	            // datetime/timestamp -> zero date
	            if (sqlType == Types.TIMESTAMP || sqlType == Types.TIMESTAMP_WITH_TIMEZONE
	                    || sqlType == Types.DATE || sqlType == Types.TIME) {

	                ps.setString(i + 1, "0000-00-00 00:00:00");
	                continue;
	            }

	            // varchar/text -> empty string
	            ps.setString(i + 1, "");
	            continue;
	        }

	        // ==========================================================
	        // Normal value (spaces preserved)
	        // ==========================================================
	        ps.setString(i + 1, v);
	    }
	}



	private void closeQuietly(BufferedReader reader) {
		if (reader != null) {
			try {
				reader.close();
			} catch (IOException e) {
				System.err.println("Warning: Failed to close BufferedReader: " + e.getMessage());
			}
		}
	}

