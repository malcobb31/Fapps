    private String buildMetadataJson(Map<String, String> masterRow, Map<String, String> detailRow, Map<String, String> addrRow) {
        Map<String, String> meta = new LinkedHashMap<String, String>();

        addMetadataFields(meta, masterRow, exclusionSet(
                COL_UM_USER_ID,
                COL_UM_USER_MODE,
                COL_UM_USER_STATUS,
                COL_UM_USER_CERTIFICATE,
                COL_UM_FI_CODE,
                COL_UM_USERNAME,
                COL_UM_FIRST_NAME,
                COL_UM_LAST_NAME,
                COL_UM_MIDDLE_NAME,
                COL_UM_TITLE,
                COL_UM_GENDER,
                COL_UM_DOB
        ));

        addMetadataFields(meta, detailRow, exclusionSet(
                COL_UD_USER_ID,
                COL_UD_CITIZENSHIP,
                COL_UD_DESIGNATION,
                COL_UD_EMPLOYEE_CODE
        ));

        addMetadataFields(meta, addrRow, exclusionSet(
                COL_UA_USER_ID,
                COL_UA_EMAIL,
                COL_UA_LANDLINE,
                COL_UA_MOBILE
        ));

        return toJson(meta);
    }

    private Set<String> exclusionSet(String... cols) {
        Set<String> set = new HashSet<String>();
        if (cols != null) {
            for (String c : cols) {
                if (c != null) {
                    set.add(c.trim().toLowerCase());
                }
            }
        }
        return set;
    }

    private void addMetadataFields(Map<String, String> target, Map<String, String> source, Set<String> excludedKeys) {
        if (source == null) return;

        for (Map.Entry<String, String> entry : source.entrySet()) {
            String key = entry.getKey();
            if (key == null) continue;

            String normalized = key.trim().toLowerCase();
            if (excludedKeys.contains(normalized)) continue;

            if (!target.containsKey(normalized)) {
                target.put(normalized, emptyToNull(entry.getValue()));
            }
        }
    }

    private String toJson(Map<String, String> map) {
        StringBuilder json = new StringBuilder("{");
        int i = 0;
        for (Map.Entry<String, String> entry : map.entrySet()) {
            if (i > 0) json.append(",");
            json.append("\"").append(escapeJson(entry.getKey())).append("\":");
            if (entry.getValue() == null) {
                json.append("null");
            } else {
                json.append("\"").append(escapeJson(entry.getValue())).append("\"");
            }
            i++;
        }
        json.append("}");
        return json.toString();
    }

    private String escapeJson(String value) {
        return value.replace("\\", "\\\\").replace("\"", "\\\"");
    }

    private String emptyToNull(String value) {
        if (value == null) return null;
        String t = value.trim();
        return t.isEmpty() ? null : t;
    }

    private void setStr(PreparedStatement ps, int idx, String value) throws Exception {
        if (value == null) {
            ps.setNull(idx, Types.VARCHAR);
        } else {
            ps.setString(idx, value);
        }
    }

    private void setUuidLike(PreparedStatement ps, int idx, String value) throws Exception {
        if (value == null) {
            ps.setNull(idx, Types.OTHER);
            return;
        }

        String t = value.trim();
        if (t.isEmpty()) {
            ps.setNull(idx, Types.OTHER);
            return;
        }

        try {
            ps.setObject(idx, UUID.fromString(t), Types.OTHER);
        } catch (IllegalArgumentException ex) {
            ps.setObject(idx, t, Types.OTHER);
        }
    }

    private String firstNonBlank(Map<String, String> row, String[] keys, String defaultValue) {
        if (row != null && keys != null) {
            for (String key : keys) {
                String v = get(row, key);
                if (v != null) return v;
            }
        }
        return defaultValue;
    }

    private Timestamp resolveTimestamp(Map<String, String> row, String[] keys, boolean useNowIfMissing) {
        String raw = firstNonBlank(row, keys, null);
        if (raw == null) {
            return useNowIfMissing ? new Timestamp(System.currentTimeMillis()) : null;
        }

        raw = raw.trim().replace('T', ' ');
        List<String> patterns = new ArrayList<String>();
        patterns.add("yyyy-MM-dd HH:mm:ss.SSS");
        patterns.add("yyyy-MM-dd HH:mm:ss");
        patterns.add("yyyy/MM/dd HH:mm:ss");
        patterns.add("dd-MM-yyyy HH:mm:ss");
        patterns.add("yyyy-MM-dd");
        patterns.add("dd-MM-yyyy");

        for (String pattern : patterns) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat(pattern);
                sdf.setLenient(false);
                Date d = sdf.parse(raw);
                return new Timestamp(d.getTime());
            } catch (ParseException ignored) { }
        }

        return useNowIfMissing ? new Timestamp(System.currentTimeMillis()) : null;
    }

    private java.sql.Date parseSqlDate(String raw) {
        if (raw == null || raw.trim().isEmpty()) {
            return null;
        }

        raw = raw.trim().replace('T', ' ');
        List<String> patterns = new ArrayList<String>();
        patterns.add("yyyy-MM-dd");
        patterns.add("dd-MM-yyyy");
        patterns.add("yyyy/MM/dd");

        for (String pattern : patterns) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat(pattern);
                sdf.setLenient(false);
                Date d = sdf.parse(raw);
                return new java.sql.Date(d.getTime());
            } catch (ParseException ignored) { }
        }

        return null;
    }

    private String get(Map<String, String> row, String col) {
        if (row == null || col == null) return null;
        String val = row.get(col);
        if (val == null) {
            val = row.get(col.trim().toLowerCase());
        }
        if (val == null || val.trim().isEmpty()) {
            return null;
        }
        return val.trim();
    }

    private void log(String level, String message, String serverIP, String evtType) {
        if ("DEBUG".equalsIgnoreCase(level) && !debugEnabled) return;

        String timestamp = LocalDateTime.now().format(logFormat);
        StringBuilder logBuilder = new StringBuilder(512);

        logBuilder.append("Time:").append(timestamp)
                .append(" [").append(capitalize(level)).append("] ")
                .append("Process_Name: ").append(processName).append(" ");

        if (serverIP != null && !serverIP.isEmpty()) {
            logBuilder.append("Server_IP: ").append(serverIP).append(" ");
        }

        logBuilder.append("Process_Version: ").append(processVersion)
                .append(" Log_Level: EVT_LOG ")
                .append(" EVT_Type: ").append(evtType != null ? evtType : "NA")
                .append(" Description: ").append(message != null ? message : "");

        System.out.println(logBuilder.toString().trim());
    }

    private String capitalize(String s) {
        if (s == null || s.isEmpty()) return s;
        return s.substring(0, 1).toUpperCase() + s.substring(1).toLowerCase();
    }
