    // ------------------ Helper ------------------
    private Timestamp toTimestamp(String isoDate) {
        try {
            if (isoDate == null || isoDate.isEmpty() || isoDate.equals("null")) {
                return new Timestamp(System.currentTimeMillis());
            }
            String s = isoDate.replace("Z", "").replace('T', ' ');
            if (s.contains(".")) {
                String[] parts = s.split("\\.");
                String ms = parts[1].length() >= 3 ? parts[1].substring(0, 3) : String.format("%-3s", parts[1]).replace(' ', '0');
                s = parts[0] + "." + ms;
            }
            java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS");
            java.util.Date d = sdf.parse(s);
            return new Timestamp(d.getTime());
        } catch (Exception e) {
            return new Timestamp(System.currentTimeMillis());
        }
    }
