				+ "FROM re_mgmt.branch_pview_bkp_1610 b "
				+ "JOIN re_mgmt.region_pview_bkp_1610 rg ON rg.id = b.region_id "
				+ "JOIN re_mgmt.reporting_entity_pview_bkp_1610 re ON re.id = rg.reporting_entity_id";
		Connection conn = null;
		PreparedStatement ps = null;
		ResultSet rs = null;

		try {
			conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
