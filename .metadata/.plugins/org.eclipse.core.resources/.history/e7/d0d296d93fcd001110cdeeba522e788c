	// Columns selected from re_user_test_v1 for the existing-users load (rule #3). This is
	// every column this parser writes, plus metadata, so the full current row is available
	// both for ranking-field reconstruction (buildRankingRowFromExistingDbRow) and for
	// change-detection / preservation when updating (resolveExistingRow, rowDiffersFromExisting).
	private static final List<String> EXISTING_USER_SELECT_COLUMNS;
	static {
		List<String> cols = new ArrayList<String>(INSERT_COLUMNS);
		if (!cols.contains("re_flag"))
			cols.add("re_flag"); // the row's own re_user.re_flag: read-only here, never written
		EXISTING_USER_SELECT_COLUMNS = Collections.unmodifiableList(cols);
	}

	/**
	 * Loads the full current target-table row set keyed by normalized user_id. Qualification for
	 * reconciliation is deliberately applied later by buildRankingRowFromExistingDbRow() and
	 * hasRequiredRankingMetadata(), so DB rows lacking the required ranking metadata can be
	 * ignored without affecting the source CSV processing.
	 */
	private Map<String, Map<String, String>> loadExistingTargetUsers() {
		Map<String, Map<String, String>> map = new HashMap<String, Map<String, String>>();

		StringBuilder sql = new StringBuilder("SELECT ");
		for (int i = 0; i < EXISTING_USER_SELECT_COLUMNS.size(); i++) {
			if (i > 0)
				sql.append(", ");
			sql.append(EXISTING_USER_SELECT_COLUMNS.get(i));
		}
		sql.append(" FROM re_mgmt.re_user_pview_bkp_1610");

		Connection conn = null;
		PreparedStatement ps = null;
		ResultSet rs = null;

		try {
			conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
			conn.setAutoCommit(false); // lets the driver stream the whole table in chunks (fetch size)
			ps = conn.prepareStatement(sql.toString());
			ps.setFetchSize(5000);
			rs = ps.executeQuery();

			while (rs.next()) {
				String userId = rs.getString("user_id");
				if (isBlank(userId))
					continue;

				Map<String, String> existingRow = new LinkedHashMap<String, String>();
				for (String col : EXISTING_USER_SELECT_COLUMNS) {
					existingRow.put(col, rs.getString(col));
				}
				map.put(normalizeKey(userId), existingRow);
			}
		} catch (Exception e) {
			log("WARN", "Existing target-table load failed: " + e.getMessage(), null, "LOOKUP_LOAD");
		} finally {
			closeQuietly(rs);
			closeQuietly(ps);
			closeQuietly(conn);
		}

		return map;
	}

	/**
	 * Builds the ranking-shaped row for an existing DB user using ONLY the ranking metadata
	 * stored on that target row. There is intentionally no fallback to final target columns
	 * such as user_type/status because this reconciliation must not infer missing source data.
	 * Users whose required metadata is incomplete are excluded from the combined population by
	 * hasRequiredRankingMetadata() and are left untouched.
	 */
	private Map<String, String> buildRankingRowFromExistingDbRow(Map<String, String> existingDbRow) {
		Map<String, String> meta = new LinkedHashMap<String, String>();
		String metadataJson = existingDbRow.get("metadata");
		if (!isBlank(metadataJson))
			parseFlatJsonObject(metadataJson, meta);

		Map<String, String> row = new LinkedHashMap<String, String>();
		row.put("user_id", existingDbRow.get("user_id"));

		// Existing DB users are eligible for reconciliation only from ranking metadata.
		// Do not fall back to target user_type/status because those are final target values,
		// not the source ranking inputs required to reproduce the ranking population.
		String userMode = get(meta, "user_mode");
		row.put("user_mode", userMode == null ? "" : userMode);

		String rawStatus = get(meta, "user_status");
		row.put("user_status", rawStatus == null ? "" : rawStatus);

		row.put("bc_organisation", get(meta, "bc_organisation"));
		row.put("region_code", get(meta, "region_code"));
		row.put("user_branch_id", get(meta, "user_branch_id"));
		row.put("login_time", get(meta, "login_time"));

		return row;
	}

	/**
	 * Existing DB users are eligible for reconciliation only when the stored metadata
	 * contains every ranking input actually required by this parser for that user's mode.
	 * Region/branch are mode-specific because IA/IU scope uses only bc_organisation,
	 * IRA/IRU additionally require region_code, and IBU additionally requires user_branch_id.
	 */
	private boolean hasRequiredRankingMetadata(Map<String, String> rankingRow) {
		if (rankingRow == null)
			return false;

		String userMode = get(rankingRow, "user_mode");
		String userStatus = get(rankingRow, "user_status");
		String bcOrganisation = get(rankingRow, "bc_organisation");
		String loginTime = get(rankingRow, "login_time");

		if (isBlank(userMode) || !USER_MODE_MAX_COUNT.containsKey(userMode.trim().toUpperCase()))
			return false;
		if (isBlank(userStatus) || !RANKED_STATUSES.contains(userStatus.trim()))
			return false;
		if (isBlank(bcOrganisation) || isBlank(loginTime))
			return false;

		String modeKey = userMode.trim().toUpperCase();
		if (("IRA".equals(modeKey) || "IRU".equals(modeKey) || "IBU".equals(modeKey))
				&& isBlank(get(rankingRow, "region_code")))
			return false;

		if ("IBU".equals(modeKey) && isBlank(get(rankingRow, "user_branch_id")))
			return false;

		return true;
	}

	/**
	 * Rule #9/#14: builds the resolved target row for an existing DB-only user (present in the
	 * DB, absent from the new CSV) after combined ranking. Reuses the same mapping helpers as
	 * resolveRow() (mapGender/mapTitle/mapFinalStatus/etc. are NOT re-run against raw CSV
	 * columns here, since there is no CSV row) but recomputes only the fields the ranking
	 * decision can actually change: user_type, status, active, and the corresponding metadata
	 * bookkeeping fields (mapped_user_type/mapped_operational_status/previous_status). Every
	 * other column is carried over unchanged from the existing DB row so an update never
	 * destroys unrelated data (rule #14).
	 */
	private Map<String, String> resolveExistingRow(Map<String, String> existingDbRow, Map<String, String> rankingRow,
			DatatypeWarnAccumulator warns) {
		Map<String, String> r = new LinkedHashMap<String, String>(existingDbRow);

		String userId = existingDbRow.get("user_id");
		RankDecision rankDecision = rankDecisionByUserId.get(normalizeKey(userId));

		String mappedType;
		if (rankDecision != null) {
			mappedType = rankDecision.userType;
		} else {
			// Not eligible for ranking (unsupported mode, non-ranked status, or failed
			// region/branch validation) - keep whatever user_type the row already has.
			mappedType = existingDbRow.get("user_type");
		}

		String rawStatus = get(rankingRow, "user_status");
		String opStatus = mapOperationalStatus(rawStatus);
		if (isBlank(opStatus)) {
			// No usable raw status was recoverable from metadata - keep the existing previous_status
			// (or current status) as the operational status baseline rather than nulling it out.
			opStatus = existingDbRow.get("status");
		}
		if (rankDecision != null && rankDecision.statusOverride != null) {
			opStatus = rankDecision.statusOverride;
		}

		String finalStatus = mapFinalStatus(opStatus);
		String previousStatus = STATUS_DEACTIVATED.equals(finalStatus) ? opStatus : null;
		Boolean active = Boolean.valueOf(STATUS_TESTBED.equals(finalStatus));

		r.put("user_type", mappedType);
		r.put("status", finalStatus);
		r.put("active", active.toString());

		// Rule #7 (IU/IAU): keep same_registration_correspondence_address consistent with the
		// (possibly changed) mapped type, same rule resolveRow() applies for new users.
		if (!isBlank(mappedType) && mappedType.startsWith("IAU")) {
			r.put("same_registration_correspondence_address", Boolean.TRUE.toString());
		}

		// Rule #14: preserve existing metadata fields; only add/overwrite the ranking-derived
		// bookkeeping keys (mapped_user_type/mapped_operational_status/previous_status), and
		// also refresh bc_organisation/region_code/user_branch_id/login_time/user_status so a
		// later run can still reconstruct ranking fields via buildRankingRowFromExistingDbRow().
		String metadataJson = existingDbRow.get("metadata");
		Map<String, String> meta = new LinkedHashMap<String, String>();
		if (!isBlank(metadataJson)) {
			parseFlatJsonObject(metadataJson, meta);
		}
		meta.put("mapped_user_type", mappedType == null ? "" : mappedType);
		meta.put("mapped_operational_status", finalStatus == null ? "" : finalStatus);
		if (!isBlank(previousStatus))
			meta.put("previous_status", previousStatus);
		if (!isBlank(get(rankingRow, "bc_organisation")))
			meta.put("bc_organisation", get(rankingRow, "bc_organisation"));
		if (!isBlank(get(rankingRow, "region_code")))
			meta.put("region_code", get(rankingRow, "region_code"));
		if (!isBlank(get(rankingRow, "user_branch_id")))
			meta.put("user_branch_id", get(rankingRow, "user_branch_id"));
		if (!isBlank(get(rankingRow, "login_time")))
			meta.put("login_time", get(rankingRow, "login_time"));
		if (!isBlank(rawStatus))
			meta.put("user_status", rawStatus);
		r.put("metadata", toJson(meta));

		return r;
	}

	/**
	 * Rule #9: determines whether an existing user's combined/ranked resolved row differs from
	 * its current DB state, so unchanged rows are left alone (rule #20: no unconditional
	 * rewrite). Compares, at minimum, user_type/status/active (rule #9's explicit minimum) plus
	 * metadata (since resolveExistingRow's metadata bookkeeping - mapped_user_type/
	 * mapped_operational_status/previous_status - can change even when the visible columns
	 * happen not to).
	 */
	private boolean rowDiffersFromExisting(Map<String, String> existingDbRow, Map<String, String> resolved) {
		if (!fieldsEqual(existingDbRow.get("user_type"), resolved.get("user_type")))
			return true;
		if (!fieldsEqual(existingDbRow.get("status"), resolved.get("status")))
			return true;
		if (!fieldsEqual(normBool(existingDbRow.get("active")), normBool(resolved.get("active"))))
			return true;
		// jsonb comes back re-formatted by PostgreSQL, so compare the parsed key/values, not the text.
		Map<String, String> a = new LinkedHashMap<String, String>();
		Map<String, String> b = new LinkedHashMap<String, String>();
		if (!isBlank(existingDbRow.get("metadata")))
			parseFlatJsonObject(existingDbRow.get("metadata").trim(), a);
		if (!isBlank(resolved.get("metadata")))
			parseFlatJsonObject(resolved.get("metadata").trim(), b);
		return !a.equals(b);
	}

	private String normBool(String v) {
		if (v == null)
			return "";
		String t = v.trim().toLowerCase();
		if ("t".equals(t) || "true".equals(t))
			return "true";
		if ("f".equals(t) || "false".equals(t))
			return "false";
		return t;
	}

	private boolean fieldsEqual(String a, String b) {
		String na = isBlank(a) ? "" : a.trim();
		String nb = isBlank(b) ? "" : b.trim();
		return na.equals(nb);
	}

	/**
	 * Loads per-user address metadata from re_mgmt.address_test, keyed by the source
	 * user_id (address.user_id holds the same source user_id string as user_master).
	 * The returned map's inner map exposes the flattened metadata jsonb fields
	 * (email_id, phone2, phone3, ...) the same way CSV-row lookups did previously,
	 * so downstream get(...)-based access in resolveRow/buildMetadataJson is unchanged.
	 */
	private Map<String, Map<String, String>> loadAddressLookup() {
		Map<String, Map<String, String>> map = new HashMap<String, Map<String, String>>();
		// re_mgmt.address_test has no top-level user_id column: user_id (and phone2/phone3/
		// email_id) live inside the metadata jsonb, e.g. metadata->>'user_id' = 'IBA0001545'.
		String sql = "SELECT metadata->>'user_id' AS user_id, "
				+ "metadata->>'phone2' AS phone2, "
				+ "metadata->>'phone3' AS phone3, "
				+ "metadata->>'email_id' AS email_id "
				+ "FROM re_mgmt.address_pview_bkp_1610 "
				+ "WHERE metadata->>'user_id' IS NOT NULL";
		Connection conn = null;
		PreparedStatement ps = null;
		ResultSet rs = null;

		try {
			conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();

			while (rs.next()) {
				String userId = rs.getString("user_id");
				if (isBlank(userId))
					continue;

				Map<String, String> flat = new HashMap<String, String>();
				flat.put("phone2", cleanValue(rs.getString("phone2")));
				flat.put("phone3", cleanValue(rs.getString("phone3")));
				flat.put("email_id", cleanValue(rs.getString("email_id")));
				map.put(normalizeKey(userId), flat);
			}
		} catch (Exception e) {
			log("WARN", "Address lookup failed: " + e.getMessage(), null, "LOOKUP_LOAD");
		} finally {
			closeQuietly(rs);
			closeQuietly(ps);
			closeQuietly(conn);
		}

		return map;
	}

	private void mergeLookupByUserId(Map<String, Map<String, String>> target, CsvTable table) {
		if (target == null || table == null || table.rows == null)
			return;
		for (Map<String, String> row : table.rows) {
			String userId = get(row, "user_id");
			if (isBlank(userId))
				continue;
			String key = normalizeKey(userId);
			Map<String, String> prev = target.get(key);
			if (prev == null) {
				target.put(key, new HashMap<String, String>(row));
				continue;
			}
			// Same user_id twice (mapping CSVs repeat rows): keep the first non-blank value per column.
			for (Map.Entry<String, String> e : row.entrySet()) {
				if (isBlank(cleanValue(prev.get(e.getKey()))) && !isBlank(cleanValue(e.getValue())))
					prev.put(e.getKey(), e.getValue());
			}
		}
	}

	private Map<String, String> lookupRowByUserId(Map<String, Map<String, String>> lookup, String userId) {
		if (lookup == null || isBlank(userId))
			return null;
		return lookup.get(normalizeKey(userId));
	}

	private boolean isUserDetails(CsvTable table) {
		return table != null && table.hasHeader("user_id")
				&& (table.hasHeader("citizenship") || table.hasHeader("designation") || table.hasHeader("employee_code")
						|| table.hasHeader("any_other_info") || table.hasHeader("department")
						|| table.hasHeader("entered_place") || table.hasHeader("specialisation"));
	}

	/**
	 * Detects the user_address CSV, e.g. headers:
	 * "address1"|"address2"|"address3"|"city"|"country"|"last_modified_date"|"modified_by"|"pincode"|
	 * "state_code"|"address4"|"email_id"|"fax"|"phone1"|"phone2"|"phone3"|"user_id"|"village_code"
	 * Used as a second-tier fallback for email/mobile/landline (rule #8) when re_mgmt.address_test (DB)
	 * has no row for a given user_id.
	 */
	private boolean isUserAddressCsv(CsvTable table) {
		return table != null && table.hasHeader("user_id")
				&& (table.hasHeader("email_id") || table.hasHeader("phone2") || table.hasHeader("phone3"));
	}

	private String resolveReportingEntityId(String bcOrg, Map<String, String> reLookup) {
		if (isBlank(bcOrg) || reLookup == null || reLookup.isEmpty())
			return null;

		String key = normalizeKey(bcOrg);
		String id = reLookup.get(key);
		if (!isBlank(id))
			return id;

		for (Map.Entry<String, String> e : reLookup.entrySet()) {
			if (e.getKey() != null && e.getKey().equalsIgnoreCase(key))
				return e.getValue();
		}

		return null;
	}

	// The real user_master export has one unnamed extra value right after this header column.
	private static final String MASTER_GAP_AFTER_HEADER = "logon_password";

	private CsvTable loadCsv(Path file) {
		try (BufferedReader br = Files.newBufferedReader(file, StandardCharsets.ISO_8859_1)) {
			String headerLine = readCsvRecord(br);
			if (isBlank(headerLine))
				return null;

			List<String> rawHeaders = parseDelimitedLine(headerLine, '|');
			if (rawHeaders.isEmpty())
				return null;

			List<String> headers = new ArrayList<>();
			for (String h : rawHeaders)
				headers.add(normalizeHeader(h));

			boolean masterFile = headers.contains("user_id") && headers.contains("user_mode")
					&& headers.contains("user_status") && headers.contains("bc_organisation");
			int gapIdx = masterFile ? headers.indexOf(MASTER_GAP_AFTER_HEADER) : -1;
			int realigned = 0, mismatched = 0;
			List<String> mismatchIds = new ArrayList<>();

			List<Map<String, String>> rows = new ArrayList<>();
			String line;
			while ((line = readCsvRecord(br)) != null) {
				if (isBlank(line))
					continue;
				List<String> vals = parseDelimitedLine(line, '|');
				// One extra unnamed value after logon_password shifts every later column by one: drop it.
				if (vals.size() == headers.size() + 1 && gapIdx >= 0) {
					vals.remove(gapIdx + 1);
					realigned++;
				} else if (vals.size() != headers.size()) {
					mismatched++;
					if (mismatchIds.size() < 5)
						mismatchIds.add(cleanValue(vals.get(0)));
				}
				while (vals.size() < headers.size())
					vals.add("");
				Map<String, String> row = new LinkedHashMap<>();
				for (int i = 0; i < headers.size(); i++)
					row.put(headers.get(i), cleanValue(i < vals.size() ? vals.get(i) : null));
				rows.add(row);
			}
			log("INFO", "Loaded: " + file.getFileName() + " | Rows=" + rows.size(), null, "CSV_LOAD");
			if (realigned > 0)
				log("INFO", "Master column realign: " + realigned + " row(s) had 1 extra value after '"
						+ MASTER_GAP_AFTER_HEADER + "' (header has " + headers.size()
						+ " columns) - extra value dropped", null, "CSV_REALIGN");
			if (mismatched > 0)
				log("WARN", "CSV column-count mismatch | file=" + file.getFileName() + " | rows=" + mismatched
						+ " | headers=" + headers.size() + " | first user_ids=" + mismatchIds, null,
						"CSV_SCHEMA_MISMATCH");
			return new CsvTable(file, headers, rows);
		} catch (Exception e) {
			log("ERROR", "CSV load error: " + file.getFileName() + " | " + e.getMessage(), null, "CSV_LOAD");
			return null;
		}
	}

	/** One logical CSV record: keeps reading physical lines while a quoted value is still open. */
	private String readCsvRecord(BufferedReader br) throws IOException {
		StringBuilder record = new StringBuilder();
		boolean inQuotes = false;
		String line;
		while ((line = br.readLine()) != null) {
			if (record.length() > 0)
				record.append('\n');
			record.append(line);
			for (int i = 0; i < line.length(); i++) {
				char ch = line.charAt(i);
				if (ch == '\\' && i + 1 < line.length() && line.charAt(i + 1) == '"') {
					i++;
					continue;
				}
				if (ch == '"' && inQuotes && i + 1 < line.length() && line.charAt(i + 1) == '"') {
					i++;
					continue;
				}
				if (ch == '"')
					inQuotes = !inQuotes;
			}
			if (!inQuotes)
				return record.toString();
		}
		return record.length() == 0 ? null : record.toString();
	}

	private boolean isUserMaster(CsvTable t) {
		return t.hasHeader("user_id") && t.hasHeader("user_mode") && t.hasHeader("user_status")
				&& t.hasHeader("bc_organisation") && t.hasHeader("first_name") && t.hasHeader("title");
	}

	private List<Path> findCsvFiles(Path dir) throws IOException {
		List<Path> files = new ArrayList<>();
		try (DirectoryStream<Path> stream = Files.newDirectoryStream(dir, "*.csv")) {
			for (Path p : stream)
				if (Files.isRegularFile(p))
					files.add(p);
		}
		files.sort(Comparator.comparing(p -> p.getFileName().toString().toLowerCase()));
		return files;
	}

