			this.reason = reason;
		}
	}

	/**
	 * Source-agnostic ranking population entry (rule #17 / #27).
	 *
	 * Wraps a "row" Map<String,String> (the same shape buildRankDecisions/buildScopeKey/
	 * passesRegionBranchValidation/resolveRow already consume via get(row, "...")) together
	 * with bookkeeping about where it came from. Ranking code (buildScopeKey,
	 * passesRegionBranchValidation, buildRankDecisions) is unchanged in *how* it reads a row -
	 * it keeps calling get(row, "user_mode") etc - it now just iterates over
	 * RankingUser.row instead of iterating CsvTable rows directly.
	 *
	 * For CSV-origin users, row == the original CSV master row (unchanged shape).
	 * For DB-origin users (existing rows not present in any new CSV), row is synthesized
	 * from the stored `metadata` jsonb (see loadExistingRankingUsers()), reusing the exact
	 * same keys (user_mode, user_status, bc_organisation, region_code, user_branch_id,
	 * login_time, user_id) so the ranking functions need no source-specific branching.
	 */
	static final class RankingUser {
		final String userId; // normalized
		final String rawUserId; // original-case user_id
		final Map<String, String> row; // ranking-shaped fields (user_mode/user_status/bc_organisation/...)
		final boolean fromCsv;
		final boolean existingInDb;
		final Map<String, String> existingDbRow; // full current column values, only set when existingInDb

		RankingUser(String userId, String rawUserId, Map<String, String> row, boolean fromCsv, boolean existingInDb,
				Map<String, String> existingDbRow) {
			this.userId = userId;
			this.rawUserId = rawUserId;
			this.row = row;
			this.fromCsv = fromCsv;
			this.existingInDb = existingInDb;
			this.existingDbRow = existingDbRow;
		}
	}

