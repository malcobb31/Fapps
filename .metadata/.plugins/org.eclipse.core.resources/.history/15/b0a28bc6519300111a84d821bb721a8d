		String userId = get(row, "user_id");
		String bcOrg = get(row, "bc_organisation");
		String userMode = get(row, "user_mode");
		String rawStatus = get(row, "user_status");

		Map<String, String> addressMetadata = lookupRowByUserId(addressLookup, userId);
		// Second-tier fallback: user_address CSV, used when re_mgmt.address (DB) has no row for this user_id.
		Map<String, String> addressCsvRow = lookupRowByUserId(userAddressCsvLookup, userId);
		Map<String, String> detailsRow = lookupRowByUserId(userDetailsLookup, userId);

		RankDecision rankDecision = rankDecisionByUserId.get(normalizeKey(userId));

		String mappedType;
		if (rankDecision != null) {
			mappedType = rankDecision.userType;
		} else {
			mappedType = mapUserType(userMode, bcOrg, rawStatus);
		}

		String opStatus = mapOperationalStatus(rawStatus);
		if (rankDecision != null && rankDecision.statusOverride != null) {
			opStatus = rankDecision.statusOverride;
		}

		// Rule #5: capture the pre-transform status, then collapse to final status.
		String previousStatus = opStatus;
		String finalStatus = mapFinalStatus(opStatus);

		// Rule #6: active is derived solely from the final status, not raw source status.
		Boolean active = Boolean.valueOf(STATUS_TESTBED.equals(finalStatus));
		String activeStr = active.toString();

		String reUuid = resolveReportingEntityId(bcOrg, reLookup);
		if (!isBlank(bcOrg) && isBlank(reUuid)) {
			warns.record("reporting_entity_id[LOOKUP_MISS]", bcOrg);
		}

		String countryCode = firstNonBlank(get(row, "country_code"), "+91");
		String gender = mapGender(get(row, "gender"));
		String title = mapTitle(get(row, "title"));

		// Rule #8: email/mobile resolved from re_mgmt.address.metadata first (DB), then the
		// user_address CSV (headers: user_id/email_id/phone2/phone3/...) as a second-tier
		// fallback when the DB has no address row for this user_id, then finally the existing
		// raw user_master CSV columns (pstn_phone_no/gsm_phone_no/email) as a last resort.
