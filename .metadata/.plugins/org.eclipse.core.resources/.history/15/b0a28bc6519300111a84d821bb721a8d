	/**
	 * Loads per-user address metadata from re_mgmt.address, keyed by the source
	 * user_id (address.user_id holds the same source user_id string as user_master).
	 * The returned map's inner map exposes the flattened metadata jsonb fields
	 * (email_id, phone2, phone3, ...) the same way CSV-row lookups did previously,
	 * so downstream get(...)-based access in resolveRow/buildMetadataJson is unchanged.
	 */
	private Map<String, Map<String, String>> loadAddressLookup() {
		Map<String, Map<String, String>> map = new HashMap<String, Map<String, String>>();
		// re_mgmt.address has no top-level user_id column: user_id (and phone2/phone3/
		// email_id) live inside the metadata jsonb, e.g. metadata->>'user_id' = 'IBA0001545'.
		String sql = "SELECT metadata->>'user_id' AS user_id, "
				+ "metadata->>'phone2' AS phone2, "
				+ "metadata->>'phone3' AS phone3, "
				+ "metadata->>'email_id' AS email_id "
				+ "FROM re_mgmt.address "
				+ "WHERE metadata->>'user_id' IS NOT NULL";
		Connection conn = null;
		PreparedStatement ps = null;
		ResultSet rs = null;

		try {
			conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();

			while (rs.next()) {
				String userId = rs.getString("user_id");
				if (isBlank(userId))
					continue;

				Map<String, String> flat = new HashMap<String, String>();
				flat.put("phone2", cleanValue(rs.getString("phone2")));
				flat.put("phone3", cleanValue(rs.getString("phone3")));
				flat.put("email_id", cleanValue(rs.getString("email_id")));
				map.put(normalizeKey(userId), flat);
			}
		} catch (Exception e) {
			log("WARN", "Address lookup failed: " + e.getMessage(), null, "LOOKUP_LOAD");
		} finally {
			closeQuietly(rs);
			closeQuietly(ps);
			closeQuietly(conn);
		}

		return map;
	}

	private void mergeLookupByUserId(Map<String, Map<String, String>> target, CsvTable table) {
		if (target == null || table == null || table.rows == null)
			return;
		for (Map<String, String> row : table.rows) {
			String userId = get(row, "user_id");
			if (isBlank(userId))
				continue;
			target.put(normalizeKey(userId), row);
		}
	}

	private Map<String, String> lookupRowByUserId(Map<String, Map<String, String>> lookup, String userId) {
		if (lookup == null || isBlank(userId))
			return null;
		return lookup.get(normalizeKey(userId));
	}

