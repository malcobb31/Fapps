		String officeAddress = "Same as registered address";

		// Rule #7 (IU) and existing IAU behavior: same_registration_correspondence_address = true.
		Boolean sameRegistrationCorrespondenceAddress = null;
		if (!isBlank(mappedType) && (mappedType.startsWith("IAU") || "IU".equals(mappedType))) {
			sameRegistrationCorrespondenceAddress = Boolean.TRUE;
