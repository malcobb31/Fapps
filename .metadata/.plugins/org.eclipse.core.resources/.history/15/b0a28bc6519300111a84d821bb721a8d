	public boolean run(String csvFolderPath) {
		EtlReport report = new EtlReport();
		report.startMs = System.currentTimeMillis();

		log("INFO", "========================================", null, "APP_START");
		log("INFO", "USER MIGRATION STARTING", null, "APP_START");
		log("INFO", "Process=" + PROCESS_NAME + "  Version=" + PROCESS_VERSION, null, "APP_START");
		log("INFO", "========================================", null, "APP_START");

		try {
			Path inputDir = Paths.get(csvFolderPath);
			if (!Files.exists(inputDir) || !Files.isDirectory(inputDir)) {
				log("ERROR", "CSV folder not found or not a directory: " + csvFolderPath, null, "CONFIG_LOAD");
				return false;
			}

			List<Path> csvFiles = findCsvFiles(inputDir);
			if (csvFiles.isEmpty()) {
				log("WARN", "No CSV files found in: " + csvFolderPath, null, "CSV_LOAD");
				return false;
			}

			List<CsvTable> masterTables = new ArrayList<CsvTable>();
			Map<String, Map<String, String>> userDetailsLookup = new HashMap<String, Map<String, String>>();
			// user_address CSV (e.g. raw_..._48_...csv, headers include user_id/email_id/phone2/phone3):
			// used as a fallback when re_mgmt.address (DB) has no row for a given user_id.
			Map<String, Map<String, String>> userAddressCsvLookup = new HashMap<String, Map<String, String>>();

			for (Path f : csvFiles) {
				CsvTable t = loadCsv(f);
				if (t == null || t.rows.isEmpty())
					continue;

				if (isUserMaster(t)) {
					masterTables.add(t);
					report.totalRows += t.rows.size();
					continue;
				}
				if (isUserAddressCsv(t)) {
					mergeLookupByUserId(userAddressCsvLookup, t);
					continue;
				}
				if (isUserDetails(t)) {
					mergeLookupByUserId(userDetailsLookup, t);
				}
			}

			if (masterTables.isEmpty()) {
				log("ERROR",
						"No valid user_master CSV found. Required headers: "
								+ "user_id, user_mode, user_status, bc_organisation, first_name, title",
						null, "CSV_LOAD");
				return false;
			}

			log("INFO", "Total source rows to process: " + report.totalRows, null, "CONFIG_LOAD");
			log("INFO", "User details rows loaded: " + userDetailsLookup.size(), null, "CONFIG_LOAD");
			log("INFO", "User address CSV rows loaded: " + userAddressCsvLookup.size(), null, "CONFIG_LOAD");

			for (CsvTable t : masterTables)
				validateSourceHeaders(t.headers);

			// Address, region, branch and reporting-entity lookups now come from the DB (re_mgmt schema),
			// not from CSV, per updated business rules.
			Map<String, Map<String, String>> addressLookup = loadAddressLookup();
			log("INFO", "Address lookup loaded from re_mgmt.address | Entries=" + addressLookup.size(), null,
					"LOOKUP_LOAD");

			Map<String, String> regionLookup = loadRegionLookup();
			log("INFO", "Region lookup loaded from re_mgmt.region | Entries=" + regionLookup.size(), null,
					"LOOKUP_LOAD");

			Map<String, String> branchLookup = loadBranchLookup();
			log("INFO", "Branch lookup loaded from re_mgmt.branch | Entries=" + branchLookup.size(), null,
					"LOOKUP_LOAD");

			Map<String, String> reLookup = loadReportingEntityLookup();
			log("INFO", "Reporting-entity lookup loaded | Entries=" + reLookup.size(), null, "LOOKUP_LOAD");

			buildRankDecisions(masterTables, regionLookup, branchLookup, report);

			String insertSql = buildInsertSql();

			try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass)) {
				conn.setAutoCommit(false);

				try (PreparedStatement ps = conn.prepareStatement(insertSql)) {

					List<Map<String, String>> batch = new ArrayList<Map<String, String>>(BATCH_SIZE);
					List<String> batchIds = new ArrayList<String>(BATCH_SIZE);

					iaCounterByBcOrganisation.clear();

					for (CsvTable masterTable : masterTables) {
						for (Map<String, String> row : masterTable.rows) {

							String userId = get(row, "user_id");
							String userMode = get(row, "user_mode");
							String modeKey = isBlank(userMode) ? "" : userMode.trim().toUpperCase();

							if (isBlank(userId)) {
								report.skipAcc.record("BLANK_USER_ID");
								continue;
							}

							if (!USER_MODE_MAX_COUNT.containsKey(modeKey)) {
								report.skipAcc.record("USER_MODE_NOT_SUPPORTED_" + modeKey);
								continue;
							}

							if (!passesRegionBranchValidation(modeKey, row, regionLookup, branchLookup)) {
								report.skipAcc.record("INVALID_REGION_OR_BRANCH_" + modeKey);
								continue;
							}

							Map<String, String> resolved = resolveRow(row, reLookup, addressLookup,
									userAddressCsvLookup, userDetailsLookup, report.dtWarn);

							bindResolvedRow(ps, resolved, report.dtWarn);
							ps.addBatch();
							batch.add(resolved);
							batchIds.add(userId);

							if (batch.size() >= BATCH_SIZE) {
								flushBatch(conn, ps, batch, batchIds, report);
								batch.clear();
								batchIds.clear();
							}
						}
					}

					if (!batch.isEmpty())
						flushBatch(conn, ps, batch, batchIds, report);
				}
			}

			if (!report.dtWarn.isEmpty()) {
				log("INFO", "-- Aggregated Datatype Warnings --", null, "DATATYPE_WARN");
				for (Map.Entry<String, Integer> e : report.dtWarn.counts().entrySet()) {
					log("WARN", "DATATYPE_WARN Column=" + e.getKey() + " Expected=" + typeForColumn(e.getKey())
							+ " Failures=" + e.getValue() + " SampleValues=" + report.dtWarn.samples().get(e.getKey()),
							null, "DATATYPE_WARN");
				}
			}

			report.endMs = System.currentTimeMillis();
			printEtlReport(report);

			// Post-migration steps run automatically after the insert phase completes.
			boolean statusUpdateOk = applyPostMigrationStatusUpdate();
			boolean dedupOk = correctDuplicateEmailMobile();

			return statusUpdateOk && dedupOk;

		} catch (Exception e) {
			log("ERROR", "Fatal ETL error: " + e.getMessage(), null, "ETL_ERROR");
			return false;
		}
	}

	/**
	 * POST-MIGRATION STATUS UPDATE STEP.
	 *
	 * Runs after the full migration/insert phase completes. For every re_user row:
	 *   1. Moves the current status value into metadata.previousStatus
	 *   2. Applies the status transform (rule #5 / STATUSES_TO_DEACTIVATE):
	 *        DELETED, REJECTED, ACTIVATION_PENDING, ACTIVATION_REJECTED, DELETION_PENDING,
	 *        IN_ACTIVE, MIGRATION_IN_ACTIVE -> DEACTIVATED
	 *        TESTBED stays TESTBED, DEACTIVATED stays DEACTIVATED
	 *
	 * Note: resolveRow() already applies this same transform and writes previousStatus
	 * into metadata at insert time (rule #5), so under normal operation this step is
	 * idempotent (status is already final, previousStatus already set) for freshly
	 * inserted rows. It is kept as an explicit, separate pass per the business
	 * requirement so it also covers any rows whose status changed by other means
	 * between insert and this step running.
	 */
	private boolean applyPostMigrationStatusUpdate() {
		log("INFO", "========================================", null, "STATUS_UPDATE_START");
		log("INFO", "POST-MIGRATION STATUS UPDATE STARTING", null, "STATUS_UPDATE_START");
		log("INFO", "========================================", null, "STATUS_UPDATE_START");

		String selectSql = "SELECT user_id, status, metadata FROM re_mgmt.re_user";
		String updateSql = "UPDATE re_mgmt.re_user SET status = ?, metadata = CAST(? AS jsonb) WHERE user_id = ?";

		int updatedCount = 0;

		try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass)) {
			conn.setAutoCommit(false);

			List<String[]> toUpdate = new ArrayList<String[]>(); // [userId, newStatus, newMetadataJson]

			try (PreparedStatement selPs = conn.prepareStatement(selectSql);
					ResultSet rs = selPs.executeQuery()) {

				while (rs.next()) {
					String userId = rs.getString("user_id");
					String currentStatus = rs.getString("status");
					String currentMetadata = rs.getString("metadata");

					if (isBlank(currentStatus))
						continue;

					String finalStatus = mapFinalStatus(currentStatus.trim());

					String newMetadata = putJsonStringField(currentMetadata, "previousStatus", currentStatus.trim());

					toUpdate.add(new String[] { userId, finalStatus, newMetadata });
				}
			}

			try (PreparedStatement updPs = conn.prepareStatement(updateSql)) {
				int sinceCommit = 0;
				for (String[] rowData : toUpdate) {
					updPs.setString(1, rowData[1]);
					updPs.setString(2, rowData[2]);
					updPs.setString(3, rowData[0]);
					updPs.addBatch();
					updatedCount++;
					sinceCommit++;
					if (sinceCommit >= BATCH_SIZE) {
						updPs.executeBatch();
						conn.commit();
						sinceCommit = 0;
					}
				}
				if (sinceCommit > 0) {
					updPs.executeBatch();
					conn.commit();
				}
			}

		} catch (Exception e) {
			log("ERROR", "Post-migration status update failed: " + e.getMessage(), null, "STATUS_UPDATE_ERROR");
			return false;
		}

		log("INFO", "Rows status-updated: " + updatedCount, null, "STATUS_UPDATE_SUMMARY");
		log("INFO", "========================================", null, "STATUS_UPDATE_END");
		log("INFO", "POST-MIGRATION STATUS UPDATE COMPLETED", null, "STATUS_UPDATE_END");
		log("INFO", "========================================", null, "STATUS_UPDATE_END");
		return true;
	}

	/**
	 * Post-migration duplicate email/mobile correction.
	 *
	 * Runs automatically after run()'s insert phase and the status update step complete.
	 *
	 * Scope: within the same RE (grouped by reporting_entity_id already written during
	 * migration), the NO user is the reference user. For each IAU_1 / IAU_2 user in that RE:
	 *   - if its effective email matches the NO user's effective email, the IAU user's
	 *     email is prefixed as "<user_type>.<original_email>"
	 *   - if its effective mobile matches the NO user's effective mobile, the IAU user's
	 *     mobile is replaced with a new sequential 10-digit number starting at 6000001111,
	 *     incrementing by 1 for each subsequent duplicate IAU sub-user within that same RE.
	 *
	 * Also handles IAU_1 vs IAU_2 duplicates directly (independent of the NO user):
	 *   - if IAU_1 and IAU_2 share the same effective email, BOTH are prefixed and BOTH
	 *     mobiles are regenerated (even if the mobiles were not themselves duplicates).
	 *   - if IAU_1 and IAU_2 share the same effective mobile (but not email), both mobiles
	 *     are regenerated.
	 *
	 * "Effective email" = lower(trim(email)). "Effective mobile" = first non-blank of
	 * mobile, mobile_number, mobile_no. When a mobile is regenerated, all three columns
	 * (mobile, mobile_number, mobile_no) are updated together.
	 *
	 * The NO user's own email/mobile are never modified. IRA, IU, IRU, IBU users are never
	 * modified. No other fields are modified.
	 */
	public boolean correctDuplicateEmailMobile() {
		log("INFO", "========================================", null, "DEDUP_START");
		log("INFO", "POST-MIGRATION DUPLICATE EMAIL/MOBILE CORRECTION STARTING", null, "DEDUP_START");
		log("INFO", "========================================", null, "DEDUP_START");

		String selectSql = "SELECT user_id, user_type, reporting_entity_id, email, mobile, mobile_number, mobile_no "
				+ "FROM re_mgmt.re_user WHERE user_type IN ('NO','IAU_1','IAU_2')";

		Map<String, List<Map<String, String>>> reGroups = new LinkedHashMap<String, List<Map<String, String>>>();

		try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass);
				PreparedStatement ps = conn.prepareStatement(selectSql);
				ResultSet rs = ps.executeQuery()) {

			while (rs.next()) {
				String reId = rs.getString("reporting_entity_id");
				if (isBlank(reId))
					continue;
				String key = normalizeKey(reId);

				Map<String, String> record = new HashMap<String, String>();
				record.put("user_id", rs.getString("user_id"));
				record.put("user_type", rs.getString("user_type"));
				record.put("email", rs.getString("email"));
				record.put("mobile", rs.getString("mobile"));
				record.put("mobile_number", rs.getString("mobile_number"));
				record.put("mobile_no", rs.getString("mobile_no"));

				List<Map<String, String>> list = reGroups.get(key);
				if (list == null) {
					list = new ArrayList<Map<String, String>>();
					reGroups.put(key, list);
				}
				list.add(record);
			}
		} catch (Exception e) {
			log("ERROR", "Failed to load users for duplicate correction: " + e.getMessage(), null, "DEDUP_ERROR");
			return false;
		}

		String updateSql = "UPDATE re_mgmt.re_user SET email = ?, mobile = ?, mobile_number = ?, mobile_no = ? WHERE user_id = ?";

		int emailCorrected = 0;
		int mobileCorrected = 0;
		long nextMobile = 6000001111L;

		try (Connection conn = DriverManager.getConnection(pgUrl, pgUser, pgPass)) {
			conn.setAutoCommit(false);

			try (PreparedStatement ps = conn.prepareStatement(updateSql)) {

				for (Map.Entry<String, List<Map<String, String>>> reEntry : reGroups.entrySet()) {
					List<Map<String, String>> members = reEntry.getValue();

					Map<String, String> noUser = null;
					List<Map<String, String>> iauUsers = new ArrayList<Map<String, String>>();
					for (Map<String, String> m : members) {
						String userType = m.get("user_type");
						if ("NO".equals(userType)) {
							noUser = m;
						} else if ("IAU_1".equals(userType) || "IAU_2".equals(userType)) {
							iauUsers.add(m);
						}
					}

					if (iauUsers.isEmpty())
						continue;

					String noEmail = noUser == null ? null : noUser.get("email");
					String noMobile = noUser == null ? null : effectiveMobile(noUser);

					// pending changes per iau user_id, applied at the end of this RE group
					Map<String, String> pendingEmail = new HashMap<String, String>();
					Map<String, String> pendingMobile = new HashMap<String, String>();

					// 1) NO vs each IAU: email
					for (Map<String, String> iau : iauUsers) {
						String userType = iau.get("user_type");
						String iauUserId = iau.get("user_id");
						String iauEmail = iau.get("email");

						if (!isBlank(noEmail) && !isBlank(iauEmail)
								&& effectiveEmail(noEmail).equals(effectiveEmail(iauEmail))) {
							pendingEmail.put(iauUserId, userType + "." + iauEmail.trim());
						}
					}

					// 2) NO vs each IAU: mobile
					for (Map<String, String> iau : iauUsers) {
						String iauUserId = iau.get("user_id");
						String iauMobile = effectiveMobile(iau);

						if (!isBlank(noMobile) && !isBlank(iauMobile) && noMobile.equals(iauMobile)) {
							pendingMobile.put(iauUserId, String.valueOf(nextMobile));
							nextMobile++;
						}
					}

					// 3) IAU_1 vs IAU_2 direct comparison (only meaningful when both are present)
					if (iauUsers.size() >= 2) {
						for (int i = 0; i < iauUsers.size(); i++) {
							for (int j = i + 1; j < iauUsers.size(); j++) {
								Map<String, String> a = iauUsers.get(i);
								Map<String, String> b = iauUsers.get(j);

								String aUserId = a.get("user_id");
								String bUserId = b.get("user_id");
								String aEmail = a.get("email");
								String bEmail = b.get("email");
								String aMobile = effectiveMobile(a);
								String bMobile = effectiveMobile(b);

								boolean emailDup = !isBlank(aEmail) && !isBlank(bEmail)
										&& effectiveEmail(aEmail).equals(effectiveEmail(bEmail));
								boolean mobileDup = !isBlank(aMobile) && !isBlank(bMobile) && aMobile.equals(bMobile);

								if (emailDup) {
									// prefix both emails and regenerate both mobiles, even if mobiles differ
									if (!pendingEmail.containsKey(aUserId))
										pendingEmail.put(aUserId, a.get("user_type") + "." + aEmail.trim());
									if (!pendingEmail.containsKey(bUserId))
										pendingEmail.put(bUserId, b.get("user_type") + "." + bEmail.trim());

									if (!pendingMobile.containsKey(aUserId)) {
										pendingMobile.put(aUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
									if (!pendingMobile.containsKey(bUserId)) {
										pendingMobile.put(bUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
								} else if (mobileDup) {
									if (!pendingMobile.containsKey(aUserId)) {
										pendingMobile.put(aUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
									if (!pendingMobile.containsKey(bUserId)) {
										pendingMobile.put(bUserId, String.valueOf(nextMobile));
										nextMobile++;
									}
								}
							}
						}
					}

					// apply pending changes for this RE group
					for (Map<String, String> iau : iauUsers) {
						String userType = iau.get("user_type");
						String iauUserId = iau.get("user_id");

						String newEmail = pendingEmail.containsKey(iauUserId) ? pendingEmail.get(iauUserId)
								: iau.get("email");
						String newMobileVal = pendingMobile.containsKey(iauUserId) ? pendingMobile.get(iauUserId)
								: effectiveMobile(iau);

						boolean changed = pendingEmail.containsKey(iauUserId) || pendingMobile.containsKey(iauUserId);
						if (!changed)
							continue;

						ps.setString(1, newEmail);
						ps.setString(2, newMobileVal);
						ps.setString(3, newMobileVal);
						ps.setString(4, newMobileVal);
						ps.setString(5, iauUserId);
						ps.addBatch();

						if (pendingEmail.containsKey(iauUserId))
							emailCorrected++;
						if (pendingMobile.containsKey(iauUserId))
							mobileCorrected++;

						log("INFO", "Duplicate corrected | user_id=" + iauUserId + " | user_type=" + userType, null,
								"DEDUP_CORRECT");
					}
				}

				ps.executeBatch();
				conn.commit();
			}
		} catch (Exception e) {
			log("ERROR", "Failed to apply duplicate correction: " + e.getMessage(), null, "DEDUP_ERROR");
			return false;
		}

		log("INFO", "Emails corrected: " + emailCorrected, null, "DEDUP_SUMMARY");
		log("INFO", "Mobiles corrected: " + mobileCorrected, null, "DEDUP_SUMMARY");
		log("INFO", "========================================", null, "DEDUP_END");
		log("INFO", "DUPLICATE EMAIL/MOBILE CORRECTION COMPLETED", null, "DEDUP_END");
		log("INFO", "========================================", null, "DEDUP_END");
		return true;
	}

	private String effectiveEmail(String email) {
		if (isBlank(email))
			return "";
		return email.trim().toLowerCase();
	}

	private String effectiveMobile(Map<String, String> record) {
		if (record == null)
			return null;
		return firstNonBlank(record.get("mobile"), record.get("mobile_number"), record.get("mobile_no"));
	}

	/**
	 * Applies the status transform used both at insert time (resolveRow) and in the
	 * explicit post-migration status-update pass (rule #5).
	 */
	private String mapFinalStatus(String status) {
		if (isBlank(status))
			return status;
		String s = status.trim();
		if (STATUSES_TO_DEACTIVATE.contains(s))
			return STATUS_DEACTIVATED;
		if (STATUS_TESTBED.equals(s))
			return STATUS_TESTBED;
		if (STATUS_DEACTIVATED.equals(s))
			return STATUS_DEACTIVATED;
		return s;
	}

	/**
	 * Adds/overwrites a single string field in a JSON object string. Falls back to a
	 * fresh single-field object if the existing value is blank or not a JSON object.
	 * Kept intentionally simple (no external JSON library) to match the rest of this
	 * codebase's hand-rolled JSON handling (see toJson/escapeJson).
	 */
	private String putJsonStringField(String existingJson, String field, String value) {
		Map<String, String> map = new LinkedHashMap<String, String>();
		if (!isBlank(existingJson)) {
			String trimmed = existingJson.trim();
			if (trimmed.startsWith("{") && trimmed.endsWith("}")) {
				parseFlatJsonObject(trimmed, map);
			}
		}
		map.put(field, value);
		return toJson(map);
	}

	/**
	 * Minimal parser for the flat, single-level string-valued JSON objects this class
	 * itself produces via toJson()/buildMetadataJson(). Not a general JSON parser;
	 * sufficient for round-tripping metadata written by this ETL.
	 */
	private void parseFlatJsonObject(String json, Map<String, String> out) {
		String body = json.trim();
		if (body.length() >= 2 && body.charAt(0) == '{' && body.charAt(body.length() - 1) == '}') {
			body = body.substring(1, body.length() - 1);
		}
		int i = 0;
		int len = body.length();
		while (i < len) {
			while (i < len && (body.charAt(i) == ',' || Character.isWhitespace(body.charAt(i))))
				i++;
			if (i >= len)
				break;
			if (body.charAt(i) != '"')
				break;
			StringBuilder key = new StringBuilder();
			i++;
			while (i < len && body.charAt(i) != '"') {
				if (body.charAt(i) == '\\' && i + 1 < len) {
					key.append(unescapeJsonChar(body.charAt(i + 1)));
					i += 2;
				} else {
					key.append(body.charAt(i));
					i++;
				}
			}
			i++; // closing quote
			while (i < len && (body.charAt(i) == ':' || Character.isWhitespace(body.charAt(i))))
				i++;
			if (i < len && body.charAt(i) == 'n' && body.startsWith("null", i)) {
				out.put(key.toString(), null);
				i += 4;
				continue;
			}
			if (i >= len || body.charAt(i) != '"') {
				// unsupported value shape (nested object/array/number) - skip to next comma at depth 0
				int depth = 0;
				while (i < len && !(body.charAt(i) == ',' && depth == 0)) {
					if (body.charAt(i) == '{' || body.charAt(i) == '[')
						depth++;
					if (body.charAt(i) == '}' || body.charAt(i) == ']')
						depth--;
					i++;
				}
				continue;
			}
			StringBuilder val = new StringBuilder();
			i++;
			while (i < len && body.charAt(i) != '"') {
				if (body.charAt(i) == '\\' && i + 1 < len) {
					val.append(unescapeJsonChar(body.charAt(i + 1)));
					i += 2;
				} else {
					val.append(body.charAt(i));
					i++;
				}
			}
			i++; // closing quote
			out.put(key.toString(), val.toString());
		}
	}

	private char unescapeJsonChar(char escaped) {
		switch (escaped) {
		case 'r':
			return '\r';
		case 'n':
			return '\n';
		case '"':
			return '"';
		case '\\':
			return '\\';
		default:
			return escaped;
		}
	}

	/**
	 * Implements the updated business rules for deriving user_type/status.
	 *
	 * Grouping/validation scope is role-specific:
	 *   IA / IAU : bc_organisation (fiCode)
	 *   IU       : bc_organisation (fiCode)
	 *   IRA      : bc_organisation (fiCode) + region_code (regionCode)
	 *   IRU      : bc_organisation (fiCode) + region_code (regionCode)
	 *   IBU      : bc_organisation (fiCode) + region_code (regionCode) + user_branch_id (branchCode)
	 *
	 * Only rows with user_mode one of IA/IU/IRA/IRU/IBU and user_status one of
	 * (1,2,4,6,7,12,20) participate in ranking. Rows failing region/branch pre-validation
	 * (rule #4) are excluded entirely before grouping.
	 * Rows are sorted by login_time descending within each (scope, user_mode) group,
	 * with user_id (ascending) as a tie-breaker when login_time is equal or blank.
	 * Top rows are forced to TESTBED, overflow rows to MIGRATION_IN_ACTIVE (which is
	 * later collapsed to DEACTIVATED by the status transform in resolveRow / rule #5).
	 */
	private void buildRankDecisions(List<CsvTable> masterTables, Map<String, String> regionLookup,
			Map<String, String> branchLookup, EtlReport report) {
		rankDecisionByUserId.clear();

		// scopeKey -> user_mode -> list of ranked-status rows
		Map<String, Map<String, List<Map<String, String>>>> grouped = new LinkedHashMap<String, Map<String, List<Map<String, String>>>>();

		for (CsvTable masterTable : masterTables) {
			for (Map<String, String> row : masterTable.rows) {
				String userId = get(row, "user_id");
				if (isBlank(userId))
					continue;

				String userMode = get(row, "user_mode");
				if (isBlank(userMode))
					continue;

				String modeKey = userMode.trim().toUpperCase();
				if (!USER_MODE_MAX_COUNT.containsKey(modeKey))
					continue;

				String userStatus = get(row, "user_status");
				if (!RANKED_STATUSES.contains(userStatus))
					continue;

				// Rule #4: IRA/IRU/IBU must pass region/branch pre-validation before ranking.
				if (!passesRegionBranchValidation(modeKey, row, regionLookup, branchLookup)) {
					continue;
				}

				String scopeKey = buildScopeKey(modeKey, row);

				Map<String, List<Map<String, String>>> byMode = grouped.get(scopeKey);
				if (byMode == null) {
					byMode = new LinkedHashMap<String, List<Map<String, String>>>();
					grouped.put(scopeKey, byMode);
				}
				List<Map<String, String>> rows = byMode.get(modeKey);
				if (rows == null) {
					rows = new ArrayList<Map<String, String>>();
					byMode.put(modeKey, rows);
				}
				rows.add(row);
			}
		}

		for (Map.Entry<String, Map<String, List<Map<String, String>>>> orgEntry : grouped.entrySet()) {
			Map<String, List<Map<String, String>>> byMode = orgEntry.getValue();

			for (String modeKey : USER_MODE_PRIORITY_ORDER) {
				List<Map<String, String>> rows = byMode.get(modeKey);
				if (rows == null || rows.isEmpty())
					continue;

				List<Map<String, String>> sorted = new ArrayList<Map<String, String>>(rows);
				Collections.sort(sorted, new Comparator<Map<String, String>>() {
					@Override
					public int compare(Map<String, String> a, Map<String, String> b) {
						String la = get(a, "login_time");
						String lb = get(b, "login_time");
						if (isBlank(la) && isBlank(lb))
							return get(a, "user_id").compareTo(get(b, "user_id"));
						if (isBlank(la))
							return 1;
						if (isBlank(lb))
							return -1;
						int cmp = lb.compareTo(la);
						if (cmp != 0)
							return cmp;
						return get(a, "user_id").compareTo(get(b, "user_id"));
					}
				});

				int maxCount = USER_MODE_MAX_COUNT.get(modeKey).intValue();

				for (int i = 0; i < sorted.size(); i++) {
					Map<String, String> row = sorted.get(i);
					String userId = get(row, "user_id");
					if (isBlank(userId))
						continue;

					RankDecision decision;
					if ("IA".equals(modeKey)) {
						if (i == 0) {
							decision = new RankDecision("IAU_1", STATUS_TESTBED);
						} else if (i == 1) {
							decision = new RankDecision("IAU_2", STATUS_TESTBED);
						} else {
							decision = new RankDecision("IA", STATUS_MIGRATION_IN_ACTIVE);
						}
					} else {
						if (i < maxCount) {
							decision = new RankDecision(modeKey, STATUS_TESTBED);
						} else {
							decision = new RankDecision(modeKey, STATUS_MIGRATION_IN_ACTIVE);
						}
					}

					rankDecisionByUserId.put(normalizeKey(userId), decision);
				}
			}
		}
	}

	/**
	 * Builds the scope key used to group rows for ranking, per role:
	 *   IA / IAU / IU : fiCode (bc_organisation)
	 *   IRA / IRU     : fiCode (bc_organisation) + regionCode (region_code)
	 *   IBU           : fiCode (bc_organisation) + regionCode (region_code) + branchCode (user_branch_id)
	 */
	private String buildScopeKey(String modeKey, Map<String, String> row) {
		String fiCode = normalizeKey(get(row, "bc_organisation"));

		if ("IRA".equals(modeKey) || "IRU".equals(modeKey)) {
			String regionCode = normalizeKey(get(row, "region_code"));
			return fiCode + "|" + regionCode;
		}
		if ("IBU".equals(modeKey)) {
			String regionCode = normalizeKey(get(row, "region_code"));
			String branchCode = normalizeKey(get(row, "user_branch_id"));
			return fiCode + "|" + regionCode + "|" + branchCode;
		}
		// IA, IU (and any other supported mode): scope is fiCode only
		return fiCode;
	}

	/**
	 * Rule #4 pre-validation: IRA/IRU require a valid region_code in re_mgmt.region.
	 * IBU additionally requires a valid user_branch_id in re_mgmt.branch (scoped to
	 * that region). IA/IU are not subject to this check and always pass.
	 */
	private boolean passesRegionBranchValidation(String modeKey, Map<String, String> row,
			Map<String, String> regionLookup, Map<String, String> branchLookup) {
		if (!"IRA".equals(modeKey) && !"IRU".equals(modeKey) && !"IBU".equals(modeKey)) {
			return true;
		}

		String regionCode = get(row, "region_code");
		if (isBlank(regionCode) || regionLookup == null || !regionLookup.containsKey(normalizeKey(regionCode))) {
			return false;
		}

		if (!"IBU".equals(modeKey)) {
			return true;
		}

		String branchCode = get(row, "user_branch_id");
		if (isBlank(branchCode) || branchLookup == null || !branchLookup.containsKey(normalizeKey(branchCode))) {
			return false;
		}

		// Ensure the branch actually belongs to the validated region.
		String branchRegionId = branchLookup.get(normalizeKey(branchCode));
		String regionId = regionLookup.get(normalizeKey(regionCode));
		return !isBlank(branchRegionId) && !isBlank(regionId) && branchRegionId.equals(regionId);
	}

	private void flushBatch(Connection conn, PreparedStatement ps, List<Map<String, String>> batch,
			List<String> batchIds, EtlReport report) throws SQLException {
		report.batchesExecuted++;
		try {
			int[] results = ps.executeBatch();
			conn.commit();
			for (int r : results) {
				if (r == 1 || r == java.sql.Statement.SUCCESS_NO_INFO) {
					report.inserted++;
				} else if (r == 0) {
					report.conflictSkipped++;
				}
			}
			log("INFO", "Batch committed | Size=" + batch.size() + " | RunningInserted=" + report.inserted, null,
					"BATCH_SUCCESS");
		} catch (BatchUpdateException bue) {
			report.batchesFailed++;
			conn.rollback();

			StringBuilder rootCause = new StringBuilder();
			SQLException next = bue.getNextException();
			while (next != null) {
				rootCause.append("[SQLState=").append(next.getSQLState()).append(" Msg=").append(next.getMessage())
						.append("] ");
				next = next.getNextException();
			}
			log("ERROR", "Batch failed | Size=" + batch.size() + " | RootCause=" + rootCause.toString().trim(), null,
					"BATCH_ERROR");

			ps.clearBatch();
			retryIndividually(conn, ps, batch, batchIds, report);
		}
	}

	private void retryIndividually(Connection conn, PreparedStatement ps, List<Map<String, String>> batch,
			List<String> batchIds, EtlReport report) throws SQLException {
		for (int i = 0; i < batch.size(); i++) {
			String userId = batchIds.get(i);
			try {
				ps.clearParameters();
				bindResolvedRow(ps, batch.get(i), report.dtWarn);
				ps.execute();
				conn.commit();
				report.inserted++;
			} catch (SQLException rowEx) {
				try {
					conn.rollback();
				} catch (Exception ignored) {
				}
				String sqlState = rowEx.getSQLState() == null ? "UNKNOWN" : rowEx.getSQLState();
				String reason;
				if ("23505".equals(sqlState)) {
					reason = "UNIQUE_CONSTRAINT_VIOLATION";
					report.conflictSkipped++;
				} else if ("23503".equals(sqlState)) {
					reason = "FK_CONSTRAINT_VIOLATION";
				} else if (sqlState.startsWith("23")) {
					reason = "INTEGRITY_CONSTRAINT_" + sqlState;
				} else {
					reason = "ROW_ERROR_" + sqlState;
				}
				report.skipAcc.record(reason);
				log("WARN", "Row skipped | user_id=" + userId + " | Reason=" + reason + " | SQLState=" + sqlState
						+ " | Detail=" + rowEx.getMessage(), null, "CONSTRAINT_ERROR");
			}
		}
	}

	private Map<String, String> resolveRow(Map<String, String> row, Map<String, String> reLookup,
			Map<String, Map<String, String>> addressLookup, Map<String, Map<String, String>> userAddressCsvLookup,
