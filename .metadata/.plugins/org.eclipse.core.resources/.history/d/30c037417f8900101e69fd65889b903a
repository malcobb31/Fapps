    // Constants
    private static final DateTimeFormatter LOG_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
    private static final int DEFAULT_THREAD_COUNT = Math.max(2, Runtime.getRuntime().availableProcessors());

    // Process information constants
    private static final String PROCESS_NAME = "CSV_TO_PSQL";
    // private static final String SERVER_IP = "127.0.0.1";
    private static final String PROCESS_VERSION = "1.0.0";

    // Performance optimization - reduce debug logging
    private static final boolean DEBUG_ENABLED = false;

    // Enhanced logging with proper event types and Server_IP
    private static void log(String level, String message, String pdbhost, String evtType) {
        if ("DEBUG".equalsIgnoreCase(level) && !DEBUG_ENABLED) return;
        String timestamp = LocalDateTime.now().format(LOG_FORMAT);
        StringBuilder logBuilder = new StringBuilder(512);
        logBuilder.append("ALERT - ").append(timestamp).append(" --> ").append("Process_Name:").append(PROCESS_NAME)
                .append(" ");
        if (pdbhost != null && !pdbhost.isEmpty()) {
            logBuilder.append("Server_IP: " + "").append(pdbhost).append(" ");
        }
        logBuilder.append("Process_Version:").append(PROCESS_VERSION).append(" ").append("Log_Level:")
                .append(level.toUpperCase()).append(" ").append("EVT_Type:").append(evtType != null ? evtType : "NA")
                .append(" ").append("Description:").append(message != null ? message : "");

        // Trim any trailing whitespace
        String finalLog = logBuilder.toString().replaceAll("\\s+$", "");
        System.out.println(finalLog);
    }

    // Resource monitoring logging
    private static void logResourceUsage(String phase, String pdbHost) {
        try {
            MemoryMXBean memoryBean = ManagementFactory.getMemoryMXBean();
            long usedMemory = memoryBean.getHeapMemoryUsage().getUsed();
            long maxMemory = memoryBean.getHeapMemoryUsage().getMax();
            double memoryUsage = (double) usedMemory / maxMemory * 100;

            com.sun.management.OperatingSystemMXBean osBean = (com.sun.management.OperatingSystemMXBean) ManagementFactory.getOperatingSystemMXBean();
            double systemCpuLoad = osBean.getSystemCpuLoad() * 100;
            long totalMemory = osBean.getTotalPhysicalMemorySize() / (1024 * 1024);
            long freeMemory = osBean.getFreePhysicalMemorySize() / (1024 * 1024);

            log("INFO", String.format("Phase:%s Process_CPU:%.2f%% System_CPU:%.2f%% JVM_Memory:%.2f%% Used:%dMB Max:%dMB System_Mem:%dMB Free:%dMB",
                    phase, getCpuUsage(), systemCpuLoad, memoryUsage, usedMemory / (1024 * 1024), maxMemory / (1024 * 1024), totalMemory, freeMemory), pdbHost, "RESOURCE_MONITOR");
        } catch (Exception e) {
            log("WARNING", "Failed to get resource usage: " + e.getMessage(), pdbHost, "RESOURCE_ERROR");
        }
    }

    private static double getCpuUsage() {
        try {
            // Simple CPU usage approximation
            com.sun.management.OperatingSystemMXBean osBean = (com.sun.management.OperatingSystemMXBean) ManagementFactory
                    .getOperatingSystemMXBean();
            double cpuLoad = osBean.getProcessCpuLoad();
            return cpuLoad >= 0 ? cpuLoad * 100 : 0.0;
        } catch (Exception e) {
            return 0.0; // Return 0 if unable to get CPU usage
        }
    }

    // Configuration classes - optimized
    public static class ProcessConfig {
        public final String dirPath, processedDirPath, delimiter;
        public final boolean hasHeader;
        public final int numTablesToPick, bulkSize, threadCount;
        public final double maxCpuThreshold, maxMemoryThreshold;
        public final DatabaseConfig sourceDb, targetDb;
        public final String configTable, dbType;

        public ProcessConfig(String dirPath, String processedDirPath, String headerFlag, String delimiter,
                String sqldburl, String sdbuser, String sdbpass, String pdbHost, String pdbPort, String pdbName,
                String pdbUser, String pdbPass, String destUrl, String destUser, String destPass,
                String numTablesToPickStr, String configTable, String maxCpuUtil, String maxMemUtil,
                String bulkNumberStr, String dbTypeStr) {

            this.dirPath = dirPath;
            this.processedDirPath = processedDirPath;
            this.hasHeader = "yes".equalsIgnoreCase(headerFlag) || "true".equalsIgnoreCase(headerFlag);
            this.delimiter = (delimiter == null || delimiter.isEmpty()) ? "," : delimiter;
            this.numTablesToPick = parseIntOrDefault(numTablesToPickStr, 10);
            this.bulkSize = parseIntOrDefault(bulkNumberStr, 10000);
            this.threadCount = Math.min(numTablesToPick, DEFAULT_THREAD_COUNT);
            this.maxCpuThreshold = parseDoubleOrDefault(maxCpuUtil, 80.0);
            this.maxMemoryThreshold = parseDoubleOrDefault(maxMemUtil, 80.0);
            this.configTable = configTable;
            this.dbType = (dbTypeStr == null) ? "psql" : dbTypeStr.trim().toLowerCase();

            log("INFO", String.format(
                    "Configuration initialized - DB_Type:%s Tables_To_Process:%d Bulk_Size:%d Thread_Count:%d CPU_Threshold:%.1f%% Memory_Threshold:%.1f%%",
                    this.dbType, this.numTablesToPick, this.bulkSize, this.threadCount, this.maxCpuThreshold, this.maxMemoryThreshold), pdbHost, "CONFIG_INIT");

            this.sourceDb = new DatabaseConfig(sqldburl, sdbuser, sdbpass);

            if ("psql".equals(this.dbType)) {
                String pgUrl = String.format("jdbc:postgresql://%s:%s/%s", pdbHost, pdbPort, pdbName);
                this.targetDb = new DatabaseConfig(pgUrl, pdbUser, pdbPass, pdbHost, pdbPort, pdbName);
                log("INFO", String.format("PostgreSQL target configured - Host:%s Port:%s Database:%s", pdbHost, pdbPort, pdbName), pdbHost, "DB_CONFIG");
            } else {
                this.targetDb = new DatabaseConfig(destUrl, destUser, destPass);
                log("INFO", "MySQL target configured", pdbHost, "DB_CONFIG");
            }
        }
    }

    public static class DatabaseConfig {
        public final String url, user, password, host, port, database;

        public DatabaseConfig(String url, String user, String password) {
