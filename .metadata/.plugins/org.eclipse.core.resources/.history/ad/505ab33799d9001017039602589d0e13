    public static String waitForOTPFromDB() {
        String url = "jdbc:mysql://localhost:3306/pview";
        String user = "root";            
        String pass = "Admin@321";        

        int maxAttempts = 10;            // default
        int waitSeconds = 15;

        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
            System.out.println("Checking OTP in DB... Attempt " + attempt);

            try (Connection conn = DriverManager.getConnection(url, user, pass)) {

                String selectQuery =
                    "SELECT sno, OTP FROM otp_table WHERE otp_read_status='P' ORDER BY sno DESC LIMIT 1";

                PreparedStatement ps = conn.prepareStatement(selectQuery);
                ResultSet rs = ps.executeQuery();

                if (rs.next()) {
                    int sno = rs.getInt("sno");
                    String otp = rs.getString("OTP");

                    
                    String updateQuery =
                        "UPDATE otp_table SET otp_read_status='D' WHERE sno=?";
                    PreparedStatement ps2 = conn.prepareStatement(updateQuery);
                    ps2.setInt(1, sno);
                    ps2.executeUpdate();

                    System.out.println("OTP FOUND: " + otp + " (sno = " + sno + ")");
                    return otp;
                }

            } catch (Exception e) {
                System.out.println("DB Error: " + e.getMessage());
            }

            try { Thread.sleep(waitSeconds * 1000); } catch (InterruptedException ignored) {}
        }

        System.out.println("NO OTP RECEIVED AFTER MAX ATTEMPTS!");
        return null;
    }


    public static boolean switchToFrameWithElement(WebDriver driver, By locator) {
        driver.switchTo().defaultContent();
        return searchFrames(driver, locator);
    }

    private static boolean searchFrames(WebDriver driver, By locator) {
        List<WebElement> frames = driver.findElements(By.tagName("iframe"));

        for (int i = 0; i < frames.size(); i++) {
            try {
                driver.switchTo().frame(i);

                // Element found in this frame?
                if (driver.findElements(locator).size() > 0) {
                    return true;
                }

                // Search nested frames inside this frame
                if (searchFrames(driver, locator)) {
                    return true;
                }

                driver.switchTo().parentFrame();
            } catch (Exception e) {
                driver.switchTo().parentFrame();
            }
        }
        return false;
    }

