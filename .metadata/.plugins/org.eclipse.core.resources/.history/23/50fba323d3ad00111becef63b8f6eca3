package data_counter_v1;

import java.sql.Connection;

public class data_counter_main_v1 {

    static PrintUtilMsg log = new PrintUtilMsg();

    public static void main(String[] args) {

        if (args.length < 5) {
            System.out.println("Usage: java daily_summary_main <db_url> <user> <pass> <target_table> <date>");
            return;
        }

        String dbUrl     = args[0];
        String user      = args[1];
        String pass      = args[2];
        String tableName = args[3];
        String date      = args[4];

        Connection conn = null;

        try {
            log.sop("MAIN", "Starting Daily Summary Job for date: " + date);

            MySQLConnection db = new MySQLConnection();
            conn = db.getConnection(dbUrl, user, pass);

            if (conn == null) {
                log.sop("MAIN", "DB CONNECTION FAILED");
                return;
            }

            daily_summary_methods service =
                    new daily_summary_methods(conn, tableName, date, dbUrl, user, pass);

            service.process();

            conn.commit(); // commit only if NO exception

            log.sop("MAIN", "Daily Summary Job Completed Successfully");

        } catch (Exception e) {

            log.sop("MAIN", "ERROR OCCURRED: " + e.getMessage());

            try {
                if (conn != null) {
                    conn.rollback();
                    log.sop("MAIN", "ROLLBACK DONE");
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }

            e.printStackTrace();
        }
    }
}