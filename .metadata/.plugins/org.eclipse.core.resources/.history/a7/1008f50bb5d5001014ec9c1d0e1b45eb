package url_parserV1;

import org.bytedeco.opencv.global.opencv_core;
import org.bytedeco.opencv.global.opencv_imgcodecs;
import org.bytedeco.opencv.opencv_core.*;
import org.bytedeco.opencv.global.opencv_imgproc;

import java.io.BufferedReader;
import java.io.File;
import java.io.InputStreamReader;

public class url_parser_methods_login {

    public static void main(String[] args) throws Exception {

    	Mat img = opencv_imgcodecs.imread("captcha.png");

    	// ----------------- 1. Resize (3x for better OCR) -----------------
    	Mat resized = new Mat();
    	opencv_imgproc.resize(img, resized, new Size(img.cols() * 3, img.rows() * 3));

    	// ----------------- 2. Convert to HSV -----------------
    	Mat hsv = new Mat();
    	opencv_imgproc.cvtColor(resized, hsv, opencv_imgproc.COLOR_BGR2HSV);

    	// Blue color range
    	Scalar lowerBlue = new Scalar(90, 40, 40, 0);
    	Scalar upperBlue = new Scalar(150, 255, 255, 0);

    	// Convert scalar → Mat
    	Mat lowerMat = new Mat(hsv.size(), hsv.type(), lowerBlue);
    	Mat upperMat = new Mat(hsv.size(), hsv.type(), upperBlue);

    	Mat mask = new Mat();
    	opencv_core.inRange(hsv, lowerMat, upperMat, mask);

    	// ----------------- 3. Gaussian Blur (smooth noise) -----------------
    	opencv_imgproc.GaussianBlur(mask, mask, new Size(3, 3), 0);

    	// ----------------- 4. Adaptive threshold (more stable letters) -----------------
    	opencv_imgproc.adaptiveThreshold(
    	    mask,
    	    mask,
    	    255,
    	    opencv_imgproc.ADAPTIVE_THRESH_MEAN_C,
    	    opencv_imgproc.THRESH_BINARY,
    	    31,
    	    10
    	);

    	// ----------------- 5. Morphology — balance strokes -----------------
    	Mat kernel = opencv_imgproc.getStructuringElement(opencv_imgproc.MORPH_RECT, new Size(2, 2));
    	opencv_imgproc.dilate(mask, mask, kernel);
    	opencv_imgproc.erode(mask, mask, kernel);

    	// ----------------- 6. Save cleaned CAPTCHA -----------------
    	opencv_imgcodecs.imwrite("processed.png", mask);

    	// ----------------- 7. Run Tesseract -----------------
    	String tessPath = "C:\\Program Files\\Tesseract-OCR\\tesseract.exe";

    	ProcessBuilder pb = new ProcessBuilder(
    	        tessPath,
    	        "processed.png",
    	        "stdout",
    	        "--psm", "7",
    	        "--oem", "3",
    	        "-c", "tessedit_char_whitelist=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
    	        "-c", "preserve_interword_spaces=1"
    	);

    	pb.redirectErrorStream(true);
    	Process p = pb.start();

    	BufferedReader br = new BufferedReader(new InputStreamReader(p.getInputStream()));
    	StringBuilder result = new StringBuilder();
    	String line;

    	while ((line = br.readLine()) != null) {
    	    result.append(line).append("\n");
    	}

    	p.waitFor();

    	System.out.println("Extracted CAPTCHA: [" + result.toString().trim() + "]");

    }
}



