        m.put("updated_by", Arrays.asList("user_acti_deacti_maker_id", "last_updated_by", "updated_by", "UPDATED_BY"));
        SOURCE_ALIASES = Collections.unmodifiableMap(m);
    }

    ntp20_process_methods(String processName, String processVersion, String jdbcUrl, String dbUser, String dbPassword, String delimiter, String serverIP) {
        this.processName = processName == null ? "NTP20" : processName;
        this.processVersion = processVersion == null ? "1.0.0" : processVersion;
        this.jdbcUrl = jdbcUrl;
        this.dbUser = dbUser;
        this.dbPassword = dbPassword;
        this.delimiter = (delimiter == null || delimiter.length() == 0) ? "|" : delimiter;
        this.serverIP = serverIP;
        this.debugEnabled = true;
        this.logFormat = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        this.fileCharset = StandardCharsets.UTF_8;
    }

    public void process(File input) {
        if (input == null) {
            log("ERROR", "Input path is null", serverIP, "FATAL_ERROR");
            return;
        }

        log("INFO", "Process started: " + input.getAbsolutePath(), serverIP, "START");

        Map<String, BranchLookupRow> branchLookup;
        try {
            branchLookup = loadBranchLookup();
        } catch (SQLException e) {
            log("ERROR", "Fatal error loading branch lookup: " + rootCause(e), serverIP, "FATAL_ERROR");
            return;
        }

        log("INFO", "Branch lookup loaded: " + branchLookup.size() + " keys", serverIP, "LOOKUP_LOADED");

        if (input.isFile()) {
            DirectorySummary ds = new DirectorySummary();
            FileSummary fs = processOneFile(input, branchLookup);
            ds.totalFiles = 1;
            if (fs != null) {
                ds.accumulate(fs);
            }
            log("INFO", buildDirectorySummary(ds), serverIP, "DIR_SUMMARY");
            return;
        }

        File[] files = input.listFiles();
        if (files == null || files.length == 0) {
            DirectorySummary ds = new DirectorySummary();
            log("INFO", buildDirectorySummary(ds), serverIP, "DIR_SUMMARY");
            return;
        }

        List<File> csvFiles = new ArrayList<File>();
        for (File f : files) {
            if (f != null && f.isFile() && f.getName().toLowerCase(Locale.ENGLISH).endsWith(".csv")) {
                csvFiles.add(f);
            }
        }

        Collections.sort(csvFiles, new Comparator<File>() {
            @Override
            public int compare(File a, File b) {
                return a.getName().compareToIgnoreCase(b.getName());
            }
        });

        DirectorySummary ds = new DirectorySummary();
        ds.totalFiles = csvFiles.size();

        final Map<String, BranchLookupRow> finalBranchLookup = branchLookup;
        ExecutorService executor = Executors.newFixedThreadPool(Math.min(MAX_PARALLEL_FILES, Math.max(1, csvFiles.size())));
        List<Future<FileSummary>> futures = new ArrayList<Future<FileSummary>>();

        for (final File file : csvFiles) {
            futures.add(executor.submit(new Callable<FileSummary>() {
                @Override
                public FileSummary call() {
                    return processOneFile(file, finalBranchLookup);
                }
            }));
        }

        executor.shutdown();

        for (Future<FileSummary> future : futures) {
            try {
                FileSummary fs = future.get();
                if (fs != null) {
                    ds.accumulate(fs);
                }
            } catch (Exception e) {
                ds.errorFiles++;
                log("ERROR", "Fatal file execution error: " + rootCause(e), serverIP, "FATAL_ERROR");
            }
        }

        log("INFO", buildDirectorySummary(ds), serverIP, "DIR_SUMMARY");
    }

    /**
     * Loads re_mgmt.branch once into memory.
     *
     * Keys registered for each row:
     * - branch.id as string
     * - branch identifier-like columns such as branch_id, branch_code, branch_no, branch_number,
     *   legacy_branch_id, code, legacy_code, legacy_id
     * - metadata JSON fields like branch_id, branch_code, legacy_branch_id, branch_no, code
     */
    private Map<String, BranchLookupRow> loadBranchLookup() throws SQLException {
        Map<String, BranchLookupRow> map = new HashMap<String, BranchLookupRow>();

        Connection connection = null;
        Statement st = null;
        ResultSet rs = null;

        try {
            connection = openConnection();
            st = connection.createStatement();
            rs = st.executeQuery(BRANCH_LOOKUP_SQL);

            ResultSetMetaData md = rs.getMetaData();
            int colCount = md.getColumnCount();

            while (rs.next()) {
                UUID branchId = readUuidByName(rs, md, colCount, "id");
                UUID regionId = readUuidByName(rs, md, colCount, "region_id");

                BranchLookupRow row = new BranchLookupRow(branchId, regionId);

                // Always register UUID branch id itself in case source values already carry UUIDs.
                if (branchId != null) {
                    registerLookupKey(map, row, branchId.toString());
                }

                for (int i = 1; i <= colCount; i++) {
                    String columnName = md.getColumnLabel(i);
                    if (columnName == null || columnName.length() == 0) {
                        columnName = md.getColumnName(i);
                    }

                    String normalizedColumn = normalizeHeader(columnName);
                    String value = rs.getString(i);

                    if (value == null) {
                        continue;
                    }

                    if (isLikelyBranchLookupColumn(normalizedColumn)) {
                        registerLookupKey(map, row, value);
                    }

                    if ("metadata".equalsIgnoreCase(normalizedColumn) || normalizedColumn.endsWith("_metadata") || normalizedColumn.contains("metadata")) {
                        registerMetadataKeys(map, row, value);
                    }
                }
            }
        } finally {
            closeQuietly(rs);
            closeQuietly(st);
            closeQuietly(connection);
        }

        return map;
    }

    private boolean isLikelyBranchLookupColumn(String normalizedColumn) {
        if (normalizedColumn == null || normalizedColumn.length() == 0) {
            return false;
        }

        if ("branch_id".equals(normalizedColumn)) return true;
        if ("branch_code".equals(normalizedColumn)) return true;
        if ("branch_no".equals(normalizedColumn)) return true;
        if ("branch_number".equals(normalizedColumn)) return true;
        if ("legacy_branch_id".equals(normalizedColumn)) return true;
        if ("legacy_id".equals(normalizedColumn)) return true;
        if ("legacy_code".equals(normalizedColumn)) return true;
        if ("code".equals(normalizedColumn)) return true;
        if ("branch".equals(normalizedColumn)) return true;

        return false;
    }

    private void registerMetadataKeys(Map<String, BranchLookupRow> map, BranchLookupRow row, String metadataJson) {
        if (metadataJson == null || metadataJson.trim().length() == 0) {
            return;
        }

        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "branch_id"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "branch_code"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "branch_no"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "branch_number"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "legacy_branch_id"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "legacy_id"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "legacy_code"));
        registerLookupKey(map, row, extractJsonStringValue(metadataJson, "code"));
    }

    private String extractJsonStringValue(String json, String key) {
        if (json == null || key == null || key.length() == 0) {
            return null;
        }

        try {
            Pattern p = Pattern.compile("(?i)\""+ Pattern.quote(key) +"\"\\s*:\\s*\"([^\"]+)\"");
            Matcher m = p.matcher(json);
            if (m.find()) {
                return m.group(1);
            }
        } catch (Exception ignore) {
            // quiet
        }
        return null;
    }

    private void registerLookupKey(Map<String, BranchLookupRow> map, BranchLookupRow row, String rawKey) {
        String key = normalizeKey(rawKey);
        if (key == null) {
            return;
        }

        if (!map.containsKey(key)) {
            map.put(key, row);
        }
    }

    private UUID readUuidByName(ResultSet rs, ResultSetMetaData md, int colCount, String wantedColumn) throws SQLException {
        if (wantedColumn == null) {
            return null;
        }

        for (int i = 1; i <= colCount; i++) {
            String columnName = md.getColumnLabel(i);
            if (columnName == null || columnName.length() == 0) {
                columnName = md.getColumnName(i);
            }
            if (wantedColumn.equalsIgnoreCase(columnName)) {
                Object value = rs.getObject(i);
                return parseUuid(value);
            }
        }
        return null;
    }

    private FileSummary processOneFile(File file, Map<String, BranchLookupRow> branchLookup) {
        FileSummary summary = new FileSummary(file == null ? "NA" : file.getName());
        summary.status = "STARTED";
        summary.effectiveBatchSize = BATCH_SIZE;

        log("INFO", "File start: " + summary.fileName, serverIP, "FILE_START");

        BufferedReader reader = null;
        Connection connection = null;
        PreparedStatement ps = null;
        boolean fatal = false;

        try {
            if (file == null || !file.exists()) {
                summary.status = "MISSING";
                summary.dbFailed++;
                fatal = true;
                return summary;
            }

            reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), fileCharset));
            String headerLine = reader.readLine();

            if (headerLine == null) {
                summary.status = "EMPTY_FILE";
                summary.emptyFile = true;
                File moved = moveAfterSuccess(file);
                summary.moved = moved != null;
                log("INFO", "File moved: " + summary.fileName + " -> " + (moved != null ? moved.getAbsolutePath() : "NA"), serverIP, "FILE_MOVED");
                logFileSummary(summary);
                return summary;
            }

            List<String> headers = parseCsvLine(headerLine, delimiter.charAt(0));
            Map<String, Integer> headerIndex = buildHeaderIndex(headers);

            if (headerIndex.isEmpty()) {
                summary.status = "HEADER_ONLY";
                summary.headerOnlyFile = true;
                File moved = moveAfterSuccess(file);
                summary.moved = moved != null;
                log("INFO", "File moved: " + summary.fileName + " -> " + (moved != null ? moved.getAbsolutePath() : "NA"), serverIP, "FILE_MOVED");
                logFileSummary(summary);
                return summary;
            }

            connection = openConnection();
            connection.setAutoCommit(false);
            ps = connection.prepareStatement(INSERT_SQL);

            String line;
            int batchCount = 0;

            while ((line = reader.readLine()) != null) {
                if (line.trim().length() == 0) {
                    summary.blankLines++;
                    continue;
                }

                summary.dataRows++;

                List<String> rowTokens = parseCsvLine(line, delimiter.charAt(0));
                RowBuildResult row = buildRow(rowTokens, headerIndex, branchLookup);

                if (row.skippedType) {
                    summary.skippedIneligibleType++;
                    summary.skipped++;
                    continue;
                }

                if (!row.ok) {
                    summary.rowErrors++;
                    summary.skipped++;
                    continue;
                }

                bindRow(ps, row.rowValues);
                ps.addBatch();
                batchCount++;

                if (batchCount >= BATCH_SIZE) {
                    executeBatch(ps, summary, file.getName(), batchCount);
                    batchCount = 0;
                }
            }

            if (batchCount > 0) {
                executeBatch(ps, summary, file.getName(), batchCount);
            }

            connection.commit();
            summary.status = summary.dataRows == 0 ? "HEADER_ONLY" : "SUCCESS";
            if (summary.dataRows == 0) {
                summary.headerOnlyFile = true;
            }

            File moved = moveAfterSuccess(file);
            summary.moved = moved != null;
            if (moved != null) {
                log("INFO", "File moved: " + summary.fileName + " -> " + moved.getAbsolutePath(), serverIP, "FILE_MOVED");
            } else {
                log("WARN", "File not moved after commit: " + summary.fileName, serverIP, "FILE_MOVED");
            }

            logFileSummary(summary);
        } catch (BatchUpdateException bue) {
            summary.batchFailures++;
            summary.dbFailed++;
            summary.status = "BATCH_FAILURE";
            fatal = true;
            log("ERROR", "Batch failure on file " + summary.fileName + ": " + rootCause(bue), serverIP, "BATCH_FAILURE");
        } catch (SQLException sqle) {
            summary.dbFailed++;
            summary.status = "DB_ERROR";
            fatal = true;
            log("ERROR", "Database error on file " + summary.fileName + ": " + rootCause(sqle), serverIP, "FATAL_ERROR");
        } catch (Exception e) {
            summary.dbFailed++;
            summary.status = "FATAL_ERROR";
            fatal = true;
            log("ERROR", "Fatal error on file " + summary.fileName + ": " + rootCause(e), serverIP, "FATAL_ERROR");
        } finally {
            if (fatal) {
                rollbackQuietly(connection);
                summary.moved = false;
                log("WARN", "File retained in source directory: " + summary.fileName, serverIP, "FILE_RETAINED");
                logFileSummary(summary);
            }
            closeQuietly(ps);
            closeQuietly(connection);
            closeQuietly(reader);
        }

        return summary;
    }

    private Connection openConnection() throws SQLException {
        return DriverManager.getConnection(jdbcUrl, dbUser, dbPassword);
    }

    private void executeBatch(PreparedStatement ps, FileSummary summary, String fileName, int batchCount) throws SQLException {
        try {
            ps.executeBatch();
            ps.clearBatch();
            summary.inserted += batchCount;
        } catch (BatchUpdateException bue) {
            summary.batchFailures++;
            log("ERROR", "Batch execution failure for file " + fileName + ": " + rootCause(bue), serverIP, "BATCH_FAILURE");
            throw bue;
        }
    }

    /**
     * Builds one target row.
     *
     * Rules:
     *  - user_mode must be IRA, IRU, or IBU. Anything else (including IAU) is skipped.
     *  - IBU: branch_id and region_id must resolve from the lookup.
     *  - IRA/IRU: region_id must resolve from the lookup; branch_id remains null.
     */
    private RowBuildResult buildRow(List<String> rowTokens, Map<String, Integer> headerIndex, Map<String, BranchLookupRow> branchLookup) {
        String userTypeRaw = normalize(getValueFromAliases(rowTokens, headerIndex, "user_mode"));
        String userType = userTypeRaw == null ? null : userTypeRaw.toUpperCase(Locale.ENGLISH);

        if (userType == null || !ELIGIBLE_USER_TYPES.contains(userType)) {
            return RowBuildResult.skipType();
        }

        Map<String, Object> values = new LinkedHashMap<String, Object>();

        UUID generatedId = UUID.randomUUID();
        values.put("id", generatedId);

        String userId = normalize(getValueFromAliases(rowTokens, headerIndex, "user_id"));
        if (userId == null) {
            return RowBuildResult.fail("user_id is required");
        }
        values.put("user_id", userId);

        String legacyBranchId = normalize(getValueFromAliases(rowTokens, headerIndex, "user_branch_id"));
        BranchLookupRow matchedBranch = resolveBranch(branchLookup, legacyBranchId);

        UUID branchId = null;
        UUID regionId = null;

        if ("IBU".equals(userType)) {
            if (matchedBranch == null || matchedBranch.branchId == null) {
                return RowBuildResult.fail("IBU user_branch_id '" + legacyBranchId + "' not found in branch lookup");
            }
            branchId = matchedBranch.branchId;
            regionId = matchedBranch.regionId;
        } else {
            // IRA / IRU
            if (matchedBranch == null || matchedBranch.regionId == null) {
                return RowBuildResult.fail("IRA/IRU user_branch_id '" + legacyBranchId + "' has no resolvable region");
            }
            branchId = null;
            regionId = matchedBranch.regionId;
        }

        values.put("branch_id", branchId);
        values.put("region_id", regionId);

        values.put("active", parseBoolean(getValueFromAliases(rowTokens, headerIndex, "active"), Boolean.TRUE));
        values.put("version", parseLong(getValueFromAliases(rowTokens, headerIndex, "version"), Long.valueOf(0L)));
        values.put("created_at", parseTimestamp(getValueFromAliases(rowTokens, headerIndex, "created_at"), currentTimestamp()));

        String createdBy = normalize(getValueFromAliases(rowTokens, headerIndex, "created_by"));
        values.put("created_by", createdBy == null ? "SYSTEM" : createdBy);

        values.put("updated_at", parseTimestamp(getValueFromAliases(rowTokens, headerIndex, "updated_at"), currentTimestamp()));

        String updatedBy = normalize(getValueFromAliases(rowTokens, headerIndex, "updated_by"));
        values.put("updated_by", updatedBy == null ? "SYSTEM" : updatedBy);

        return RowBuildResult.success(values);
    }

    private BranchLookupRow resolveBranch(Map<String, BranchLookupRow> branchLookup, String legacyBranchId) {
        if (branchLookup == null || branchLookup.isEmpty()) {
            return null;
        }
        String key = normalizeKey(legacyBranchId);
        if (key == null) {
            return null;
        }

        BranchLookupRow row = branchLookup.get(key);
        if (row != null) {
            return row;
        }

        // extra fallback if source includes quotes or odd whitespace
        row = branchLookup.get(key.replace("\"", ""));
        if (row != null) {
            return row;
        }

        return null;
    }

    private void bindRow(PreparedStatement ps, Map<String, Object> rowValues) throws SQLException {
        int i = 1;
        for (String column : INSERT_COLUMNS) {
            Object value = rowValues.get(column);

            if ("id".equals(column) || "branch_id".equals(column) || "region_id".equals(column)) {
                ps.setObject(i, value);
            } else if ("active".equals(column)) {
                if (value == null) {
                    ps.setNull(i, java.sql.Types.BOOLEAN);
                } else {
                    ps.setBoolean(i, ((Boolean) value).booleanValue());
                }
            } else if ("version".equals(column)) {
                if (value == null) {
                    ps.setNull(i, java.sql.Types.BIGINT);
                } else {
                    ps.setLong(i, ((Long) value).longValue());
                }
            } else if ("created_at".equals(column) || "updated_at".equals(column)) {
                if (value == null) {
                    ps.setTimestamp(i, null);
                } else {
                    ps.setTimestamp(i, (Timestamp) value);
                }
            } else {
                ps.setString(i, value == null ? null : String.valueOf(value));
            }
            i++;
        }
    }

    private Map<String, Integer> buildHeaderIndex(List<String> headers) {
        Map<String, Integer> map = new HashMap<String, Integer>();
        if (headers == null) {
            return map;
        }

        for (int i = 0; i < headers.size(); i++) {
            String h = normalizeHeader(headers.get(i));
            if (h != null && h.length() > 0 && !map.containsKey(h)) {
                map.put(h, Integer.valueOf(i));
            }
        }
        return map;
    }

    private String getValueFromAliases(List<String> rowTokens, Map<String, Integer> headerIndex, String targetColumn) {
        List<String> aliases = SOURCE_ALIASES.get(targetColumn);
        if (aliases == null) {
            return null;
        }

        for (String alias : aliases) {
            Integer idx = headerIndex.get(normalizeHeader(alias));
            if (idx != null && idx.intValue() >= 0 && idx.intValue() < rowTokens.size()) {
                return rowTokens.get(idx.intValue());
            }
        }
        return null;
    }

    private List<String> parseCsvLine(String line, char delim) {
        List<String> result = new ArrayList<String>();
        StringBuilder current = new StringBuilder();
        boolean inQuotes = false;

        for (int i = 0; i < line.length(); i++) {
            char c = line.charAt(i);
            if (inQuotes) {
                if (c == '"') {
                    if (i + 1 < line.length() && line.charAt(i + 1) == '"') {
                        current.append('"');
                        i++;
                    } else {
                        inQuotes = false;
                    }
                } else {
                    current.append(c);
                }
            } else {
                if (c == '"') {
                    inQuotes = true;
                } else if (c == delim) {
                    result.add(current.toString());
                    current.setLength(0);
                } else {
                    current.append(c);
                }
            }
        }

        result.add(current.toString());
        return result;
    }

    private UUID parseUuid(Object value) {
        if (value == null) {
            return null;
        }
        if (value instanceof UUID) {
            return (UUID) value;
        }
        try {
            return UUID.fromString(String.valueOf(value).trim());
        } catch (Exception e) {
            return null;
        }
    }

    private Boolean parseBoolean(String value, Boolean defaultValue) {
        String n = normalize(value);
        if (n == null) {
            return defaultValue;
        }

        String v = n.toLowerCase(Locale.ENGLISH);
        if ("true".equals(v) || "t".equals(v) || "1".equals(v) || "yes".equals(v) || "y".equals(v)) {
            return Boolean.TRUE;
        }
        if ("false".equals(v) || "f".equals(v) || "0".equals(v) || "no".equals(v) || "n".equals(v)) {
            return Boolean.FALSE;
        }
        return defaultValue;
    }

    private Long parseLong(String value, Long defaultValue) {
        String n = normalize(value);
        if (n == null) {
            return defaultValue;
        }
        try {
            return Long.valueOf(n);
        } catch (Exception e) {
            return defaultValue;
        }
    }

    private Timestamp parseTimestamp(String value, Timestamp defaultValue) {
        String n = normalize(value);
        if (n == null) {
            return defaultValue;
        }

        List<DateTimeFormatter> f = Arrays.asList(
                DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"),
                DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss"),
                DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss"),
                DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss"),
                DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS"),
                DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss.SSS"),
                DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss.SSS")
        );

        for (int i = 0; i < f.size(); i++) {
            try {
                return Timestamp.valueOf(LocalDateTime.parse(n, f.get(i)));
            } catch (DateTimeParseException ignore) {
                // try next
            }
        }

        try {
            return Timestamp.from(OffsetDateTime.parse(n).toInstant());
        } catch (Exception ignore) {
            // try next
        }

        return defaultValue;
    }

    private Timestamp currentTimestamp() {
        return Timestamp.from(LocalDateTime.now().atZone(ZoneId.systemDefault()).toInstant());
    }

    private String normalize(String value) {
        if (value == null) {
            return null;
        }
        String t = value.trim();
        if (t.length() == 0) {
            return null;
        }
        if ("\\N".equalsIgnoreCase(t)) {
            return null;
        }
        if ("NULL".equalsIgnoreCase(t)) {
            return null;
        }
        return t;
    }

    private String normalizeHeader(String value) {
        String n = normalize(value);
        return n == null ? null : n.toLowerCase(Locale.ENGLISH);
    }

    private String normalizeKey(String value) {
        String n = normalize(value);
        return n == null ? null : n.toUpperCase(Locale.ENGLISH);
    }

    private File moveAfterSuccess(File sourceFile) {
        if (sourceFile == null || !sourceFile.exists()) {
            return null;
        }

        File parent = sourceFile.getParentFile();
        if (parent == null) {
            return null;
        }

        File processedDir = new File(parent, "processed");
        if (!processedDir.exists()) {
            processedDir.mkdirs();
        }

        File target = new File(processedDir, sourceFile.getName());
        int attempt = 0;

        while (target.exists()) {
            attempt++;
            String name = sourceFile.getName();
            int dot = name.lastIndexOf('.');
            String base = dot > 0 ? name.substring(0, dot) : name;
            String ext = dot > 0 ? name.substring(dot) : "";
            target = new File(processedDir, base + "_" + attempt + ext);
        }

        try {
            Files.move(sourceFile.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
            return target;
        } catch (IOException e) {
            log("ERROR", "File move failed for " + sourceFile.getName() + ": " + rootCause(e), serverIP, "FILE_MOVE_FAILED");
            return null;
        }
    }

