    private static final class DirectorySummary {
        private int totalFiles;
        private int completedFiles;
        private int retainedFiles;
        private int emptyFiles;
        private int headerOnlyFiles;
        private int errorFiles;
        private int totalRows;
        private int inserted;
        private int skipped;
        private int skippedIneligibleType;
        private int dbFailed;
        private int rowErrors;
        private int batchFailures;
        private int blankLines;

        private void accumulate(FileSummary fs) {
            if (fs == null) {
                return;
            }
            completedFiles++;
            if (!fs.moved && ("FATAL_ERROR".equalsIgnoreCase(fs.status) || "DB_ERROR".equalsIgnoreCase(fs.status) || "BATCH_FAILURE".equalsIgnoreCase(fs.status))) {
                retainedFiles++;
            }
            if (fs.emptyFile) {
                emptyFiles++;
            }
            if (fs.headerOnlyFile) {
                headerOnlyFiles++;
            }
            totalRows += fs.dataRows;
            inserted += fs.inserted;
            skipped += fs.skipped;
            skippedIneligibleType += fs.skippedIneligibleType;
            dbFailed += fs.dbFailed;
            rowErrors += fs.rowErrors;
            batchFailures += fs.batchFailures;
            blankLines += fs.blankLines;
        }
    }

