    // Only these user_mode values are eligible for this table. IAU is explicitly excluded.
    private static final Set<String> ELIGIBLE_USER_TYPES;
    static {
        Set<String> s = new HashSet<String>();
        s.add("IRA");
        s.add("IRU");
        s.add("IBU");
        ELIGIBLE_USER_TYPES = Collections.unmodifiableSet(s);
    }

    private static final String INSERT_SQL =
            "INSERT INTO re_mgmt.user_branch_region (" +
            "id, user_id, branch_id, region_id, active, version, created_at, created_by, updated_at, updated_by" +
            ") VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

    private static final List<String> INSERT_COLUMNS = Collections.unmodifiableList(Arrays.asList(
            "id",
            "user_id",
            "branch_id",
            "region_id",
            "active",
            "version",
            "created_at",
            "created_by",
            "updated_at",
            "updated_by"
    ));

    // Source CSV column aliases (user_master file) mapped to logical fields we need.
    private static final Map<String, List<String>> SOURCE_ALIASES;
    static {
        Map<String, List<String>> m = new LinkedHashMap<String, List<String>>();
        m.put("user_id", Arrays.asList("user_id", "USER_ID"));
        m.put("user_branch_id", Arrays.asList("user_branch_id", "USER_BRANCH_ID"));
        m.put("user_mode", Arrays.asList("user_mode", "USER_MODE"));
