package url_parserV1;

import javax.imageio.ImageIO;
import java.awt.image.BufferedImage;
import java.io.File;
import java.nio.file.Files;
import java.nio.file.Paths;

public class url_parser_methods_login {

    // CHANGE THIS PATH IF TESSERACT IS INSTALLED ELSEWHERE
    private static final String TESSERACT_PATH = "C:\\Program Files\\Tesseract-OCR\\tesseract.exe";

    public static void main(String[] args) throws Exception {

        String inputImage = "captcha.png";
        String processedImage = "processed.png";

        // Preprocess image (Java only)
        preprocessImage(inputImage, processedImage);

        // Run OCR using installed Tesseract (no JARs)
        String extracted = runTesseract(processedImage);

        System.out.println("Extracted CAPTCHA: " + extracted);
    }


    // -----------------------
    // 1. PREPROCESSING (NO OPENCV)
    // -----------------------
    public static void preprocessImage(String input, String output) throws Exception {
        BufferedImage img = ImageIO.read(new File(input));

        int w = img.getWidth();
        int h = img.getHeight();

        BufferedImage bw = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_BINARY);

        for (int y = 0; y < h; y++) {
            for (int x = 0; x < w; x++) {

                int rgb = img.getRGB(x, y);

                int r = (rgb >> 16) & 0xff;
                int g = (rgb >> 8) & 0xff;
                int b = rgb & 0xff;

                // Simple grayscale + threshold
                int gray = (r + g + b) / 3;
                int threshold = 120; // adjust for your captcha

                int value = (gray < threshold) ? 0 : 255;
                int newRGB = (value << 16) | (value << 8) | value;

                bw.setRGB(x, y, newRGB);
            }
        }

        ImageIO.write(bw, "png", new File(output));
    }


    // -----------------------
    // 2. OCR USING TESSERACT EXE
    // -----------------------
    public static String runTesseract(String imgPath) throws Exception {

        ProcessBuilder pb = new ProcessBuilder(
                TESSERACT_PATH,
                imgPath,
                "ocr_output",
                "-l", "eng",
                "--dpi", "300"
        );

        pb.redirectErrorStream(true);
        Process p = pb.start();
        p.waitFor();

        // Read OCR result from 'ocr_output.txt'
        byte[] data = Files.readAllBytes(Paths.get("ocr_output.txt"));
        return new String(data).trim();
    }
}



