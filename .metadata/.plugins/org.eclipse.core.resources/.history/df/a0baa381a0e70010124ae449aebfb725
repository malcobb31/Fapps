package unstructured;

import com.amazonaws.ClientConfiguration;
import com.amazonaws.auth.AWSStaticCredentialsProvider;
import com.amazonaws.auth.BasicAWSCredentials;
import com.amazonaws.client.builder.AwsClientBuilder;
import com.amazonaws.services.s3.*;
import com.amazonaws.services.s3.model.*;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.logging.*;

public class unstructured_main {

    private static final String S3_ENDPOINT = "http://172.20.161.11";
    private static final String REGION = "us-east-1";
    private static final String ACCESS_KEY = "HPZBCYK10H24VCNRKKM7";
    private static final String SECRET_KEY = "hNz4QcK6TWQUmCuqfUSr+DBHXC2kHo93Fhq5xqLm";
    private static final String SOURCE_BUCKET = "dc-bulkarch-bucket1";
    private static final String DEST_BUCKET = "testincdata";
    private static final String DEST_PREFIX = "dc-bulkarch-bucket1/";
    private static final int MAX_COPY = 10;

    private static final Logger logger = Logger.getLogger(unstructured_main.class.getName());

    static {
        Logger root = Logger.getLogger("");
        for (Handler h : root.getHandlers()) {
            root.removeHandler(h);
        }

        ConsoleHandler handler = new ConsoleHandler();
        handler.setFormatter(new Formatter() {
            private final SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
            @Override
            public String format(LogRecord r) {
                return String.format(
                        "%s | %s | %s | %s%n",
                        sdf.format(new Date(r.getMillis())),
                        r.getLevel(),
                        r.getLoggerName(),
                        r.getMessage()
                );
            }
        });

        handler.setLevel(Level.INFO);
        root.addHandler(handler);
        root.setLevel(Level.INFO);
    }

    public static void main(String[] args) {

        long startTime = System.currentTimeMillis();

        int totalScanned = 0;
        int copiedCount = 0;
        int skippedCount = 0;

        logger.info("Incremental copy job started");

        AmazonS3 s3 = createS3Client();

        ListObjectsV2Request listReq = new ListObjectsV2Request()
                .withBucketName(SOURCE_BUCKET);

        ListObjectsV2Result result;

        try {
            do {
                result = s3.listObjectsV2(listReq);

                for (S3ObjectSummary obj : result.getObjectSummaries()) {

                    totalScanned++;

                    if (copiedCount >= MAX_COPY) {
                        logger.info("Copy limit reached (" + MAX_COPY + "). Stopping early.");
                        logSummary(totalScanned, copiedCount, skippedCount, startTime);
                        return;
                    }

                    String sourceKey = obj.getKey();
                    String destKey = DEST_PREFIX + sourceKey;

                    if (destinationExists(s3, DEST_BUCKET, destKey)) {
                        skippedCount++;
                        logger.info("SKIPPED : " + sourceKey);
                        continue;
                    }

                    CopyObjectRequest copyReq = new CopyObjectRequest(
                            SOURCE_BUCKET, sourceKey,
                            DEST_BUCKET, destKey
                    );

                    s3.copyObject(copyReq);
                    copiedCount++;

                    logger.info("COPIED  : " + sourceKey);
                }

                listReq.setContinuationToken(result.getNextContinuationToken());

            } while (result.isTruncated());

            logSummary(totalScanned-1
            		, copiedCount, skippedCount, startTime);

        } catch (Exception e) {
            logger.log(Level.SEVERE, "Job failed: " + e.getMessage(), e);
            logSummary(totalScanned, copiedCount, skippedCount, startTime);
        }
    }

    private static void logSummary(int total, int copied, int skipped, long startTime) {

        long durationSec = (System.currentTimeMillis() - startTime) / 1000;

        logger.info("========== JOB SUMMARY ==========");
        logger.info("Source bucket        : " + SOURCE_BUCKET);
        logger.info("Destination bucket   : " + DEST_BUCKET);
        logger.info("Total files scanned  : " + total);
        logger.info("Files copied         : " + copied);
        logger.info("Files skipped        : " + skipped);
        logger.info("Execution time (sec) : " + durationSec);
        logger.info("=================================");
    }

    private static AmazonS3 createS3Client() {

        logger.info("Creating S3 client for endpoint " + S3_ENDPOINT);

        BasicAWSCredentials creds =
                new BasicAWSCredentials(ACCESS_KEY, SECRET_KEY);

        ClientConfiguration config = new ClientConfiguration();
        config.setSignerOverride("AWSS3V4SignerType");

        return AmazonS3ClientBuilder.standard()
                .withEndpointConfiguration(
                        new AwsClientBuilder.EndpointConfiguration(
                                S3_ENDPOINT, REGION))
                .withPathStyleAccessEnabled(true)
                .withClientConfiguration(config)
                .withCredentials(
                        new AWSStaticCredentialsProvider(creds))
                .build();
    }

    private static boolean destinationExists(
            AmazonS3 s3, String bucket, String key) {

        try {
            s3.getObjectMetadata(bucket, key);
            return true;
        } catch (AmazonS3Exception e) {
            return e.getStatusCode() != 404;
        }
    }
}




